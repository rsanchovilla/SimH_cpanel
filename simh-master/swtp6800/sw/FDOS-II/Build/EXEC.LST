11058                                          ********************************************
11059                                          * FDOS command: CHGAT,fname,nn (hex)
11060                                          ********************************************
11061                                          * set file attribute to nn
11062  
11063  0948 BD 03BE  C.CHGAT JSR     GETFNAM   Get next param in command line into FNAME/DRVNUM variables
11064  094B BD 053C          JSR     DIRSRCH
11065  094E 4D               TSTA    
11066  094F 27 03            BEQ     L0954
11067  0951 7E 0790          JMP     ERNOFIL   Print error "NO FILE", return to command prompt
11068   
11069  0954 BD 03BE  L0954   JSR     GETFNAM   Get next param in command line into FNAME/DRVNUM variables
11070  0957 CE 0169          LDX     #FNAME
11071  095A BD 096F          JSR     CVTH2B    convert hex HHHH string at addr X to binay in TMPH,TMPL
11072  095D BD 11B3          JSR     CHK9X     Check file attrib. If is $9X return to command prompt
11073  0960 B6 0174          LDAA    TMPL      get the new attribute to set
11074  0963 81 FF            CMPA    #$FF
11075  0965 27 05            BEQ     L096C     jump to error (cannot set attrib $FF)
11076  0967 A7 05            STAA    $0005,X   store new attrib in dir entry
11077  0969 7E 0A04          JMP     L0A04
11078   ;
11079  096C 7E 0228  L096C   JMP     ERFMT     Print "FORMAT ERROR", return to command prompt
11080   ;
11081   
11082                                          Convert HHHH to binary
11083                                          On Entry: X=addr of buf with HHHH hex string
11084                                          On exit: TMPH,TMPL holds the resulting value of HHHH string pointed by X
11085                                          
11086  096F 7F 0173  CVTH2B  CLR     TMPH      temp value - holds the MSB resulting value of HHHH string pointed by X
11087  0972 7F 0174          CLR     TMPL      temp value - holds the LSB resulting value of HHHH string pointed by X
11088  0975 A6 00    L0975   LDAA    $0000,X   get next char from buffer
11089  0977 BD 0983          JSR     L0983
11090  097A 24 04            BCC     L0980     if carry set -> error -> return
11091  097C FE 0175          LDX     L0175
11092  097F 39               RTS     
11093  0980 08       L0980   INX     
11094  0981 20 F2            BRA     L0975
11095   ;
11096  0983 80 30    L0983   SUBA    #$30      convert '0' -> 0
11097  0985 25 2C            BCS     L09B3     if char < '0' -> carry is set -> jump to return
11098  0987 8B E9            ADDA    #$E9
11099  0989 25 28            BCS     L09B3     if char > 'F' -> carry is set -> jump to return
11100  098B 8B 06            ADDA    #$06
11101  098D 2A 04            BPL     L0993
11102  098F 8B 07            ADDA    #$07
11103  0991 25 20            BCS     L09B3
11104  0993 8B 0A    L0993   ADDA    #$0A    
11105  0995 0C               CLC     
11106  0996 25 1B            BCS     L09B3
11107  0998 B7 0172          STAA    TMP       save bin digit
11108  099B F6 0173          LDAB    TMPH      temp value - holds the MSB resulting value of HHHH string pointed by X
11109  099E B6 0174          LDAA    TMPL      temp value - holds the LSB resulting value of HHHH string pointed by X
11110  09A1 48               ASLA    
11111  09A2 59               ROLB    
11112  09A3 48               ASLA    
11113  09A4 59               ROLB    
11114  09A5 48               ASLA    
11115  09A6 59               ROLB    
11116  09A7 48               ASLA    
11117  09A8 59               ROLB    
11118  09A9 BB 0172          ADDA    TMP       add bin digit saved
11119  09AC F7 0173          STAB    TMPH      temp value - holds the MSB resulting value of HHHH string pointed by X
11120  09AF B7 0174          STAA    TMPL      temp value - holds the LSB resulting value of HHHH string pointed by X
11121  09B2 0C               CLC     
11122  09B3 39       L09B3   RTS     
