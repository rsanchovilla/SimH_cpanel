10488  0541 46               RORA    
10489  0542 46               RORA    
10490  0543 8A 04            ORAA    #$04      dir starts at sector 4
10491  0545 B7 01F9          STAA    DRVSEC    save unit (in bits 7-6) and 1st sector of dir (bits 5-0)
10492                                          Loop on dir sectors into track
10493  0548 B6 01F9  L0548   LDAA    DRVSEC    get unit (in bits 7-6) and sector (bits 5-0) for current dir sector
10494  054B 84 3F            ANDA    #$3F      isolate sector
10495  054D 81 1B            CMPA    #SECTORS+1
10496  054F 27 49            BEQ     L059A     if current dir sector <> last one -> proceed with this dir sector
10497  0551 CE 0179          LDX     #SECBUF   Disk Sector buffer
10498  0554 B6 01F9          LDAA    DRVSEC    get unit (in bits 7-6) and sector (bits 5-0) to read
10499  0557 5F               CLRB              B=Track to read (=0 because dir is in track 0)
10500  0558 BD 0463          JSR     RDSECT    Read a disk sector (A=unit/sec, B=track, X=buffer)
10501  055B 4D               TSTA    
10502  055C 27 05            BEQ     L0563     jump if ad ok. 
10503  055E 7C 01F9          INC     DRVSEC    If cannot read the dir secotr, proceed to next one
10504  0561 20 E5            BRA     L0548
10505                                          Decode dir sector:
10506  0563 CE 0179  L0563   LDX     #SECBUF   Disk Sector buffer
10507  0566 FF 0177          STX     DIRPTR    set addr of 1st dir entry into sector buffer
10508                                          Loop on dir sectors into sector buffer
10509  0569 FE 0177  L0569   LDX     DIRPTR    get addr current dir entry 
10510  056C A6 05            LDAA    $0005,X   a=attribute
10511  056E 81 FF            CMPA    #$FF      is = $FF ? 
10512  0570 27 28            BEQ     L059A     if attrib=FF -> jump to return from dir search (with A not zero)
10513  0572 81 80            CMPA    #$80      is = $80 ?
10514  0574 27 25            BEQ     L059B     if attrib=80 -> deleted file -> jump to skip this entry and proceed with the next one
10515  0576 A6 00            LDAA    $0000,X   compare FNAME with dir entry
10516  0578 B1 0169          CMPA    FNAME
10517  057B 26 1E            BNE     L059B     not same name -> jump to skip this entry and proceed with the next one
10518  057D A6 01            LDAA    $0001,X
10519  057F B1 016A          CMPA    FNAME+1
10520  0582 26 17            BNE     L059B     not same name -> jump to skip this entry and proceed with the next one
10521  0584 A6 02            LDAA    $0002,X
10522  0586 B1 016B          CMPA    FNAME+2
10523  0589 26 10            BNE     L059B     not same name -> jump to skip this entry and proceed with the next one
10524  058B A6 03            LDAA    $0003,X
10525  058D B1 016C          CMPA    FNAME+3
10526  0590 26 09            BNE     L059B     not same name -> jump to skip this entry and proceed with the next one
10527  0592 A6 04            LDAA    $0004,X
10528  0594 B1 016D          CMPA    FNAME+4
10529  0597 26 02            BNE     L059B     not same name -> jump to skip this entry and proceed with the next one
10530  0599 4F               CLRA              file found in direntry DIRPTR -> return A=0
10531  059A 39       L059A   RTS    
10532                                          Proceed to next dir entry:
10533  059B 86 0B    L059B   LDAA    #$0B      add 11 to dirptr
10534  059D 5F               CLRB    
