11197                                          ********************************************
11198                                          * FDOS command: INIT[,unit]
11199                                          ********************************************
11200                                          * unit cannot be 0. to init unit 0 use command INITX
11201  
11202  0A4B BD 0B4D  C.INIT  JSR     GETUNIT   Get next command line param as unit 0..3 (sets DRVNUM with unit number)
11203  0A4E B6 016E          LDAA    DRVNUM
11204  0A51 27 3C            BEQ     ERFMT2    jump to print "FORMAT ERROR", return to command prompt
11205  0A53 20 03            BRA     L0A58
11206   ;
11207                                          ********************************************
11208                                          * FDOS command: INITX
11209                                          ********************************************
11210                                          * init unit 0 
11211  
11212  0A55 7F 016E  C.INITX CLR     DRVNUM    set unit to init as zero
11213  0A58 B6 016E  L0A58   LDAA    DRVNUM
11214  0A5B 0C               CLC     
11215  0A5C 46               RORA    
11216  0A5D 46               RORA    
11217  0A5E 46               RORA    
11218  0A5F 8A 03            ORAA    #$03
11219  0A61 B7 01F9          STAA    DRVSEC    save unit (in bits 7-6) and sector (bits 5-0)
11220  0A64 86 01            LDAA    #$01     
11221  0A66 B7 01FA          STAA    NXTTRK    1st file of disk starts at track 1, sector
11222  0A69 B7 01FB          STAA    NXTSEC
11223  0A6C BD 06E7          JSR     NEWDIR    Create end-of-dir entry at start of dir sector
11224  0A6F 39               RTS     
11225  
11226                                          ********************************************
11227                                          * FDOS command: HOME[,unit]
11228                                          ********************************************
11229  
11230  0A70 BD 0B4D  C.HOME  JSR     GETUNIT   Get next command line param as unit 0..3 (sets DRVNUM with unit number)
11231  0A73 B6 016E          LDAA    DRVNUM
11232  0A76 0C               CLC     
11233  0A77 46               RORA    
11234  0A78 46               RORA    
11235  0A79 46               RORA    
11236  0A7A 4C               INCA              A=unit | sector 1
11237  0A7B BD F1FF          JSR     SAVE      PROM Call: Save X in SAVXR and LDX DIO 
11238  0A7E A7 06            STAA    $0006,X   DKDOD COMMAND DISK <UNIT><SECTOR>
11239  0A80 86 20            LDAA    #$20
11240  0A82 A7 02            STAA    $0002,X   DKCOD TO THE COMMAND REGISTER
11241  0A84 DE 19            LDX     SAVXR     PROM Var
11242  0A86 BD 04D9          JSR     DSKRDY    Check if disk is ready (print error and return to command prompt if not)
11243  0A89 86 0C            LDAA    #$0C      Seek to track 0 command
11244  0A8B BD F268          JSR     LOOP      PROM CAll: Issue command in reg A and loop on busy 
11245  0A8E 39               RTS     
11246  0A8F 7E 0228  ERFMT2  JMP     ERFMT     Print "FORMAT ERROR", return to command prompt
11247  
11248                                          ********************************************
11249                                          * FDOS command: LIST[,unit]
11250                                          ********************************************
11251                                          list the disk directory 
11252                                          
11253  0A92 BD 0B4D  C.LIST  JSR     GETUNIT   Get next command line param as unit 0..3 (sets DRVNUM with unit number)
11254  0A95 B6 016E          LDAA    DRVNUM
11255  0A98 0C               CLC     
11256  0A99 46               RORA    
11257  0A9A 46               RORA    
11258  0A9B 46               RORA    
11259  0A9C 8A 04            ORAA    #$04      Now unit in bits 7-6 | sector 4 (start of dir)
11260  0A9E B7 01F9          STAA    DRVSEC    save unit (in bits 7-6) and sector (bits 5-0)
11261  
11262  0AA1 BD 0B78          JSR     LPTLN     Print <CR><LF> on printer
11263                                          RSV: replace by PRTLN to display in console instead of sending it to printer
11264  0AA4 F6 0324          LDAB    MDIRHDR   String "NAME   ATTR TRAK SCTR  SIZE"
11265  0AA7 CE 0325          LDX     #MDIRHDR+1
11266  0AAA A6 00    L0AAA   LDAA    $0000,X   
11267  0AAC BD 010C          JSR     LPTOUT    Print the string
11268                                          RSV: replace by CONOUT to display the directory in console instead of sending it to printer
11269  0AAF 08               INX     
11270  0AB0 5A               DECB    
11271  0AB1 26 F7            BNE     L0AAA
11272  0AB3 BD 0B78          JSR     LPTLN     Print <CR><LF> on printer
11273                                          RSV: replace by PRTLN to display in console instead of sending it to printer
11274  0AB6 BD 0B78          JSR     LPTLN     Print <CR><LF> on printer
11275                                          RSV: replace by PRTLN to display in console instead of sending it to printer
11276  
11277  0AB9 B6 01F9  L0AB9   LDAA    DRVSEC    get unit (in bits 7-6) and current dir sector (bits 5-0)
11278  0ABC 84 3F            ANDA    #$3F      isolate sector
11279  0ABE 81 1B            CMPA    #SECTORS+1
11280  0AC0 26 06            BNE     L0AC8     if current dir sector <> last one -> proceed with this dir sector
11281  0AC2 BD 0B78  L0AC2   JSR     LPTLN     Print <CR><LF> on printer
11282                                          RSV: replace by PRTLN to display in console instead of sending it to printer
11283  0AC5 7E 0214          JMP     EXEC      jump to Executive warm start 
11284   
11285  0AC8 B6 01F9  L0AC8   LDAA    DRVSEC    get unit (in bits 7-6) and current dir sector (bits 5-0)
11286  0ACB 5F               CLRB              Select track 0 in B: directory resides in track 0
11287  0ACC CE 0179          LDX     #SECBUF   Disk Sector buffer    
11288  0ACF BD 0463          JSR     RDSECT    Read a disk sector (A=unit/sec, B=track, X=buffer)
11289  0AD2 4D               TSTA    
11290  0AD3 27 05            BEQ     L0ADA
11291  0AD5 7C 01F9          INC     DRVSEC    save unit (in bits 7-6) and sector (bits 5-0)
11292  0AD8 20 DF    L0AD8   BRA     L0AB9
11293   
11294  0ADA CE 0179  L0ADA   LDX     #SECBUF   Disk Sector buffer
11295  0ADD FF 0177          STX     DIRPTR    get addr current dir entry 
11296  0AE0 FE 0177  L0AE0   LDX     DIRPTR    get addr current dir entry 
11297  0AE3 A6 05            LDAA    $0005,X   get attrib 
11298  0AE5 81 FF            CMPA    #$FF      is $FF?
11299  0AE7 27 D9            BEQ     L0AC2     if so -> end-of-dir entry -> jump to end dir listing
11300  0AE9 A6 00            LDAA    $0000,X   printout file name
11301  0AEB BD 010C          JSR     LPTOUT
11302  0AEE A6 01            LDAA    $0001,X
11303  0AF0 BD 010C          JSR     LPTOUT
11304  0AF3 A6 02            LDAA    $0002,X
11305  0AF5 BD 010C          JSR     LPTOUT
11306  0AF8 A6 03            LDAA    $0003,X
11307  0AFA BD 010C          JSR     LPTOUT
11308  0AFD A6 04            LDAA    $0004,X
11309  0AFF BD 010C          JSR     LPTOUT
11310  0B02 BD 0B69          JSR     LPT3SPC   Print 3 Spaces
11311  0B05 A6 05            LDAA    $0005,X   get attrib
11312  0B07 BD 043C          JSR     LPTHH     print 2-hex digits numberHH
11313  0B0A BD 0B69          JSR     LPT3SPC   Print 3 Spaces
11314  0B0D A6 06            LDAA    $0006,X   get 1st track 
11315  0B0F BD 043C          JSR     LPTHH     print 2-hex digits numberHH
11316  0B12 BD 0B69          JSR     LPT3SPC   Print 3 Spaces
11317  0B15 A6 07            LDAA    $0007,X   get 1st sector
11318  0B17 BD 043C          JSR     LPTHH     print 2-hex digits numberHH
11319  0B1A BD 0B69          JSR     LPT3SPC   Print 3 Spaces
11320  0B1D E6 08            LDAB    $0008,X   get file size (MSB)
11321  0B1F A6 09            LDAA    $0009,X   get file size (LSB)
11322  0B21 80 01            SUBA    #$01
11323  0B23 C2 00            SBCB    #$00    
11324  0B25 36               PSHA    
11325  0B26 17               TBA     
11326  0B27 BD 043C          JSR     LPTHH     print file size (MSB)
11327  0B2A 32               PULA    
11328  0B2B BD 043C          JSR     LPTHH     print file size (LSB)
11329  0B2E BD 0B78          JSR     LPTLN     Print <CR><LF> on printer
11330  0B31 86 0B            LDAA    #$0B      add 11 to DIRPTR to select next dir entry                                                      
11331  0B33 5F               CLRB    
11332  0B34 BB 0178          ADDA    L0178
11333  0B37 F9 0177          ADCB    DIRPTR    get addr current dir entry 
11334  0B3A B7 0178          STAA    L0178
11335  0B3D F7 0177          STAB    DIRPTR    get addr current dir entry 
11336  0B40 FE 0177          LDX     DIRPTR    get addr current dir entry 
11337  0B43 8C 01F2          CPX     #SECBUF+11*11
11338  0B46 26 98            BNE     L0AE0     jump if more dir entries in this dir sector
11339  0B48 7C 01F9          INC     DRVSEC    save unit (in bits 7-6) and sector (bits 5-0)
11340  0B4B 20 8B            BRA     L0AD8     jump to proceed with next dir sector
11341   
11342                                          Get next command line param as unit number '0'..'3'
11343                                          If empty -> asume '0'
11344                                          on exit: DRVNUM = 0..3 the unit number
11345   
11346  0B4D BD 03BE  GETUNIT JSR     GETFNAM   Get next param in command line into FNAME/DRVNUM variables
11347  0B50 B6 0169          LDAA    FNAME
11348  0B53 81 20            CMPA    #$20
11349  0B55 27 0B            BEQ     L0B62
11350  0B57 80 30            SUBA    #$30
11351  0B59 16               TAB     
11352  0B5A 84 FC            ANDA    #$FC
11353  0B5C 26 08            BNE     L0B66
11354  0B5E F7 016E          STAB    DRVNUM
11355  0B61 39               RTS     
11356  0B62 7F 016E  L0B62   CLR     DRVNUM
11357  0B65 39               RTS     
11358  0B66 7E 0228  L0B66   JMP     ERFMT     Print "FORMAT ERROR", return to command prompt
11359   
11360  0B69 86 20    LPT3SPC LDAA    #$20      Print 3 spaces
11361  0B6B BD 010C          JSR     LPTOUT
11362  0B6E 86 20            LDAA    #$20
11363  0B70 BD 010C          JSR     LPTOUT
11364  0B73 86 20            LDAA    #$20
11365  0B75 7E 010C          JMP     LPTOUT
11366   
11367  0B78 86 0D    LPTLN   LDAA    #$0D      Print <CR><LF> on printer
11368  0B7A BD 010C          JSR     LPTOUT
11369  0B7D 86 0A            LDAA    #$0A
11370  0B7F 7E 010C          JMP     LPTOUT
