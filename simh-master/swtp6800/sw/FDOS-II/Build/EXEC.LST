11981  0FDB 0C       DIRSE   CLC               read and set-up 1st dir sector
11982  0FDC B6 0F4E          LDAA    DUNIT     Get the unit beging used on DELETE
11983  0FDF 46               RORA    
11984  0FE0 46               RORA    
11985  0FE1 46               RORA    
11986  0FE2 8A 04            ORAA    #$04      now A=<unit> | sector 4 = start of dir
11987  0FE4 B7 0F54          STAA    PUSEM     CURRENT SECTOR BEING MOVED <UNIT><SECTOR>
