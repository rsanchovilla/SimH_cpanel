11372                                          ********************************************
11373                                          * FDOS command: ASMB,SrcFname,ObjFname,nn
11374                                          ********************************************
11375                                          * all params must be given
11376                                          * ObjFname is created, should not exist
11377                
11378  0B82 BD 0C2D  C.ASMB  JSR     GTASMPA   Get ASMB params SrcFname (opened as input), ObjFname (file created for output)
11379  0B85 BD 03BE          JSR     GETFNAM   Get next param in command line (nn) into FNAME/DRVNUM variables
11380  0B88 CE 0169          LDX     #FNAME
11381  0B8B BD 096F          JSR     CVTH2B    convert hex HHHH string at addr X to binay in TMPH,TMPL
11382  0B8E 86 FF            LDAA    #$FF
11383  0B90 97 01            STAA    OFILE     PROM Var: Output file number
11384  0B92 B6 0174          LDAA    TMPL      result of CVTH2B conversion: the nn param
11385  0B95 36               PSHA    
11386  0B96 80 05            SUBA    #$05      is nn <= 5?
11387  0B98 2A 1F            BPL     ERFMT2    if nn > 5 -> jump to print "FORMAT ERROR" and return to command prompt
11388  0B9A 32               PULA    
11389  0B9B 36               PSHA    
11390  0B9C 80 02            SUBA    #$02      is nn >= 2?
11391  0B9E 2B 19            BMI     ERFMT2    if nn < 2 -> jump to print "FORMAT ERROR" and return to command prompt
11392  0BA0 32               PULA    
11393  0BA1 48               ASLA    
11394  0BA2 4C               INCA    
11395  0BA3 97 00            STAA    PASS      PROM Var: assembly pass info
11396  0BA5 97 00            STAA    PASS      PROM Var: assembly pass info
11397  0BA7 81 07            CMPA    #$07
11398  0BA9 26 03            BNE     L0BAE
11399  0BAB 7F 0001          CLR     OFILE     PROM Var: Output file number
11400  0BAE CE 0115  L0BAE   LDX     #CMDLIN   Command Line buffer address
11401  0BB1 FF 0165          STX     CMDINI    stores the addr of 1st char in command line buffer to be processed
11402  0BB4 BD 03BE          JSR     GETFNAM   Get next param in command line ("ASMB") into FNAME/DRVNUM variables
11403  0BB7 20 2D            BRA     LOADRUN   Load FNAME prog file and Run it 
11404   
11405  0BB9 7E 0228  ERFMT2  JMP     ERFMT     Print "FORMAT ERROR", return to command prompt
11406  
11407                                          ********************************************
11408                                          * FDOS command: EDIT,InFname,NewOutFName
11409                                          ********************************************
11410                                          * alternate valid syntax: EDIT,,NewOutFName
11411                                          * NewOutFName is created, should not exists
11412  
11413  0BBC BD 03BE  C.EDIT  JSR     GETFNAM   Get next param in command line into FNAME/DRVNUM variables
11414  0BBF B6 0169          LDAA    FNAME
11415  0BC2 81 20            CMPA    #$20
11416  0BC4 27 50            BEQ     C.BUILD
11417  0BC6 BD 0C37          JSR     GTEDTPA   open FNAME as input, NewOutFName (file created for output)
11418  0BC9 7F 016E  L0BC9   CLR     DRVNUM
11419  0BCC CE 0169          LDX     #FNAME    set FNAME='EDIT '
11420  0BCF 86 45            LDAA    #$45      'E'
11421  0BD1 A7 00            STAA    $0000,X
11422  0BD3 86 44            LDAA    #$44      'D'
11423  0BD5 A7 01            STAA    $0001,X
11424  0BD7 86 49            LDAA    #$49      'I'
11425  0BD9 A7 02            STAA    $0002,X
11426  0BDB 86 54            LDAA    #$54      'T'
11427  0BDD A7 03            STAA    $0003,X
11428  0BDF B7 0200          STAA    LINCNT    Line count for VIEW command
11429  0BE2 86 20            LDAA    #$20      <SPACE>
11430  0BE4 A7 04            STAA    $0004,X
11431  
11432                                          Load and Run a prog from disk
11433                                          On Entry: FNAME/DRVNUM -> the program to load from disk
11434                                                    SVIUNIT -> the Unit and sector for input file
11435  
11436  0BE6 BD 05B7  LOADRUN JSR     OPENR     Open FNAME for reading
11437  0BE9 4D               TSTA    
11438  0BEA 27 03            BEQ     L0BEF     if A=0 -> open file success -> proceed
11439  0BEC 7E 0790          JMP     ERNOFIL   Print error "NO FILE", return to command prompt
11440    
11441  0BEF B6 01FF  L0BEF   LDAA    SVIUNIT
11442  0BF2 97 03            STAA    IUNIT     PROM Var: Unit and sector for input file
11443  0BF4 CE 0000          LDX     #$0000
11444  0BF7 DF 17            STX     OFFSET    PROM Var: Offset when loading a prog
11445  0BF9 8D 05            BSR     HIMEM     Set the High RAM addr in TEMP var
11446  0BFB 9E 11            LDS     TEMP      PROM Var
11447  0BFD 7E F032          JMP     ASSEM     PROM Call: load and start assembler
11448   
11449                                          Scan RAM to find high RAM addr
11450                                          on exit: TEMP var in zero page holds the highest RAM addr 
11451                                          RSV: change this routine to set a fixed himem value instead of scanning ram
11452                                               to avoid messing with mapped I/O addr
11453   
11454  0C00 CE 1FF0  HIMEM   LDX     #EXECEND  End of exec addr
11455  0C03 86 A5            LDAA    #$A5
11456  0C05 E6 00    L0C05   LDAB    $0000,X   check if value written to addr X is read back
11457  0C07 A7 00            STAA    $0000,X   
11458  0C09 A1 00            CMPA    $0000,X
11459  0C0B 26 05            BNE     L0C12     if not read back -> end of ram found -> jump to set TEMP var
11460  0C0D E7 00            STAB    $0000,X
11461  0C0F 08               INX     
11462  0C10 20 F3            BRA     L0C05
11463  0C12 09       L0C12   DEX     
11464  0C13 DF 11            STX     TEMP      PROM Var
11465  0C15 39               RTS     
11466  
11467                                          ********************************************
11468                                          * FDOS command: BUILD,newfile
11469                                          ********************************************
11470                                          * create new file and Call editor on it
11471  
11472  0C16 CE 0001  C.BUILD LDX     #$0001    Set vars for a dummy input file
11473  0C19 DF 04            STX     ISIZE     PROM Var: size (in sectors) of input file
11474  0C1B 86 01            LDAA    #$01
11475  0C1D 97 06            STAA    ITRK      PROM Var: Track for input file
11476  0C1F 7F 0008          CLR     ICNTR     PROM Var: IFILE buffer counter
11477  0C22 7F 0007          CLR     ISCTR     PROM Var: current sector
11478  0C25 7F 0003          CLR     IUNIT     PROM Var: Unit and sector for input file
11479  0C28 BD 0C40          JSR     CREATF    Get FNAME from command line and create it as new output file 
11480  0C2B 20 9C            BRA     L0BC9
11481   
11482                                          get ASMB params
11483   
11484  0C2D BD 03BE  GTASMPA JSR     GETFNAM   Get next param (SrcFname) in command line into FNAME/DRVNUM variables
11485  0C30 B6 0169          LDAA    FNAME
11486  0C33 81 20            CMPA    #$20
11487  0C35 27 06            BEQ     ERNOFI2   jump to Print error "NO FILE", return to command prompt
11488  0C37 BD 11B0  GTEDTPA JSR     OPCHK9X   Open FNAME and Check file attrib. If is $9X return to command prompt
11489  0C3A 4D               TSTA    
11490  0C3B 27 03            BEQ     CREATF    Get FNAME from command line (ObjFname) and create it as new output file
11491  0C3D 7E 0790  ERNOFI2 JMP     ERNOFIL   Print error "NO FILE", return to command prompt
11492   
11493                                          Create a new output file 
11494                                          name from command param, attrib = FF, size = free space
11495   
11496  0C40 BD 03BE  CREATF  JSR     GETFNAM   Get output filename into FNAME/DRVNUM variables as next param in command line 
11497  0C43 B6 0169          LDAA    FNAME
11498  0C46 81 20            CMPA    #$20      is FNAME set?
11499  0C48 27 F3            BEQ     ERNOFI2   jump to Print error "NO FILE", return to command prompt
11500  
11501                                          Create a new output file 
11502                                          name = fname, attrib = FF, size = free space
11503  
11504  0C4A CE 07B7  NEWFILE LDX     #MAXSIZE  Max posible file size in sectors (is DOOF1 routine in EDOS-II)
11505  0C4D DF 09            STX     OSIZE     PROM Var: set size of output file
11506  0C4F FF 0170          STX     FSIZE
11507                                          Set FSIZE for new output file = free space in disk
11508  0C52 86 FF    L0C52   LDAA    #$FF
11509  0C54 B7 016F          STAA    ATTRIB    file attribute
11510  0C57 BD 0610          JSR     OPENX     Open new file for writting
11511  0C5A 4D               TSTA    
11512  0C5B 27 11            BEQ     L0C6E     jump if success -> proceed with new file created
11513  0C5D 81 03            CMPA    #$03      if A=3 -> no room (X=number of free sectors=max size of file that can be created), use this value
11514  0C5F 26 0A            BNE     L0C6B     jump to print file creation error          
11515  0C61 DF 09            STX     OSIZE     PROM Var: use available size as size of output file
11516  0C63 FF 0170          STX     FSIZE
11517  0C66 26 EA            BNE     L0C52     if disk not full -> go back to tray to open file again
11518  0C68 7E 0A3F          JMP     ERNROOM   Print "NO ROOM" error, return to command prompt
11519  0C6B 7E 0A32  L0C6B   JMP     ERNEWFI   Print new file creation error, return to command prompt
11520                                          Set Track/sector for new output file     
11521  0C6E B6 01FC  L0C6E   LDAA    NEWTRK    starting track of new file
11522  0C71 97 0B            STAA    OTRK      PROM Var: set output file start track
11523  0C73 B6 016E          LDAA    DRVNUM
11524  0C76 97 02            STAA    OUNIT     PROM Var: Unit and sector for output file
11525  0C78 0C               CLC     
11526  0C79 46               RORA    
11527  0C7A 46               RORA    
11528  0C7B 46               RORA    
11529  0C7C BA 01FD          ORAA    NEWSEC    starting sector of new file
11530  0C7F 97 0C            STAA    OSCTR     PROM Var: set output file start sector
11531  0C81 7F 000D          CLR     OCNTR     PROM Var: set buffer counter of output file
11532  
11533                                          Save ITRK/ISIZE/IUNIT
11534  
11535  0C84 96 06    SVIFILE LDAA    ITRK      PROM Var: Track for input file
11536  0C86 97 0E            STAA    TITRK     PROM Var
11537  0C88 DE 04            LDX     ISIZE     PROM Var: size (in sectors) of input file
11538  0C8A DF 0F            STX     TISZE     PROM Var
11539  0C8C 96 03            LDAA    IUNIT     PROM Var: Unit and sector for input file
11540  0C8E B7 01FF          STAA    SVIUNIT
11541  0C91 86 FF            LDAA    #$FF
11542  0C93 97 01            STAA    OFILE     PROM Var: Output file number
11543  0C95 39               RTS     
11544  
11545                                          ********************************************
11546                                          * FDOS command: LOAD,newfile
11547                                          ********************************************
11548                                          * create a new file and loads it from paper tape
11549  
11550  0C96 BD 0C40  C.LOAD  JSR     CREATF    Get FNAME from command line and create it as new output file
11551  0C99 BD 0D01          JSR     WROFILE   read bytes and write them into output file until Ctrl-Z
11552  0C9C 7E 073D          JMP     UPDAT     close output file (flush data to floppy)     
11553  
11554                                          ********************************************
11555                                          * FDOS command: XGEN[,fname]
11556                                          ********************************************
11557                                          * if fname present -> will use it as EXEC
11558                                          * else -> will read EXEC from paper tape
11559  
11560  0C9F 86 01    C.XGEN  LDAA    #$01      Set destination to track 1, sector 1, unit 0
11561  0CA1 97 0B            STAA    OTRK      PROM Var: set output file start track
11562  0CA3 97 0C            STAA    OSCTR     PROM Var: set output file start sector
