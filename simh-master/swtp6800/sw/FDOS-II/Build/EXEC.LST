11149  09EA 81 20            CMPA    #$20
11150  09EC 27 F0            BEQ     L09DE     jump if NewName is blank
11151  09EE A7 00            STAA    $0000,X   Update filename
11152  09F0 B6 016A          LDAA    FNAME+1
11153  09F3 A7 01            STAA    $0001,X
11154  09F5 B6 016B          LDAA    FNAME+2
11155  09F8 A7 02            STAA    $0002,X
