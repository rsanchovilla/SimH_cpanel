11021  08FD 20 AC            BRA     VIEWGK    jump to get key from user
11022                                          Process P (Previous) command -> print previous frame
11023  08FF FE 0175  VIEWP   LDX     NLINE     current line for VIEW command
11024  0902 B6 0947          LDAA    NFRAME+1  number of lines per frame (defaults to 20)
11025  0905 49               ROLA    
11026  0906 09       VIEW9   DEX     
11027  0907 27 E6            BEQ     VIEWF     -> return to first frame of file 
11028  0909 4A               DECA    
11029  090A 26 FA            BNE     VIEW9
11030  090C FF 0200          STX     LINCNT    Line count for VIEW command
11031  090F CE 0000          LDX     #$00
11032  0912 FF 0175          STX     NLINE     current line for VIEW command
11033  0915 FE 0946          LDX     NFRAME    number of lines per frame (defaults to 20)
11034  0918 FF 01FE          STX     NFRAM2    number of lines per frame 
11035  091B BD F03B          JSR     RESTR     restore IFILE pointers -> rewind the file
11036  091E 86 0A            LDAA    #$0A
11037  0920 BD 0112          JSR     CONOUT
11038  0923 7E 086E          JMP     VIEW1
11039   ;
11040  0926 FE 0175  INCLIN  LDX     NLINE     current line for VIEW command
11041  0929 08               INX     
11042  092A FF 0175          STX     NLINE     current line for VIEW command
11043  092D FE 0200          LDX     LINCNT    Line count for VIEW command
11044  0930 09               DEX     
11045  0931 FF 0200          STX     LINCNT    Line count for VIEW command
11046  0934 39               RTS     
