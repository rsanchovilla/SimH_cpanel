10788  0746 7D 000D  L0746   TST     OCNTR     PROM Var: buffer counter of output file
10789  0749 27 06            BEQ     L0751
10790  074B 4F               CLRA    
10791  074C BD F1AD          JSR     WRT       PROM Call: write byte to disk
10792  074F 20 F5            BRA     L0746
10793                                  
10794  0751 CE 0000  L0751   LDX     #$00
10795  0754 FF 0169          STX     FNAME     clear FNAME
10796  0757 FF 016B          STX     FNAME+2
10797  075A FF 016C          STX     FNAME+3
10798  
10799  075D 96 02            LDAA    OUNIT     PROM Var: Unit and sector for output file
10800  075F B7 016E          STAA    DRVNUM
10801  0762 4F               CLRA    
10802  0763 B7 016F          STAA    ATTRIB    set file attribute = 0
10803  0766 BD 053C          JSR     DIRSRCH   search for FNAME=0000 -> will not found to -> should return $FF as file not found
10804  0769 81 FF            CMPA    #$FF
10805  076B 26 BB            BNE     ERMEDIA   ... else some error has ocurred searching the dir
10806  076D FE 0177          LDX     DIRPTR    get addr of last dir entry (as file 00000 is not found)
10807  0770 A6 09            LDAA    $0009,X   get file size (LSB)
10808  0772 E6 08            LDAB    $0008,X   get file size (MSB)
10809  0774 80 01            SUBA    #$01    
10810  0776 C2 00            SBCB    #$00
10811  0778 90 0A            SUBA    OSIZE+1   PROM Var: set size of output file 
10812  077A D2 09            SBCB    OSIZE     PROM Var: set size of output file
10813                                          fsize = free size - actual output file size
10814  077C B7 0171          STAA    FSIZE+1
10815  077F F7 0170          STAB    FSIZE
10816  0782 BD 067F          JSR     NEWATSZ   Set attrib of new file in dir entry just created, update end-of-dir 
10817  0785 20 BC            BRA     L0743     jp to terminate update
10818   ;
10819                                          ********************************************
10820                                          * FDOS command: RUN,progfile[,hhhh]
10821                                          ********************************************
10822                                          * load prog from with bias hhhh (16bits hex value). 
10824                                          * then go to monitor
10825  
10826  0787 BD 03BE  C.RUN   JSR     GETFNAM   Get next param (program file) in command line into FNAME/DRVNUM variables
10827  078A BD 05B7          JSR     OPENR     Open file for reading
10828  078D 4D               TSTA    
10829  078E 27 09            BEQ     L0799     if A=0 -> open file success -> proceed
10830  0790 F6 0305  ERNOFIL LDAB    MNOFILE   String "NO FILE"
10831  0793 CE 0306          LDX     #MNOFILE+1
10832  0796 7E 022E          JMP     PRTERR    Print error msg and return to command line
10833   ;
10834  0799 BD 03BE  L0799   JSR     GETFNAM   Get next param in command line into FNAME/DRVNUM variables
10835  079C CE 0169          LDX     #FNAME    is the optional offset on loading 
10836  079F BD 096F          JSR     CVTH2B    convert hex HHHH string at addr X to binay in TMPH,TMPL
10837  07A2 FE 0173          LDX     TMPH      conversion result - the offset in RUN command
10838  07A5 DF 17            STX     OFFSET    PROM Var: Offset when loading a prog
10839  07A7 BD 0C00          JSR     HIMEM     Set the High RAM addr in TEMP var
10840  07AA 9E 11            LDS     TEMP      PROM Var
10841  07AC 7E F02C          JMP     PROG      PROM Call: PROG loads a program an return to monitor
10842  
10843                                          ********************************************
10844                                          * FDOS command: RUNGO,progfile,[InFile],[OutFile],[hh]
10845                                          ********************************************
10846                                          * is present, outfile is created. If already exists -> error "DUPL FILE"
10847                                          * hh is progfile param stored in PASS
10848  
10849  07AF BD 03BE  C.RUNGO JSR     GETFNAM   Get next param (progfile) in command line into FNAME/DRVNUM variables
10850  07B2 BD 03BE          JSR     GETFNAM   Get next param (InFile) in command line into FNAME/DRVNUM variables
10851  07B5 CE 0001          LDX     #$01      init to no input file
10852  07B8 DF 04            STX     ISIZE     PROM Var: size (in sectors) of input file
10853  07BA 7F 0006          CLR     ITRK      PROM Var: Track for input file
10854  07BD 7F 0003          CLR     IUNIT     PROM Var: Unit and sector for input file
10855  07C0 B6 0169          LDAA    FNAME
10856  07C3 81 20            CMPA    #$20
10857  07C5 27 09            BEQ     L07D0     if no infile -> jump to proceed without input file
10858  07C7 BD 05B7          JSR     OPENR     Open input file for reading
10859  07CA 4D               TSTA    
10860  07CB 27 03            BEQ     L07D0     if A=0 -> open file success -> proceed
10861  07CD 7E 0790          JMP     ERNOFIL   Print error "NO FILE", return to command prompt
10862   ;
10863  07D0 BD 03BE  L07D0   JSR     GETFNAM   Get next param (OutFile) in command line into FNAME/DRVNUM variables
10864  07D3 B6 0169          LDAA    FNAME
10865  07D6 81 20            CMPA    #$20
10866  07D8 27 05            BEQ     L07DF     if no outfile -> jump to proceed without output file
10867  07DA BD 0C4A          JSR     NEWFILE   Create new file FNAME
10868  07DD 20 16            BRA     L07F5
10869   ;
10870  07DF CE 0001  L07DF   LDX     #$01
10871  07E2 DF 09            STX     OSIZE     PROM Var: set size of output file
10872  07E4 86 4C            LDAA    #TRACKS-1
10873  07E6 97 0B            STAA    OTRK      PROM Var: set output file start track
10874  07E8 86 01            LDAA    #$01
10875  07EA 97 0C            STAA    OSCTR     PROM Var: set output file start sector
10876  07EC 7F 000D          CLR     OCNTR     PROM Var: set buffer counter of output file
10877  07EF BD 0C84          JSR     SVIFILE   Save ITRK/ISIZE/IUNIT
10878  07F2 7F 0001          CLR     OFILE     PROM Var: Output file number
10879  
10880  07F5 BD 03BE  L07F5   JSR     GETFNAM   Get next param in command line into FNAME/DRVNUM variables
10881  07F8 CE 0169          LDX     #FNAME
10882  07FB BD 096F          JSR     CVTH2B    convert hex HHHH string at addr X to binay in TMPH,TMPL
10883  07FE B6 0174          LDAA    TMPL      temp value
10884  0801 97 00            STAA    PASS      PROM Var: assembly pass info
10885  0803 CE 0115          LDX     #CMDLIN   Command Line buffer address
10886  0806 FF 0165          STX     CMDINI    stores the addr of 1st char in command line buffer to be processed
10887  0809 BD 03BE          JSR     GETFNAM   Get next param (skips "RUNGO")
10888  080C BD 03BE          JSR     GETFNAM   Get next param (the program filename)
10889  080F 7E 0BE6          JMP     LOADRUN   Load FNAME prog file and Run it 
