11175  0A18 BD 03BE          JSR     GETFNAM   Get next param in command line into FNAME/DRVNUM variables
11176  0A1B FE 0165          LDX     CMDINI    get the addr of 1st char in command line buffer to be processed
11177  0A1E BD 096F          JSR     CVTH2B    convert hex HHHH string at addr X to binay in TMPH,TMPL
11178  0A21 FE 0173          LDX     TMPH      get the hh value
11179  0A24 27 22            BEQ     L0A48
11180  0A26 FF 0170          STX     FSIZE     use it as file length
11181  0A29 BD 0610          JSR     OPENX     Open new file for writting
11182  0A2C 4D               TSTA    
11183  0A2D 26 03            BNE     ERNEWFI   Print new file creation error, return to command prompt
11184  0A2F 7E 0214          JMP     EXEC      jump to Executive warm start 
11185   ;
11186  0A32 81 02    ERNEWFI CMPA    #$02      Print error when creating a new file: A=2 -> file already exists
11187  0A34 26 09            BNE     ERNROOM                                         else > no room
11188  0A36 F6 0312  ERDUPL  LDAB    MDUPLFL   String "DUPL FILE"
11189  0A39 CE 0313          LDX     #MDUPLFL+1
11190  0A3C 7E 022E          JMP     PRTERR    Print error msg and return to command line
11191  0A3F F6 031C  ERNROOM LDAB    MNOROOM   String "NO ROOM"
11192  0A42 CE 031D          LDX     #MNOROOM+1
11193  0A45 7E 022E          JMP     PRTERR    Print error msg and return to command line
11194   ;
11195  0A48 7E 0228  L0A48   JMP     ERFMT     Print "FORMAT ERROR", return to command prompt
