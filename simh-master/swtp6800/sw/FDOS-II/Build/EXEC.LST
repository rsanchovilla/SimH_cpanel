00000  
00001                                             FDOS-II executve EXEC
00002                                             
00003                                             Thanks to Ben Zotto for FDOS-II original disk
00004                                             Disassembly annotated by Roberto Sancho Feb/2026
00005                  
10000  
10001                SECTORS EQU     26        Sectors per track
10002                TRACKS  EQU     77        tracks per disk 
10003                MAXSIZE EQU     (NUMTRK-1)*NUMSEC-1      (77-1)*26-1=1975=07B7h -> max posible file size in sectors - 1
10004  
10005                                          ICOM FD360 PROM ENTRY POINTS
10006  
10007                DKDID EQU $F800 INPUT DATA FROM DISK
10008                DKDIC EQU $F801 INPUT DATA CONTROL
10009                DKCOD EQU $F802 OUTPUT COMMANDS TO DISK
10010                DKCOC EQU $F803 OUTPUT COMMAND CONTROL
10011                DKDOD EQU $F806 OUTPUT DATA TO DISK
10012                DKDOC EQU $F807 OUTPUT DATA CONTROL

                                               Also uses $E401 PIA SIO SERIAL I/O. =$37 to turn echo off
10013                                
10014                FDOS    EQU     $F000     Boot FDOS          
10015                        EQU     $F003     FDOS call updt
10016                
10017                CI      EQU     $F006     CI    console char in            
10018                CO      EQU     $F009     CO    console char out
10019                RDI     EQU     $F00C     RDI   paper tape reader in
10020                LO      EQU     $F00F     LO    list output
10021                PO      EQU     $F012     PO    punch output
10022                EXIT    EQU     $F015     MONITOR
10023                
10024                DIO     EQU     $F018     Disk I/O PIA port is FDB DKDID = $F800
10025                                          used en COPY command, in XSUP/LOOPP/RDSECP routine
10026                 
10027                PROG    EQU     $F02C     PROG  load a program and return to monitor
10028                ASSEM   EQU     $F032     ASSEM load and start assembler
10029                RESTR   EQU     $F03B     RESTR restore IFILE pointers
10030                RESET   EQU     $F06F     RESET set up PIAs and reset drive electronics
10031                RI      EQU     $F135     RI    read a byte from disk in reg A, if EOF carry is set
10032                WRT     EQU     $F1AD     WRT   write a byte to disk from reg A
10033                SAVE    EQU     $F1FF     SAVE  STX SAVXR; LDX DIO; RTS save X, return Input data from disk
10034                XUS     EQU     $F22C     XMIT  send select unit/sector (logical) to disk
10035                SEEK    EQU     $F250     SEEK  track in A
10036                RFLAG   EQU     $F25F     RFLAG Reset error flag
10037                LOOP    EQU     $F268     LOOP  Issue command in reg A and loop on busy 
10038  
10039                                          VARIABLES IN ZERO PAGE USED BY ICOM FD360 PROM ENTRY POINTS
10040  
10041                PASS    EQU     $00       ASSEMBLY PASS INFO
10042                OFILE   EQU     $01       OFILE NUMBER (set if output file open)
10043                OUNIT   EQU     $02       OFILE UNIT
10044                IUNIT   EQU     $03       IFILE UNIT - SCTR/UNIT
10045                ISIZE   EQU     $04       IFILE SIZE
10046                ITRK    EQU     $06       IFILE TRACK
10047                ISCTR   EQU     $07       IFILE SECTOR
10048                ICNTR   EQU     $08       IFILE BUFFER COUNTER
10049                OSIZE   EQU     $09       OFILE SIZE
10050                OTRK    EQU     $0B       OFILE TRACK
10051                OSCTR   EQU     $0C       OFILE SECTOR
10052                OCNTR   EQU     $0D       OFILE BUFFER COUNTER
10053                TITRK   EQU     $0E       save ITRACK
10054                TISZE   EQU     $0F       save ISIZE
10055  
10056  
10057                SAVXR   EQU     $19       Save X reg, used by PROM
10058                TEMP    EQU     $11        
10059                OFFSET  EQU     $17       Offset when loading a prog
10060  
10061                        ORG     $0100     EXEC start
10062                EXECINI EQU *             Start of executive prog
10063   
10064  0100 7E 0202          JMP     EXECINI   EXEC Cold Start 
10065  0103 7E 073D          JMP     UPDAT     close output file (flush data to floppy)
10066  0106 7E F012  PCHOUT  JMP     PO        punch output
10067  0109 7E F00C  RDRIN   JMP     RDI       paper tape reader in
10068  010C 7E F00F  LPTOUT  JMP     LO        Send a char to line printer
10069  010F 7E F006  CONIN   JMP     CI        Read char from console (bloquing)
10070  0112 7E F009  CONOUT  JMP     CO        Print char in A in console
10071  
10072  0115          CMDLIN  RMB     80        Command Line buffer: the command line typed by user at "!" prompt. 
10073  0165          CMDINI  RMB     2         stores the addr of 1st char in command line buffer to be processed
10074  0167          CMDLEND RMB     2         stores the addr of last char in command line buffer (the addr of final <CR> + 1)
10075  0169          FNAME   RMB     5         current filename param (read from command line)
10076  016E          DRVNUM  RMB     1         drive unit number 0..3
10077  016F          ATTRIB  RMB     1         file attribute 
10078  0170          FSIZE   RMB     2         file size
10079  0172          TMP     RMB     1         temp value used in hex to binary conversion CVTH2B routine, RENAM/COPY commands, punch space PCHADV routine
10080  0173          TMPH    RMB     1         8/16bit temp value used RDSECT/WRSECT, number of free sectors in disc in OPENX routine,
10081  0174          TMPL    RMB     1                 16bits hex to bin value as result of CVTH2B, temp value in COPY/MERGE command
10082  0175          NLINE   RMB     1         current line for VIEW command   
10083  0176          L0176
10084  0177          DIRPTR  RMB     2         addr of current dir entry into sector buffer
10085  0179          SECBUF  RMB     128       Disk Sector buffer
10086  01F9          DRVSEC  RMB     1         unit (in bits 7-6) and sector (bits 5-0. 1st sector of track is sector 1)
10087  01FA          NXTTRK  RMB     1         1st free sector to place in end-of-dir entry 
10088  01FB          NXTSEC  RMB     1
10089  01FC          NEWTRK  RMB     1         1st track when creating a new file
10090  01FD          NEWSEC  RMB     1         1st sector when creating a new file
10091  01FE          L01FE
10092  01FF          SVIUNIT RMD     1         save Input file unit | sector
10093  0200          LINCNT  RMD     1         Line count for VIEW command
10094  0201          EOFFLAG RMD     1         end of file flag
10095  
10096  0202 8E 1FF0  EXECINI LDS     #EXECEND  Set initial stack
10097  0205 BD 041E          JSR     PRTLN     Print <CR><LF> to start a new line
10098  0208 F6 035F          LDAB    MBANNER   String "ICOM FDOS-II" (cold startup banner)
10099  020B CE 0360          LDX     #MBANNER+1
10100  020E BD 0414          JSR     PRTSTR    Print String
10101  0211 BD 041E          JSR     PRTLN     Print <CR><LF> to start a new line
10102  
10103  0214 BD 119F  EXEC    JSR     ECHOOFF   SET ECHO OFF for CONIN
10104  0217 8E 1FF0          LDS     #EXECEND  Init this stack pointer
10105  021A BD 0381          JSR     RDCMD     Print "!" prompt and read command line from console
10106  021D BD 03BE          JSR     GETFNAM   Get 1st param in command line into FNAME/DRVNUM variables
10107  0220 CE 0265          LDX     #CMDTBL
10108                                          Scan command table for FNAME and jump to corresponding routine
10109  0223 8C 02F8  L0223   CPX     #CMDTEND  table finished?
10110  0226 26 0B            BNE     L0233     if not finished -> jump to process the current table entry 
10111                                          Command not found:
10112  0228 F6 02F8  ERFMT   LDAB    MFMTERR   String "FORMAT ERROR"
10113  022B CE 02F9          LDX     #MFMTERR+1
10114  022E BD 0414  PRTERR  JSR     PRTSTR    Print String
10115  0231 20 E1            BRA     EXEC      jump to Executive warm start 
10116                                          Process command table entry:
10117  0233 A6 00    L0233   LDAA    $0000,X   Compare command in FNAME with command name in table
10118  0235 B1 0169          CMPA    FNAME
10119  0238 26 22            BNE     L025C     jump if not this command
10120  023A A6 01            LDAA    $0001,X
10121  023C B1 016A          CMPA    FNAME+1
10122  023F 26 1B            BNE     L025C     jump if not this command
10123  0241 A6 02            LDAA    $0002,X
10124  0243 B1 016B          CMPA    FNAME+2
10125  0246 26 14            BNE     L025C     jump if not this command
10126  0248 A6 03            LDAA    $0003,X
10127  024A B1 016C          CMPA    FNAME+3
10128  024D 26 0D            BNE     L025C     jump if not this command
10129  024F A6 04            LDAA    $0004,X
10130  0251 B1 016D          CMPA    FNAME+4
10131  0254 26 06            BNE     L025C     jump if not this command
10132                                          command found in command table:
10133  0256 EE 05            LDX     $0005,X   get the address for this comand
10134  0258 AD 00            JSR     $0000,X   call it
10135  025A 20 B8            BRA     EXEC      jump to Executive warm start 
10136                                          command found in current entry:
10137  025C 08       L025C   INX               select next command table entry   
10138  025D 08               INX     
10139  025E 08               INX     
10140  025F 08               INX     
10141  0260 08               INX     
10142  0261 08               INX     
10143  0262 08               INX     
10144  0263 20 BE            BRA     L0223     jump to process the command table entry
