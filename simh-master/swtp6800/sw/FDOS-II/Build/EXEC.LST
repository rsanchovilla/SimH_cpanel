10891                                          ********************************************
10892                                          * FDOS command: PRINT,fname
10893                                          ********************************************
10894                                          * send file to line printer
10895  
10896  0812 BD 03BE  C.PRINT JSR     GETFNAM   Get next param in command line into FNAME/DRVNUM variables
10897  0815 BD 11B0          JSR     OPCHK9X   Open FNAME and Check file attrib. If is $9X return to command prompt
10898  0818 4D               TSTA    
10899  0819 27 03            BEQ     L081E
10900  081B 7E 0790          JMP     ERNOFIL   Print error "NO FILE", return to command prompt
10901   ;
10902  081E BD F135  L081E   JSR     RI        RI read a byte from disk in reg A, if EOF carry is set
10903  0821 25 09            BCS     L082C     Ctrl-Z <EOF> read from disk -> jump to terminate printing
10904  0823 84 7F            ANDA    #$7F
10905  0825 27 F7            BEQ     L081E     Skip any 00 byte
10906  0827 BD 010C          JSR     LPTOUT    Print 
10907  082A 20 F2            BRA     L081E
10908   ;
10909  082C 7E 0214  L082C   JMP     EXEC      jump to Executive warm start 
10910   
10911                                          process <fname,hhhh> command parameter
10912                                          on exit: fname is open for read
10913                                                   hhhh hex value defaults to $14 (=20) if not set
10914                                                   stored in NFRAM2,NFRAME     
10933  
10934                                          ********************************************
10935                                          * FDOS command: VIEW,fname,nn,n0
10936                                          ********************************************
10937                                          * view file in console
10938                                          * nn=lines per frame in hex. defaults to 20 (dec) = 14 (hex)
10939                                          * n0=first line to be shown
10940                                          * keys while viewving a file: N/P -> next/prev frame, F/B
10941  
10915  082F CE 0000  CMDFNHH LDX     #$00
10916  0832 FF 0175          STX     NLINE     current line for VIEW command
10917  0835 BD 03BE          JSR     GETFNAM   Get next param in command line into FNAME/DRVNUM variables
10918  0838 BD 05B7          JSR     OPENR     Open file for reading
10919  083B 4D               TSTA    
10920  083C 27 03            BEQ     L0841     if A=0 -> open file success -> proceed
10921  083E 7E 0790          JMP     ERNOFIL   Print error "NO FILE", return to command prompt
10923  0841 BD 0C84  L0841   JSR     SVIFILE   Save ITRK/ISIZE/IUNIT
10924  0844 BD 03BE          JSR     GETFNAM   Get next param in command line into FNAME/DRVNUM variables
10925  0847 CE 0169          LDX     #FNAME
10926  084A BD 096F          JSR     CVTH2B    convert hex HHHH string at addr X to binay in TMPH,TMPL
10927  084D FE 0173          LDX     TMPH      conversion result
10928  0850 26 03            BNE     L0855
10929  0852 CE 0014          LDX     #$14      =20 is the default value for lines per frame
10930  0855 FF 01FE  L0855   STX     NFRAM2    number of lines per frame 
10931  0858 FF 0946          STX     NFRAME    number of lines per frame (defaults to 20)
10932  085B 39               RTS     

10942  085C BD 082F  C.VIEW  JSR     CMDFNHH   process <fname,hhhh> command parameter
10943  085F BD 11C2          JSR     CHK9XP    Check file attrib. If is $9X return to command prompt, else read next param
10944  0862 CE 0169          LDX     #FNAME
10945  0865 BD 096F          JSR     CVTH2B    convert hex HHHH string at addr X to binay in TMPH,TMPL
10946  0868 FE 0173          LDX     TMPH      temp value -> n0 param = first line to be shown
10947  086B FF 0200          STX     LINCNT    Set Line count for VIEW command

10948  086E FE 0200  VIEW1   LDX     LINCNT    Get Line count for VIEW command
10949  0871 8C 0000          CPX     #$00      if > then 0 read LINE0 lines from file
10950  0874 27 12            BEQ     VIEWN     goto print next frame of file
                                               skip LINCNT lines from input file

10951  0876 BD F135  VIEW2   JSR     RI        RI read a byte from disk in reg A, if EOF carry is set
10952  0879 25 79            BCS     VIEWEOF   jmp if end of file
10953  087B 84 7F            ANDA    #$7F      clear bit8
10954  087D 27 F7            BEQ     VIEW2     if <NUL> goto read next byte from file
10955  087F 81 0A            CMPA    #$0A
10956  0881 26 F3            BNE     VIEW2     if not <LF> goto read next byte from file
10957  0883 BD 0926          JSR     INCLIN    incr NLINE, decr LINE0
10958  0886 26 EE            BNE     VIEW2     if LINE0 <> 0 goto read next byte from file

10959  0888 FE 01FE  VIEWN   LDX     NFRAM2    get number of lines per frame      
10960  088B FF 0200          STX     LINCNT    Line count for VIEW command

                                               print LINCNT lines from input file

10961  088E BD 0935  VIEW4   JSR     PRTHHHH   Print NLINE as 4 hex digits, then space
10962  0891 BD F135  VIEW5   JSR     RI        RI read a byte from disk in reg A, if EOF carry is set
10963  0894 25 5E            BCS     VIEWEOF   jmp if end of file
10964  0896 84 7F            ANDA    #$7F
10965  0898 27 F7            BEQ     VIEW5     if <NUL> goto read next byte from file
10966  089A 81 0A            CMPA    #$0A   
10967  089C 27 05            BEQ     VIEW6
10968  089E BD 0112          JSR     CONOUT    print char from file if not <LF>
10969  08A1 20 EE            BRA     VIEW5
10971  08A3 BD 0112  VIEW6   JSR     CONOUT    print <LF>
10972  08A6 BD 0926          JSR     INCLIN    incr NLINE, decr LINE0
10973  08A9 26 E3            BNE     VIEW4     if LINE0 <> 0 goto read next byte from file

10974  08AB BD 0422  VIEWGK  JSR     GETKEY    Get Key from console
10975  08AE 36               PSHA      
10976  08AF BD 041E          JSR     PRTLN     Print <CR><LF> to start a new line
10977  08B2 32               PULA    
10978  08B3 C6 46            LDAB    #$46      'F'
10979  08B5 11               CBA     
10980  08B6 26 02            BNE     VIEW8     key is not 'F'
10981  08B8 20 35            BRA     VIEWF     Process F (First) command -> return to first frame of file 
10983  08BA C6 50    VIEW8   LDAB    #$50      'P'
10984  08BC 11               CBA     
10985  08BD 27 40            BEQ     VIEWP     Process P (Previous) command -> print previous frame
10986  08BF C6 4E            LDAB    #$4E      'N'
10987  08C1 11               CBA     
10988  08C2 27 C4            BEQ     VIEWN     Process N (Next) command -> print next frame of file 
10989  08C4 C6 42            LDAB    #$42      'B'
10990  08C6 11               CBA     
10991  08C7 27 0F            BEQ     VIEWB     Process B (Beginning) command -> print 1st line of file
10992  08C9 C6 0D            LDAB    #$0D      <CR>
10993  08CB 11               CBA     
10994  08CC 27 07            BEQ     VIEWX     Process <CR> -> exits VIEW command
10995  08CE 86 3F            LDAA    #$3F      '?'
10996  08D0 BD 0112          JSR     CONOUT
10997  08D3 20 D6            BRA     VIEWGK    jump to get key from user
10998   ;
10999  08D5 7E 0202  VIEWX   JMP     EXECINI   EXEC Cold Start 
11000   
11014                                          Process B (Beginning) command -> return to first line of file 
11001  08D8 8D 0B    VIEWB   BSR     CMDLRST   Reset command line pointer, 
11002  08DA BD 082F          JSR     CMDFNHH   process <fname,hhhh> command parameter 
11003  08DD CE 0000          LDX     #$00
11004  08E0 FF 0200          STX     LINCNT    Line count for VIEW command
11005  08E3 20 89            BRA     VIEW1
11006   
11007                                          Reset command line pointer, so
11008                                          next call to GETFNAM will fill FNAME with 1st command line parameter 
11009   
11010  08E5 CE 0115  CMDLRST LDX     #CMDLIN   Command Line buffer address
11011  08E8 FF 0165          STX     CMDINI    stores the addr of 1st char in command line buffer to be processed
11012  08EB BD 03BE          JSR     GETFNAM   Get next param in command line into FNAME/DRVNUM variables
11013  08EE 39               RTS     
11014                                          Process F (First) command -> return to first frame of file 
11015  08EF 8D F4    VIEWF   BSR     CMDLRST   Reset command line pointer, so
11016  08F1 7E 085C          JMP     C.VIEW
