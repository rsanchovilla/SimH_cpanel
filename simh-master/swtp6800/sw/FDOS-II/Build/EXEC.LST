11915  0F48 39               RTS               file copied -> return
11916  
11917  0F49 7C 0201  L0F49   INC     EOFFLAG   set end of file flag
11918  0F4C 20 E1            BRA     L0F2F     jump to start writing
11919   ;
11920  0F4E 00       DUNIT   RMB     1         unit 0..4 begin modified (on DELETE, PACK)
11921  0F4F 00 00    PUFCP   RMB     2         FILE CONTROL BLOCK STRING POINTER (FILE BEING PURGED)
11922  0F51 00       PUSEC   RMB     1         CURRENT SECTOR BEING PURGED <UNIT><SECTOR>
11923  0F52 00 00    PUFMP   RMB     2         FILE CONTROL BLOCK STRING POINTER (FILE BEING MOVED)
11924  0F54 00       PUSEM   RMB     1         CURRENT SECTOR BEING MOVED <UNIT><SECTOR>
11925  
11926  0F55 0A       MPERM   FCB     10," PERMANENT"
11927  0F60 08       MDEL    FCB     8, " DELETED"
11928  0F69 0C       MPACKNG FCB     12,"PACKING DISK"
