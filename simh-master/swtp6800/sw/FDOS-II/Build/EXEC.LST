11930                                          ********************************************
11931                                          * FDOS command: DELET[:unit],fname[,fname2...]
11932                                          ********************************************
11933                                          * if no filename is give, just pack the disk
11934  
11935  0F76 B6 016E  C.DELET LDAA    DRVNUM    Get current unit (set by GETFNAME when called during command line parsing)
11936  0F79 B7 0F4E          STAA    DUNIT     Save it (the unit begin used on DELETE)
11937  0F7C BD 03BE  L0F7C   JSR     GETFNAM   Get next param (file to delete) in command line into FNAME/DRVNUM variables
11938  0F7F B6 0169          LDAA    FNAME     get the param (filename to delete)
11939  0F82 81 20            CMPA    #$20      is blank ?
11940  0F84 26 03            BNE     L0F89     jump if param is filled
11941  0F86 7E 102A          JMP     PACK      param not filled -> command terminated -> proceed to pack the disk
11942   
11943  0F89 B6 0F4E  L0F89   LDAA    DUNIT     Get the unit used on DELETE
11944  0F8C B7 016E          STAA    DRVNUM    Use it
11945  0F8F BD 05B7          JSR     OPENR     Open file for reading
11946  0F92 4D               TSTA    
11947  0F93 26 E7            BNE     L0F7C     if A<>0 -> open file fail -> file does not exists -> proceed with next param (next file to delete)
11948  0F95 BD 11C8          JSR     CHKPERM   check permanent attribute in Dir Entry (attrib=$01 -> permanent file)
11949  0F98 01               NOP     
11950  0F99 26 16            BNE     L0FB1     jump if regular file 
11951  0F9B CE 0169          LDX     #FNAME
11952  0F9E C6 05            LDAB    #5        Print the Filename 
11953  0FA0 BD 0414          JSR     PRTSTR    Print String
11954  0FA3 CE 0F56          LDX     #MPERM+1  String " PERMANENT"
11955  0FA6 F6 0F55          LDAB    MPERM
11956  0FA9 BD 0414          JSR     PRTSTR    Print String
11957  0FAC BD 041E          JSR     PRTLN     Print <CR><LF> to start a new line
11958  0FAF 20 CB            BRA     L0F7C     proceed with next param (next file to delete)
11959   
11960  0FB1 86 80    L0FB1   LDAA    #$80      Set attribute as file deleted
11961  0FB3 A7 05            STAA    $0005,X   store it in dir entry
11962  0FB5 B6 01F9          LDAA    DRVSEC    get current dir entry unit (in bits 7-6) and sector (bits 5-0)                  
11963  0FB8 5F               CLRB              B=track=0 -> dir is in track 0
11964  0FB9 CE 0179          LDX     #SECBUF   Disk Sector buffer 
11965  0FBC BD 04EE          JSR     WRSECT    write back dir entry to disk, with attribute set to $80
11966  0FBF 4D               TSTA    
11967  0FC0 27 03            BEQ     L0FC5     jump if write succeed
11968  0FC2 7E 049A          JMP     EDSKERR   Print error "MEDIA ERROR" and return to command prompt
11969   
11970  0FC5 CE 0169  L0FC5   LDX     #FNAME
11971  0FC8 C6 05            LDAB    #$05      Print the Filename 
11972  0FCA BD 0414          JSR     PRTSTR    Print String
11973  0FCD CE 0F61          LDX     #MDEL+1   String " DELETED"
11974  0FD0 F6 0F60          LDAB    MDEL
11975  0FD3 BD 0414          JSR     PRTSTR    Print String
11976  0FD6 BD 041E          JSR     PRTLN     Print <CR><LF> to start a new line
11977  0FD9 20 A1            BRA     L0F7C     proceed with next param (next file to delete)
