10200  
10201                                          Print "!" prompt, read command line (with editing) from console until user hits <CR>
10202                                          on exit: CMDLIN  stores the typed command line, including <CR> at the end
10203                                                   CMDINI  stores the addr of 1st char in command line buffer to be processed
10204                                                   CMDLEND stores the addr of last char in command line buffer (the addr of final <CR> + 1)
10205  
10206  0381 BD 041E  RDCMD   JSR     PRTLN     Print <CR><LF> to start a new line
10207  0384 86 21            LDAA    #$21      '!'
10208  0386 BD 0112  L0386   JSR     CONOUT    Print command prompt
10209  0389 CE 0115          LDX     #CMDLIN   Command Line buffer address
10210  038C FF 0165          STX     CMDINI    stores the addr of 1st char in command line buffer to be processed
10211                                          main loop:
10212  038F BD 0422  L038F   JSR     GETKEY    Read char from console (blocking)
10213  0392 81 08            CMPA    #$08      = BackSpace?
10214  0394 27 1B            BEQ     L03B1
10215  0396 81 18            CMPA    #$18      = Ctrl-X ?
10216  0398 27 21            BEQ     L03BB     if so, return to executive to ask for a new command line
10217  039A 81 8A            CMPA    #$8A      RSV: Maybe replace by ESC
10218  039C 27 1D            BEQ     L03BB     if so, return to executive to ask for a new command line
10219  039E A7 00            STAA    $0000,X   Save key in Command Line Buffer
10220  03A0 08               INX               incr pointer into buffer
10221  03A1 8C 0165          CPX     #CMDLIN+$50
10222  03A4 26 03            BNE     L03A9     jump if buffer not full
10223  03A6 7E 0228          JMP     ERFMT     Print "FORMAT ERROR", return to command prompt
10224  03A9 81 0D    L03A9   CMPA    #$0D      = <CR>?
10225  03AB 26 E2            BNE     L038F     if key presed by used is not <CR> then return to main loop to read next key from console
10226  03AD FF 0167          STX     CMDLEND   stores the addr of last char in command line buffer (the addr of final <CR> + 1)
10227  03B0 39               RTS 
10228                                          handle the BackSpace key:    
10229  03B1 8C 0115  L03B1   CPX     #CMDLIN   Command Line buffer address
10230  03B4 27 CB            BEQ     RDCMD     if command line is empty, jump to print again command prompt in a new line
10231  03B6 09               DEX               decrement buffer pointer
10232  03B7 A6 00            LDAA    $0000,X   A=last key pressed
10233  03B9 20 D4            BRA     L038F
10234  03BB 7E 0214  L03BB   JMP     EXEC      jump to Executive warm start 
10235   
10236                                          get filename from command line
10237                                          can be ":n" -> drive specifier -> sets drvNum
10238                                          can be "fname" -> sets fname
10239                                          can be "fname:n" -> sets fname and drvNum
10240                                          read chars from cmdline until CR or ',' 
10241                                          on exit: FNAME   filename param (read from command line)
10242                                                           if not specified, fname="     " (5 spaces)
10243                                                   DRVNUM  drive specified (=0 if none specified)
10244                                                           if not specified, drvnum=0
10245   
10246  03BE CE 0169  GETFNAM LDX     #FNAME    fill fname with spaces
10247  03C1 86 20            LDAA    #$20      
10248  03C3 C6 05            LDAB    #$05      fname length
10249  03C5 A7 00    L03C5   STAA    $0000,X
10250  03C7 08               INX     
10251  03C8 5A               DECB    
10252  03C9 26 FA            BNE     L03C5
10253  03CB 7F 016E          CLR     DRVNUM    set DrvNum=0 -> defaults to unit 0
10254  
10255  03CE CE 0169          LDX     #FNAME
10256  03D1 BD 03F7  L03D1   JSR     CHKPARM   check param available, return 1st char
10257  03D4 81 3A            CMPA    #$3A      is ":" ?
10258  03D6 26 15            BNE     L03ED     if not -> jump to handle file name
10259                                          handle unit number 
10260  03D8 BD 03F7          JSR     CHKPARM   check param available, get unit digit
10261  03DB 80 30            SUBA    #$30      convert ascii '0' to binary 0
10262  03DD 16               TAB               save unit in B
10263  03DE 84 FC            ANDA    #$FC      check if units in 0..3 range
10264  03E0 26 08            BNE     L03EA     if not on 0..3 rangel -> jump to print error message
10265  03E2 F7 016E          STAB    DRVNUM    save unit 
10266  03E5 BD 03F7  L03E5   JSR     CHKPARM   ignore any remaining char and return
10267  03E8 20 FB            BRA     L03E5
10268  
10269  03EA 7E 0228  L03EA   JMP     ERFMT     Print "FORMAT ERROR", return to command prompt
10270                                          handle fine name:
10271  03ED 8C 016E  L03ED   CPX     #FNAME+5  fname var full?
10272  03F0 27 DF            BEQ     L03D1     if so -> jump to process next char from param 
10273  03F2 A7 00            STAA    $0000,X   store param char in fname
10274  03F4 08               INX     
10275  03F5 20 DA            BRA     L03D1     jump to process next char from param 
10276   
10277                                          check there is a param at current cmd line pointer char
10278                                          if char is <CR> or ',' -> not a param -> make caller returns
10279                                          else -> preserves X value, A=1st char of param
10280   
10281  03F7 FF 0412  CHKPARM STX     L0412     save X 
10282  03FA FE 0165          LDX     CMDINI    get the addr of 1st char in command line buffer to be processed
10283  03FD A6 00            LDAA    $0000,X   get 1st char of param
10284  03FF 81 0D            CMPA    #$0D      is <CR> ? 
10285  0401 27 0C            BEQ     L040F     if so, command line ended, there is no param to read -> make caller returns
10286  0403 08               INX     
10287  0404 FF 0165          STX     CMDINI    stores the addr of 1st char in command line buffer to be processed
10288  0407 81 2C            CMPA    #$2C      is ',' ?
10289  0409 27 04            BEQ     L040F     if so, param ended -> make caller returns
10290  040B FE 0412          LDX     L0412     restore X
10291  040E 39               RTS     
10292  040F 31       L040F   INS               make caller returns
10293  0410 31               INS     
10294  0411 39               RTS     
10295  0412 00       L0412   RMB     2         local save area for X
10296  
10297  
10298  0414 A6 00    PRTSTR  LDAA    $0000,X   Print String at addr in reg X, length reg B
10299  0416 BD 0112          JSR     CONOUT
10300  0419 08               INX     
10301  041A 5A               DECB    
10302  041B 26 F7            BNE     PRTSTR    
10303  041D 39               RTS     
10304  
10305  041E 86 0D    PRTLN   LDAA    #$0D      Print #13#10 <CR><LF> in console to start a new line
10306  0420 20 09            BRA     L042B
10307   
10308                                          read a key from console (blocking) with echo
10309                                          print #10#13 if RETURN is pressed
10310                                          On exit: pressed key in A
10311   
10312  0422 BD 010F  GETKEY  JSR     CONIN     Read char from console (bloking)
10313  0425 84 7F            ANDA    #$7F      make it 7-bit ascii
10314  0427 81 7F            CMPA    #$7F      is <DEL> pressed?
10315  0429 27 10            BEQ     L043B     if so, return 
10316  042B 36       L042B   PSHA              save read char in A
10317  042C BD 0112          JSR     CONOUT    echo typed char in console
10318  042F 32               PULA              restore read char in A
10319  0430 81 0D            CMPA    #$0D      is <CR> pressed?
10320  0432 26 07            BNE     L043B     if not, return char in A
10321  0434 36               PSHA              if char typed by user is <CR>, then
10322  0435 86 0A            LDAA    #$0A         after echoing it
10323  0437 BD 0112          JSR     CONOUT       print a <LF>
10324  043A 32               PULA              restore read char in A
10325  043B 39       L043B   RTS     
10326  
10327  043C 36       LPTHH   PSHA              Send A as HH hex string to line printer
10328  043D 8D 15            BSR     CVTH2X    Convert Hi nibble of A to A='0'..'F' 
10329  043F BD 010C          JSR     LPTOUT
10330  0442 32               PULA    
10331  0443 8D 13            BSR     CVTL2X    Convert Lo nibble of A to A='0'..'F' 
10332  0445 7E 010C          JMP     LPTOUT
10333   ;
10334  0448 36       PRTHH   PSHA              Print A as HH hex string on console
10335  0449 8D 09            BSR     CVTH2X    Convert Hi nibble of A to A='0'..'F' 
10336  044B BD 0112          JSR     CONOUT
10337  044E 32               PULA    
10338  044F 8D 07            BSR     CVTL2X    Convert Lo nibble of A to A='0'..'F' 
10339  0451 7E 0112          JMP     CONOUT
10340   ;
10341  0454 44       CVTH2X  LSRA              Convert Hi nibble of A to A='0'..'F' 
10342  0455 44               LSRA    
10343  0456 44               LSRA    
10344  0457 44               LSRA    
10345  0458 84 0F    CVTL2X  ANDA    #$0F      Convert Lo nibble of A to A='0'..'F' 
10346  045A 81 0A            CMPA    #$0A 
10347  045C 2B 02            BMI     L0460
10348  045E 8B 07            ADDA    #$07
10349  0460 8B 30    L0460   ADDA    #$30
10350  0462 39               RTS     
10351  
10352                                          Read a disk sector 
10353                                          on entry: A=unit (bits 7-6) | sector (1st sector is 1)
10354                                                    B=track (1st track is 0)
10355                                                    X=addr of buffer where to store data read from disk
10356                                          on exit:  A=0 -> Ok, A<>0 -> error
10357  
10358  0463 FF 0173  RDSECT  STX     TMPH      save sector buffer addr
10359  0466 37               PSHB    
10360  0467 BD F22C          JSR     XUS       PROM Call: select unit/sector
10361  046A BD 04D9          JSR     DSKRDY    Check if disk is ready (print error and return to command prompt if not)
10362  046D 32               PULA    
10363  046E BD F250          JSR     SEEK      PROM Call: Seek track in A
10364  0471 86 05            LDAA    #$05
10365  0473 B7 01FE          STAA    L01FE     set retry count
10366  0476 86 02    L0476   LDAA    #$02      Read command
10367  0478 BD F268          JSR     LOOP      PROM Call: Issue command in reg A and loop on busy 
10368  047B BD F1FF          JSR     SAVE      PROM Call: Save X in SAVXR and LDX DIO 
10369  047E A6 00            LDAA    $0000,X   DKDID READ THE DISK STATUS
10370  0480 DE 19            LDX     SAVXR     PROM Var - get disk status DKDID 
10371  0482 84 80            ANDA    #$80      IF DELETED DATA (DD), REPORT IT
10372  0484 26 1D            BNE     L04A3
10373  0486 BD F1FF          JSR     SAVE      PROM Call: Save X in SAVXR and LDX DIO 
10374  0489 A6 00            LDAA    $0000,X   DKDID READ THE DISK STATUS
10375  048B DE 19            LDX     SAVXR     PROM Var
10376  048D 84 08            ANDA    #$08      if CRC error
10377  048F 4D               TSTA    
10378  0490 27 17            BEQ     L04A9
10379  0492 BD F25F          JSR     RFLAG     PROM Call: reset disk error flag
10380  0495 7A 01FE          DEC     L01FE
10381  0498 26 DC            BNE     L0476
10382  049A F6 034F  EDSKERR LDAB    MDSKERR   String "MEDIA ERROR"
10383  049D CE 0350          LDX     #MDSKERR+1
10384  04A0 7E 022E          JMP     PRTERR    Print error msg and return to command line
10385  04A3 BD F25F  L04A3   JSR     RFLAG     PROM Call: reset disk error flag
10386  04A6 86 80            LDAA    #$80
10387  04A8 39               RTS     
10388  04A9 FE 0173  L04A9   LDX     TMPH      get sector buffer addr
10389  04AC 86 80            LDAA    #$80
10390  04AE B7 01FE          STAA    L01FE
10391  04B1 86 3C    L04B1   LDAA    #$3C      DEFINE DISK COMMAND MODE
