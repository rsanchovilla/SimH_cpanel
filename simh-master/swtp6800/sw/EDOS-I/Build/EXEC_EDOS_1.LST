10080                 
10081 0100 01         EXEC    NOP               EXEC Cold Start     
10082 0101 BD FC06            JSR     INTIO     PROM: INITIALIZE I/O
10083 0104 8E 0058            LDS     #EXSTK    EXEC STACK (STARTS AT $0058 DOWNWARDS)
10084 0107 BD 018A            JSR     CRLF      ESTABLISH NEW LINE ON CONSOLE 
10085 010A 86 21              LDAA    #'!       PRINT AN ASCII "!" 
10086 010C BD 08AF            JSR     CO        console char out
10087 010F BD 01A2            JSR     ECHOC     GET A CONSOLE INPUT CHARACTER WITH ECHO
10088 0112 80 41              SUBA    #'A
10089 0114 2B EA              BMI     EXEC      IF INPUT CHAR < 'A' RETURN TO EXEC PROMPT    
10090 0116 81 18              CMPA    #$18
10091 0118 2A 1E              BPL     ERRM      ERROR -> PRINT '?' AND RETURN TO EXEC PROMPT
10092 011A 97 5D              STAA    CH        Multiply CH x 3
10093 011C 9B 5D              ADDA    CH        to use the jump table
10094 011E 9B 5D              ADDA    CH
10095 0120 5F                 CLRB              (B,A) = typed ascii char * 3
10096 0121 CE 0142            LDX     #CMDST    COMMAND SERVICE ADDRESS TABLE
10097 0124 DF 59              STX     L0059     COMPUTE THE COMMAND ADDR
10098 0126 9B 5A              ADDA    L005A
10099 0128 D9 59              ADCB    L0059
10100 012A D7 59              STAB    L0059
10101 012C 97 5A              STAA    L005A
10102 012E DE 59              LDX     L0059
10103 0130 7F 0064            CLR     NPARAM    NUMBER OF PARAMS TO BE READ FROM COMMAND LINE
10104 0133 7C 0064            INC     NPARAM    SET AN INITIAL VALUE OF 1
10105 0136 6E 00              JMP     0,X       CALL THIS COMMAND SERVICE
10106  ;
10107 0138 BD 018A    ERRM    JSR     CRLF      ERROR -> PRINT '?' AND RETURN TO EXEC PROMPT
10108 013B 86 3F              LDAA    #'?
10109 013D BD 08AF            JSR     CO        console char out
10110 0140 20 BE              BRA     EXEC      Return to EXEC prompt
