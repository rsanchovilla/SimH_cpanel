10387 0337 7E 0100            JMP     EXEC      Return to EXEC prompt

10389 033A CE 1000    DCRDLIN LDX     #$1000    READ A LINE FROM DISK
10390 033D DF 59              STX     L0059
10391 033F BD FC09    DCRDLI2 JSR     XRI       PROM: DISK READ a byte in reg A, if EOF carry is set
10392 0342 25 0C              BCS     DCRDLI3   JUMP IF EOF
10393 0344 DE 59              LDX     L0059
10394 0346 A7 00              STAA    0,X       STORE BYTE READ FROM DISK
10395 0348 08                 INX     
10396 0349 DF 59              STX     L0059
10397 034B 81 0D              CMPA    #$0D      IS <CR>?
10398 034D 26 F0              BNE     DCRDLI2   JUMP TO READ NEXT CHAR IF NOT
10399 034F 39                 RTS               RETURN. LINE IS READ
10401 0350 86 1A      DCRDLI3 LDAA    #$1A      STORE EOF
10402 0352 DE 59              LDX     L0059     AS LAST CHAR IN LINE BUFFER
10403 0354 A7 00              STAA    0,X
10404 0356 08                 INX     
10405 0357 86 0D              LDAA    #$0D      AND ADD A <CR> AS TERMINATOR
10406 0359 A7 00              STAA    0,X
10407 035B 7C 0067            INC     DEVCH     SET EOF FLAG
10408 035E 39                 RTS     

