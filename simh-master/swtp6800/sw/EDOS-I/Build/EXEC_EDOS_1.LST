10112                                           *THE COMMAND SERVICE ADDRESS FOR EACH COMMAND
10113                                           *
10114 0142 7E 06B0    CMDST   JMP     ASMB      'A ASSEMBLE 
10115 0145 7E 0138            JMP     ERRM      'B' ERROR -> PRINT '?' AND RETURN TO EXEC PROMPT
10116 0148 7E 079A            JMP     L079A     'C'
10117 014B 7E 02D5            JMP     DUMP      'D DUMP
10118 014E 7E 03B9            JMP     L03B9     'E
10119 0151 7E 0138            JMP     ERRM      'F' ERROR -> PRINT '?' AND RETURN TO EXEC PROMPT
10120 0154 7E 0138            JMP     ERRM      'G' ERROR -> PRINT '?' AND RETURN TO EXEC PROMPT
10121 0157 7E 0695            JMP     L0695     'H
10122 015A 7E 047A            JMP     INIT      'I INIT DISK
10123 015D 7E 0138            JMP     ERRM      'J' ERROR -> PRINT '?' AND RETURN TO EXEC PROMPT
10124 0160 7E 0138            JMP     ERRM      'K' ERROR -> PRINT '?' AND RETURN TO EXEC PROMPT
10125 0163 7E 04B7            JMP     L04B7     'L
10126 0166 7E FEFC            JMP     EXBUG     'M' MON -> Monitor warm entry point
10127 0169 7E 0439            JMP     L0439     'N
10128 016C 7E 0138            JMP     ERRM      'O' ERROR -> PRINT '?' AND RETURN TO EXEC PROMPT
10129 016F 7E 039F            JMP     L039F     'P
10130 0172 7E 0138            JMP     ERRM      'Q' ERROR -> PRINT '?' AND RETURN TO EXEC PROMPT
10131 0175 7E 02C6            JMP     L02C6     'R
10132 0178 7E 055B            JMP     STORE     'S
10133 017B 7E 0746            JMP     L0746     'T
10134 017E 7E 0138            JMP     ERRM      'U' ERROR -> PRINT '?' AND RETURN TO EXEC PROMPT
10135 0181 7E 0138            JMP     ERRM      'V' ERROR -> PRINT '?' AND RETURN TO EXEC PROMPT
10136 0184 7E 0138            JMP     ERRM      'W' ERROR -> PRINT '?' AND RETURN TO EXEC PROMPT
10137 0187 7E 059B            JMP     XGEN      'X  Update FDOS system area
