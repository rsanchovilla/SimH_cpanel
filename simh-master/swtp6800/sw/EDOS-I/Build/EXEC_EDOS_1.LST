10139                                           *
10140                                           *THIS ROUTINE PRODUCES <CR> <LF> ON THE CONSOLE
10141                                           *(ESTABLISH A NEW LINE FOR THE NEXT FUNCTION)
10142                                           *
10143 018A 86 0D      CRLF    LDAA    #$0D      <CR>
10144 018C BD 08AF            JSR     CO        console char out
10145 018F 86 0A              LDAA    #$0A      <LF>
10146 0191 7E 08AF            JMP     CO        console char out
10147                                           *
10148                                           *THIS ROUTINE OUTPUTS 100 DECIMAL NULLS 
10149                                           *
10150 0194 C6 64      NULOC   LDAB    #100      COUNT OF NULLS TO OUTPUT
10151 0196 D7 5D              STAB    CH
10152 0198 4F         NULO1   CLRA    
10153 0199 BD 08B5            JSR     OCHR      paper tape char out, no nulls
10154 019C 7A 005D            DEC     CH
10155 019F 26 F7              BNE     NULO1  
10156 01A1 39                 RTS     
