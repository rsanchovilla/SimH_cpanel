10224 020C 27 0A              BEQ     FILSE2    JUMP IF SO -> VALID SEPARATOR
10225 020E 81 2C              CMPA    #',       IS ","
10226 0210 27 06              BEQ     L0218     JUMP IF SO -> VALID SEPARATOR
10227 0212 81 0D              CMPA    #$0D      IS <CR> ?
