 
10009                 DKDID   EQU     $EC00     iCOM floppy disk controller PIA ports
10010                 DKDIC   EQU     $EC01 
10011                 DKCOD   EQU     $EC02 
10012                 DKCOC   EQU     $EC03 
10013                 DKDOD   EQU     $EC06 
10014                 DKDOC   EQU     $EC07 
10015                 
10016                                           EDOS PROM ROUTINES
10017 
10018                 INIIO   EQU     $E806     INITIALIZE I/O
10019                 XRI     EQU     $E809     DISK READ VECTOR read a byte from disk in reg A, if EOF carry is set
10020                 XWRT    EQU     $E80C     DISK WRITE VECTOR write a byte to disk from reg A
10021                 PROG    EQU     $E815     LOAD PROGRAM
10022                 ASSEM   EQU     $E81B     LOAD ASSEMBLER
10023                 EDITOR  EQU     $E824     LOAD EDITOR
10024                 INCDA   EQU     $E9EF     SUBROUTINE TO INCR DA TRACK & SECTOR
10025                 XUS     EQU     $EA03     SUBROUTINE TO XMIT UNIT/SECTOR (LOGICAL) BYTE
10026                 SEEK    EQU     $EA2B     SUBROUTINE TO SEEK TRACK IN A
10027                 RFLAG   EQU     $EA38     SUBROUTINE TO RESET ERROR FLAG
10028                 CHK     EQU     $EA4D     SUBROUTINE TO CHECK IF A DISK, ELSE ERROR 3
10029                 CHK1    EQU     $EA57     ROUTINE TO PUT ERROR (A)

10016                                           EXBUG ROUTINES
10033 
10034                 EXBUG   EQU     $F564     Monitor warm entry point
                      CONIN   EQU     $F015     CONSOLE INPUT WITH ECHO
                      CONOUT  EQU     $F018     CONSOLE OUTPUT WITH NULLS LOGIC
                      OCHAR   EQU     $F9CF     CONSOLE OUTPUT WITHOUT NULLS
                      LSTOUT  EQU     $EAB0     OUTPUT BYTE TO LIST DEVICE
                      RDRIN   EQU     $EB02     PAPER TAPE READER IN 

                      SPEED   EQU     $FF02    EXBUG SPEED FLAG 
                      EXPUN   EQU     $FF62    EXBUG PUNCH FLAG

10035 
10036                                           VARIABLES IN ZERO PAGE USED BY ICOM FD360 PROM ENTRY POINTS
10037 
10038                 PASS    EQU     $00       ASSEMBLY PASS INFO
10039                 OFILE   EQU     $01       OUTPUT FILE NUMBER
10040                 OUNIT   EQU     $02       OUTPUT UNIT
10041                 IUNIT   EQU     $03       INPUT UNIT
10042                 ISIZE   EQU     $04       INPUT FILE SIZE
10043                 ITRK    EQU     $06       INPUT FILE TRACK
10044                 ISCTR   EQU     $07       INPUT FILE SECTOR
10045                 ICNTR   EQU     $08       INPUT FILE BUFFER COUNTER
10046                 OSIZE   EQU     $09       OUTPUT FILE SIZE
10047                 OTRK    EQU     $0B       OUTPUT FILE TRACK
10048                 OSCTR   EQU     $0C       OUTPUT FILE SECTOR
10049                 OCNTR   EQU     $0D       OUTPUT FILE BUFFER COUNTER
10050                 TITRK   EQU     $0E       TEMP LOC 1
10051                 TISZE   EQU     $0F       TEMP LOC 2
10052                 
10053                 L0010
10054 
10055                         ORG     $0020
10056 
10057 0020 7E 0100            JMP     EXEC      EXEC Cold Start     
10058 0023 7E 0284    L0023   JMP     L0284
10059                 
10060                 L0059   
10061                 L005A
10062                 L005B   
10063                
10064                 CH      EQU     $5D       CHAR TEMP VAR
10065                 FNOTBL  EQU     $5E
10066                 FNO1    EQU     $5F       1ST CMD PARAM FILE NO 
10067                 FNO2H   EQU     $60
10068                 FNO2    EQU     $61       2ND CMD PARAM FILE NO 
10069                 FNO3H   EQU     $62
10070                 FNO3    EQU     $63       3RD CMD PARAM FILE NO 
10071                 NPARAM  EQU     $64       NUMBER OF PARAMS TO BE READ FROM COMMAND LINE
10072 
10073                 USECT   EQU     $65       = <UNIT 0..3 in bits 7-6><SECTOR 1..26 in bits 5-0>
10074                 L0066
10075                 DEVCH   EQU     $67       DEVICE TO USE: T, C, P / EOF FLAG
10076 
10077                 EXSTK   EQU     $6B       EXECUTIVE STACK BEGINS HERE
10078 
