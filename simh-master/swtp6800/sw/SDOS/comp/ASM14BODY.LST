1BFE 1D37         5:          FDB      XMOD
  0001            6:          DO       CONDASM=1
1C00 36           7:          FCB      +OP:NE            A#B 
1C01 1C8A         8:          FDB      XNE
1C03 35           9:          FCB      +OP:EQ            A=B
1C04 1C91        10:          FDB      XEQ
1C06 32          11:          FCB      +OP:LT            A<B
1C07 1C9D        12:          FDB      XLT
1C09 33          13:          FCB      +OP:GE            A>=B  A=>B
1C0A 1CA3        14:          FDB      XGE
1C0C 31          15:          FCB      +OP:GT            A>B
1C0D 1C97        16:          FDB      XGT
1C0F 34          17:          FCB      +OP:LE            A<=B  A=<B
1C10 1CA9        18:          FDB      XLE
                 19:          FIN
1C12 71          20:          FCB      +OP:PLS           +A
1C13 1CF0        21:          FDB      XPOS
1C15 72          22:          FCB      +OP:MNS           -A
1C16 1CE2        23:          FDB      XNEG
1C18 73          24:          FCB      +OP:COM           \A
1C19 1CF7        25:          FDB      XCOM
1C1B 74          26:          FCB      +OP:NOT           &A
1C1C 1CFC        27:          FDB      XNOT
  0001           28:          DO       CONDASM=1
1C1E 37          29:          FCB      +OP:HI            A>>B
1C1F 1CB5        30:          FDB      XHI
1C21 38          31:          FCB      +OP:LO            A<<B
1C22 1CAF        32:          FDB      XLO
1C24 3A          33:          FCB      +OP:LS            A\<B
1C25 1CBB        34:          FDB      XLS
1C27 39          35:          FCB      +OP:HS            A>/B
1C28 1CC1        36:          FDB      XHS
                 37:          FIN
1C2A 00          38:          FCB      0
