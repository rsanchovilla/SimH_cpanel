2B1F 8200       108:          SBCA     #0                     ....
2B21 B7307E     109:          STAA     NotSectorMask       this mask will extract the byte-within-...
2B24 F7307F     110:          STAB     NotSectorMask+1     ...-sector field from a file pointer.
2B27 43         111:          COMA                       Make mask to extract the sector-number
2B28 53         112:          COMB                         field from a file pointer;
2B29 B7307C     113:          STAA     SectorMask        Put it in appropriately named slot.
2B2C F7307D     114:          STAB     SectorMask+1           ....
                115: 
2B2F 8604       116:          LDAA     #OPT:BO
2B31 8D10       117:          BSR      OPTOR             PUT IN OPTION WORD
                118: 
                119: **** Done processing options; get out ****
  2B33          120: OPTEND   ;LDX     #CRAPOUT$         ERR RET IF I/O ERROR DURING ASM
2B33 CE0142     121:          LDX      #CRAPOUT$




