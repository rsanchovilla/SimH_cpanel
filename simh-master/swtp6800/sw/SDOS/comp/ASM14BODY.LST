ASM14A.IOFM.ASM
2D0B 08          42:          INX
                 43:          FIN
2D0D DF48        44:          STX      BUCKET
2D0F 8C318D      45:          CPX      #HSHEND
2D12 270E        46:          BEQ      SORT3             THIS IS BEST SYMBOL, ADD TO SORTCHAIN
                 47:          ;LDX     S:NEXT,X          COMPARE BUCKET HEAD WITH THIS SYMBOL
2D14 EE00        48:          LDX      S:NEXT,X
2D16 DF4E        49:          STX      NEW
                 50: *
                 51: * NEW - PTR TO SYM NOW BEING COMPARED WITH SYM POINTED
                 52: * TO BY THIS
                 53: *
  0001           54:          IF       DUMPV=1
                 55:          ;LDX     RTNPTR            USE THE SPECIFIED COMPARISON SUBROUTINE
2D18 DE44        56:          LDX      RTNPTR
                 57:          ;JSR     0,X               SORT BY NAME OR BY VALUE
2D1A AD00        58:          JSR      0,X
  0002           59:          ELSE
 *S*             60:          ;JSR     SORTNAME
 *S*             61:          JSR      SORTNAME
                 62:          FIN
2D1C 28EB        63:          BVC      SORT2             B/ THIS <= NEW
                 64:          ;LDX     BUCKET            ELSE NEW < THIS, USE NEW INSTEAD
2D1E DE48        65:          LDX      BUCKET
2D20 20E1        66:          BRA      SORT1             REMEMBER NEW AS BEST
                 67: *
                 68: * FOUND THE BEST SYMBOL - ADD TO CHAIN
                 69: *
  2D22           70: SORT3    EQU      *                 THIS --> NEXT TO CHAIN
                 71:          ;LDX     THIS              EXHAUST LISTS FINALLY ?
2D22 DE4C        72:          LDX      THIS
2D24 2601        73:          BNE      SORT4             NO
2D26 39          74:          RTS                        YES, GET OUT!
                 75: 
  2D27           76: SORT4    ;LDD     S:NEXT,X          FIND NEXT(THIS)
2D27 E601        77:          LDAB     (S:NEXT)+1,X
2D29 A600        78:          LDAA     S:NEXT,X
                 79:          ;CLR     0,X               MAKE IT END OF SORT CHAIN
2D2B 6F00        80:          CLR      0,X
                 81:          ;CLR     1,X




ASM/6800 1.3H4: 2D2D ASM/6800 1.4       - - - S Y M B O L    T A B L E    D U M P - - -
