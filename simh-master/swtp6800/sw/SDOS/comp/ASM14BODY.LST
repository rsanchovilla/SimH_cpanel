2AC3 BD15FE      59:          JSR      MAKEINCLB
2AC6 DFA7        60:          STX      .CURINCLB         SAVE POINTER,
                 61:          ;CLR     INCLVL              RESET INCLUDE LEVEL TO 0.
2AC8 7F009C      62:          CLR      INCLVL
                 63: 
                 64: **** Get the listing-file's name from the user ****
  2ACB           65: RLO      ;LDX     #RLO              ERR RET
2ACB CE2ACB      66:          LDX      #RLO
2ACE DFAA        67:          STX      IOERRLOC
                 68:          ;JSR     PUTT
2AD0 BD2A3F      69:          JSR      PUTT
2AD3 4C697374    70:          FCC      /Listing File=/
2AE0 00          71:          FCB      0
2AE1 8D56        72:          BSR      GETNAME           GET THE NAME
2AE3 2606        73:          BNE      WANTLO            GO HANDLE IN NAME NOT NULL
2AE5 86FD        74:          LDAA     #\OPT:LO
2AE7 8D5E        75:          BSR      OPTAND            INDICATE NO BO
2AE9 2009        76:          BRA      RBO
                 77: 
                 78: **** Open the listing file for the user (if possible) ****
2AEB C602        79: WANTLO   LDAB     #LO               CH #
                 80:          ;JSR     CREATE$           CREATE THE LO FILE
2AED BD010E      81:          JSR      CREATE$




