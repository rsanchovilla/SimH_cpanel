                495:          FIN
                496: *        NOW ADJUST BINARY PRODUCT TO MAKE INTO BASE 100
  12E5          497: CONVERTTOBASE100  EQU               *    (A,B)<=9999 GETS CONVERTED TO BASE 100
12E5 9701       498:          STAA     TEMPB             ASSERT: (A)<=INT(99*99/256)=38?
12E7 8612       499:          LDAA     #MULDIV100/256    COMPUTE APPROX PRODUCT DIVIDED BY 100
12E9 9700       500:          STAA     TEMPA
                501:          ;LDX     TEMPA
12EB DE00       502:          LDX      TEMPA
12ED A660       503:          LDAA     MULDIV100&$FF,X   = (PRODUCT MOD 256)/100
12EF EB88       504:          ADDB     (MULDIV100&$FF)+9999//256,X    = (PRODUCT MOD 256) MOD 100
12F1 2404       505:          BCC      *+6               B/ PRODUCT MOD 256 + (PRODUCT - (PRODUCT MOD 256)
12F3 8B02       506:          ADDA     #2                REMAINDER >= 256, ADJUST LEFT HAND DIGIT
12F5 C0C8       507:          SUBB     #200              ADJUST REMAINDER
