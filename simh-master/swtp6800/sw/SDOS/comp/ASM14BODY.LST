                  9:          ;JSR      P1INIT            DO SETUP FOR PASS 1,
072A BD1A57      10:          JSR      P1INIT
  072D           11: LOOP1    ;JSR      PINIT             DO SETUP FOR EVERY PASS,
072D BD1A27      12:          JSR      PINIT
                 13: *
0730 8D42        14: LOOP     BSR      READ              READ RECORD & DO PRE-SCAN
                 15:          ;JSR      DOIT              EXECUTE THE COMMAND
0732 BD08F6      16:          JSR      DOIT
0735 9695        17:          LDAA     EOFF              DID WE HIT AN END ?
0737 27F7        18:          BEQ      LOOP              B/ NO:  KEEP GOING
                 19: *
  0739           20: ENDIT    ;JSR      END:              WHEN WE HIT AN END OF FILE,
0739 BD1875      21:          JSR      END:
073C 20F2        22:          BRA      LOOP                Treat as END.  Only returns if end of
                 23: ;                                     INCLUDE file.
                 24: *
                 25: *        SIMPLE, ISN'T IT?
                 26: *




ASM/6800 1.3H4: 073C ASM/6800 1.4       - - -   M C S - 6 8 0 0   A S S E M B L E R   - - -
08/16/82 00:00:00; Page 33; Form 2      - - -  R E A D   I N P U T   L I N E  - - -
ASM14A.MAIN.ASM
                  2: *
                  3: *
                  4: *  R E A D
                  5: *
                  6: *        NO ARGUMENTS.
                  7: *        SETS @INBUF := NEXT NON-COMMENT INPUT LINE, TERMINATED
                  8: *          BY A NULL.  USES INPTR TO MAINTAIN POINTER INTO INBUF
                  9: *
                 10: *        THE FOLLOWING FUNCTIONS ARE HANDLED HERE (OR IN ROUTINES CALLED HERE):
                 11: *
                 12: *        (1)      RECOGNITION & ELIMINATION OF COMMENT LINES.
                 13: *        (2)      RECOGNITION OF COMMAND FIELD.  (CFPTR)
                 14: *        (3)      MACRO EXPANSION (ACTUAL TEXT SUBSTITUTION ONLY);
                 15: *                 CODE TO DO MACRO EXPANSION HERE IFF. MACRO = 1
                 16: *        (4)      ITERATIVE ASEMBLY (PACKING & UNPACKING FROM MEM)
                 17: *                 IFF. ITER = 1
                 18: *        (5)      NULLS ARE ELIMINATED (I.E. IGNORED)
                 19: *        (6)      ^L (FORM-FEED) CHARACTERS IN COLUMN 1 ARE
                 20: *                 REMOVED, AND A PAGE IS SIGNALED.
                 21: *        (7)      SOURCE LINE NUMBERS ARE ELIMINATED, AND THE LABEL
                 22: *                 FIELD IS FOUND (LFPTR).
                 23: *        (8)      IF END OF FILE WAS ENCOUNTERED READING THIS LINE, **EOF
                 24: *                 ENOUNTERED** IS REPORTED.
                 25: *




ASM/6800 1.3H4: 073C ASM/6800 1.4       - - -   M C S - 6 8 0 0   A S S E M B L E R   - - -
08/16/82 00:00:00; Page 34; Form 3      - - -  R E A D   I N P U T   L I N E  - - -
ASM14A.MAIN.ASM
                  2: 
                  3: **** Handle end of file -- dummy up an END ****
073E 969C         4: RENDIT   LDAA     INCLVL            ARE WE IN AN INCLUDE FILE?
0740 260F         5:          BNE      INCLEOF           B/YES
                  6:          ;JSR     ENDER             BITCH ABOUT MISSING END
0742 BD087F       7:          JSR      ENDER
                  8:          ;LDX     INBUF
0745 DEAE         9:          LDX      INBUF
0747 DF34        10:          STX      TPTR
                 11:          ;LDX     #RENDEND          Load address of an END image,
0749 CE07FA      12:          LDX      #RENDEND
                 13:          ;JSR     MOVEB1              move it to INBUF.
074C BD2C12      14:          JSR      MOVEB1
074F 202F        15:          BRA      READ1             Now, process line.
                 16: 
0751 32          17: INCLEOF  PULA                       PRUNE
0752 32          18:          PULA                        STACK
                 19:          ;JMP     ENDIT
0753 7E0739      20:          JMP      ENDIT
                 21: 
                 22: *
                 23: * LINE W/O CF:
0756 5D          24: READC1   TSTB                       ;LF SEEN?
0757 2709        25:          BEQ      READC             ;NO
  0759           26: READE    ;LDX     #FAKEEQU          WELL.. FAKE "LF EQU *"
0759 CE07B1      27:          LDX      #FAKEEQU
075C DF24        28:          STX      CFPTR
075E 08          29:          INX
075F DF28        30:          STX      EXPTR
0761 39          31:          RTS
                 32: *
0762 9695        33: READC    LDAA     EOFF              HIT END OF FILE?
0764 26D8        34:          BNE      RENDIT             B/ YES:  PERFORM AN "END"
                 35:          ;LDX     RPTF              ARE WE SKIPPING DUE TO RPT 0 ?
0766 DEA1        36:          LDX      RPTF
0768 2704        37:          BEQ      READC2            B/ YES ==> MARK AS SKIPPED.
076A 968E        38:          LDAA     SKPFLG            ARE WE SKIPPING DUE TO IF 0 ?
076C 2703        39:          BEQ      READC3              B/ NO; NORMAL LISTING.
  076E           40: READC2   ;JSR     MRKSKP            SKIPPING A COMMENT (?!)
076E BD2709      41:          JSR      MRKSKP




ASM/6800 1.3H4: 076E ASM/6800 1.4       - - -   M C S - 6 8 0 0   A S S E M B L E R   - - -
08/16/82 00:00:00; Page 35; Form 3      - - -  R E A D   I N P U T   L I N E  - - -
ASM14A.MAIN.ASM
  0771           42: READC3   EQU      *
                 43:          ;JSR      LIST              LIST A COMMENT LINE...
0771 BD220D      44:          JSR      LIST
  0774           45: READ     EQU      *                 ENTRY POINT FOR READ
                 46:          ;JSR      CLRLST            CLEAR LISTING FUNCTIONS,
0774 BD26D9      47:          JSR      CLRLST
                 48:          ;LDX      #LINEN            BUMP LINE #
0777 CE0091      49:          LDX      #LINEN
                 50:          ;JSR      INCBCD            IN BCD.
077A BD0823      51:          JSR      INCBCD
                 52:          ;JSR     INLINE            GO GET A LINE FROM WHOMEVER IS GIVING THEM OUT
077D BD2B90      53:          JSR      INLINE
  0780           54: READ1    EQU      *                 CONTINUE WITH LINE PROCESSING.




ASM/6800 1.3H4: 077D ASM/6800 1.4       - - -   M C S - 6 8 0 0   A S S E M B L E R   - - -
08/16/82 00:00:00; Page 36; Form 4      - - -  R E A D   I N P U T   L I N E  - - -
ASM14A.MAIN.ASM
                  2: *
                  3: *   LINE HAS BEEN INPUT;  NOW FIND THE CF, FILTER OUT COMMENTS,
                  4: *   AND HANDLE CONTROL-L'S.
                  5: *
  0780            6: READ20   EQU      *
                  7:          ;LDX      INBUF             ;MOVE POINTER...
0780 DEAE         8:          LDX      INBUF
0782 DF28         9:          STX      EXPTR             ;TO START OF BUFFER
                 10: *
                 11: *START TO SCAN LINE
                 12: *
0784 8D31        13: READ2    BSR      RGNUM             READ LINE NUMBER (IF ANY)...SET UP LFPTR.
                 14:          ;JSR      GETXC             ;GET THE FIRST CHAR.(INC EXPTR)
0786 BD1F95      15:          JSR      GETXC
                 16:          ;JSR      WHICH             ;WHAT IS IT?
0789 BD0832      17:          JSR      WHICH
078C 20          18:          FCB      +BLANK
078D 07E0        19:          FDB      READ3             B/ BLANK:  END OF LABEL.(NO LABEL)
078F 09          20:          FCB      +TAB
0790 07E0        21:          FDB      READ3             B/ TAB:  END OF LABEL.(NO LABEL)
0792 2A          22:          FCB      +'*
0793 0762        23:          FDB      READC             B/ * ==> COMMENT
0795 3B          24:          FCB      +';
0796 0762        25:          FDB      READC             B/ ; ==> COMMENT
0798 0D          26:          FCB      +$D
0799 0762        27:          FDB      READC             B/ CR ==> COMMENT
                 28: *
  0000           29:          DO       STRINGS=1
 *S*             30:          FCB      +'"
 *S*             31:          FDB      READQS            B/ " ==> QUOTED STRING
                 32:          FIN
                 33: *
079B 00          34:          FCB      0
                 35: *
                 36: * NONE OF THE ABOVE:  EAT A LABEL FIELD.
  079C           37: READ2L   ;JSR      GETXC             ;GET A CHAR
079C BD1F95      38:          JSR      GETXC
                 39:          ;JSR      WHICH             ;WHAT IS IT.
079F BD0832      40:          JSR      WHICH
                 41:    




ASM/6800 1.3H4: 07A2 ASM/6800 1.4       - - -   M C S - 6 8 0 0   A S S E M B L E R   - - -
08/16/82 00:00:00; Page 37; Form 4      - - -  R E A D   I N P U T   L I N E  - - -
ASM14A.MAIN.ASM
07A2 20          42:          FCB      +BLANK            B/ BLANK:  END OF LABEL.
07A3 07DC        43:          FDB      READ3A
07A5 09          44:          FCB      +TAB
07A6 07DC        45:          FDB      READ3A            B/ TAB ==> END OF LABEL.
07A8 3B          46:          FCB      +';
07A9 0759        47:          FDB      READE             B/ '; ==> LF W/O CF ==> YECCH.
07AB 0D          48:          FCB      +$D
07AC 0759        49:          FDB      READE             B/  CR ==> LF W/O CF ==> YELL.
                 50: *
  0000           51:          DO       STRINGS=1
 *S*             52:          FCB      +'"               B/ DBL QUOTE ==> ANOTHER STRING
 *S*             53:          FDB      READQS
                 54:          FIN
                 55: *
07AE 00          56:          FCB      +0                END OF LIST
07AF 20EB        57:          BRA      READ2L
                 58: 
                 59: 
07B1 45515520    60: FAKEEQU  FCC      'EQU *'
07B6 0D          61:          FCB      $0D




ASM/6800 1.3H4: 07B6 ASM/6800 1.4       - - -   M C S - 6 8 0 0   A S S E M B L E R   - - -
08/16/82 00:00:00; Page 38; Form 4      - - -  R E A D   I N P U T   L I N E  - - -
ASM14A.MAIN.ASM
                 63: *
                 64: *  RGNUM --
                 65: *
                 66: *        SCANS AND DELETES LINE NUMBERS FROM BEGINNING OF LINE (IF LN-
                 67: * SCANNING WAS REQUESTED).
                 68: *
                 69: *        SETS LFPTR TO FIRST CH OF LABEL FIELD.
                 70: *
                 71: 
  07B7           72: RGNUM    EQU      *
07B7 96BA        73:          LDAA     OPTF              ARE LINE NUMBERS PRESENT TO BE DELETED?
07B9 8510        74:          BITA     #OPT:LN             FIND OUT BY CHECKING THE OPTION FLAGS...
07BB 271A        75:          BEQ      RGRTS               B/ NO...  JUST SET LFPTR AND RETURN.
                 76: 
  07BD           77: RGNUM1   EQU      *                 OTHERWISE GNAW AWAY AT UNSIGHTLY
                 78:          ;JSR     GETXC               LINE NUMBERS.   READ A CHARACTER,
07BD BD1F95      79:          JSR      GETXC
                 80:          ;JSR     CHRANGE             AND MAKE DECISION ACCORDING TO WHAT IT IS.
07C0 BD0848      81:          JSR      CHRANGE
07C3 303907BD    82:          +'0,'9,RGNUM1              DIGIT ==> EAT SOME MORE.
07C7 2E2E07BD    83:          +'.,'.,RGNUM1              DOT   ==> EAT SOME MORE.
07CB 202007D7    84:          +BLANK,BLANK,RGRTS         SPACE ==> END OF NUMBER, EAT IT TOO.
07CF 090907D7    85:          +TAB,TAB,RGRTS             TAB   ==> LIKE SPACE.
07D3 00          86:          0                          <END OF LIST>
                 87:  
                 88: *  ALL OTHER CHARACTERS COME HERE... AND MEAN 'IMMEDIATE END OF NUMBER, START
                 89: *  OF LABEL FIELD.
                 90: 
                 91:          ;JSR     REJXC             SO GIVE THE CHARACTER BACK TO THE LABEL FIELD.
07D4 BD1F9E      92:          JSR      REJXC
                 93: 
  07D7           94: RGRTS    EQU      *                 COME HERE TO SET LFPTR TO EXPTR AND SPLIT.
                 95:          ;LDX     EXPTR             WHAT DID I TELL YOU?
07D7 DE28        96:          LDX      EXPTR
07D9 DF22        97:          STX      LFPTR             (A BRIEF MUSICAL INTERLUDE)
07DB 39          98:          RTS                        LIKE THE MAN SAID....




ASM/6800 1.3H4: 07DB ASM/6800 1.4       - - -   M C S - 6 8 0 0   A S S E M B L E R   - - -
08/16/82 00:00:00; Page 39; Form 5      - - -  R E A D   I N P U T   L I N E  - - -
ASM14A.MAIN.ASM
                  1: *
                  2: * EAT A STRING:
                  3: *
  0000            4:          DO       STRINGS=1
 *S*              5: READQS   EQU      *
 *S*              6:          ;JSR      GETXC             ;GET A CHARACTER
 *S*              7:          JSR      GETXC
 *S*              8:          ;CMPA     #$D               ;END OF LINE?
 *S*              9:          CMPA     #$D
 *S*             10:          BEQ      READE             ;B/ YES ==> END OF THE LINE FOR THIS
 *S*             11:          ;CMPA     #'"               ;END OF STRING?
 *S*             12:          CMPA     #'"
 *S*             13:          BNE      READQS            ;B/ NO ==> GET ANOTHER CH.
 *S*             14:          BRA      READ2L            ;END ==> GO EAT REST OF LF.
                 15:          FIN
                 16: *
                 17: *  EAT BLANKS TO START OF CF
                 18: *
07DC C6FF        19: READ3A   LDAB     #$FF              ;REMEMBER THAT LF SEEN
07DE 2001        20:          BRA      READ3L            ;SKIP NEXT BYTE
07E0 5F          21: READ3    CLRB                       ;REMEMBER:  NO LF SEEN
  07E1           22: READ3L   ;JSR      GETXC             ;GET ANOTHER CHARACTER
07E1 BD1F95      23:          JSR      GETXC
                 24:          ;JSR      WHICH             ;WHAT IS IT.
07E4 BD0832      25:          JSR      WHICH
07E7 20          26:          FCB      +BLANK
07E8 07E1        27:          FDB      READ3L            BLANK ==> KEEP GETTING
07EA 09          28:          FCB      +TAB
07EB 07E1        29:          FDB      READ3L            TAB >> DITTO
07ED 3B          30:          FCB      +';
07EE 0756        31:          FDB      READC1            ; ==> NO CF
07F0 0D          32:          FCB      +$D
07F1 0756        33:          FDB      READC1            CR ==> NO CF
07F3 00          34:          FCB      +0                END.
                 35: *
                 36: * FOUND CF.
                 37:          ;LDX      EXPTR             GET POINTER TO CF
07F4 DE28        38:          LDX      EXPTR
07F6 09          39:          DEX                        ;POINT TO START,
07F7 DF24        40:          STX      CFPTR             ;AND SAVE IT.




ASM/6800 1.3H4: 07F9 ASM/6800 1.4       - - -   M C S - 6 8 0 0   A S S E M B L E R   - - -
