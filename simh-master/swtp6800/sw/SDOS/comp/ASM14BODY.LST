ASM/6800 1.3H4: 2208 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 263; Form 2     - - - L I S T - - -
ASM14A.IOFM.ASM
                  2: *
                  3: *
                  4: *  L I S T
                  5: *
                  6: *
220A 3A0900       7: LST:     FCB      ':,TAB,0
                  8: *
  220D            9: LIST     EQU      *
220D 9654        10:          LDAA     PASS              DO NOTHING, PASS 1
220F 2756        11:          BEQ      LISTR
2211 96C1        12:          LDAA     LIST:T
2213 D6A0        13:          LDAB     LIST:P
2215 8401        14:          ANDA     #LF:ERR           ERROR ON THIS LINE?
2217 9784        15:          STAA     DOCOPY            IF ERROR THEN COPY LO TO CONS
2219 2617        16:          BNE      LIST1             B/ YES: ALWAYS LIST.
                 17: * NO ERROR:
221B C501        18:          BITB     #LL:LIST          LISTING ON?
221D 2748        19:          BEQ      LISTR             B/ NO: RETURN.
                 20: * NO ERROR, LISTING ON:  CHECK FOR SUPPRESSION OF THIS TYPE
                 21: * OF LINE.
                 22: *
221F 96C1        23: LIST05   LDAA     LIST:T            RELOAD THE FLAGS
                 24:          ;LDX      #LSTSUP           GET @ OF LIST
2221 CE226D      25:          LDX      #LSTSUP
2224 A500        26: LIST10   BITA     0,X
2226 2704        27:          BEQ      LIST11            IF T-BIT IS ON...
2228 E501        28:          BITB     1,X               ...AND P-BIT IS OFF...
222A 273B        29:          BEQ      LISTR             ...THEN DONT LIST ME.
                 30: *
  222C           31: LIST11   ;LEAX    2,X
  0000           32:          IF       2<0
 *S*             33:          RPT      -2
 *S*             34:          DEX
                 35:          ELSE
  0002           36:          RPT      2
222C 08          37:          INX
                 38:          FIN
222E 6D00        39:          TST      0,X
2230 26F2        40:          BNE      LIST10            KEEP TRYING.
                 41: *




ASM/6800 1.3H4: 2230 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 264; Form 2     - - - L I S T - - -
ASM14A.IOFM.ASM
                 42: * MUST PRINT:
                 43: *     STILL, IF LF:PTD IS ON, DON'T LIST THE LINE.
                 44: * I.E. DON'T LIST THE SI LINE BUT LIST OTHER SH--
                 45: *
                 46: *
  2232           47: LIST1    ;LDX      LBBEG
2232 DEB6        48:          LDX      LBBEG
                 49:          ;JSR      PTTL             PUMP OUT # ON LEFT
2234 BD2650      50:          JSR      PTTL
                 51: *        JSR      PUTB3               AND RESET ALL THE CRAP ON THE LEFT.  MAINLY FOR
2237 96C1        52:          LDAA     LIST:T            CK/ FLAGS FOR SOURCE LINE:
2239 8502        53:          BITA     #LF:PTD             IS IT ALREADY PRINTED?
223B 2619        54:          BNE      LIST2               B/ YES:  DON'T PRINT LINE AGAIN.
                 55: 
                 56: 
                 57: **** PRINT TEXT OF LINE ****
                 58: 
223D 8609        59:          LDAA     #TAB              MOVE OVER TO THE <LINE#> FIELD.
                 60:          ;JSR     LSTC                (WHICH IS CONVENIENTLY PLACED AT THE FIRST TAB 
223F BD24AB      61:          JSR      LSTC
2242 D692        62:          LDAB     LINEN+1           PRINT LINE #
2244 9691        63:          LDAA     LINEN
                 64:          ;JSR      PTNLB             PRINT W/ LEADING BLANKS
2246 BD266D      65:          JSR      PTNLB
                 66:          ;LDX      #LST:
2249 CE220A      67:          LDX      #LST:
                 68:          ;JSR      PTTL              PRINT LINE, NEXT TAB STOP
224C BD2650      69:          JSR      PTTL
                 70:          ;LDX      INBUF
224F DEAE        71:          LDX      INBUF
                 72:          ;JSR      PTTL              PRINT INPUT LINE.
2251 BD2650      73:          JSR      PTTL
2254 2007        74:          BRA      LIST21
                 75: *
  2256           76: LIST2    EQU      *                 SI LINE ALREADY PRINTED
2256 96A9        77:          LDAA     COLNO
2258 2703        78:          BEQ      LIST21            OPTIMIZE CRLF.
                 79:          ;JSR      CRLF             NO XTRA CR/LF IF LINE IS NULL
225A BD24CA      80:          JSR      CRLF
                 81: *




ASM/6800 1.3H4: 225D ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 265; Form 2     - - - L I S T - - -
ASM14A.IOFM.ASM
225D 96C1        82: LIST21   LDAA     LIST:T
