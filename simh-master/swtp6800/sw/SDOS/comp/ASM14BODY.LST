ASM/6800 1.3H4: 0A9E ASM/6800 1.4       - - -   D E C O D E   L I N E   - - -
08/16/82 00:00:00; Page 65; Form 1      - - -  D O I T D R  - - -
ASM14A.DREX.ASM
                  2: *
                  3: *
                  4: *   D O I T D R
                  5: *
                  6: *        PROCESSES DIRECTIVES...
                  7: *        ASSUMES THAT SYM CONTAINS THE SYMBOL IN CF(1) AND
                  8: *        THAT CF(1) IS A SYMBOL ONLY.
                  9: *
  0AA0           10: DOITDR   EQU      *
                 11:          ;LDX      #D0               GET HEAD OF ASM-125 CHAIN
0AA0 CE0EAA      12:          LDX      #D0
                 13:          ;JSR      FSYM1             AND SEE IF ITS A SYSTEM DIRECTIVE
0AA3 BD20C9      14:          JSR      FSYM1
0AA6 2660        15:          BNE      DOITMM            B/ MUST BE A FUNNY DATA STMT OR MACRO
                 16: *
  0AA8           17: DIR1     ;LDX      SYMPT             GET POINTER TO DIRECTIVE'S BLOCK
0AA8 DE38        18:          LDX      SYMPT
0AAA DF3A        19:          STX      DIRPT             SAVE FOR LATER.
0AAC A604        20:          LDAA     S:TYPE,X          GET TYPE BITS,
0AAE 8504        21:          BITA     #D:LF             EQUATE LF TO PC?
0AB0 2705        22:          BEQ      DIR2              B/ NO...
0AB2 36          23:          PSHA                       SAVE TYPE,
                 24:          ;JSR      LFPC              LF=PC
0AB3 BD21DB      25:          JSR      LFPC
0AB6 32          26:          PULA                       RESTORE TYPE.
                 27: *
0AB7 8502        28: DIR2     BITA     #D:AF             FIND AF ?
0AB9 2705        29:          BEQ      DIR31             B/ NO...
0ABB 36          30:          PSHA                       SAVE TYPE,
                 31:          ;JSR      FINDAF            FIND ARG FIELD,
0ABC BD206C      32:          JSR      FINDAF
0ABF 32          33:          PULA                       RESTORE TYPE.
                 34: *
0AC0 8510        35: DIR31    BITA     #D:DO
0AC2 270D        36:          BEQ      DIR3              NOT A DOLVL INCREMENTER.
                 37:          ;INC      DOLVL
0AC4 7C009B      38:          INC      DOLVL
0AC7 2608        39:          BNE      DIR3
                 40:          ;DEC      DOLVL
0AC9 7A009B      41:          DEC      DOLVL




ASM/6800 1.3H4: 0ACC ASM/6800 1.4       - - -   D E C O D E   L I N E   - - -
08/16/82 00:00:00; Page 66; Form 1      - - -  D O I T D R  - - -
ASM14A.DREX.ASM
0ACC 36          42:          PSHA
                 43:          ;JSR      NSTER
0ACD BD087B      44:          JSR      NSTER
0AD0 32          45:          PULA
                 46: *
0AD1 8508        47: DIR3     BITA     #D:CC             IS THIS A CONTROL CARD?
0AD3 2706        48:          BEQ      DIR32             B/ NO...
0AD5 C604        49:          LDAB     #LF:CC            ELSE FLAG AS SUCH
0AD7 DAC1        50:          ORAB     LIST:T
0AD9 D7C1        51:          STAB     LIST:T
                 52: *
0ADB 8520        53: DIR32    BITA     #D:CA             IS THIS A CONDITIONAL ASSEMBLY LINE?
0ADD 2706        54:          BEQ      DIR33               B/ NO, GO ON.
0ADF C640        55:          LDAB     #LF:CA            ELSE MARK THIS LINE FOR LISTER
0AE1 DAC1        56:          ORAB     LIST:T              SO IT WILL CHECK WHETHER TO LIST IT.
0AE3 D7C1        57:          STAB     LIST:T
                 58: *
0AE5 8580        59: DIR33    BITA     #D:SI             Is this a directive we suppress during
0AE7 2709        60:          BEQ      DIR4                an include?
0AE9 D69C        61:          LDAB     INCLVL            Yup:  Are we doing an INCLUDE?
0AEB 2705        62:          BEQ      DIR4                B/ No:  do the directive.
                 63:          ;JSR     MRKSKP            Yes:  Mark as skipped;
0AED BD2709      64:          JSR      MRKSKP
0AF0 2013        65:          BRA      DIR5                and skip the processing.
                 66: *
  0AF2           67: DIR4     ;LDX      DIRPT             MAKE SURE WE HAVE PTR TO SYM,
0AF2 DE3A        68:          LDX      DIRPT
                 69:          ;LDX      S:VAL,X           GET ADDRESS OF ROUTINE,
0AF4 EE02        70:          LDX      S:VAL,X
0AF6 36          71:          PSHA                       SAVE A
                 72:          ;JSR      0,X               CALL IT.
0AF7 AD00        73:          JSR      0,X
0AF9 32          74:          PULA                       GET BACK FLAGS
0AFA 8502        75:          BITA     #D:AF             DID HE WANT AN AF?
0AFC 2707        76:          BEQ      DIR5              IF NOT, DON'T BOTHER
0AFE 8540        77:          BITA     #D:SS             DO WE CHECK SYNTAX?
0B00 2603        78:          BNE      DIR5              IF NOT, OK
                 79:          ;JSR     ECKEOF            CK FOR END OF FIELD
0B02 BD1E15      80:          JSR      ECKEOF
  0B05           81: DIR5     ;JMP     LIST




ASM/6800 1.3H4: 0B05 ASM/6800 1.4       - - -   D E C O D E   L I N E   - - -
