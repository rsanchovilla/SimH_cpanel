                 96: 
  0001           97:          IF       CONDASM!REPEAT
                 98: *
                 99: *  CDOSKP --
                100: *
                101: *        CHECKS CF OF CURRENT LINE.  IF CF(1) IS SYMBOL ONLY, AND IF
                102: *        SYMBOL SPECIFIES A C/A DIRECTIVE, THEN V IS CLEARED, AND
                103: *        X IS SET TO ADDRESS OF HANDLER.
                104: *
                105: *        OTHERWISE V IS SET, AND X IS DONT-CARE.
                106: *
                107: 
  0937          108: CDOSKP   ;JSR     CHCFSYM           CK/ IS CF(1) A SYMBOL ONLY?
0937 BD2057     109:          JSR      CHCFSYM
093A 262F       110:          BNE      DOSK1R              B/ NO.  NOT C/A DIRECTIVE.
                111:          ;JSR     CHSYMD            CK/ IS SYM A DIRECTIVE WE KNOW?
093C BD2066     112:          JSR      CHSYMD
093F 262A       113:          BNE      DOSK1R              B/ NO.  NOT C/A DIRECTIVE.
                114:          ;LDX      SYMPT             GET POINTER TO DIRECTIVE
0941 DE38       115:          LDX      SYMPT
0943 A602       116:          LDAA     S:VAL,X           ELSE GET GOOD STUFF
0945 E603       117:          LDAB     S:VAL+1,X         AND SCAN FOR THE DIRECTIVE WE LIKE.
                118:          ;LDX      #DOSKPT           GET @ OF TABLE,
0947 CE096D     119:          LDX      #DOSKPT
  094A          120: DOSKPL   ;CMPA     0,X               HIGH BYTE MATCH?
094A A100       121:          CMPA     0,X
094C 2613       122:          BNE      DOSKP1            B/ NO, TRY NEXT
                123:          ;CMPB     1,X               LOW BYTE MATCH?
094E E101       124:          CMPB     1,X
0950 260F       125:          BNE      DOSKP1            B/ NO, TRY NEXT
0952 8C098D     126:          CPX      #DOSKPT1          CK/ END DIRECTIVE GET US HERE?




