                  2: *
                  3: *
                  4: *  G E T O P T
                  5: *
                  6: *        GET THE SI,LO,AND BO ASSIGNMENTS FROM USER.
                  7: * OPEN THE APROPRIATE FILES AND START ASSEMBLY WITH
                  8: * INPUT FROM THE CONS DEVICE UNTIL AN EMPTY LINE IS GIVEN
                  9: *
                 10: *
  2A5F           11: GETOPT   EQU      *
                 12: 
                 13: **** Output a greeting (?) ****
                 14:          ;LDX     ASMPATCH          Setup assembly
2A5F FE258E      15:          LDX      ASMPATCH
2A62 FF2A91      16:          STX      ASMPAT             and patch
                 17:          ;JSR      PUTT
2A65 BD2A3F      18:          JSR      PUTT
2A68 0D          19:          FCB      $D
  0001           20:          IFUND    MC6809
2A69 536F6674    21:          FCC      'Software Dynamics ASM/6800, Version '
  0001           22:          ELSE
 *S*             23:          FCC      'Software Dynamics ASM/6809, Version '
                 24:          FIN
2A8D 312E34      25:          FCB      (RELEASE/$10&$F)+'0,'.,(RELEASE&$F)+'0
2A90 41          26:          FCB      ASSEMBLY          Show assembly
2A91 2020        27: ASMPAT   FCC      '  '
2A93 202F20      28:          FCC      ' / '
2A96 33          29:          FCB      (VERS/$1000&$F)+'0+('A-'9-1)*((VERS/$1000&$F)>9)
2A97 37          30:          FCB      (VERS/$100&$F)+'0+('A-'9-1)*((VERS/$100&$F)>9)
2A98 45          31:          FCB      (VERS/$10&$F)+'0+('A-'9-1)*((VERS/$10&$F)>9)
2A99 43          32:          FCB      (VERS&$F)+'0+('A-'9-1)*((VERS&$F)>9)
2A9A 0D          33:          FCB      $D
2A9B 00          34:          FCB      0
2A9C 9F2A        35:          STS      FLAMOUT           SAVE STACK FOR I/O ERROR POSSIBILITY
                 36: 
                 37: **** Get the source-file's name from the user ****
  2A9E           38: RSI      ;LDX     #RSI              GET LOC FOR I/O ERR
2A9E CE2A9E      39:          LDX      #RSI
2AA1 DFAA        40:          STX      IOERRLOC
                 41:          ;JSR     PUTT              SAY SOMETHING




ASM/6800 1.3H4: 2AA3 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
