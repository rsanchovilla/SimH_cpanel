ASM/6800 1.3H4: 0BAB ASM/6800 1.4       - - - O P C O D E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 76; Form 6      - - - C H I M M - - -
ASM14A.DITL0.ASM
                  2: *13*
                  3: *
                  4: *
                  5: * SUBROUTINE TO CHECK FOR IMMEDIATE INSTRUCTIONS:
                  6: * IF IT IS IMMEDIATE, THEN RETURNS Z=1, AND SETS VAL
                  7: * TO VALUE OF EXPRESSION.  OTHERWISE, RETURNS Z=0.
                  8: *
  0BAE            9: CHIMM    ;LDX      AFPTR             GET POINTER TO FIRST CH.
0BAE DE26        10:          LDX      AFPTR
0BB0 270C        11:          BEQ      CHIRTN            B/ NO AF; NOT IMMEDIATE.
0BB2 A600        12:          LDAA     0,X               GET FIRST CH OF AF.
                 13:          ;CMPA     #'#               IS IT IMMEDIATE QUALIFIER?
0BB4 8123        14:          CMPA     #'#
0BB6 2605        15:          BNE      CHIRTS            B/ NO # AT START ==> NOT IMMEDIATE.
0BB8 08          16:          INX                        POINT AT NEXT CH,
                 17:          ;JSR      EVAFX             GO EVALUATE THE EXPRESSION.
0BB9 BD1AF5      18:          JSR      EVAFX
0BBC 5F          19:          CLRB                       SET APPROPRIATE CC.
0BBD 39          20: CHIRTS   RTS                        AND EXIT, SUCCESS.
                 21: *
0BBE 08          22: CHIRTN   INX                        SET CC # 0,
0BBF 39          23:          RTS                        AND EXIT, FAIL.




ASM/6800 1.3H4: 0BBF ASM/6800 1.4       - - - O P C O D E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 77; Form 7      - - - C H I N D X - - -
ASM14A.DITL0.ASM
                  2: *
                  3: * SUBROUTINE TO CHECK FOR INDEXED INSTRUCTION.  EATS THE FOLLOWING
                  4: * CONSTRUCTS AS INDEXED:
                  5: *        X
                  6: *        ,X
                  7: *        <EXP>,X
                  8: *
                  9: * NOTE THAT X MUST BE ALL BY ITSELF IN ORDER TO BE RECOGNIZED;
                 10: *        +X, (X), X+3 ETC. WILL NOT BE RECOGNIZED AS INDEXED INSTRUCTION
                 11: *
  0BC0           12: CHINDX   ;LDX      AFPTR             GET POINTER TO AF,
0BC0 DE26        13:          LDX      AFPTR
                 14:          ;JSR      GNOBX             GET FIRST OBJECT.
0BC2 BD1E38      15:          JSR      GNOBX
                 16:          ;CMPA     #O:SYM            IS IT A SYMBOL?
0BC5 8101        17:          CMPA     #O:SYM
0BC7 261B        18:          BNE      CHIND1            B/ NO:  SEE IF <EXP>,X
0BC9 8D3A        19:          BSR      ISITX             IS SYM = "X"?
0BCB 2617        20:          BNE      CHIND1            B/ NO:  NOT SIMPLEST FORM.
0BCD 4F          21: CHINDCL  CLRA                       CLEAR VALUE
0BCE 975F        22:          STAA     VAL
0BD0 9760        23:          STAA     VAL+1
                 24: *  INDEXED INSTRUCTION FOUND...
0BD2 31          25: CHIN2    INS                        POP RETURN @
0BD3 31          26:          INS
0BD4 965F        27:          LDAA     VAL               GET HIGH BYTE OF INDEX VAL.
0BD6 2703        28:          BEQ      CHIN0             B/ NO OVERFLOW...
                 29:          ;JSR      OVRFLW            *E* OVERFLOW ON INDEX INSTR.
0BD8 BD0883      30:          JSR      OVRFLW
0BDB 8620        31: CHIN0    LDAA     #$20              ELSE 'OR' IN INDEX BIT,
0BDD 9A57        32:          ORAA     OP                OR INTO THE OP
                 33:          ;JSR     PUTB              PUT IT
0BDF BD26A5      34:          JSR      PUTB
0BE2 20B9        35:          BRA      OUTVL             GO PUT OUT THE DISPLACEMENT
                 36: *
  0BE4           37: CHIND1   ;LDX      AFPTR             RESET TO START OF AF
0BE4 DE26        38:          LDX      AFPTR
0BE6 DF28        39:          STX      EXPTR
                 40:          ;JSR      GTCMA             FIND THE COMMA...
0BE8 BD1E1C      41:          JSR      GTCMA




ASM/6800 1.3H4: 0BEB ASM/6800 1.4       - - - O P C O D E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 78; Form 7      - - - C H I N D X - - -
ASM14A.DITL0.ASM
0BEB 28D0        42:          BVC      CHIRTS            B/ WRETCH... NO CAN BE INDEXED
                 43:          ;JSR      GNOBJ             GET WHATS AFTER THE COMMA...
0BED BD1E2C      44:          JSR      GNOBJ
                 45:          ;CMPA     #O:SYM            IS IT A SYMBOL?
0BF0 8101        46:          CMPA     #O:SYM
0BF2 26C9        47:          BNE      CHIRTS            B/ NO ==> NOT INDEXED.
0BF4 8D0F        48:          BSR      ISITX             IS SYMBOL X?
0BF6 26C5        49:          BNE      CHIRTS            B/ NO ==> NOT INDEXED
                 50:          ;LDX     AFPTR             SEE IF THE FIRST AF CHAR WAS A COMMA (AS IN ,X)
0BF8 DE26        51:          LDX      AFPTR
0BFA A600        52:          LDAA     0,X               LOAD 1ST CHAR
                 53:          ;CMPA    #',               IS IT?
0BFC 812C        54:          CMPA     #',
0BFE 27CD        55:          BEQ      CHINDCL           IF SO, SET NULL OFFSET
                 56:          ;JSR      EVAF              GET VAL FOR AF
0C00 BD1AF3      57:          JSR      EVAF
0C03 20CD        58:          BRA      CHIN2             AND GO CHECK THAT ITS GOOD.
                 59: ****
                 60: **** CHECK THAT SYM IS "X"
  0C05           61: ISITX    ;LDX      #$100+'X
0C05 CE0158      62:          LDX      #$100+'X
0C08 9C62        63:          CPX      SYM
0C0A 26B1        64:          BNE      CHIRTS            RETURN NE IF NOT X SYMBOL
                 65:          ;JMP     CKEOF             SEE IF EOF NEXT
0C0C 7E1E06      66:          JMP      CKEOF
                 67: *




ASM/6800 1.3H4: 0C0C ASM/6800 1.4       - - - O P C O D E   P R O C E S S I N G - - -
