                 59: *
                 60: *
                 61: *  I S I T
                 62: *
                 63: *        SCANS A LIST OF VALUES, RETURNS CC # 0 IF
                 64: *        NONE OF THEM ARE EQUAL  TO THE VALUE IN ACCA
                 65: *
                 66: *        A, X ARE DESTROYED.
                 67: *
                 68: *
  08DE           69: ISIT     EQU      *
                 70:          ;PULX                      Pointer to table
08DE 30          71:          TSX
08DF EE00        72:          LDX      0,X
08E1 31          73:          INS
08E2 31          74:          INS
  08E3           75: ISITL    ;CMPA     0,X               IS THE NEXT ONE THE ONE I WANT?
08E3 A100        76:          CMPA     0,X
08E5 2708        77:          BEQ      ISITR             B/ YES.  GET OUT
08E7 08          78:          INX                        POINT TO NEXT...
08E8 6D00        79:          TST      0,X               END OF LIST ?
08EA 26F7        80:          BNE      ISITL             B/ NO.  TRY ANOTHER
08EC 08          81:          INX                        (BUMP POINTER AND CLEAR CCZ)
                 82:          ;JMP      0,X               GO DO THE NEXT INSTRUCTION
08ED 6E00        83:          JMP      0,X
08EF 08          84: ISITR    INX                        EAT UP THE REST OF THE LIST
08F0 6D00        85:          TST      0,X
08F2 26FB        86:          BNE      ISITR
                 87:          ;JMP      1,X               AND LEAVE.
08F4 6E01        88:          JMP      1,X




ASM/6800 1.3H4: 08F4 ASM/6800 1.4       - - -   M C S - 6 8 0 0   A S S E M B L E R   - - -
08/16/82 00:00:00; Page 51; Form 12     - - - D O I T - - -
ASM14A.MAIN.ASM
                  2: *
                  3: *
                  4: *
                  5: * DOIT --
                  6: *
                  7: *        CALLS DOITL, CONTROLS SKIPPING, ETC.
                  8: *
                  9: *        DOITL IS PERFORMED ACCORDING TO THE FOLLOWING CONDITIONS:
                 10: *        (A)      RPTF<0  ==> DOITL IS CALLED ONCE.
                 11: *        (B)      RPTF=0  ==> DOITL IS NOT CALLED. LINE IS SKIPPED.
                 12: *        (C)      RPTF>0  ==> DOITL IS CALLED RPTF TIMES.
                 13: *        (D)      SKPFLG#0 ==> DOITL IS NOT CALLED; WE ARE SKIPPING.
                 14: *
                 15: *        IN THIS LAST CASE (SKPFLG#0), WE CHECK WHETHER THE
                 16: *        COMMAND IS SOMETHING WHICH AFFECTS OUR SKIPPING.
                 17: *        THE COMMANDS ARE:
                 18: *        (1)      DO/IF/CASE        BUMP SKPLVL
                 19: *        (2)      ELSE/ELSEIF       IF SKPLVL=0, & IF SKIPFLB
                 20: *                                   > 0, THEN DEC SKPFLG.  IF
                 21: *                                   SKPFLG = 0, THEN TERMINATE
                 22: *                                   THE SKIP.  IF SKPLVL<0, CONTINUE
                 23: *                                   SKIPPING.
                 24: *        (3)      FIN               DEC SKPLVL; IF SKPLVL=0 THEN
                 25: *                                   SKPFLG:=0, WHICH STOPS THE SKIP.
                 26: *
                 27: *




ASM/6800 1.3H4: 08F4 ASM/6800 1.4       - - -   M C S - 6 8 0 0   A S S E M B L E R   - - -
