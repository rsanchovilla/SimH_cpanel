ASM14A.IOFM.ASM
                  2: *
                  3: *        DUMPRINT
                  4: *        SYMPT IS ADDRESS OF SYMBOL; TPTR IS CLOBBERED
                  5: *
  2E10            6: DUMPRINT EQU      *
2E10 D6B2         7:          LDAB     WIDTH             ELIMINATE OCCASIONAL
2E12 D0A9         8:          SUBB     COLNO               DANGLING SYMBOLS BY ONLY
2E14 C5F0         9:          BITB     #$F0                USING COLUMNS...
2E16 2712        10:          BEQ      DMPTCR              OF MINIMUM LENGTH.   B/ TOO SMALL.
2E18 D6A9        11:          LDAB     COLNO             OUTPUT TAB IF SYMBOL...
2E1A CB10        12:          ADDB     #$F+1             WILL FIT IN REMAINDER...(+1 TO REMEMBER
                 13:                                     ;  EXTRA IMPLIED SPACE)
2E1C C4F0        14:          ANDB     #$F0              OF LINE, ELSE <CR>
2E1E CB06        15:          ADDB     #6                NOTE THAT EXTREMELY LONG...
                 16:          ;LDX     SYMPT             SYMBOLS THAT WONT FIT ON ONE LINE...
2E20 DE38        17:          LDX      SYMPT
2E22 EB05        18:          ADDB     S:LEN,X           WILL BE CHOPPED
2E24 8609        19:          LDAA     #TAB
                 20:          ;CMPB    WIDTH
2E26 D1B2        21:          CMPB     WIDTH
2E28 2302        22:          BLS      DMPT1
2E2A 860D        23: DMPTCR   LDAA     #$D               GET <CR>
2E2C 8D26        24: DMPT1    BSR      DPUTLO            **POOF**
                 25:          ;LDX     SYMPT             OUTPUT ' ' IF SYMBOL
2E2E DE38        26:          LDX      SYMPT
2E30 8620        27:          LDAA     #BLANK            WAS USED, ELSE '*'
2E32 E604        28:          LDAB     S:TYPE,X
2E34 C508        29:          BITB     #T:USED
2E36 2602        30:          BNE      DMPT2             LOVE THOSE RELATIVE BRANCHES!
2E38 862A        31:          LDAA     #'*
2E3A C510        32: DMPT2    BITB     #T:DDEF           IS THIS A DDEF?
2E3C 2702        33:          BEQ      DMPT3             IF NOT, GO ON
2E3E 862B        34:          LDAA     #'+               ELSE INDICATE THE DDEF CONDITION
2E40 8D12        35: DMPT3    BSR      DPUTLO            OUTPUT 'SYMBOL REFERENCED' CHARACTER
                 36:          ;LDX     SYMPT             OUTPUT THE SYMBOL NAME
2E42 DE38        37:          LDX      SYMPT
2E44 E605        38:          LDAB     S:LEN,X           GET ITS LENGTH
  2E46           39: DUMPRINT1 EQU     *
2E46 A606        40:          LDAA     S:TEXT,X          GET BYTE OF NAME
2E48 08          41:          INX                        BUMP NAME SCAN POINTER




