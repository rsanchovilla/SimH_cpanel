0B6D 0C57        26:          FDB      BRANCH            GROUP 3      RELATIVE BRANCH.
0B6F 0C3A        27:          FDB      JMPJSR            GROUP 4      FUNNY FOR INSTS W/ INDEXED OR EXTEND
0B71 0BA7        28:          FDB      DYADXNI           GROUP 5      DYADIC IN X, S; IMMEDIATE NOT ALLOWE
                 29: *




ASM/6800 1.3H4: 0B71 ASM/6800 1.4       - - - O P C O D E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 74; Form 5      - - - D Y A D I C   R E G I S T E R - - -
ASM14A.DITL0.ASM
                  2: *
                  3: * DYADR -- DYADIC REGISTER: EG. ADD, SUB
0B73 9656         4: DYADRSCN LDAA     REG               GET REGISTER VALUE
0B75 44           5:          LSRA                       :00 1
0B76 46           6:          RORA                       :80 0
0B77 46           7:          RORA                       :40 0
0B78 9A57         8:          ORAA     OP                MAKE OPCODE
0B7A D657         9:          LDAB     OP                SAVE OLD OP,
0B7C 9757        10:          STAA     OP                UPDATE
0B7E 39          11:          RTS
                 12: *
                 13: * CHECK FOR IMMEDIATE.
  0B7F           14: DYADR    EQU      *
0B7F 8DF2        15:          BSR      DYADRSCN          SET UP REGISTER IN OPCODE.
0B81 8D2B        16:          BSR      CHIMM             CHECK IMMEDIATE & EVAL IF SO
0B83 2622        17:          BNE      DYADR4            B/ NOT IMMEDIATE.
0B85 965F        18:          LDAA     VAL               IN RANGE?
0B87 270B        19:          BEQ      DYADR1            B/ YES.
0B89 7D0060      20:          TST      VAL+1             IS IT POSSIBLE THAT THE SIGN IS EXTENDED?
0B8C 2C03        21:          BGE      DYOVF             IF NOT, ERR
0B8E 43          22:          COMA                       IS HIGH ORDER STUFF SIGN
0B8F 2703        23:          BEQ      DYADR1            B/ YES.
  0B91           24: DYOVF    ;JSR     OVRFLW            *E* OVERFLOW
0B91 BD0883      25:          JSR      OVRFLW
  0B94           26: DYADR1   EQU      *
0B94 4F          27: OUT2     CLRA                       OUTPUT OP, VALL
0B95 9A57        28: OUT2O    ORAA     OP                OR OP W/ ACCA, OUTPUT OP,VAL
  0B97           29: OUT2A    ;JSR      PUTB              OUTPUT A
0B97 BD26A5      30:          JSR      PUTB
                 31:          ;JSR     ECKEOF            ERROR IF END OF FIELD NOT NEXT
0B9A BD1E15      32:          JSR      ECKEOF
0B9D 9660        33: OUTVL    LDAA     VAL+1             OUTPUT LOW VAL
  0B9F           34: OUT1A    EQU      *
  0B9F           35: OUTL     ;JSR      PUTB              PUT THE BYTE
0B9F BD26A5      36:          JSR      PUTB
  0BA2           37: OUTX     ;JMP      LIST              AND FLAKE OUT.
0BA2 7E220D      38:          JMP      LIST
                 39: *
                 40: *
                 41: * CHECK FOR INDEXED:




