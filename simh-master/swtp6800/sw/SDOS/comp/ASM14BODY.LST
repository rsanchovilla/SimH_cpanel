ASM14A.MAIN.ASM
                  2: *
                  3: *
                  4: * EVNUL - EVAL AN EXP AND IF IT IS NULL RETURN A ZERO - NOT AN ERR
                  5: *        RETURNS  C=0 IF EVALUBLE EXPRESSION PRESENT
                  6: *                 C=1 IF NONE OR EXPRESSION CONTAINED A FORWARD REFERENCE
                  7: *
  13A9            8: EVNUL    EQU      *
                  9:          ;JSR     GNOBJ             SEE IF A TERM COMES NEXT
13A9 BD1E2C      10:          JSR      GNOBJ
                 11:          ;INC     RJOBJ             IN ANY CASE - REJECT THIS OBJECT
13AC 7C005C      12:          INC      RJOBJ
                 13:          ;CMPA    #O:TERM           WELL?
13AF 8106        14:          CMPA     #O:TERM
13B1 2608        15:          BNE      EVIT              IF NOT, JUST MUNCH A EXP
                 16:          ;CLR     VAL               CLEAR VALUE
13B3 7F005F      17:          CLR      VAL
                 18:          ;CLR     VAL+1             DITTO
13B6 7F0060      19:          CLR      VAL+1
13B9 0D          20: EVSEC    SEC
13BA 39          21:          RTS
                 22: *
  13BB           23: EVIT     ;JSR     EVAL              GO TO IT
13BB BD1B24      24:          JSR      EVAL
13BE 9659        25:          LDAA     XTYPE             Get extpression type
13C0 8501        26:          BITA     #XT:FREF          Forward reference?
13C2 26F5        27:          BNE      EVSEC             B/Yes
13C4 0C          28:          CLC
13C5 39          29:          RTS
                 30: *




ASM/6800 1.3H4: 13C5 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 121; Form 16    - - - L I S T I N G   C O N T R O L - - -
ASM14A.MAIN.ASM
  0001            2:          IF       NICE=1
                  3: *
                  4: *
                  5: * LIST:
                  6: *        HANDLES LIST PSEUDO-OP;  IF AF #0 AND  LO WAS SPECIFIED, TURNS LISTING
                  7: *        ON; ELSE TURNS LISTING OFF.
                  8: *
                  9: * PCC:
                 10: *        HANDLES "PCC <VAL>"; TURNS LISTING OF CONTROL COMMANDS OFF OR ON; COMMANDS
                 11: *        AFFECTED ARE PAGE, TITLE, LIST, PCC, PSR, PCA, PGEN, SPACE.
                 12: *
                 13: * PSR:
                 14: *        HANDLES "PSR <VAL>"; TURNS LISTING OF SKIPPED RECORDS OFF OR
                 15: *        ON.
                 16: *
                 17: * PCA:
                 18: *        HANDLES "PCA <VAL>"; TURNS LISTING OF CONDITIONAL-ASSEMBLY COMMANDS OFF
                 19: *        OR ON.  COMMANDS AFFECTED ARE DO, IF, ELSE, FIN, ELSEIF, RPT, CASE.
                 20: *
                 21: * PGEN:
                 22: *        HANDLES "PGEN <VAL>"; TURNS LISTING OF EXTRA GENERATED-CODE LISTING
                 23: *        LINES OFF OR ON.  IF "PGEN 0" IS SPECIFIED, THEN ONLY THE FIRST 4 BYTES
                 24: *        OF A GENERATIVE DIRECTIVE WILL BE LISTED.  EG, FCC /ABCDEF/ WILL ONLY
                 25: *        HAVE THE FIRST FOUR DATA BYTES LISTED.
                 26: *
  13C6           27: LIST:    EQU      *
13C6 96BA        28:          LDAA     OPTF              IS LO INHIBITED?
13C8 43          29:          COMA
13C9 850A        30:          BITA     #OPT:LO!OPT:LST   ARE BOTH ON?
13CB 26EE        31:          BNE      EVIT                   B/ NO:  EVALUATE AND CHUCK.
13CD C601        32:          LDAB     #LL:LIST          GET LISTING BIT FOR LATER.
13CF 9654        33: LIST:1   LDAA     PASS              IF THIS IS PASS 1, SPLIT.
13D1 27E8        34:          BEQ      EVIT                B/ ALL DONE.
13D3 37          35:          PSHB                       SAVE THE BIT TO BE AFFECTED,
13D4 8DE5        36:          BSR      EVIT                AND SLURP UP THE AF.
13D6 33          37:          PULB                       GET OUR BIT BACK.
13D7 9659        38:          LDAA     XTYPE             CHECK THE EXPRESSION FOR OK-NESS.
13D9 8504        39:          BITA     #XT:UNDF          ONLY THING BAD IN PASS2 IS UNDEF.
13DB 260E        40:          BNE      LIST:ILV          B/ REPORT ERROR IF UNDEFINED.
13DD 17          41:          TBA                        COPY BIT INTO A,




