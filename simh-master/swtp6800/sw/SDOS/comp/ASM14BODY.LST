ASM14A.MAIN.ASM
07F9 39          41: READR    RTS                        ;SPLIT.
                 42: 
                 43: **** Image of end statement for happy assembler ****
07FA 09454E44    44: RENDEND fcc       / END              ;<<Supplied By ASM>>/
0813 0D00        45:          fcb      $D,0




ASM/6800 1.3H4: 0813 ASM/6800 1.4       - - -   M C S - 6 8 0 0   A S S E M B L E R   - - -
08/16/82 00:00:00; Page 41; Form 6      - - -  F O R M F E E D  - - -
ASM14A.MAIN.ASM
                  2: 
                  3: **** FORMFEED ****
                  4: 
                  5: *        DOES ALL WORK REQUIRED WHEN A FORM SEPARATION IS DETECTED
                  6: *        IN THE SOURCE FILE.  FAIRLY TRIVIAL.
                  7: 
                  8: 
  0815            9: FORMFEED EQU      *
                 10:          ;JSR     EJECT             ADVANCE LISTING,
0815 BD1561      11:          JSR      EJECT
                 12:          ;LDX     #FPGE             BUMP FORM COUNTER.
0818 CE008F      13:          LDX      #FPGE
081B 8D06        14:          BSR      INCBCD
                 15:          ;LDX     #1                RESET LINE-#-WITHIN-FORM
081D CE0001      16:          LDX      #1
0820 DF91        17:          STX      LINEN
                 18: 
0822 39          19:          RTS                        AND GO HOME.




ASM/6800 1.3H4: 0822 ASM/6800 1.4       - - -   M C S - 6 8 0 0   A S S E M B L E R   - - -
08/16/82 00:00:00; Page 42; Form 7      - - - I N C B C D - - -
ASM14A.MAIN.ASM
                  2: *
                  3: *  INCBCD --
                  4: *        INCREMENTS A BCD NUMBER POINTED TO BY X
                  5: *
                  6: *        ACCA IS CHANGED
                  7: *
  0823            8: INCBCD   EQU      *
0823 A601         9:          LDAA     1,X               GET LOW BYTE
0825 8B01        10:          ADDA     #1                INCREMENT IT
0827 19          11:          DAA                        ADJUST IT,
0828 A701        12:          STAA     1,X               AND SAVE IT.
082A A600        13:          LDAA     0,X               DO SAME FOR HIGH BYTE
082C 8900        14:          ADCA     #0
082E 19          15:          DAA
082F A700        16:          STAA     0,X
0831 39          17:          RTS




ASM/6800 1.3H4: 0831 ASM/6800 1.4       - - -   M C S - 6 8 0 0   A S S E M B L E R   - - -
08/16/82 00:00:00; Page 43; Form 8      - - - W H I C H - - -
ASM14A.MAIN.ASM
                  2: *
                  3: *4*
                  4: *
                  5: *
                  6: * WHICH --
                  7: *        DOES A TABLE BRANCH ACCORDING TO THE CONTENTS OF A.
                  8: *
                  9: *        A IS COMPARED W/ THE FIRST BYTE OF A 3-BYTE ENTRY;
                 10: *        IF IT MATCHES, THEN THE NEXT TWO BYTES ARE TAKEN AS
                 11: *        THE EXIT ADDRESS.  OTHERWISE, THE NEXT ENTRY IS TRIED.
                 12: *        THIS GOES ON UNTIL AN ENTRY IS FOUND W/ A ZERO ENTRY.
                 13: *
                 14: *        NOTE THAT A SHOULD NOT BE ZERO.  IF NO MATCH IS FOUND
                 15: *        THEN WHICH RETURNS TO THE BYTE FOLLOWING THE ZERO BYTE.
                 16: *
                 17: *
  0832           18: WHICH    EQU      *
                 19:          ;PULX                      ;Get table address
0832 30          20:          TSX
0833 EE00        21:          LDX      0,X
0835 31          22:          INS
0836 31          23:          INS
                 24: *
  0837           25: WHCH1    ;CMPA     0,X               ;IS THIS THE ONE?
0837 A100        26:          CMPA     0,X
0839 2709        27:          BEQ      WHCHX             ;B/YES ==>  BYE.
                 28:          ;LEAX    3,X
  0000           29:          IF       3<0
 *S*             30:          RPT      -3
 *S*             31:          DEX
                 32:          ELSE
  0003           33:          RPT      3
083B 08          34:          INX
                 35:          FIN
083E 6D00        36:          TST      0,X               ;END OF LIST?
0840 26F5        37:          BNE      WHCH1             ;B/ NO==> TRY ANOTHER.
                 38: *
                 39:          ;JMP      1,X               ;TAKE FAIL EXIT.
0842 6E01        40:          JMP      1,X
                 41: *




ASM/6800 1.3H4: 0842 ASM/6800 1.4       - - -   M C S - 6 8 0 0   A S S E M B L E R   - - -
08/16/82 00:00:00; Page 44; Form 8      - - - W H I C H - - -
ASM14A.MAIN.ASM
                 42: * MATCH FOUND--
  0844           43: WHCHX    ;LDX      1,X               GET THE RETURN @
0844 EE01        44:          LDX      1,X
                 45:          ;JMP      0,X               AND GO, BABY, GO.
0846 6E00        46:          JMP      0,X




ASM/6800 1.3H4: 0846 ASM/6800 1.4       - - -   M C S - 6 8 0 0   A S S E M B L E R   - - -
08/16/82 00:00:00; Page 45; Form 9      - - - C H R A N G E - - -
ASM14A.MAIN.ASM
                  2: *
                  3: *
                  4: *  C H R A N G E
                  5: *
                  6: *        Check for character in A in a specified range; branch
                  7: *        to appropriate place if so.
                  8: *
                  9: *
  0848           10: CHRANGE  EQU      *
                 11:          ;PULX                      ;Table address
0848 30          12:          TSX
0849 EE00        13:          LDX      0,X
084B 31          14:          INS
084C 31          15:          INS
  084D           16: CHRLP    ;CMPA     0,X
084D A100        17:          CMPA     0,X
084F 2D08        18:          BLT      CHRNX
                 19:          ;CMPA     1,X
0851 A101        20:          CMPA     1,X
0853 2E04        21:          BGT      CHRNX
                 22:          ;LDX      2,X
0855 EE02        23:          LDX      2,X
                 24:          ;JMP      0,X
0857 6E00        25:          JMP      0,X
                 26: *
  0859           27: CHRNX    ;LEAX    4,X
  0000           28:          IF       4<0
 *S*             29:          RPT      -4
 *S*             30:          DEX
                 31:          ELSE
  0004           32:          RPT      4
0859 08          33:          INX
                 34:          FIN
085D 6D00        35:          TST      0,X
085F 26EC        36:          BNE      CHRLP
                 37:          ;JMP      1,X               TAKE A FLYING LEAP
0861 6E01        38:          JMP      1,X




ASM/6800 1.3H4: 0861 ASM/6800 1.4       - - -   M C S - 6 8 0 0   A S S E M B L E R   - - -
08/16/82 00:00:00; Page 46; Form 10     - - - E R R O R   S U B R O U T I N E S - - -
ASM14A.MAIN.ASM
                  2:    
                  3: *5*
                  4: *
                  5: * ERROR ROUTINES:
                  6: *
                  7: *  ERROR ROUTINES WILL ALWAYS CONSIST OF A BSR TO ERROR,
                  8: *  FOLLOWED BY A TWO-BYTE FLAG VALUE.  THIS VALUE WILL BE
                  9: *  INCLUSIVE 'OR'ED INTO ERRFLG.
                 10: *
0863 8D4E        11: CRSCAN   BSR      ERROR             ;LF W/O CF.
0865 0001        12:          FDB      F:ILLF
                 13: *
  0863           14: ILLF     EQU      CRSCAN
                 15: *
0867 8D4A        16: SYNTAX   BSR      ERROR             ;SYNTAX ERROR
0869 0002        17:          FDB      F:SYNTX
                 18: *
086B 8D46        19: ILLAF    BSR      ERROR
086D 0004        20:          FDB      F:ILLAF           ;ILLEGAL AF
                 21: *
086F 8D42        22: UNDEF    BSR      ERROR
0871 0008        23:          FDB      F:UNDF            ;UNDEFINED SYMBOL
                 24: *
0873 8D3E        25: DDEF     BSR      ERROR
0875 0010        26:          FDB      F:DDEF            ;DOUBLY DEFINED SYMBOL
                 27: *
0877 8D3A        28: UDDEF    BSR      ERROR
0879 0020        29:          FDB      F:UDDF            ;USE OF DBL-DEF SYMBOL
                 30: *
087B 8D36        31: NSTER    BSR      ERROR             *E* NESTING ERROR IF/DO/CASE
087D 0040        32:          FDB      F:NST
                 33: *
087F 8D32        34: ENDER    BSR      ERROR             *E* EOF HIT BEFORE END STATEMENT.
0881 0080        35:          FDB      F:END
                 36: *
0883 8D2E        37: OVRFLW   BSR      ERROR             *E* VALUE OVERFLOWED FIELD
0885 0101        38:          FDB      F:OVF
                 39: *
0887 8D2A        40: BRANERR  BSR      ERROR             *E* OUT-OF-RANGE BRA/BSR
0889 0102        41:          FDB      F:BRA




ASM/6800 1.3H4: 0889 ASM/6800 1.4       - - -   M C S - 6 8 0 0   A S S E M B L E R   - - -
08/16/82 00:00:00; Page 47; Form 10     - - - E R R O R   S U B R O U T I N E S - - -
ASM14A.MAIN.ASM
                 42: *
088B 8D26        43: ILLVAL   BSR      ERROR             *E* ILLEGAL VALUE
088D 0104        44:          FDB      F:ILV
                 45: *
088F 8D22        46: BADDIG   BSR      ERROR             *E* BAD DIGIT
0891 0108        47:          FDB      F:BADD
                 48: *
