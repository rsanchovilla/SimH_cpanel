2C2F DE5F        29:          LDX      VAL
2C31 2610        30:          BNE      DUMPTBL1          YES, GO PRINT CORRECT MESSAGE
                 31:          ;LDX     #NOSYM            GET "NO SYMBOLS...." MESSAGE
2C33 CE2C54      32:          LDX      #NOSYM
                 33:          ;JSR     PTTL              AND PRINT IT
2C36 BD2650      34:          JSR      PTTL
