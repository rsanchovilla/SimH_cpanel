ASM14A.IOFM.ASM
                146: *****************************************************************************
                147: *
                148: * Name:  FilePosition (TargetAddress (*in AB*) )
                149: *
                150: * Function:
                151: *        Given a target load address in AB, Fileposition returns a pointer
                152: *        to a four byte buffer that contains a filepointer.  This filepointer
                153: *        can be used to do a position prior to a write for outputting a
                154: *        record that starts at TargetAddress.  The filepointer is built in
                155: *        a special buffer; CURREC.FILEBASE is not modified.
                156: *
                157: * Arguments:
                158: *        AB       "TargetAddress"   Target load address.
                159: *
                160: * Results:
                161: *        X        "FPbuffer"        Address of four byte file address.
                162: *
                163: * Changed:                          Preserved:
                164: *        A, B, C, X                      ***NONE***
                165: *
                166: *****************************************************************************
                167: 
                168: **** Compute file address (& return pointer to buffer) for target address ****
                169: **** in AB.  Address assumes inclusion in current record                  ****
  2953          170: FilePosition      equ *
                171:          ;LDX     #FPbuffer         Load pointer to file-position buffer
2953 CE3078     172:          LDX      #FPbuffer
2956 FB308B     173:          ADDB     CURREC+R$FILEBASE+3    FPbuffer := CURREC.FILEBASE +
2959 E703       174:          STAB     3,X                                NEWREC.BASE -
295B B9308A     175:          ADCA     CURREC+R$FILEBASE+2                CURREC.BASE
295E A702       176:          STAA     2,X
2960 B63089     177:          LDAA     CURREC+R$FILEBASE+1
2963 8900       178:          ADCA     #0
2965 A701       179:          STAA     1,X
2967 B63088     180:          LDAA     CURREC+R$FILEBASE
296A 8900       181:          ADCA     #0
296C A700       182:          STAA     0,X
296E B63084     183:          LDAA     CURREC+R$BASE
2971 F63085     184:          LDAB     CURREC+R$BASE+1
                185: 




