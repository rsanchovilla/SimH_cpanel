ASM/6800 1.3H4: 16E9 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 154; Form 27    - - - I F U N D : - - -
ASM14A.MAIN.ASM
  0001            2:          DO       CONDASM=1         MUST HAVE OTHER STUFF TO GET THIS
                  3: *
                  4: *
                  5: * I F U N D :
                  6: *
                  7: *        IF VARIABLE IS UNDEFINED OR A FWD REF - THEN COND=TRUE
                  8: *
                  9: *
  16EC           10: IFUND:   ;CLR     VAL               CLEAR VALUE (FALSE COND)
16EC 7F005F      11:          CLR      VAL
                 12:          ;CLR     VAL+1
16EF 7F0060      13:          CLR      VAL+1
                 14:          ;JSR     GNOBJ             GET THE SYMBOL
16F2 BD1E2C      15:          JSR      GNOBJ
                 16:          ;CMPA    #O:SYM            IS IT?
16F5 8101        17:          CMPA     #O:SYM
16F7 2615        18:          BNE      IFUERR            IF NOT, ERR
                 19:          ;JSR     CKEOF             IS FIELD SYMBOL ONLY?
16F9 BD1E06      20:          JSR      CKEOF
16FC 2610        21:          BNE      IFUERR              B/ NOPE.  NO CAN DO.
                 22: 
                 23: *
                 24: * SYM TO BE TESTED IS IN SYM
                 25: *
                 26:          ;JSR     FSYM              WHERE ARE YOU?
16FE BD20C3      27:          JSR      FSYM
1701 2606        28:          BNE      NDEFD             IF NOT THERE - SUCCESS - SET TRUE
1703 A604        29:          LDAA     S:TYPE,X          GET TYPE
1705 8505        30:          BITA     #T:UNDF!T:FREF    IS IT UNDEF OR FREF?
1707 27DA        31:          BEQ      IFAIL             IT'S DEFINED (DARN) FAIL!!!
                 32: *
                 33: * SYM IS UNDEF - SET VAL=1 AND SUCCEED
                 34: *
  1709           35: NDEFD    ;INC     VAL+1             SAY "TRUE"
1709 7C0060      36:          INC      VAL+1
170C 20DB        37:          BRA      IF:T              GOTO HANDLE TRUE
                 38: *
  170E           39: IFUERR   ;JSR     ILLAF             SCREAM
170E BD086B      40:          JSR      ILLAF
1711 20D0        41:          BRA      IFAIL             FAIL THE TEST




ASM/6800 1.3H4: 1711 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 155; Form 27    - - - I F U N D : - - -
ASM14A.MAIN.ASM
                 42:          FIN
                 43: *




ASM/6800 1.3H4: 1711 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 156; Form 28    - - - I F U N D : - - -
ASM14A.MAIN.ASM
  0001            2:          DO       CONDASM=1         MUST HAVE OTHER STUFF TO GET THIS
                  3: *
                  4: *
                  5: * I F D E F :
                  6: *
                  7: *        IF VARIABLE IS DEFINED OR NOT A FWD REF - THEN COND=TRUE
                  8: *
                  9: *
  1713           10: IFDEF:   ;LDX     #0                SET VALUE (TRUE COND)
1713 CE0000      11:          LDX      #0
1716 DF5F        12:          STX      VAL
                 13:          ;JSR     GNOBJ             GET THE SYMBOL
1718 BD1E2C      14:          JSR      GNOBJ
                 15:          ;CMPA    #O:SYM            IS IT?
171B 8101        16:          CMPA     #O:SYM
171D 26EF        17:          BNE      IFUERR            IF NOT, ERR
                 18:          ;JSR     CKEOF             IS FIELD SYMBOL ONLY?
171F BD1E06      19:          JSR      CKEOF
1722 26EA        20:          BNE      IFUERR              B/ NOPE.  NO CAN DO.
                 21: 
                 22: *
                 23: * SYM TO BE TESTED IS IN SYM
                 24: *
                 25:          ;JSR     FSYM              WHERE ARE YOU?
1724 BD20C3      26:          JSR      FSYM
1727 2606        27:          BNE      ISDEFD            IF NOT THERE - FAILURE - SET FALSE
1729 A604        28:          LDAA     S:TYPE,X          GET TYPE
172B 8505        29:          BITA     #T:UNDF!T:FREF    IS IT UNDEF OR FREF?
172D 26B4        30:          BNE      IFAIL             IT'S NOT DEFINED (DARN) FAIL!!!
                 31: *
                 32: * SYM IS DEF - SET VAL=1 AND SUCCEED
                 33: *
  172F           34: ISDEFD   ;INC     VAL+1             SAY "TRUE"
172F 7C0060      35:          INC      VAL+1
1732 20B5        36:          BRA      IF:T              GOTO HANDLE TRUE
                 37:          FIN




ASM/6800 1.3H4: 1732 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 157; Form 29    - - - E L S E : - - -
ASM14A.MAIN.ASM
  0001            2:          DO       CONDASM=1
                  3: *
                  4: *
                  5: *   E L S E :
                  6: *
                  7: *        Handles direct execution of ELSE directive.  If DOLVL
                  8: *        is zero, then this is an error.  Otherwise, begin skipping
                  9: *        to FIN, w/ SKPLVL = 0.
                 10: *
                 11: *
                 12: *
                 13: *   E L S I F :
                 14: *
                 15: *        Handles direct execution of ELSEIF directive.  Just like
                 16: *        ELSE:, but needs different address
                 17: *
1734 01          18: ELSIF:   NOP
  1735           19: ELSE:    EQU      *
1735 7D009B      20:          TST      DOLVL
1738 270E        21:          BEQ      ELSE:1
173A 4F          22: ELSE:0   CLRA
173B 975F        23:          STAA     VAL               (Clear high-order byte of listing Val)
173D 979A        24:          STAA     SKPLVL            Start skipping.
173F 4A          25:          DECA                         Set A to -1,
1740 978E        26:          STAA     SKPFLG              sez:  skip to a FIN.
1742 969B        27:          LDAA     DOLVL             Display the nesting level on the listing:
1744 9760        28:          STAA     VAL+1               poke it into the low order byte,
1746 20A1        29:          BRA      IF:X                and hop to someone who JMPs to PUTV.
                 30: 
                 31: *
  1748           32: ELSE:1   ;JMP      NSTER             *E* ELSE W/O DO.
1748 7E087B      33:          JMP      NSTER
                 34:          FIN




ASM/6800 1.3H4: 1748 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 158; Form 30    - - - F I N - - -
ASM14A.MAIN.ASM
  0001            2:          DO       CONDASM=1
                  3: *
                  4: *
                  5: *  F I N :
                  6: *
                  7: *        Handles direct execution of FIN directive.  If DOLVL
                  8: *        is zero, then this is an error.  Otherwise, DOLVL is
                  9: *        decremented.
                 10: *
  174B           11: FIN:     EQU      *
174B 969B        12:          LDAA     DOLVL
174D 27F9        13:          BEQ      ELSE:1            B/ NESTING ERROR.
174F 4A          14:          DECA
1750 979B        15:          STAA     DOLVL
1752 39          16:          RTS
                 17:          FIN




ASM/6800 1.3H4: 1752 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 159; Form 31    - - - C A S E : - - -
ASM14A.MAIN.ASM
  0001            2:          DO       CONDASM=1
                  3: *
                  4: *
                  5: *   C A S E :
                  6: *
                  7: *        Handles direct execution of CASE directive.  If
                  8: *        value of AF(1) < 0, then skip to FIN;
                  9: *                       = 0, then inc DOLVL, continue execution.
                 10: *                       > 0, then skip to n-th ELSE
                 11: *
  1753           12: CASE:    EQU      *
                 13:          ;JSR      EVALCT
1753 BD1B3A      14:          JSR      EVALCT
                 15:          ;LDX      VAL
1756 DE5F        16:          LDX      VAL
1758 278F        17:          BEQ      IF:T
175A 8D8D        18:          BSR      IF:X              LIST VALUE,
                 19:          ;LDX      VAL
175C DE5F        20:          LDX      VAL
175E 2DDA        21:          BLT      ELSE:0            ENTER SKIP MODE.
                 22: *  ELSE SKIP TO N-TH
1760 9660        23:          LDAA     VAL+1
1762 2A05        24:          BPL      CASEOK
                 25:          ;JSR      ILLVAL            *E* ILLEGAL VALUE ON CASE:  TOO BIG
1764 BD088B      26:          JSR      ILLVAL
1767 20D1        27:          BRA      ELSE:0
1769 978E        28: CASEOK   STAA     SKPFLG
                 29:          ;CLR      SKPLVL
176B 7F009A      30:          CLR      SKPLVL
176E 39          31:          RTS
                 32:          FIN




ASM/6800 1.3H4: 176E ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 160; Form 32    - - - O P T  (HANDLES "WITH" COMMAND)  - - -
ASM14A.MAIN.ASM
                  2: *
                  3: * OPT:
                  4: *        ACCEPTS OPTIONS AND SETS THE CORRECT BITS/ VALUES.
                  5: *
                  6: *
                  7: * LEGAL OPTIONS: (SEE OPTTABLE BELOW)
                  8: *
                  9: *
  176F           10: OPT:     ;JSR     GNOBJ             GET THE OPTION
176F BD1E2C      11:          JSR      GNOBJ
                 12:          ;CMPA    #O:TERM           DONE?
1772 8106        13:          CMPA     #O:TERM
1774 2605        14:          BNE      CONT              IF NOT, EAT THIS OPT
                 15:          ;CMPB    #ASCII:COMMA      A COMMA?
1776 C12C        16:          CMPB     #ASCII:COMMA
1778 27F5        17:          BEQ      OPT:              IF SO, GET THE OPTION FOLLOWING
                 18: *
                 19: * A TERM SEEN - FINISH UP
                 20: *
177A 39          21:          RTS                        GO HOME
                 22: *
  177B           23: CONT     ;CMPA    #O:SYM            A SYMBOL?
177B 8101        24:          CMPA     #O:SYM
177D 2705        25:          BEQ      OSEARCH           OF SO, SEE IF IT IS A VALID OPTION
  177F           26: OPTERR   ;JSR     ILLAF             YELL
177F BD086B      27:          JSR      ILLAF
1782 20EB        28:          BRA      OPT:              TRY TO GET THE REST OF THE OPTIONS
                 29: *
  1784           30: OSEARCH  ;LDX     #OPTTABLE         GET ADDR OF OPTION TABLE
1784 CE17CF      31:          LDX      #OPTTABLE
                 32:          ;JSR     FSYM1             GO FIND OPTION
1787 BD20C9      33:          JSR      FSYM1
178A 26F3        34:          BNE      OPTERR            ERR IF NOT LEGAL OPTION
178C A604        35:          LDAA     S:TYPE,X          GET THE VALUE TO PASS
                 36:          ;LDX     S:VAL,X           GET THE ADDR OF THE HANDLING ROUTINE
178E EE02        37:          LDX      S:VAL,X
                 38:          ;JSR     0,X               GO DO WORK FOR OPTION
1790 AD00        39:          JSR      0,X
1792 20DB        40:          BRA      OPT:              TRY FOR NEXT OPT




ASM/6800 1.3H4: 1792 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 161; Form 32    - - - O P T  (HANDLES "WITH" COMMAND)  - - -
ASM14A.MAIN.ASM
                 42: *
                 43: * NUMSET - SCAN FOR =<EXP> AND SET THE PAGE ZERO LOC
                 44: *        WHOSE ADDR IS IN A TO THE VALUE OF THE EXPRESSION.
                 45: *        ERROR IF VALUE HAS UPPER 8 BITS # 0.
                 46: *          --OR--  IF VALUE IS << CONTENTS OF ACCB.
                 47: *
                 48: * WIDSET -- SETS ACCB TO 30 (THE MINIMUM WIDTH) AND GOES TO NUMSET.
                 49: *
1794 5F          50: DEPSET   CLRB
1795 8D0A        51:          BSR      NUMSET            Get Value setting
1797 2705        52:          BEQ      DEPRTS            B/Zero OK (means no pages setting)
1799 C60F        53:          LDAB     #MINDEP           Minimum depth
179B 11          54:          CBA                        Enough depth?
179C 252E        55:          BCS      NUMERR            B/No, we're not in over our heads
179E 39          56: DEPRTS   RTS
                 57: 
  179F           58: WIDSET   EQU      *                 COME HERE TO SET WIDTH....
179F C61E        59:          LDAB     #30               LOAD MINIMUM VALUE,
                 60: 
17A1 37          61: NUMSET   PSHB                       SAVE LOW LIMIT.
17A2 36          62:          PSHA                       SAVE ADDR TO POKE
                 63: *
                 64: * GET THE VALUE
                 65: *
                 66:          ;JSR     GNOBJ             GET THE NEXT OBJ
17A3 BD1E2C      67:          JSR      GNOBJ
  0001           68:          DO       CONDASM=1         IF RELATIONAL OPS
                 69:          ;CMPA    #O:OP             AN OP?
17A6 8107        70:          CMPA     #O:OP
17A8 2604        71:          BNE      OPTVF             IF NOT, NO VALUE SPECD
                 72:          ;CMPB    #OP:EQ            EQUALS?
17AA C135        73:          CMPB     #OP:EQ
17AC 2706        74:          BEQ      OPTV2             IF SO, GET THE <EXP> FOLLOWING
  0001           75:          ELSE
 *S*             76:          ;CMPA    #O:UNKN           UNKNOWN?
 *S*             77:          CMPA     #O:UNKN
 *S*             78:          BNE      OPTVF             IF NOT, NO EQUALS - NO <EXP>
 *S*             79:          ;CMPB    #'=               WELL?
 *S*             80:          CMPB     #'=
 *S*             81:          BEQ      OPTV2             IF SEEN = GO SCAN <EXP>




ASM/6800 1.3H4: 17AC ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 162; Form 32    - - - O P T  (HANDLES "WITH" COMMAND)  - - -
ASM14A.MAIN.ASM
                 82:          FIN
  17AE           83: OPTVF    ;INC     RJOBJ             I DIDN'T SEE THAT!
17AE 7C005C      84:          INC      RJOBJ
                 85:          ;LEAS    2,S               BALANCE YE STACK...
  0000           86:          IF       2<0
 *S*             87:          RPT      -2
 *S*             88:          DES
                 89:          ELSE
  0002           90:          RPT      2
17B1 31          91:          INS
                 92:          FIN
17B3 39          93:          RTS
                 94: *
