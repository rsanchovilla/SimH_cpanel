  08F6           29: DOIT     EQU      *
  0001           30:          DO       CONDASM=1         FOR CONDITIONAL ASSEMBLY...
08F6 968E        31:          LDAA     SKPFLG            ;ARE WE SKIPPING MULTIPLE LINES?
08F8 2637        32:          BNE      DOSKP             ;B/ YES ==> HANDLE SKIP.
                 33:          FIN
                 34: *
  0001           35:          DO       REPEAT=1
                 36:          ;LDX     RPTF              ;IS THIS A NORMAL LINE?
08FA DEA1        37:          LDX      RPTF
08FC 271B        38:          BEQ      DOSKR             B/ NO ==> RPT 0 WAS DONE ON ME.
08FE 2B16        39:          BMI      DONORM            B/ YES; PERFORM ONE TIME.
                 40: *  REPEAT N TIMES.
0900 8D35        41:          BSR      CDOSKP            CK/ CAN THIS LINE BE RPT'D?
0902 2815        42:          BVC      DOSKR               B/ NO.  WANDER AROUND AND YELL ... EVENTUALLY.
0904 8D10        43: DOMANY   BSR      DONORM            ;EXECUTE THE LINE,
                 44:          ;LDX      RPTF              ;DECREMENT THE COUNTER.
0906 DEA1        45:          LDX      RPTF
0908 09          46:          DEX
0909 DFA1        47:          STX      RPTF
090B 2EF7        48:          BGT      DOMANY            ;B/ DO IT AGAIN, SAM.
                 49:          ;LDX     #-1
090D CEFFFF      50:          LDX      #-1
0910 DFA1        51:          STX      RPTF              ;SET RPTF := -1
0912 39          52:          RTS
                 53:          FIN
                 54: *
                 55: *  NORMAL PERFORM.
  0001           56:          IF       REPEAT=1
  0913           57: DORPTER  ;JSR     NSTER             ==>SPOT THE TWIT<==
0913 BD087B      58:          JSR      NSTER
                 59:          FIN
  0916           60: DONORM   ;JMP      DOITL             ;GO DO THE GOOD THING.
0916 7E09E6      61:          JMP      DOITL
                 62: *                                   (AND DON'T COME BACK)




