ASM14A.IOFM.ASM
2D2D 6F01        82:          CLR      1,X
                 83:          ;STD     [LAST]            DELETE SYMBOL FROM HEAD OF BUCKET
2D2F DE4A        84:          LDX      LAST
2D31 E701        85:          STAB     1,X
2D33 A700        86:          STAA     0,X
                 87:          ;LDX     SORTAIL           HANG THIS SYMBOL ON TAIL OF SORTCHAIN
2D35 DE50        88:          LDX      SORTAIL
                 89:          ;LDD     THIS
2D37 D64D        90:          LDAB     THIS+1
2D39 964C        91:          LDAA     THIS
                 92:          ;STD     S:NEXT,X
2D3B E701        93:          STAB     (S:NEXT)+1,X
