                  3: *
                  4: *
                  5: *   F F C :
                  6: *
                  7: *        HANDLES FFC COMMAND 
                  8: *
                  9: *
0FF3 4F          10: FFC:     CLRA                       Set max
0FF4 C6FF        11:          LDAB     #$FF               char to scan
                 12:          ;LDX     AFPTR             Point to AF
0FF6 DE26        13:          LDX      AFPTR
                 14:          ;JSR     FCONVI            Go form floating value
0FF8 BD10AC      15:          JSR      FCONVI
0FFB 39          16:          RTS                        Normal exit, return to directive handler
0FFC 01          17:          NOP                        Filler, RTS takes on 1 byte
0FFD 2003        18:          BRA      FCONVOVERFLOW     Overflow exit
                 19:          ;JMP     SYNTAX            Syntax error exit
0FFF 7E0867      20:          JMP      SYNTAX
                 21: 
  1002           22: FCONVOVERFLOW
                 23:          ;JMP     OVRFLW            Flag overflow error
1002 7E0883      24:          JMP      OVRFLW
                 25: 
                  0:          INCLUDE ASM14A.FCONV.ASM
1005 0002         1: BUFERP   RMB      2                 Pointer to text buffer
1007 0001         2: DIGCNT   RMB      1                 HOLDS SIG DIGIT COUNT FOR FCONVI
1008 0001         3: DIGFLG   RMB      1                 DIGIT FLAG FOR FCONVI
                  4: *
  000A            5: DIGMAX   EQU      10                Max number fo digits allowed
1009 0001         6: ML       RMB      1                 Multiplier digit for FMUL, FDIV
                  7: *
100A 0001         8: MSIGN    RMB      1                 Holds sign of result
100B 0001         9: MEXP     RMB      1                 Holds exp, must preceed FAC
100C 0001        10: FAC1     RMB      1                 FAC, Floating accumulator
100D 0001        11: FAC2     RMB      1
100E 0001        12: FAC3     RMB      1
100F 0001        13: FAC4     RMB      1
1010 0001        14: FAC5     RMB      1
1011 0001        15: FAC6     RMB      1
1012 0006        16: FACEXT1  RMB      6                 FAC Extention




