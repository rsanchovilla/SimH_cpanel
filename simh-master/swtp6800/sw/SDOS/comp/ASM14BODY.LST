1D21 208A        10:          BRA      OPFNSH1
                 11: *
                 12: * A/B
1D23 8D1E        13: XDIV     BSR      DODIV             COPY ARGS, CALL DIVIDE.
1D25 20F5        14:          BRA      XMUL1             AND GO RETURN RESULT...
                 15: *
                 16: * A//B  COVERED QUOTIENT
1D27 8D1A        17: XCQU     BSR      DODIV
1D29 9631        18:          LDAA     MLC+1
1D2B D630        19:          LDAB     MLC               GET QUOTIENT...
