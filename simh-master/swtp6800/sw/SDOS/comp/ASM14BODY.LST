ASM14A.MAIN.ASM
                 42:          ;EORA    #-1               COMPLEMENT IT,
13DE 88FF        43:          EORA     #-1
13E0 94A0        44:          ANDA     LIST:P            AND SCRUP THAT BIT IN LIST FLAGE.
                 45:          ;LDX     VAL               TEST CONTROL VALUE...
13E2 DE5F        46:          LDX      VAL
13E4 2F01        47:          BLE      LIST:2              B/ TURN BIT OFF.
13E6 1B          48:          ABA                          ELSE MERGE BIT IN.
13E7 97A0        49: LIST:2   STAA     LIST:P            SHOVE FLAGS BACK,
13E9 2037        50:          BRA      ORG2              AND PUT THE VALUE IN DISPLAY.
  13EB           51: LIST:ILV ;JSR     ILLVAL            REPORT BAD VALUE,
13EB BD088B      52:          JSR      ILLVAL
13EE 2032        53:          BRA      ORG2              AND PUT THE VALUE.
  13F0           54: PCC:     EQU      *
13F0 C604        55:          LDAB     #LL:PCC           GET OPTION
13F2 20DB        56:          BRA      LIST:1
  13F4           57: PSR:     EQU      *
13F4 C610        58:          LDAB     #LL:SKP           GET OPTION
13F6 20D7        59:          BRA      LIST:1
  13F8           60: PCA:     EQU      *
13F8 C640        61:          LDAB     #LL:PCA           GET OPTION
13FA 20D3        62:          BRA      LIST:1
  13FC           63: PGEN:    EQU      *
13FC C602        64:          LDAB     #LL:GEN           GET OPTION
13FE 20CF        65:          BRA      LIST:1
                 66:          FIN




ASM/6800 1.3H4: 13FE ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 123; Form 17    - - - R P T - - -
ASM14A.MAIN.ASM
  0001            2:          IF       REPEAT=1
                  3: *
                  4: *
                  5: * RPT:
                  6: *        HANDLES RPT PSUEDO-OP.  IF RPTF IS NON-ZERO WHEN CALLED, THEN NSTERR IS 
                  7: *        CALLED, AND THE RPT IS NOT PERFORMED.  RPTF IS SET TO +1 IN THIS CASE, FORCI
                  8: *        THE RPT TO BE ABORTED.  IF RPTF IS NEGATIVE, THEN AF IS EVALUATED, AND
                  9: *        IF IT IS OK, THEN RPTF IS SET TO THE VALUE.  IF <VAL> IS NEG, THEN RPTF IS S
                 10: *        TO ZERO.  
                 11: *
  1400           12: RPT:     EQU      *
                 13:          ;JSR     EVALCT            EVALUATE AS CONTROL VALUE,
1400 BD1B3A      14:          JSR      EVALCT
1403 2604        15:          BNE      RPT:0               B/ NO GOOD; SKIP NEXT.
                 16:          
                 17:          ;LDX     VAL               VAL IS GOOD; STUFF IT AWAY.
1405 DE5F        18:          LDX      VAL
1407 2C03        19:          BGE      RPT:1               B/ IF NEG, THEN VAL=0.
  1409           20: RPT:0    ;LDX     #0                FORCE RPTF TO ZERO,
1409 CE0000      21:          LDX      #0
140C DFA1        22: RPT:1    STX      RPTF              SAVE RPTF,
140E 2012        23:          BRA      ORG2              AND PUT VALUE.
                 24:          FIN




ASM/6800 1.3H4: 140E ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 124; Form 18    - - - O R G - - -
ASM14A.MAIN.ASM
                  2: *
                  3: *
                  4: *   O R G :
                  5: *
                  6: *        HANDLES ORG COMMAND.  AF MAY NOT BE A FORWARD REF;
                  7: *        LF IS EQUATED TO NEW PC.
                  8: *
                  9: *
  1410           10: ORG:     EQU      *
                 11:          ;JSR      EVALCT            GET NEW PC
1410 BD1B3A      12:          JSR      EVALCT
                 13: *        JSR      ISCTR             IS IT A CONTROL VALUE?
                 14: *                                   THE ABOVE MAKES SURE.
1413 2607        15:          BNE      ORG1              B/ NO GOOD.  DONT GO ANYWHERE
                 16:          ;JSR     ECKEOF            MAKE SURE THERE'S NO EXTRA SYNTAX
1415 BD1E15      17:          JSR      ECKEOF
                 18:          ;LDX      VAL               ELSE SET NEW PC,
1418 DE5F        19:          LDX      VAL
141A DF96        20:          STX      PC
  141C           21: ORG1     ;JSR      LFPC              (I KNOW, I COULD GO TO
141C BD21DB      22:          JSR      LFPC
                 23: *                                   LFEQU, SINCE VAL=PC, BUT
                 24: *                                   THAT WOULD UNDULY SCREW THE
                 25: *                                   SLOB WHO BLEW THE VALUE.
                 26:          ;JSR      PNCHIT            PUNCH THE BUFFER,
141F BD2760      27:          JSR      PNCHIT
  1422           28: ORG2     ;JMP      PUTV              AND OUTPUT THE VALUE.
1422 7E2717      29:          JMP      PUTV




ASM/6800 1.3H4: 1422 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
