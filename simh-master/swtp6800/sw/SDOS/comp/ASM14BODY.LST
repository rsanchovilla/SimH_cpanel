ASM14A.MAIN.ASM
                  2: ******************************************************************************
                  3: *
                  4: *  INCLUDE:
                  5: *
                  6: *        PROCESSES THE INCLUDE COMMAND.  SYNTAX IS:
                  7: *
                  8: *                 INCLUDE   <FILENAME>
                  9: *
                 10: *        WHERE <FILENAME> MUST BE BOTH A VALID FILENAME *AND* A VALID ASSEMBLER
                 11: *        SYMBOL.  IF YOU HAVE AN INCLUDE FILE THAT WANTS TO BEGIN W/ A $,
                 12: *        ENTER:
                 13: *
                 14: *                 INCLUDE   DISK:$WHATEVERITIS
                 15: *
                 16: ******************************************************************************
                 17: 
  1574           18: INCLUDE: EQU      *
                 19:          ;LDX     RPTF              FIRST, VERIFY THAT WE'RE NOT BEING RPT'D.
1574 DEA1        20:          LDX      RPTF
1576 2F0A        21:          BLE      INCLUDE1            B/ NO PROBLEM.
1578 09          22:          DEX                        IF > 0, RPTF MUST BE 1.
1579 2707        23:          BEQ      INCLUDE1            B/ THAT'S WHAT IT IS.
                 24: 
                 25: **** ERROR:  ATTEMPT TO RPT AN INCLUDE ****
                 26:          ;LDX     #-1               FORCE RPTF TO (OFF).
157B CEFFFF      27:          LDX      #-1
157E DFA1        28:          STX      RPTF                ....
1580 8D1B        29:          BSR      INCLUDE:NSTER       ALSO, REPORT NESTING ERROR.
                 30: 
                 31: **** VALIDATE SYNTAX OF COMMAND & GET FILENAME IN SYM:BLK ****
  1582           32: INCLUDE1 EQU      *
                 33:          ;JSR     GNOBJ             GET FIRST OBJECT OF AF.
1582 BD1E2C      34:          JSR      GNOBJ
                 35:          ;CMPA    #O:SYM              IS IT A SYMBOL?
1585 8101        36:          CMPA     #O:SYM
1587 2605        37:          BNE      INCLUDE2            B/ NO: REPORT AN ERROR & ABORT.
                 38:          ;JSR     CKEOF             CHECK NEXT OBJECT; BETTER BE TERMINATOR.
1589 BD1E06      39:          JSR      CKEOF
158C 2703        40:          BEQ      INCLUDE3            B/ SURE 'NUFF.  SYNTAX IS GOOD.




ASM/6800 1.3H4: 158C ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 138; Form 25    - - - I N C L U D E : - - -
ASM14A.MAIN.ASM
                 42: 
  158E           43: INCLUDE2 EQU      *
                 44:          ;JMP     SYNTAX            BAD COMMAND SYNTAX:  GET OUT OF HERE!
158E 7E0867      45:          JMP      SYNTAX
                 46: 
                 47: **** CHECK THAT NEITHER (1) THE NESTING LEVEL, NOR (2) THE INCLUDE COUNTER
                 48: **** WOULD BE OVERFLOWED BY THIS INCLUDE.  IF SO, QUIT NOW W/ "NESTING ERR".
  1591           49: INCLUDE3 EQU      *
1591 969C        50:          LDAA     INCLVL            INCLUDE FILE NESTING COUNTER KEEPS
                 51:          ;CMPA    #MAXINCLVL          US FROM LOOPING FOREVER ON RECURSIVE INCLUDES.
1593 8114        52:          CMPA     #MAXINCLVL
1595 2406        53:          BCC      INCLUDE:NSTER       B/ WOW! WE ARE REALLY UP TO OUR NECKS.
1597 969D        54:          LDAA     INCLNUM           ALSO, CHECK THE INCLUDE FILE NUMBER, AS
                 55:          ;CMPA    #MAXINCLNUM         THIS NUMBER IS IMPORTANT FOR PASS SYNCH.
1599 81FE        56:          CMPA     #MAXINCLNUM
159B 2503        57:          BCS      INCLUDE4            B/ SMALL ENOUGH; WE CAN DO IT.
                 58: 
  159D           59: INCLUDE:NSTER EQU *
                 60:          ;JMP     NSTER             SOME INCLUDE NESTING LIMIT EXCEEDED.
159D 7E087B      61:          JMP      NSTER
                 62: 
                 63: **** GET POINTER TO AN INCBL (INCLUDE-BLOCK) THAT WILL BE FOR THIS STMT ****
  15A0           64: INCLUDE4 EQU      *
                 65:          ;LDX     #SYM:BLK+S:TEXT   LOAD ADDRESS OF BEGINNING OF NAME.
15A0 CE0063      66:          LDX      #SYM:BLK+S:TEXT
15A3 D662        67:          LDAB     SYM:BLK+S:LEN       LOAD LENGTH OF NAME.
                 68:          ;JSR     MAKEINCLB           MAKE OR FIND THE APPROPRIATE BLOCK.
15A5 BD15FE      69:          JSR      MAKEINCLB
15A8 DF38        70:          STX      SYMPT               SAVE POINTER IN SYMPT, TEMPORARILY;
15AA 2744        71:          BEQ      INCLUDE%            B/ IT'S NIL:  NO ROOM, CAN'T DO INCLUDE.
                 72: 
                 73: **** SAVE CURRENT INPUT FILE'S STATUS IN CURRENT INCLB ****
                 74:          ;JSR     INCLSAVE
15AC BD166A      75:          JSR      INCLSAVE
                 76: 
                 77: **** MAKE NEW BLOCK POINT TO BLOCK HOLDING STATUS ****
15AF 96A7        78:          LDAA     .CURINCLB         ...BY STORING A POINTER
15B1 D6A8        79:          LDAB     .CURINCLB+1         IN THE APPROPRIATE PLACE.
                 80:          ;LDX     SYMPT             LOAD POINTER;
15B3 DE38        81:          LDX      SYMPT




ASM/6800 1.3H4: 15B5 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 139; Form 25    - - - I N C L U D E : - - -
ASM14A.MAIN.ASM
15B5 A704        82:          STAA     INCLB:PREVB,X       SAVE HIGH BYTE;
15B7 E705        83:          STAB     INCLB:PREVB+1,X     LOW BYTE.
                 84: 
                 85: **** TRANSFER CONTROL TO THE NEW INCLB ****
                 86:          ;JSR     INCLCOPYOUT       COPY OUT THE STATUS & SET .CURINCLB
15B9 BD16B7      87:          JSR      INCLCOPYOUT




ASM/6800 1.3H4: 15B9 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 140; Form 25    - - - I N C L U D E : - - -
ASM14A.MAIN.ASM
                 89: **** OPEN THE FILE SPECIFIED IN .CURINCLB ****
  15BC           90: OPENCURINCLB EQU  *
15BC C601        91:          LDAB     #SI               START BY CLOSING THE SOURCE CHANNEL.
                 92:          ;JSR     CLOSE$
15BE BD010B      93:          JSR      CLOSE$
                 94:          ;LDX     #INCLNOTFOUND     SETUP FOR ERROR ON OPEN
15C1 CE1687      95:          LDX      #INCLNOTFOUND
15C4 DFAA        96:          STX      IOERRLOC
15C6 9F2A        97:          STS      FLAMOUT
                 98:          ;LDX     .CURINCLB         NOW; LOAD LENGTH OF NAME (USING PTR)
15C8 DEA7        99:          LDX      .CURINCLB
15CA A60F       100:          LDAA     INCLB:LEN,X         INTO ACCA.
                101:          ;JSR     INCLB@NAME        LOAD ADDRESS OF TEXT FIELD INTO X.
15CC BD15DD     102:          JSR      INCLB@NAME
15CF C601       103:          LDAB     #SI               LOAD CHANNEL NUMBER;
                104:          ;JSR     OPEN$               AND OPEN THE CHANNEL.
15D1 BD0108     105:          JSR      OPEN$
  15D4          106: INCLERRESET
                107:          ;LDX     #CRAPOUT$         Reset I/O package error vector
15D4 CE0142     108:          LDX      #CRAPOUT$
15D7 DFAA       109:          STX      IOERRLOC
                110: **** LIST THE LINE, NOW *****
                111:          ;JSR     LIST
15D9 BD220D     112:          JSR      LIST
15DC 39         113:          RTS




ASM/6800 1.3H4: 15DC ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 141; Form 25    - - - C O M P U T E   . C U R I N C L   A D D R S - - -
ASM14A.MAIN.ASM
                115: ******************************************************************************
                116: *
                117: * NAME:  INCL@NAME()
                118: *
                119: * FUNCTION:
                120: *        SETS X TO (.CURINCL)+INCLB:TEXT
                121: *
                122: *
                123: * NAME:  AB.CURINCL(B: BYTE.OFFSET)
                124: *
                125: * FUNCTION:
                126: *        SETS X TO (.CURINCL)+(B)
                127: *
                128: *
                129: * NAME:  TABX(AB: WORD)             RETURNS X: WORD
                130: *
                131: * FUNCTION:
                132: *        SETS X TO (AB).
                133: *
                134: ******************************************************************************
                135: 
                136: 
                137: **** LOAD (.CURINCLB)+#INCLB:TEXT INTO X ****
  15DD          138: INCLB@NAME EQU    *
15DD C610       139:          LDAB     #INCLB:TEXT
                140: 
                141: **** LOAD (.CURINCLB)+(B) INTO X.  PRESERVES A ****
  15DF          142: AB.CURINCLB EQU   *
15DF DBA8       143:          ADDB     .CURINCLB+1       COMPUTE LOW ORDER BYTE,
15E1 37         144:          PSHB                         SAVE,
15E2 C600       145:          LDAB     #0                COMPUTE HIGH ORDER BYTE,
15E4 D9A7       146:          ADCB     .CURINCLB           LIKE THIS;
15E6 37         147:          PSHB                         SAVE.
15E7 2002       148:          BRA      TABXX
                149: 




ASM/6800 1.3H4: 15E7 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 142; Form 25    - - - C O M P U T E   . C U R I N C L   A D D R S - - -
ASM14A.MAIN.ASM
                151: **** TRANSFER AB TO X ****
  15E9          152: TABX     EQU      *
15E9 37         153:          PSHB
15EA 36         154:          PSHA
  15EB          155: TABXX    ;PULX
15EB 30         156:          TSX
15EC EE00       157:          LDX      0,X
15EE 31         158:          INS
15EF 31         159:          INS
15F0 39         160: INCLUDE% RTS




ASM/6800 1.3H4: 15F0 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 143; Form 25    - - - M A K E I N C L B L O C K - - -
ASM14A.MAIN.ASM
                162: ******************************************************************************
                163: *
                164: * NAME:  MAKEINCLB                       TPTR points to NAME, B=NAME size
                165: *
                166: * FUNCTION:
                167: *        RETURNS A POINTER TO AN INCLB THAT CONTAINS THIS INCLUDE FILE'S
                168: *        NAME.  THIS INCLB IS ALSO PROPERLY INITIALIZED.  INCLVL & INCLNUM
                169: *        ARE BOTH INCREMENTED.
                170: *
                171: ******************************************************************************
                172: 
  15F1          173: MAKEINCLBABORT    EQU               *
                174:          ;DEC     INCLNUM           BACKUP COUNTERS
15F1 7A009D     175:          DEC      INCLNUM
                176:          ;DEC     INCLVL
15F4 7A009C     177:          DEC      INCLVL
                178:          ;LDX     #0                AND FLAG NO SPACE
15F7 CE0000     179:          LDX      #0
15FA 39         180:          RTS
                181: 
  15FB          182: INCLRLNMS1 ;JMP   INCLRLNMS
15FB 7E16A4     183:          JMP      INCLRLNMS
                184: 
  15FE          185: MAKEINCLB EQU     *
                186:          ;INC     INCLNUM           ONE MORE INCLUDE FILE FOR THE ROAD....
15FE 7C009D     187:          INC      INCLNUM
                188:          ;INC     INCLVL              ONE LEVEL DEEPER IN SHIT.
1601 7C009C     189:          INC      INCLVL
                190:          ;JSR     FINDINCLB         TRY TO FIND A BLOCK BUILT LAST PASS....
1604 BD1653     191:          JSR      FINDINCLB
1607 26F2       192:          BNE      INCLRLNMS1          B/ YUPPERS.  CLEAR OUT ITS LNUMS &
                193: *                                     PREPARE IT FOR REUSE.
                194: 
                195: **** NEED TO CREATE AN INCLUDE-BLOCK ****
1609 DF34       196:          STX      TPTR              SAVE NAME POINTER.
160B CB10       197:          ADDB     #INCLB:SIZE:        ADD IN OVERHEAD FOR HAPPY ASSEMBLERS.
160D 37         198:          PSHB                         SAVE FOR HAPPY TERRY.
                199:          ;JSR     GTBLK             GET (B) BYTES OF MEMORY.
160E BD20A6     200:          JSR      GTBLK
1611 33         201:          PULB                         RESTORE: IT'S HAPPY HOUR.




ASM/6800 1.3H4: 1612 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 144; Form 25    - - - M A K E I N C L B L O C K - - -
ASM14A.MAIN.ASM
1612 27DD       202:          BEQ      MAKEINCLBABORT      B/ NO MEMORY -- RETURN NULL POINTER.
                203: 
                204: **** NOW HAVE MEMORY.  STPTR POINTS TO FIRST BYTE (AS DOES X) ****
1614 8610       205:          LDAA     #INCLB:SIZE:      INITIALIZE COUNTER.
  1616          206: MAKEINCLB1 EQU    *                 LOOP POINT:
                207:          ;CLR     0,X                 ZERO THE BLOCK.
1616 6F00       208:          CLR      0,X
1618 08         209:          INX
1619 4A         210:          DECA
161A 26FA       211:          BNE      MAKEINCLB1          B/ NOT DONE YET.
                212: 
                213: **** NOW, COPY FILENAME TO BLOCK ****
161C C010       214:          SUBB     #INCLB:SIZE:      TAKE OUT OVERHEAD BYTES;
                215:          ;LDX     STPTR             GET POINTER TO INCLB
161E DEAC       216:          LDX      STPTR
1620 E70F       217:          STAB     INCLB:LEN,X         AND SAVE COUNT.
                218: 
  1622          219: MAKEINCLB2 EQU    *
1622 DF36       220:          STX      TPTR1             SAVE DEST. POINTER.
                221:          ;LDX     TPTR              LOAD SOURCE POINTER;
1624 DE34       222:          LDX      TPTR
1626 A600       223:          LDAA     0,X                 LOAD NEXT CHARACTER.
1628 08         224:          INX                          BUMP POINTER.
1629 DF34       225:          STX      TPTR                SAVE POINTER.
                226:          ;LDX     TPTR1             LOAD DEST. POINTER;
162B DE36       227:          LDX      TPTR1
162D A710       228:          STAA     INCLB:TEXT,X        SAVE NEXT CHARACTER.
162F 08         229:          INX                          BUMP POINTER.
1630 5A         230:          DECB                       DECREMENT COUNT;
1631 26EF       231:          BNE      MAKEINCLB2          B/ NOT DONE YET: LOOP.
                232: 
                233: **** SET UP A CUPPLE OTHER HANDY THINGS ****
                234:          ;LDX     STPTR             GET POINTER TO BASE OF INCLB
1633 DEAC       235:          LDX      STPTR
1635 969D       236:          LDAA     INCLNUM             AND POKE IN THE INCLUDE FILE NUMBER.
1637 A70E       237:          STAA     INCLB:NUM,X            ....
                238: 
                239: **** LINK INTO MASTER INCLBLK CHAIN ****
                240:          ;LDX     INCLTAIL          GET POINTER TO LAST;
1639 DEA5       241:          LDX      INCLTAIL




ASM/6800 1.3H4: 163B ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 145; Form 25    - - - M A K E I N C L B L O C K - - -
ASM14A.MAIN.ASM
163B 2607       242:          BNE      MAKEINCLB3          B/ CHAIN ISN'T EMPTY.
                243:          ;LDX     STPTR             ELSE, INITIALIZE TAIL POINTER/HEAD POINTER.
163D DEAC       244:          LDX      STPTR
163F DFA5       245:          STX      INCLTAIL               ....
1641 DFA3       246:          STX      INCLHEAD               ....
1643 39         247: MAKEINCLB% RTS
                248: 
  1644          249: MAKEINCLB3 EQU    *                 LINK INTO NON-NUL CHAIN.
1644 96AC       250:          LDAA     STPTR             GET @/ NEW LAST BLOCK;
1646 D6AD       251:          LDAB     STPTR+1                ....
1648 A700       252:          STAA     INCLB:NEXT,X      AND MAKE FLINK(TAIL):=@NEWBLOCK.
164A E701       253:          STAB     INCLB:NEXT+1,X         ....
164C 97A5       254:          STAA     INCLTAIL          UPDATE TAIL POINTER;
164E D7A6       255:          STAB     INCLTAIL+1             ....
                256:          ;LDX     INCLTAIL          LOAD NEW POINTER (ALWAYS <> 0).
1650 DEA5       257:          LDX      INCLTAIL
1652 39         258:          RTS




ASM/6800 1.3H4: 1652 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 146; Form 25    - - - F I N D I N C L B - - -
ASM14A.MAIN.ASM
                260: ******************************************************************************
                261: *
                262: * NAME:  FINDINCLB
                263: *
                264: * FUNCTION:
                265: *        GIVEN A FILENAME @[0,X], A LENGTH IN B AND THE CURRENT INCLUDE
                266: *        FILE NUMBER FOR THIS PASS, ATTEMPTS TO FIND A CORRESPONDING
                267: *        INCLB.  IF FAILURE, RETURNS ZERO IN X.
                268: *
                269: ******************************************************************************
                270: 
  1653          271: FINDINCLB EQU     *
1653 DF34       272:          STX      TPTR              (SAVE ADDRESS)
1655 969D       273:          LDAA     INCLNUM           LOAD CURRENT INCLUDE-FILE NUMBER.
                274:          ;LDX     INCLHEAD          GET HEAD OF INCLUDEBLOCK CHAIN.
1657 DEA3       275:          LDX      INCLHEAD
1659 2708       276:          BEQ      FINDINCLB%          B/ NO COULD FINDEM.
                277: 
                278: **** LOOP THROUGH CHAIN UNTIL WE FIND A FILE NUMBER THAT MATCHES ****
  165B          279: FINDINCLB1 EQU    *
                280:          ;CMPA    INCLB:NUM,X       DOES THIS MATCH?
165B A10E       281:          CMPA     INCLB:NUM,X
165D 2708       282:          BEQ      FINDINCLB2          B/ YES!!
                283:          ;LDX     INCLB:NEXT,X      NO: TRY NEXT.
165F EE00       284:          LDX      INCLB:NEXT,X
1661 26F8       285:          BNE      FINDINCLB1          B/ THERE'S ANOTHER TO CHECK.
  1663          286: FINDINCLB% EQU    *
                287:          ;LDX     TPTR              RESTORE POINTER;
1663 DE34       288:          LDX      TPTR
1665 4F         289:          CLRA                         INDICATE FAILURE.
1666 39         290:          RTS
                291: 
                292: **** FOUND A MATCH ****
  1667          293: FINDINCLB2 EQU    *
1667 8601       294:          LDAA     #1                SET NOT-ZERO,
1669 39         295:          RTS                          AND RETURN OUR POINTER.




ASM/6800 1.3H4: 1669 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 147; Form 25    - - - I N C L S A V E - - -
ASM14A.MAIN.ASM
                297: ******************************************************************************
                298: *
                299: * NAME:  INCLSAVE
                300: *
                301: * FUNCTION:
                302: *        SAVE STATUS OF CURRENT SI FILE IN CURRENT INCLUDE BLOCK FOR
                303: *        LATER RECOVERY.
                304: *
                305: ******************************************************************************
                306: 
  166A          307: INCLSAVE EQU      *
166A C60A       308:          LDAB     #INCLB:FPOS       CONSTRUCT POINTER TO FPOS BUFFER;
                309:          ;JSR     AB.CURINCLB         WILL COME BACK IN X.
166C BD15DF     310:          JSR      AB.CURINCLB
166F C601       311:          LDAB     #SI               READ POSITION OF SI CHANNEL.
                312:          ;JSR     GETPOS$             ....
1671 BD0111     313:          JSR      GETPOS$
                314: 
                315: **** COPY LINE NUMBER/FORM NUMBER ****
                316:          ;LDX     .CURINCLB         GET POINTER TO INCLB;
1674 DEA7       317:          LDX      .CURINCLB
1676 968F       318:          LDAA     FPGE              COPY FORM #.
1678 D690       319:          LDAB     FPGE+1                 ....
167A A706       320:          STAA     INCLB:FPGE,X           ....
167C E707       321:          STAB     INCLB:FPGE+1,X         ....
167E 9691       322:          LDAA     LINEN             COPY LINE #.
1680 D692       323:          LDAB     LINEN+1                ....
1682 A708       324:          STAA     INCLB:LINEN,X          ....
1684 E709       325:          STAB     INCLB:LINEN+1,X        ....
1686 39         326:          RTS




ASM/6800 1.3H4: 1686 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 148; Form 25    - - - P O P I N C L - - -
ASM14A.MAIN.ASM
                328: ******************************************************************************
                329: *
                330: * NAME:  POPINCL()
                331: *
                332: * FUNCTION:
                333: *        FINISHES PROCESSING CURRENT INCLUDE FILE, AND RESTORES INCLUDE
                334: *        FILE FROM LOWER LEVEL.  YUP, IT REPOSITIONS AND EVERYTHING.
                335: *
                336: ******************************************************************************
                337: 
  1687          338: INCLNOTFOUND      EQU               *
                339:          ;JSR     FILNOTF
1687 BD08A7     340:          JSR      FILNOTF
                341:          ;JSR     INCLERRESET       Reset I/O error vector
168A BD15D4     342:          JSR      INCLERRESET
                343: 
  168D          344: POPINCL  EQU      *
                345:          ;DEC     INCLVL            BACK UP BY ONE;
168D 7A009C     346:          DEC      INCLVL
                347:          ;LDX     .CURINCLB         LOAD CURRENT INCLB;
1690 DEA7       348:          LDX      .CURINCLB
                349:          ;LDX     INCLB:PREVB,X       FETCH POINTER TO WHOEVER CALLED IT;
1692 EE04       350:          LDX      INCLB:PREVB,X
                351:          ;JSR     INCLCOPYOUT         RESTORE THAT GUY AS CURRENT INCLUDE.
1694 BD16B7     352:          JSR      INCLCOPYOUT
                353: 
                354: **** CLOSE PREVIOUS AND OPEN CURRENT ****
                355:          ;JSR     OPENCURINCLB      THAT DOES THE OPEN.
1697 BD15BC     356:          JSR      OPENCURINCLB
                357: 
                358: **** RESET THE POSITION ****
169A C60A       359:          LDAB     #INCLB:FPOS       GET @/ SAVED POSITION;
                360:          ;JSR     AB.CURINCLB         (IN X);
169C BD15DF     361:          JSR      AB.CURINCLB
169F C601       362:          LDAB     #SI               SET CHANNEL NUMBER;
                363:          ;JMP     POSITION$           SET POSITION & SPLIT.
16A1 7E0126     364:          JMP      POSITION$




ASM/6800 1.3H4: 16A1 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 149; Form 25    - - - I N C L R N M S - - -
ASM14A.MAIN.ASM
                366: ******************************************************************************
                367: *
                368: * NAME:  INCLRNMS
                369: *
                370: * FUNCTION:
                371: *        CLEARS THE FPGE/LINEN FIELDS OF THE INCLB WHOSE ADDRESS IS PASSED
                372: *        IN X.
                373: *
                374: * CHANGES:                          PRESERVES:
                375: *        C                               A B X
                376: *
                377: ******************************************************************************
                378: 
  16A4          379: INCLRLNMS EQU     *
                380:          ;CLR     INCLB:FPGE,X
16A4 6F06       381:          CLR      INCLB:FPGE,X
                382:          ;CLR     INCLB:FPGE+1,X
16A6 6F07       383:          CLR      INCLB:FPGE+1,X
                384:          ;INC     INCLB:FPGE+1,X    (SET FPGE TO 1)
16A8 6C07       385:          INC      INCLB:FPGE+1,X
                386:          ;CLR     INCLB:LINEN,X
16AA 6F08       387:          CLR      INCLB:LINEN,X
                388:          ;CLR     INCLB:LINEN+1,X
16AC 6F09       389:          CLR      INCLB:LINEN+1,X
16AE 39         390:          RTS




ASM/6800 1.3H4: 16AE ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 150; Form 25    - - - I N C L W A T C H O U T - - -
ASM14A.MAIN.ASM
                392: ******************************************************************************
                393: *
                394: * NAME:  INCLWATCHOUT()
                395: *
                396: * FUNCTION:
                397: *        USED AS A GATE MONSTER ON ROUTINES THAT SHOULD NOT BE EXECUTED
                398: *        UNLESS WE ARE DEALING WITH LEVEL 0 OF INCLUDES.
                399: *
                400: ******************************************************************************
                401: 
  16AF          402: INCLWATCHOUT EQU  *
16AF 7D009C     403:          TST      INCLVL            ARE WE AT LEVEL 0?
16B2 2702       404:          BEQ      INCLWATCHOUT%       B/ YES.  RETURN TO CALLER.
                405:          ;LEAS    2,S               ELSE POP RETURN ADDRESS;
  0000          406:          IF       2<0
 *S*            407:          RPT      -2
 *S*            408:          DES
                409:          ELSE
  0002          410:          RPT      2
16B4 31         411:          INS
                412:          FIN
  16B6          413: INCLWATCHOUT% EQU *                      ....
16B6 39         414:          RTS                          IN ANY EVENT, GO HOME.




ASM/6800 1.3H4: 16B6 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 151; Form 25    - - - I N C L C O P Y O U T - - -
ASM14A.MAIN.ASM
                416: ******************************************************************************
                417: *
                418: * NAME:  INCLCOPYOUT(X)
                419: *
                420: * FUNCTION:
                421: *        X IS A POINTER TO AN INCLB THAT IS TO BE MADE THE CURRENT
                422: *        INCLB.  WE STORE IT INTO .CURINCLB; THEN COPY OUT THE VARIOUS
                423: *        LINE-# RELATED INFO INTO MAIN STORE.
                424: *
                425: ******************************************************************************
                426: 
  16B7          427: INCLCOPYOUT EQU   *
16B7 DFA7       428:          STX      .CURINCLB         SAVE POINTER.
16B9 A606       429:          LDAA     INCLB:FPGE,X      COPY SOME CONTEXT:
16BB E607       430:          LDAB     INCLB:FPGE+1,X         ....
                431:          ;LDX     INCLB:LINEN,X          ....
16BD EE08       432:          LDX      INCLB:LINEN,X
16BF 978F       433:          STAA     FPGE                   ....
16C1 D790       434:          STAB     FPGE+1                 ....
16C3 DF91       435:          STX      LINEN                  ....
                436:          ;LDX     .CURINCLB         RESTORE POINTER;
16C5 DEA7       437:          LDX      .CURINCLB
16C7 39         438:          RTS                          SPLIT.




ASM/6800 1.3H4: 16C7 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 152; Form 26    - - - D O ,   I F - - -
ASM14A.MAIN.ASM
  0001            2:          DO       CONDASM=1
                  3: *
                  4: *
                  5: *  D O :
                  6: *
                  7: *        Handles DO psuedo-op:  right now is an IF, w/ error check.
                  8: *
  16C8            9: DO:      ;JSR      EVALCT            GET CONTROL VALUE,
16C8 BD1B3A      10:          JSR      EVALCT
16CB 965F        11:          LDAA     VAL
16CD 2D10        12:          BLT      IF:1
16CF 2606        13:          BNE      DO:1              B/  FAR TOO BIG.
16D1 9660        14:          LDAA     VAL+1
                 15:          ;CMPA     #1
16D3 8101        16:          CMPA     #1
16D5 2308        17:          BLS      IF:1
  16D7           18: DO:1     ;JSR      ILLVAL
16D7 BD088B      19:          JSR      ILLVAL
16DA 2003        20:          BRA      IF:1
                 21: *
  16DC           22: IF:      ;JSR      EVALCT
16DC BD1B3A      23:          JSR      EVALCT
  16DF           24: IF:1     ;LDX      VAL
16DF DE5F        25:          LDX      VAL
16E1 2E06        26:          BGT      IF:T
                 27: *
                 28: * AN IF THAT FAILED:
                 29: *    SET SKPFLG = 1, SKPLVL = 0
                 30: *
16E3 4F          31: IFAIL    CLRA
16E4 979A        32:          STAA     SKPLVL
16E6 4C          33:          INCA
16E7 978E        34:          STAA     SKPFLG            SKIP TO FIRST ELSE.
  16E9           35: IF:X     ;JMP      PUTV              OUTPUT VALUE AND LEAVE.
16E9 7E2717      36:          JMP      PUTV
                 37: *
                 38: * AN IF THAT SUCCEEDED:
                 39: *        INCREMENT DOLVL.
                 40: *
  16E9           41: IF:T     EQU      IF:X




