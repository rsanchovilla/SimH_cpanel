ASM/6800 1.3H4: 2B8E ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 339; Form 36    - - - I N L I N E - - -
ASM14A.IOFM.ASM
                  2: *
                  3: * INLINE - INPUT A LINE FROM THE APROPRIATE PLACE.
                  4: *
                  5: *        IF PASS1 - INITIALY GET LINES FROM CONS
                  6: * AND SAVE THEM FOR PASS 2 IN SYM TABLE AREA. AS SOON AS
                  7: * EMPTY LINE IS INPUT - READ FROM SI DEVICE
                  8: *
                  9: *        IF PASS 2 - INITIALLY GET STORED LINES FROM PASS 1.
                 10: * THEN, WHEN WE RUN OUT OF USER INPUT LINES, READ LINES
                 11: * FROM THE SI DEVICE.
                 12: *
                 13: *
                 14: *
                 15: *
                 16: *        FORMAT OF SAVED LINE BLOCKS:
                 17: *
                 18: *                 ------------------
                 19: *                 *    CHAR        *
                 20: *                 *    CHAR        *
                 21: *                  . . . . . . 
                 22: *                 *     <CR>       *
                 23: *                 *     <NUL>      *
                 24: *                 *   PTR TO NEXT  *
                 25: *                 * LINE BLOCK     *
                 26: *                 ------------------
                 27: *
                 28: *
  2B90           29: INLINE   ;LDX     INBUF             PT TO START OF BUFFER
2B90 DEAE        30:          LDX      INBUF
2B92 DF20        31:          STX      INPTR             SAVE AWAY
2B94 969C        32:          LDAA     INCLVL            ARE WE AT BOTTOM LEVEL?
2B96 2649        33:          BNE      STDLINE             B/ NO: ALWAYS READ FROM FILE.
2B98 9687        34:          LDAA     INCNT             DO WE READ FROM CONS?
2B9A 2645        35:          BNE      STDLINE           IF NOT, STANDARD LINE
2B9C 9654        36:          LDAA     PASS              WHICH PASS
2B9E 262A        37:          BNE      P2INPUT           IF PASS 2 DO WEIRD STUFF
2BA0 DF36        38:          STX      TPTR1             SAVE SOURCE ADDR FOR MOVE
2BA2 863E        39:          LDAA     #'>
                 40:          ;JSR     PUTCC             PROMPT THE GUY SO THAT HE DOESN'T FALL ASLEEP
2BA4 BD2A11      41:          JSR      PUTCC




ASM/6800 1.3H4: 2BA4 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 340; Form 36    - - - I N L I N E - - -
ASM14A.IOFM.ASM
                 42:          ;JSR     GETL              GET A LINE
2BA7 BD2A4F      43:          JSR      GETL
2BAA 5A          44:          DECB
2BAB 272E        45:          BEQ      P2INDONE          IF NULL LINE, WE ARE DONE
                 46: *
                 47: * GOT LINE - NOW GET A BLOCK FROM SYM TBL AND SAVE IT THERE
                 48: *
2BAD CB04        49:          ADDB     #4                ADD TO COUNT OR <CR><NUL>+2 PTR BYTES
                 50:          ;JSR     GTBLK             GET SOME SPACE
2BAF BD20A6      51:          JSR      GTBLK
2BB2 2727        52:          BEQ      P2INDONE          IF NO SPACE, ACT LIKE NORMAL
2BB4 DF34        53:          STX      TPTR              SAVE ADDR OF BLOCK
                 54:          ;LDX     INLLINK           LD ADDR OF LAST LINK
2BB6 DE85        55:          LDX      INLLINK
2BB8 9634        56:          LDAA     TPTR              LINK THIS BLOCK IN
2BBA A700        57:          STAA     0,X
2BBC 9635        58:          LDAA     TPTR+1
2BBE A701        59:          STAA     1,X
2BC0 8D4E        60:          BSR      MOVEB             TPTR1 --> TPTR
2BC2 08          61:          INX                        POINT PAST YE NULL,
2BC3 DF85        62:          STX      INLLINK           SAVE PTR TO LAST LINK
                 63:          ;CLR     0,X               INDICATE END OF LIST
2BC5 6F00        64:          CLR      0,X
                 65:          ;CLR     1,X
2BC7 6F01        66:          CLR      1,X
2BC9 39          67: OUTLINE  RTS                        ALL DONE (PHEW)
                 68: *
                 69: * MUST GET LINES FROM SAVED LIST
                 70: *
2BCA DF34        71: P2INPUT  STX      TPTR              SAVE AS DESTINATON ADDRESS
                 72:          ;LDX     INLLINK           LD PTR TO LINK TO NEXT BYTE
2BCC DE85        73:          LDX      INLLINK
                 74:          ;LDX     0,X               LD ADDR OF NEXT BLK
2BCE EE00        75:          LDX      0,X
2BD0 2709        76:          BEQ      P2INDONE          IF=0 END OF FUNNY INPUT - READ FROM SI NOW
2BD2 DF36        77:          STX      TPTR1             SAVE AS SOURCE ADDR
2BD4 8D3A        78:          BSR      MOVEB             FILL THE INPUT BUFFER
                 79:          ;LDX     TPTR1             LD PTR TO NEXT LINK
2BD6 DE36        80:          LDX      TPTR1
2BD8 DF85        81:          STX      INLLINK           SAVE IN SAFE PLACE




ASM/6800 1.3H4: 2BDA ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 341; Form 36    - - - I N L I N E - - -
ASM14A.IOFM.ASM
2BDA 39          82:          RTS
                 83: *
                 84: * HANDLE REMAINING LINES AS NORMAL (I.E. FROM SI).
                 85: *
  2BDB           86: P2INDONE ;DEC     INCNT             MAKE INCNT # 0
2BDB 7A0087      87:          DEC      INCNT
                 88:          ;JSR     FORMFEED            EJECT A PAGE.
2BDE BD0815      89:          JSR      FORMFEED
  2BE1           90: STDLINE  EQU      *
2BE1 9695        91:          LDAA     EOFF              END OF FILE?
2BE3 26E4        92:          BNE      OUTLINE           B/YES
  2BE5           93: STDLINE1 ;JSR     GETCS             GET A SOURCE CHAR,
2BE5 BD29DF      94:          JSR      GETCS
                 95:          ;CMPA    #CTRLL            IS IT A CONTROL-L?
2BE8 810C        96:          CMPA     #CTRLL
2BEA 2608        97:          BNE      READL3              B/ NOPE: START SAVING LINE.
                 98:          ;JSR     FORMFEED          THROW FORM,
2BEC BD0815      99:          JSR      FORMFEED
2BEF 20F0       100:          BRA      STDLINE             AND EAT ANY MORE ^L-S.
  2BF1          101: READL1   ;JSR      GETCS             ;GET A SOURCE CHARACTER
2BF1 BD29DF     102:          JSR      GETCS
  2BF4          103: READL3   EQU      *
                104: *2*
                105: *
                106: * GOT A CH IN A; PUT IT IN THE BUFFER.
                107:          ;LDX      INPTR             ;POKE THIS CHARACTER AWAY,
2BF4 DE20       108:          LDX      INPTR
2BF6 A700       109:          STAA     0,X               ;IN THE BUFFER
2BF8 9CB0       110:          CPX      INBUFE            HIT END OF LINE BUFFER?
2BFA 270A       111:          BEQ      READ99               B/ YES:  DON'T BUMP POINTER.
2BFC 08         112:          INX                        ;AUTOINCREMENT
2BFD DF20       113: READ98   STX      INPTR             ;SAVE POINTER.
                114: *
                115: * GOT ALL THE LINE?
                116:          ;CMPA     #$D               ;CARRIAGE RETURN?
2BFF 810D       117:          CMPA     #$D
2C01 26EE       118:          BNE      READL1            ;B/ NO, GO GET ANOTHER CH.
                119:          ;CLR      0,X               ;CR SEEN: APPEND A NULL.
2C03 6F00       120:          CLR      0,X
2C05 39         121:          RTS




ASM/6800 1.3H4: 2C05 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 342; Form 36    - - - I N L I N E - - -
ASM14A.IOFM.ASM
                122: 
                123: ****  ARRGH.... OUT OF INPUT BUFFER..... ******
  2C06          124: READ99   ;JSR     ILTRUNC           SET ERROR FLAG,
2C06 BD08A3     125:          JSR      ILTRUNC
                126:          ;LDX     INPTR               RESTORE INPUT POINTER,
2C09 DE20       127:          LDX      INPTR
2C0B 20F0       128:          BRA      READ98              AND CONTINUE UNTIL WE FIND A $D.




ASM/6800 1.3H4: 2C0B ASM/6800 1.4       - - - I / O    S E C T I O N - - -
