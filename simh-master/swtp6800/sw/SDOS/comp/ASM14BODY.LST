                  2: *
                  3: * A+B
1C2E 8D52         4: XADD     BSR      GTA
1C30 AB01         5:          ADDA     OBL,X             ADD B
1C32 E900         6:          ADCB     OBH,X             HIGH BYTE,
                  7: *
  1C34            8: OPFNSH   EQU      *                 A HAS NEW OA
1C34 A704         9:          STAA     OAL,X             SAVE IT.
1C36 E703        10:          STAB     OAH,X
  1C38           11: OPFN1    EQU      *                 POP OFF OBH, OBL,  OPERATOR
                 12:          ;LEAS    2,S
  0000           13:          IF       2<0
 *S*             14:          RPT      -2
 *S*             15:          DES
                 16:          ELSE
  0002           17:          RPT      2
1C38 31          18:          INS
                 19:          FIN
  1C3A           20: OPFN2    EQU      *
1C3A 31          21:          INS                        POP THE OPERATOR
                 22:          ;JMP      EXST3             AND GO SCAN ANOTHER OPERATOR
1C3B 7E1B99      23:          JMP      EXST3
                 24: *
                 25: * A-B
  1C3E           26: XSUB     EQU      *
1C3E 8D42        27:          BSR      GTA               A := OAL;  B:= OAH
1C40 A001        28:          SUBA     OBL,X
1C42 E200        29:          SBCB     OBH,X
1C44 20EE        30:          BRA      OPFNSH            AND GO POKE.




