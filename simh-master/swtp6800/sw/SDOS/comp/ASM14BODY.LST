ASM14A.IOFM.ASM
27EF CE3037      82:          LDX      #BBST+2
27F2 B63083      83:          LDAA     NEWREC+R$LEN+1      load length,
27F5 C603        84:          LDAB     #BO                 set channel,
                 85:          ;JSR     WRITEREC$           and send a number of bytes.
27F7 BD0123      86:          JSR      WRITEREC$
                 87:          ;JSR     GetNewrecEnd      Now, compute new length of CURREC according
27FA BD29C0      88:          JSR      GetNewrecEnd
                 89:          ;LDX     #CURREC+R$BASE      to:  CURREC.LEN max ...
27FD CE3084      90:          LDX      #CURREC+R$BASE
                 91:          ;JSR     DP$SUB                     ... (NEWREC.BASE+NEWREC.LEN)-CURREC.BASE
2800 BD29AA      92:          JSR      DP$SUB
                 93:          ;LDX     #CURREC+R$LEN
2803 CE3086      94:          LDX      #CURREC+R$LEN
                 95:          ;JSR     DP$MAX
2806 BD29B7      96:          JSR      DP$MAX
2809 A700        97:          STAA     0,X               Save result in CURREC.R$LEN
280B E701        98:          STAB     1,X
280D 39          99: OutSDOS% RTS                          and split.




ASM/6800 1.3H4: 280D ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 301; Form 24    - - - C h e c k   S D O S  A l i g n - - -
ASM14A.IOFM.ASM
                101: *****************************************************************************
                102: *
                103: * Name:  CheckSDOSalign ()
                104: *
                105: * Function:
                106: *        Examines the new record segment that is to be output, along with the
                107: *        OutSDOSrecord data base, and decides whether we should attempt to
                108: *        align this record by ending the old record and starting a new one.
                109: *        If so, the CY flag is set on exit.
                110: *
                111: * Results:
                112: *        CY                         If set, CheckSDOSalign thinks we should
                113: *                                     attempt to align this record with the
                114: *                                     sector size on the disk.
                115: *
                116: * Algorithm:
                117: *        The following checks are made:
                118: *
                119: *        *  We call CkNewrecord, which will close the current record if
                120: *           it makes sense/is necessary to do so.
                121: *
                122: *        *  If the new record is not of maximum length, we do not align.
                123: *                 --ELSE--
                124: *        *  If the current load record segment is empty, we align.
                125: *                 --ELSE--
                126: *        *  If the top target address of this record is less than that of
                127: *           the top of the new record, and writing the new record will cause
                128: *           a sector crossing, we align.
                129: *
                130: *****************************************************************************
                131: 
  280E          132: CheckSDOSalign    EQU *
280E 8D3C       133:          BSR      CkNewRecord       Close current record, if necessary.
2810 F63083     134:          LDAB     NEWREC+R$LEN+1    If length <> maximum permitted, this...
                135:          ;CMPB    #BBEND-(BBST+2)     record is a 'patch' record & should not
2813 C140       136:          CMPB     #BBEND-(BBST+2)
2815 2630       137:          BNE      CkSDOSalign:NO      be aligned.  B/ Don't align.
                138: 
                139: **** Check for no current record ****
2817 F6308C     140:          LDAB     CURREC+R$VALID    Is current record valid?




ASM/6800 1.3H4: 281A ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 302; Form 24    - - - C h e c k   S D O S  A l i g n - - -
ASM14A.IOFM.ASM
281A 272D       141:          BEQ      CkSDOSalign:YES     B/ No:  then align this record.
                142: 
                143: **** Check for record overlapping current record ****
                144:          ;JSR     GetNewrecEnd      Get address of end of this record segment.
281C BD29C0     145:          JSR      GetNewrecEnd
281F 37         146:          PSHB                       Save again during computation.
2820 36         147:          PSHA
                148:          ;JSR     GetCurrecEnd      Compute end address of Current Record.
2821 BD29C5     149:          JSR      GetCurrecEnd
2824 30         150:          TSX                        Point to (Newrec.BASE+Newrec.LEN).
                151:          ;JSR     DP$CMP              Check other bound for containment.
2825 BD29B0     152:          JSR      DP$CMP
                153:          ;LEAS    2,S                 (Pop used-up value)
  0000          154:          IF       2<0
 *S*            155:          RPT      -2
 *S*            156:          DES
                157:          ELSE
  0002          158:          RPT      2
2828 31         159:          INS
                160:          FIN
282A 241B       161:          BCC      CkSDOSAlign:NO      B/ Record is contained: don't align.
                162: 
                163: **** Newrec overlaps Currec, but we may still want to align if this record ****
                164: **** will cross a sector boundary in the file.                             ****
282C C001       165:          SUBB     #1                Compute address of last byte in CURREC.
282E 8200       166:          SBCA     #0                  ....
                167:          ;JSR     SectorNum         Extract sector field from CURREC's end address.
2830 BD298C     168:          JSR      SectorNum
2833 37         169:          PSHB                       Save on TOS.
2834 36         170:          PSHA
                171:          ;JSR     GetNewrecEnd      Compute sector number for last byte written.
2835 BD29C0     172:          JSR      GetNewrecEnd
2838 C001       173:          SUBB     #1
283A 8200       174:          SBCA     #0
                175:          ;JSR     SectorNum
283C BD298C     176:          JSR      SectorNum
283F 30         177:          TSX                        Now, compare them.
                178:          ;JSR     DP$CMP
2840 BD29B0     179:          JSR      DP$CMP
                180:          ;LEAS    2,S                 (pop stack)




ASM/6800 1.3H4: 2840 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 303; Form 24    - - - C h e c k   S D O S  A l i g n - - -
ASM14A.IOFM.ASM
  0000          181:          IF       2<0
 *S*            182:          RPT      -2
 *S*            183:          DES
                184:          ELSE
  0002          185:          RPT      2
2843 31         186:          INS
                187:          FIN
2845 2602       188:          BNE      CkSDOSalign:YES   B/ Sector crossing --> align!
                189: 
                190: **** Dont Align..... ****
  2847          191: CkSDOSalign:NO    EQU *
2847 0C         192:          CLC
2848 39         193:          RTS
                194: 
                195: **** Do Align ...... ****
  2849          196: CkSDOSalign:YES   EQU *
2849 0D         197:          SEC
  0001          198:          IF       1                 Don't ever align for now.
284A 0C         199:          CLC
                200:          FIN
284B 39         201:          RTS




ASM/6800 1.3H4: 284B ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 304; Form 24    - - - C h e c k   N e w   R e c o r d - - -
ASM14A.IOFM.ASM
                203: *****************************************************************************
                204: *
                205: * Name:  CkNewRecord ()
                206: *
                207: * Function:
                208: *        Compares the new record segment against the current record segment.
                209: *        If the new record segment cannot/should not be included in the
                210: *        current record, we call FinishCurrec to close the current record
                211: *        segment.
                212: *
                213: * Changes:                          Preserves:
                214: *        ****ALL****                     ****NONE****
                215: *
                216: *****************************************************************************
                217: 
  284C          218: CkNewRecord       equ *
284C B6308C     219:          LDAA     CURREC+R$VALID    Is current record segment open?
284F 2720       220:          BEQ      CkNewRec%           B/ No:  nothing to do.
                221:          ;JSR     GetNewrecBase     Is target load address of new record
2851 BD29D1     222:          JSR      GetNewrecBase
                223:          ;LDX     #CURREC+R$BASE      below target load address of
2854 CE3084     224:          LDX      #CURREC+R$BASE
                225:          ;JSR     DP$CMP              current record segment?
2857 BD29B0     226:          JSR      DP$CMP
285A 2511       227:          BCS      CkNewrec:POOF       B/ Yes:  finish current record.
                228:          ;JSR     GetCurrecEnd      Is target load address of new record
285C BD29C5     229:          JSR      GetCurrecEnd
285F CB01       230:          ADDB     #1                  beyond a "reasonable" distance from
2861 8900       231:          ADCA     #0                  the end target address of the currently
2863 250C       232:          BCS      CkNewrec%           open record? B/ We are too close to $FFFF.
                233:          ;LDX     #NEWREC+R$BASE      If so, finish current record.
2865 CE3080     234:          LDX      #NEWREC+R$BASE
                235:          ;JSR     DP$CMP              .....
2868 BD29B0     236:          JSR      DP$CMP
286B 2404       237:          BCC      CkNewrec%           B/ It's close enough, use current record.
                238: 
                239: **** Finish current record & split ****
  286D          240: CkNewrec:POOF     equ *
286D 4F         241:          CLRA                       Flag:  not last record.
                242:          ;JSR     FinishCurrec




ASM/6800 1.3H4: 286E ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 305; Form 24    - - - C h e c k   N e w   R e c o r d - - -
ASM14A.IOFM.ASM
286E BD2913     243:          JSR      FinishCurrec
                244: 
                245: **** Split ****
  2871          246: CkNewrec%         equ *
2871 39         247:          RTS




ASM/6800 1.3H4: 2871 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 306; Form 24    - - - P u t   R e c o r d   H d r - - -
ASM14A.IOFM.ASM
                249: *****************************************************************************
                250: *
                251: * Name:  PutRecordHdr ()
                252: *
                253: * Function:
                254: *        When we are beginning a new load record, PutRecordHdr does all
                255: *        the work required to set up the software tables.  It assumes that
                256: *        CURREC.FILEBASE points to the first free byte of the output file.
                257: *        CURREC.FILEBASE is advanced 5 bytes, to reserve space for a load
                258: *        record header; CURREC.LEN is set to zero, to indicate the lack of
                259: *        data output; CURREC.VALID is set non-zero ("true") to indicate
                260: *        that the rest of the nonsense is valid; and CURREC.BASE is set to
                261: *        NEWREC.BASE, which is assumed to be the base target load address
                262: *        for this record.
                263: *
                264: * Changed:                          Preserved:
                265: *        ***ALL***                       ***NONE***
                266: *
                267: *****************************************************************************
                268: 
  2872          269: PutRecordHdr      EQU *
2872 4F         270:          CLRA                       Load AB w/ 5
2873 C605       271:          LDAB     #5
2875 F7308C     272:          STAB     CURREC+R$VALID    Mark Currec as valid.
                273:          ;JSR     UpdateFilebase    Add 5 to Filebase.
2878 BD28FC     274:          JSR      UpdateFilebase
                275:          ;LDX     NEWREC+R$BASE     Set new base of record,
287B FE3080     276:          LDX      NEWREC+R$BASE
287E FF3084     277:          STX      CURREC+R$BASE
                278:          ;LDX     #0                Set length to zero.
2881 CE0000     279:          LDX      #0
2884 FF3086     280:          STX      CURREC+R$LEN
2887 39         281:          RTS




ASM/6800 1.3H4: 2887 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 307; Form 24    - - - A l i g n   S D O S   R e c o r d - - -
ASM14A.IOFM.ASM
                283: *****************************************************************************
                284: *
                285: * Name:  AlignSDOSrecord ()
                286: *
                287: * Function:
                288: *        Assuming that we really do want to perform an alignment operation,
                289: *        we do the work here.  Of course, if the record just happens already
                290: *        to be aligned, we don't have to do much.
                291: *
                292: * Arguments:
                293: *        ***NONE***
                294: *
                295: * Changes:
                296: *        A, B, C, X
                297: *
                298: * Input:
                299: *        CURREC+R$VALID             Byte flag, indicating whether we are
                300: *                                     currently building a record.
                301: *
                302: *           ...+R$BASE              Target load address of current record.
                303: *
                304: *           ...+R$FILEPOINTER       File address of start of data bytes in
                305: *                                     current record.
                306: *
                307: *        NEWREC+R$BASE              Target load address of new record segment
                308: *                                     (which we are attempting to align).
                309: *
                310: *           ...+R$LEN               Length (number of data bytes) in new
                311: *                                     record segment.
                312: *
                313: *        SectorMask                 Word, mask for extracting sector field
                314: *                                     of a file address.  Comes from disk
                315: *                                     DCB via SYSCALL.
                316: *
                317: *        NotSectorMask              Word, mask for extracting byte-within-sector
                318: *                                     field of a file address.  Source same as
                319: *                                     SectorMask's.
                320: *
                321: *****************************************************************************
                322: 




ASM/6800 1.3H4: 2887 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 308; Form 24    - - - A l i g n   S D O S   R e c o r d - - -
ASM14A.IOFM.ASM
  2888          323: AlignSDOSrecord   equ *
2888 B6308C     324:          LDAA     CURREC+R$VALID    Is a record being built?
288B 2719       325:          BEQ      AlignSDOS$1         B/ No-- must align.
                326: 
                327: **** Check whether current record is already aligned ****
                328:          ;JSR     GetCurrecBase     Get target load address of Currec.
288D BD29D8     329:          JSR      GetCurrecBase
                330:          ;JSR     SectorRem           and compute offset in current sector.
2890 BD2993     331:          JSR      SectorRem
2893 37         332:          PSHB                       Save on tos.
2894 36         333:          PSHA                            ....
2895 B6308A     334:          LDAA     CURREC+R$FILEBASE+2 Get file base address of Currec;
2898 F6308B     335:          LDAB     CURREC+R$FILEBASE+3    (double precision);
                336:          ;JSR     SectorRem           compute file sector offset.
289B BD2993     337:          JSR      SectorRem
289E 30         338:          TSX                        Compare the offsets;
                339:          ;JSR     DP$CMP              if they are equal, we're aligned.
289F BD29B0     340:          JSR      DP$CMP
                341:          ;LEAS    2,S                 (pop stack)
  0000          342:          IF       2<0
 *S*            343:          RPT      -2
 *S*            344:          DES
                345:          ELSE
  0002          346:          RPT      2
28A2 31         347:          INS
                348:          FIN
28A4 2755       349:          BEQ      AlignSDOS%          B/ already aligned!
                350: 
                351: **** Need to do work to align. ****
  28A6          352: AlignSDOS$1       EQU *
28A6 4F         353:          CLRA                       Set argument = FALSE,
                354:          ;JSR     FinishCurrec        and flush the record.
28A7 BD2913     355:          JSR      FinishCurrec
                356:          ;JSR     GetCurrecBase     Get dummy value for FilePosition.
28AA BD29D8     357:          JSR      GetCurrecBase
28AD CB08       358:          ADDB     #8                Add in overhead for skip+rec header.
28AF 8900       359:          ADCA     #0
                360:          ;JSR     FilePosition      Compute file pointer for end of record.
28B1 BD2953     361:          JSR      FilePosition
28B4 A602       362:          LDAA     2,X                 Load lsw into AB,




ASM/6800 1.3H4: 28B6 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 309; Form 24    - - - A l i g n   S D O S   R e c o r d - - -
ASM14A.IOFM.ASM
28B6 E603       363:          LDAB     3,X
28B8 37         364:          PSHB                         and save on TOS.
28B9 36         365:          PSHA
                366:          ;JSR     GetNewrecBase     AB := Newrec.BASE
28BA BD29D1     367:          JSR      GetNewrecBase
28BD 30         368:          TSX
                369:          ;JSR     DP$SUB            Compute the difference,
28BE BD29AA     370:          JSR      DP$SUB
                371:          ;JSR     SectorRem           and take it modulo some power of 2.
28C1 BD2993     372:          JSR      SectorRem
                373:                                     ; (since it's a power of 2, we dont need
                374:                                     ;  to do this til now).
28C4 A700       375:          STAA     0,X               Save result on TOS for a second,
28C6 E701       376:          STAB     1,X
28C8 B6307E     377:          LDAA     NotSectorMask     Check whether we can chuck the skip record.
28CB F6307F     378:          LDAB     NotSectorMask+1
28CE C002       379:          SUBB     #2                If so, this operation will yeild a zero.
                380:          ;JSR     DP$CMP              (Note, no carry possible from above SUB).
28D0 BD29B0     381:          JSR      DP$CMP
28D3 32         382:          PULA                       Restore offset to AB,
28D4 33         383:          PULB
28D5 2724       384:          BEQ      AlignSDOS%          B/ No skip record needed.  offset=5.
                385: 
                386: **** Output a skip record, skipping (AB) bytes. ****
28D7 37         387:          PSHB                       Construct a record on TOS,
28D8 36         388:          PSHA
28D9 8600       389:          LDAA     #RTYPE$SKIP
28DB 36         390:          PSHA                         do this now, cause it's clearer.
                391:          ;JSR     GetCurrecBase     Get CURREC.BASE
28DC BD29D8     392:          JSR      GetCurrecBase
28DF 8D72       393:          BSR      FilePosition
28E1 C603       394:          LDAB     #BO               Position to that byte, pleeze.
                395:          ;JSR     POSITION$
28E3 BD0126     396:          JSR      POSITION$
28E6 30         397:          TSX                        Get address of record,
28E7 8603       398:          LDAA     #3                Get length of skip record,
28E9 C603       399:          LDAB     #BO
                400:          ;JSR     WRITEREC$
28EB BD0123     401:          JSR      WRITEREC$
                402: 




ASM/6800 1.3H4: 28EB ASM/6800 1.4       - - - I / O    S E C T I O N - - -
