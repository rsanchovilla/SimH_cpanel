                 42:          ;JSR     GTBLK
22D0 BD20A6      43:          JSR      GTBLK
22D3 27F8        44:          BEQ      SVERLR            B/ NONE, QUIT SAVING ERROR BLOCKS
22D5 DF36        45:          STX      TPTR1             ELSE SAVE POINTER TO NEW BLOCK
                 46: *
                 47: *        CONSTRUCT NEW ERROR BLOCK
                 48: *
                 49:          ;CLR     ERB:NEXT,X        MARK AS LAST BLOCK...
22D7 6F00        50:          CLR      ERB:NEXT,X
                 51:          ;CLR     ERB:NEXT+1,X
22D9 6F01        52:          CLR      ERB:NEXT+1,X
22DB 968F        53:          LDAA     FPGE              COPY IN FILE PAGE NUMBER
22DD D690        54:          LDAB     FPGE+1
22DF A702        55:          STAA     ERB:FPGE,X
22E1 E703        56:          STAB     ERB:FPGE+1,X
22E3 9691        57:          LDAA     LINEN             COPY IN LINE NUMBER
22E5 D692        58:          LDAB     LINEN+1
22E7 A704        59:          STAA     ERB:LINEN,X
22E9 E705        60:          STAB     ERB:LINEN+1,X
                 61: *
                 62: *        CHAIN INTO LAST OF LIST
                 63: *
                 64:          ;LDX     TPTR              GET POINTER TO LAST BLOCK
22EB DE34        65:          LDX      TPTR
22ED 9636        66:          LDAA     TPTR1             GET ITS NEW NEXT POINTER
22EF D637        67:          LDAB     TPTR1+1
22F1 A700        68:          STAA     ERB:NEXT,X        MAKE NEXT(LAST):=A(NEW BLOCK)
22F3 E701        69:          STAB     ERB:NEXT+1,X
22F5 39          70:          RTS
                 71:          FIN




