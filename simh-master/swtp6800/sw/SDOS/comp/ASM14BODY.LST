ASM14A.IOFM.ASM
                403: **** Now, update Filebase to point to end of skipped region ****
28EE C603       404:          LDAB     #3                Add three bytes to pointer for skip hdr,
28F0 4F         405:          CLRA                         so load AB with 3.
28F1 30         406:          TSX                        Get pointer to our copy of skip record,
28F2 08         407:          INX                          point to count of bytes to skip,
                408:          ;JSR     DP$ADD              and add it to 3 to get total to add to...
28F3 BD299A     409:          JSR      DP$ADD
28F6 8D04       410:          BSR      UpdateFilebase      the file pointer.
                411:          ;LEAS    3,S               Prune stack of 3 bytes
  0000          412:          IF       3<0
 *S*            413:          RPT      -3
 *S*            414:          DES
                415:          ELSE
  0003          416:          RPT      3
28F8 31         417:          INS
                418:          FIN
  28FB          419: AlignSDOS%        equ *
28FB 39         420:          RTS




ASM/6800 1.3H4: 28FB ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 311; Form 25    - - - U p d a t e   F i l e b a s e - - -
ASM14A.IOFM.ASM
                  2: *****************************************************************************
                  3: *
                  4: * Name:  UpdateFilebase (Offset: WORD)
                  5: *
                  6: * Function:
                  7: *        Adds offset (passed in AB) to CURREC+R$FILEBASE.
                  8: *
                  9: * Argument:
                 10: *        AB       "Offset"          Unsigned integer number to be added to
                 11: *                                     file base pointer.
                 12: *
                 13: * Changed:
                 14: *        A, B, C.
                 15: *
                 16: * Preserved:
                 17: *        X
                 18: *
                 19: * Data:
                 20: *        CURREC+R$FILEBASE          Has (AB) added to it, in place.
                 21: *
                 22: *****************************************************************************
                 23: 
  28FC           24: UpdateFilebase    EQU *
28FC FB308B      25:          ADDB     CURREC+R$FILEBASE+3
28FF F7308B      26:          STAB     CURREC+R$FILEBASE+3
2902 B9308A      27:          ADCA     CURREC+R$FILEBASE+2
2905 B7308A      28:          STAA     CURREC+R$FILEBASE+2
2908 2408        29:          BCC      UpdateFilebase%
                 30:          ;INC     CURREC+R$FILEBASE+1
290A 7C3089      31:          INC      CURREC+R$FILEBASE+1
290D 2603        32:          BNE      UpdateFilebase%
                 33:          ;INC     CURREC+R$FILEBASE
290F 7C3088      34:          INC      CURREC+R$FILEBASE
  2912           35: UpdateFilebase%   EQU *
2912 39          36:          RTS




ASM/6800 1.3H4: 2912 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
