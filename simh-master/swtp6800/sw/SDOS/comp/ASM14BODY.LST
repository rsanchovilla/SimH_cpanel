                 45:          ;LDX     #TTLBUF           GET ADDRESS OF BUFFER,
14F9 CE2F63      46:          LDX      #TTLBUF
14FC 2023        47:          BRA      PAGE0             HANDLE LIKE PAGE
  14FE           48: NAME:    EQU      *
                 49:          ;LDX     #NAMEBF           GET NAME-BUFFER ADDRESS
14FE CE2F45      50:          LDX      #NAMEBF
1501 861D        51:          LDAA     #NAMESZ-1         AND SIZE;
1503 2022        52:          BRA      PAGE0A            B/ NOW HANDLE LIKE PAGE, TITLE -- BUT DON'T EJECT
                 53:          FIN
  1505           54: SPACE:   EQU      *
                 55:          ;JSR      EVALCT            EVALUATE THE AF.
1505 BD1B3A      56:          JSR      EVALCT
                 57: *        JSR      ISCTR             MAKE SURE ITS LEGAL
                 58:          ;LDX      VAL
1508 DE5F        59:          LDX      VAL
150A 2E04        60:          BGT      SPC1              VAL > 0 ==> GO DO IT.
150C 8601        61:          LDAA     #1                ELSE SKIP 1
150E 2008        62:          BRA      SKIP
                 63: *
1510 9660        64: SPC1     LDAA     VAL+1             GET SKIP COUNT,
1512 D65F        65:          LDAB     VAL               TEST H(VAL)
1514 2702        66:          BEQ      SKIP              B/ IT'S OK:  SKIP N
1516 86FF        67:          LDAA     #$FF              ELSE MAKE BIG SKIP COUNT
                 68: *
  1518           69: SKIP     EQU      *                 ACCA = # OF LINES TO SKIP
                 70:          ;CMPA     LLTP              ANY LEFT ON THIS PAGE?
1518 9155        71:          CMPA     LLTP
151A 2349        72:          BLS      SKIP1             B/ YES: GO LOOP THRU TO BOF
151C 2043        73:          BRA      EJECT
                 74: *
  151E           75: PAGE:    EQU      *
                 76: *
  0001           77:          DO       TITLES=1
                 78:          ;LDX     #SBTTBF           COPY INTO SUBTITLE BUFFER.
151E CE2FCC      79:          LDX      #SBTTBF
1521 8668        80: PAGE0    LDAA     #TTLMAX-1         GET COUNT,
1523 8D02        81:          BSR      PAGE0A            YUP, IT'S OLD T.M. CHEAT TIME AGAIN.




