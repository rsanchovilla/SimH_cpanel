ASM/6800 1.3H4: 08B1 ASM/6800 1.4       - - -   M C S - 6 8 0 0   A S S E M B L E R   - - -
08/16/82 00:00:00; Page 48; Form 11     - - - E R R O R   S U B R O U T I N E S - - -
ASM14A.MAIN.ASM
                  2: *
                  3: *
                  4: * NAME:  ERROR
                  5: *
                  6: * FUNCTION:       MERGES ERROR CODE INTO FLAGS OF ERRORS REPORTED
                  7: *        FOR THIS LINE.
                  8: *
                  9: * CALL:
                 10: *        <TOS, TOS-1>               ADDRESS OF ERROR CODE.
                 11: *        <NOS, NOS-1>               RETURN ADDRESS.
                 12: *
                 13: * ERROR CODES HAVE THE FOLLOWING FORM:
                 14: *        FCB      GROUP,MASK
                 15: *
                 16: *        GROUP    INDICATES WHICH CELL IN ERR:F IS TO BE UPDATED;
                 17: *        MASK     IS A BIT MASK INDICATING WHICH BIT IS TO BE UPDATED.
                 18: *
                 19: * REGISTERS:
                 20: *        A AND B ARE PRESERVED;  X IS DESTROYED.
                 21: *
                 22: *
  08B3           23: ERROR
                 24:          ;PULX                      ;Error code address
08B3 30          25:          TSX
08B4 EE00        26:          LDX      0,X
08B6 31          27:          INS
08B7 31          28:          INS
08B8 36          29:          PSHA                       ;GET SOME WORKING STORAGE
08B9 37          30:          PSHB
08BA A601        31:          LDAA     1,X               LOAD ERROR MASK,
08BC E600        32:          LDAB     0,X                    ERROR GROUP.
                 33:          ;JSR     LDAXB             CONVERT ERROR GROUP TO ERROR FLAG CELL @.
08BE BD2001      34:          JSR      LDAXB
08C1 008A        35:          #ERR:F                          (BASE OF ERROR FLAG TABLE)
08C3 A500        36:          BITA     0,X               IS FLAG ALREADY SET?
08C5 2613        37:          BNE      RTERR                  B/ YEAH, DON'T BUMP COUNT.
08C7 AA00        38:          ORAA     0,X               ELSE, SET FLAG,
08C9 A700        39:          STAA     0,X                    RETURN RESULT TO TABLE.
                 40: 
                 41: *  BUMP GLOBAL ERROR COUNT.....




ASM/6800 1.3H4: 08CB ASM/6800 1.4       - - -   M C S - 6 8 0 0   A S S E M B L E R   - - -
08/16/82 00:00:00; Page 49; Form 11     - - - E R R O R   S U B R O U T I N E S - - -
ASM14A.MAIN.ASM
08CB 968D        42:          LDAA     ERRC              GET THE COUNT -- IT'S BCD.
08CD 8B01        43:          ADDA     #1                     ADD 1 TO IT,
08CF 19          44:          DAA                             IN DECIMAL.
08D0 2502        45:          BCS      ERROR$1                B/ OVERFLOW, DON'T SAVE.
08D2 978D        46:          STAA     ERRC              ELSE SAVE.
                 47: 
  08D4           48: ERROR$1 EQU       *
08D4 96C1        49:          LDAA     LIST:T            SET "ERROR LINE" FLAG FOR LISTER.
08D6 8A01        50:          ORAA     #LF:ERR
08D8 97C1        51:          STAA     LIST:T
                 52: 
                 53: *  COMMON EXIT PATH.
08DA 33          54: RTERR    PULB                       RESTORE REGISTERS & EXIT.
08DB 32          55:          PULA
08DC 0C          56:          CLC
08DD 39          57:          RTS




ASM/6800 1.3H4: 08DD ASM/6800 1.4       - - -   M C S - 6 8 0 0   A S S E M B L E R   - - -
