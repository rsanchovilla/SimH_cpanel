  0001            2:          IF       SHIFT=1
                  3: * A##B  SHIFT A (+B PLACES TO LEFT) (-B PLACES TO RIGHT)
1C46 8D3A         4: XSHF     BSR      GTA
1C48 6D00         5: XSHF0    TST      OBH,X             LEFT OR RIGHT SHIFT?
1C4A 2C0C         6:          BGE      XSHF1             B/ B>0 ==> LEFT SHIFT.
                  7: * SHIFT RIGHT...
1C4C 54           8: XSHFR    LSRB
1C4D 46           9:          RORA
                 10:          ;INC      OBL,X
1C4E 6C01        11:          INC      OBL,X
1C50 26FA        12:          BNE      XSHFR             B/ STILL SOME LEFT TO DO...
                 13:          ;INC      OBH,X             INC H(CTR)
1C52 6C00        14:          INC      OBH,X
1C54 2DF6        15:          BLT      XSHFR             B/ STILL SOME LEFT...
1C56 20DC        16:          BRA      OPFNSH            ALL DONE; OA IS SET
                 17: * SHIFT LEFT.
1C58 2E04        18: XSHF1    BGT      XSHF2             B/ SOME TO DO STILL.
1C5A 6D01        19:          TST      OBL,X             IS COUNTER ZERO?
1C5C 27D6        20:          BEQ      OPFNSH            B/ YES ==> ALL DONE.
1C5E 48          21: XSHF2    ASLA
1C5F 59          22:          ROLB
                 23:          ;DEC      OBL,X
1C60 6A01        24:          DEC      OBL,X
1C62 26E4        25:          BNE      XSHF0             B/GO DO ANOTHER (WEIRD, EH)
                 26:          ;DEC      OBH,X
1C64 6A00        27:          DEC      OBH,X
1C66 2AF6        28:          BPL      XSHF2             B/ CAN'T BE THRU WITH THE SHIFT.
1C68 20CA        29:          BRA      OPFNSH            ALL DONE; SAVE THE VALUE.
                 30:          FIN




