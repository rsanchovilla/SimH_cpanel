                  9:          ;LDX     #HSHTBL-S:NEXT    GET BASE POINTER,
1A0A CE308D      10:          LDX      #HSHTBL-S:NEXT
1A0D DF34        11: ZAPCHN0  STX      TPTR                AND SAVE FOR LATER.
  1A0F           12: ZAPCHN1  ;LDX     S:NEXT,X          GET POINTER TO NEXT BLOCK,
1A0F EE00        13:          LDX      S:NEXT,X
1A11 270C        14:          BEQ      ZAPCHN2             B/ HIT END OF THIS HASH CHAIN.
1A13 A604        15:          LDAA     S:TYPE,X          SET TYPE TO TYPE!T:FREF.
1A15 8520        16:          BITA     #T:SPEC           Special symbol ?
1A17 26F6        17:          BNE      ZAPCHN1           B/Yes
1A19 8A01        18:          ORAA     #T:FREF
1A1B A704        19:          STAA     S:TYPE,X
1A1D 20F0        20:          BRA      ZAPCHN1           DO THIS FOR ENTIRE CHAIN.
  1A1F           21: ZAPCHN2  ;LDX     TPTR              HIT END OF ONE CHAIN, MOVE
1A1F DE34        22:          LDX      TPTR
                 23:          ;LEAX    2,X                 ON TO THE NEXT.
  0000           24:          IF       2<0
 *S*             25:          RPT      -2
 *S*             26:          DEX
                 27:          ELSE
  0002           28:          RPT      2
1A21 08          29:          INX
                 30:          FIN
1A23 5A          31:          DECB                       REDUCE LOOP COUNTER,
1A24 26E7        32:          BNE      ZAPCHN0             B/ GO ON IF ANY ARE LEFT.
1A26 39          33: ERFIN,EDONE RTS                     ELSE, ALL DONE.




