ASM/6800 1.3H4: 264F ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 283; Form 12    - - - P T T L - - -
ASM14A.IOFM.ASM
                  2: *
                  3: *
                  4: *  P T T L
                  5: *
                  6: *        Put string (X) to listing.
                  7: *
                  8: *        NOTE THE IMMENSE HASSLE DUE TO THE POSSIBILITY THAT WE
                  9: *        MIGHT GET REENTERED (BY CAUSING A PAGE THROW).
                 10: *
                 11: *                 ENDED BY NUL.
                 12: *
  2650           13: PTTL     EQU      *
2650 A600        14: PTTL0    LDAA     0,X
2652 2601        15:          BNE      PTTL1             B/ NOT END.
2654 39          16:          RTS
                 17: *
2655 08          18: PTTL1    INX                        POINT TO NEXT
2656 DF40        19:          STX      LTPTR             SAVE POINTER.
2658 D641        20:          LDAB     LTPTR+1           PUSH IT.  WE MIGHT GET
265A 37          21:          PSHB
265B D640        22:          LDAB     LTPTR
265D 37          23:          PSHB                       ...REENTERED.
                 24:          ;JSR      LSTC              OUTPUT (A)
265E BD24AB      25:          JSR      LSTC
                 26:          ;PULX
2661 30          27:          TSX
2662 EE00        28:          LDX      0,X
2664 31          29:          INS
2665 31          30:          INS
2666 20E8        31:          BRA      PTTL




ASM/6800 1.3H4: 2666 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 284; Form 13    - - - P T N L - - -
ASM14A.IOFM.ASM
                  2: *
                  3: *
                  4: *   P T N L
                  5: *
                  6: *        Output number in A,B to LO suppressing leading zeros.
                  7: *        A,B must not be zero.
                  8: *
                  9: *
  2668           10: PTNL     EQU      *
2668 37          11:          PSHB
2669 36          12:          PSHA
266A 5F          13:          CLRB
266B 2004        14:          BRA      PTNLE
                 15: *
  266D           16: PTNLB    EQU      *
266D 37          17:          PSHB
266E 36          18:          PSHA
266F C620        19:          LDAB     #BLANK            BLANK FILL
                 20: *
2671 30          21: PTNLE    TSX
2672 A601        22:          LDAA     1,X
2674 E701        23:          STAB     1,X
                 24: *
  2676           25: PTNL1    ;JSR      ATX2
2676 BD26DE      26:          JSR      ATX2
2679 30          27:          TSX
267A 36          28:          PSHA
267B A600        29:          LDAA     0,X
267D E700        30:          STAB     0,X
                 31:          ;JSR      ATX2
267F BD26DE      32:          JSR      ATX2
2682 37          33:          PSHB




ASM/6800 1.3H4: 2682 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 285; Form 13    - - - P T N L - - -
ASM14A.IOFM.ASM
                 35: *
                 36: *  STACK NOW LOOKS LIKE THIS:
                 37: *
                 38: *   SP   ==> NIBBLE 2 OF NUMBER IN ASCII
                 39: *            NIBBLE 3 OF NUMBER IN ASCII
                 40: *            NIBBLE 4 OF NUMBER IN ASCII
                 41: *   X+1  ==> FILL CH.
                 42: *
2683 C604        43:          LDAB     #4                OUTPUT 4 CH,
2685 DF40        44:          STX      LTPTR
                 45: *
  2687           46: PTNL2    EQU      *
                 47:          ;CMPA     #'0               IS IT A LEADING ZERO?
2687 8130        48:          CMPA     #'0
2689 2612        49:          BNE      PTNL3               B/ NO.  START SIGNIFICANCE
                 50:          ;CMPB    #1                IS THIS THE LAST DIGIT?
268B C101        51:          CMPB     #1
268D 270E        52:          BEQ      PTNL3               B/ YES.  UNCONDITIONALLY START SIGNIF.
268F A601        53:          LDAA     1,X               GET FILL,
2691 2705        54:          BEQ      PTNL21              B/ DON'T PUT A NULL.
                 55:          ;JSR      LSTCP
2693 BD24A6      56:          JSR      LSTCP
                 57:          ;LDX      LTPTR             GET POINTER BACK.
2696 DE40        58:          LDX      LTPTR
                 59: *
  2698           60: PTNL21   EQU      *
2698 5A          61:          DECB
2699 32          62:          PULA
269A 26EB        63:          BNE      PTNL2
269C 39          64:          RTS
                 65: *
  269D           66: PTNL3    EQU      *
                 67:          ;JSR      LSTCP
269D BD24A6      68:          JSR      LSTCP
26A0 32          69:          PULA
26A1 5A          70:          DECB
26A2 26F9        71:          BNE      PTNL3
26A4 39          72: COLRTN   RTS




ASM/6800 1.3H4: 26A4 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 286; Form 14    - - - P U T B - - -
ASM14A.IOFM.ASM
                  2: *
                  3: *
                  4: *   P U T B
                  5: *
                  6: *        Output a byte to the BO tape, if this is pass 2 and
                  7: *        if BO was requested.  Always increment PC.  Also,
                  8: *        arrange for the listing of the byte.  Call LIST if we
                  9: *        just ran out of space in this listing line.
                 10: *
                 11: *
  26A5           12: PUTB     EQU      *
26A5 D6C4        13:          LDAB     PCPUT             HAS PC BEEN LISTED YET?
26A7 2604        14:          BNE      PUTB1             B/ YES:  DONT WORRY ABOUT IT.
26A9 36          15:          PSHA                       ELSE SAVE OUR BYTE,
26AA 8D46        16:          BSR      PUTPC             OUTPUT THE PC,
26AC 32          17:          PULA                       AND GET OUR BYTE BACK.
                 18: *
  26AD           19: PUTB1    EQU      *
                 20:          ;JSR      PNCHB             OUTPUT BYTE TO BO
26AD BD2749      21:          JSR      PNCHB
                 22:          ;LDX      PC                BUMP PC
26B0 DE96        23:          LDX      PC
26B2 08          24:          INX
26B3 DF96        25:          STX      PC
                 26:          ;LDX      LBFPT             GET POINTER TO NEXT BYTE IN LIST BUF
26B5 DEC2        27:          LDX      LBFPT
26B7 8D25        28: PUTB01   BSR      ATX2              MAKE (A) INTO HEX IN A,B
26B9 A700        29:          STAA     0,X               HOSE INTO BYTE 1
26BB E701        30:          STAB     1,X               HOSE INTO BYTE 2
                 31:          ;CLR      2,X               END BUFFER MARK.
26BD 6F02        32:          CLR      2,X
26BF 08          33:          INX
26C0 9CB8        34:          CPX      EOLBF             END OF BUFFER?
26C2 2708        35:          BEQ      PUTB2             B/ YES (I HAVE SOME SLOP)
26C4 08          36:          INX
26C5 9CB8        37:          CPX      EOLBF             I REPEAT...
26C7 2703        38:          BEQ      PUTB2             IF CPX GAVE REAL CC, T'WERE EASIER..
26C9 DFC2        39:          STX      LBFPT             SAVE POINTER
26CB 39          40:          RTS                        AND SPLIT.
                 41: *




ASM/6800 1.3H4: 26CB ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 287; Form 14    - - - P U T B - - -
ASM14A.IOFM.ASM
  26CC           42: PUTB2    EQU      *
                 43:          ;JSR      LIST              OUTPUT THIS LINE.
26CC BD220D      44:          JSR      LIST
  26CF           45: PUTB3    ;CLR      PCPUT             PC HASN'T BEEN PUT YET,
26CF 7F00C4      46:          CLR      PCPUT
                 47:          ;LDX      LBBEG             INITIALIZE POINTER,
26D2 DEB6        48:          LDX      LBBEG
26D4 DFC2        49: PUTB4    STX      LBFPT
                 50:          ;CLR      0,X               AND MARK END OF BUFFER
26D6 6F00        51:          CLR      0,X
26D8 39          52:          RTS




ASM/6800 1.3H4: 26D8 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 288; Form 15    - - - C L R L S T - - -
ASM14A.IOFM.ASM
                  2: *
                  3: *
                  4: *   C L R L S T
                  5: *
                  6: *        Clears listing flags, marks PC as not output.
                  7: *
  26D9            8: CLRLST   EQU      *
                  9:          ;CLR      LIST:T            CLEAR FLAGS FOR THIS LINE,
26D9 7F00C1      10:          CLR      LIST:T
26DC 20F1        11:          BRA      PUTB3             AND INITIALIZE ME.




ASM/6800 1.3H4: 26DC ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 289; Form 16    - - - B I N   T O   H E X   R O U T I N E S - - -
ASM14A.IOFM.ASM
                  2: *
                  3: *
                  4: *   A T X
                  5: *
                  6: *        Converts low-order nibble of ACCA to hex character in A.
                  7: *
                  8: *   A T X 2
                  9: *
                 10: *        Converts byte in ACCA to two hex characters:  high in
                 11: *        ACCA, low in ACCB.
                 12: *
                 13: *
  26DE           14: ATX2     EQU      *
26DE 36          15:          PSHA                       SAVE BYTE,
26DF 8D06        16:          BSR      ATX               CONVERT LOW NIBBLE.
26E1 16          17:          TAB                        SAVE IN ACCB,
26E2 32          18:          PULA                       AND CONVERT HIGH NIBBLE.
26E3 44          19:          LSRA                       EXTRACT IT
26E4 44          20:          LSRA
26E5 44          21:          LSRA
26E6 44          22:          LSRA
                 23: *                                   AND FALL INTO ATX.
                 24: *
  26E7           25: ATX      EQU      *
26E7 840F        26:          ANDA     #$F               MASK OFF NIBBLE,
26E9 8B30        27:          ADDA     #'0               MAKE HEX DIGIT,
                 28:          ;CMPA     #'9               OVERFLOW?
26EB 8139        29:          CMPA     #'9
26ED 2F02        30:          BLE      *+4               B/ NO: RETURN
26EF 8B07        31:          ADDA     #'A-'9-1          ELSE ADJUST
26F1 39          32:          RTS                        AND SPLIT.




ASM/6800 1.3H4: 26F1 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 290; Form 17    - - - P U T P C - - -
ASM14A.IOFM.ASM
                  2: *
                  3: *
                  4: *   P U T P C
                  5: *
                  6: *        Puts PC into listing buffer followed by a blank.  Sets
                  7: *        PCPUT so we remember that we put it.  Note that PC is
                  8: *        always listed at the extreme left of the listing buffer.
                  9: *
                 10: *
  26F2           11: PUTPC    EQU      *
                 12:          ;LDX     PC                SAVE FOR HEADER OUTPUT
26F2 DE96        13:          LDX      PC
26F4 DF98        14:          STX      LINEPC
                 15:          ;LDX      LBFPT             GET LISTING POINTER,
26F6 DEC2        16:          LDX      LBFPT
26F8 9696        17:          LDAA     PC                THOSE OF YOU WHO LIKE PRISTINE
26FA 8DBB        18:          BSR      PUTB01            CODE, PLEASE IGNORE THESE
26FC 9697        19:          LDAA     PC+1              FOUR LINES OF CODE.  YOU
26FE 8DB7        20:          BSR      PUTB01            REALLY DIDN'T WANT TO KNOW...
2700 8620        21:          LDAA     #BLANK            PUT A BLANK AFTER IT
2702 A700        22:          STAA     0,X               THUSLY,
2704 97C4        23:          STAA     PCPUT             REMEMBER THAT PC IS PUT,
2706 08          24:          INX
2707 20CB        25:          BRA      PUTB4             AND APPEND A NULL.




ASM/6800 1.3H4: 2707 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 291; Form 18    - - - M R K S K P - - -
ASM14A.IOFM.ASM
                  2: *
                  3: *
                  4: *   M R K S K P
                  5: *
                  6: *        Shovels *S* into listing buffer, sets LF:SKP and
                  7: *        returns.
                  8: *
                  9: *
  2709           10: MRKSKP   EQU      *
2709 96C1        11:          LDAA     LIST:T            MARK AS SKIPPED
270B 8A08        12:          ORAA     #LF:SKP
270D 97C1        13:          STAA     LIST:T
270F 8D1D        14:          BSR      STUFFB
2711 202A532A    15:          FCC      / *S*/
2715 00          16:          FCB      0
2716 39          17:          RTS
                 18: 
                 19: 




ASM/6800 1.3H4: 2716 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 292; Form 19    - - - P U T V - - -
ASM14A.IOFM.ASM
                  2: *
                  3: *
                  4: *   P U T V
                  5: *
                  6: *        Outputs VAL as a 2-byte number in listing field.  If
                  7: *        PCPUT is clear, then 2 blanks are stuffed into the
                  8: *        the listing buffer.
                  9: *
                 10: *        In any event, VAL is then stuffed into the next available
                 11: *        bytes.
                 12: *
                 13: *
  2717           14: PUTV     EQU      *
                 15:          ;LDX      LBFPT             GET A POINTER,
2717 DEC2        16:          LDX      LBFPT
2719 96C4        17:          LDAA     PCPUT             HAS PC BEEN OUTPUT?
271B 2605        18:          BNE      PUTV1             B/ YES.  NOTHING TO DO.
271D 8D0F        19:          BSR      STUFFB            STUFF SOME BYTES
271F 2020        20:          FCC      /  /               2 BLANKS
2721 00          21:          FCB      0                 AND A NULL
  2722           22: PUTV1    ;LDX      LBFPT             GET POINTER.
2722 DEC2        23:          LDX      LBFPT
2724 965F        24:          LDAA     VAL
                 25:          ;JSR      PUTB01            OUTPUT IT.
2726 BD26B7      26:          JSR      PUTB01
2729 9660        27:          LDAA     VAL+1
                 28:          ;JMP      PUTB01            ALSO LOW BYTE.
272B 7E26B7      29:          JMP      PUTB01




ASM/6800 1.3H4: 272B ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 293; Form 20    - - - S T U F F B - - -
ASM14A.IOFM.ASM
                  2: *
                  3: *
                  4: *   S T U F F B
                  5: *
                  6: *        Stuffs the string following the call into the listing
                  7: *        buffer.  No idiot checks.  Must be terminated by a null.
                  8: *
  272E            9: STUFFB   EQU      *
                 10:          ;PULX                      Get return address
272E 30          11:          TSX
272F EE00        12:          LDX      0,X
2731 31          13:          INS
2732 31          14:          INS
  2733           15: STFFBL   EQU      *
2733 A600        16:          LDAA     0,X
2735 DF36        17:          STX      TPTR1
                 18:          ;LDX      LBFPT
2737 DEC2        19:          LDX      LBFPT
2739 A700        20:          STAA     0,X
273B 2708        21:          BEQ      STFFBR
273D 08          22:          INX
273E DFC2        23:          STX      LBFPT
                 24:          ;LDX      TPTR1
2740 DE36        25:          LDX      TPTR1
2742 08          26:          INX
2743 20EE        27:          BRA      STFFBL
  2745           28: STFFBR   ;LDX      TPTR1             GET RETURN @
2745 DE36        29:          LDX      TPTR1
                 30:          ;JMP      1,X               AND LEAVE.
2747 6E01        31:          JMP      1,X




ASM/6800 1.3H4: 2747 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
