17BA 33         102:          PULB                       LOAD LOW LIMIT.
17BB 965F       103:          LDAA     VAL               IS THIS ZERO?
17BD 260D       104:          BNE      NUMERR            IF NOT, ILLEGAL VALUE
                105:          ;CLR     TPTR              (CLEAR HIGH-ORDER ADDRESS.)
17BF 7F0034     106:          CLR      TPTR
17C2 9660       107:          LDAA     VAL+1             GET LOW ORDER VALUE.
17C4 11         108:          CBA                        IS IT BIG ENUFF?
17C5 2505       109:          BCS      NUMERR                 B/ NO WAY.
                110:          ;LDX     TPTR              GET THE POINTER
17C7 DE34       111:          LDX      TPTR
17C9 A700       112:          STAA     0,X               SAVE THE VALUE
17CB 39         113:          RTS
  17CC          114: NUMERR   ;JMP     ILLVAL            ILLEGAL VALUE!
17CC 7E088B     115:          JMP      ILLVAL




