                 23:          ;JSR     DUMPVAL           DUMP LIST SORTED BY VALUE
2C29 BD2CA0      24:          JSR      DUMPVAL
                 25:          FIN
                 26:          ;JSR     CRLF              FINISH PRETTY PRINT
2C2C BD24CA      27:          JSR      CRLF
