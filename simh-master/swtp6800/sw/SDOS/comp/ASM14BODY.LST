ASM14A.EVAL.ASM
                  2: *
                  3: * HIT A TERMINATOR WHEN A VALUE WAS EXPECTED.  IN THIS CASE, THE
                  4: * STACK TOP IS AN OPERATOR.  UNLESS STACK-TOP = OP:BOX, DROP DEAD.
                  5: * OTHERWISE WIND DOWN GRACEFULLY.
                  6: *EXST8    TSX                        GET POINTER TO STACK TOP
                  7: *         LDAA     0,X               WHATS THE STACK TOP?
                  8: *         CMPA     #OP:BOX           IS IT COOL?
                  9: *         BNE      EXPSE1            B/ NO.  FLAMES AND SMOKE.
                 10: *         CLRA                       NULL EXP:  CLEAR THE VAL,
                 11: *         PSHA
                 12: *         PSHA
                 13: *         BRA      EXST7             AND WIND DOWN.
                 14: * NO NULL EXPS ALLOWED NOW
                 15: *
  1BD7           16: EXST8    ;JMP     EXPSE             ERROR HIM
1BD7 7E1B68      17:          JMP      EXPSE
                 18: *




ASM/6800 1.3H4: 1BD7 ASM/6800 1.4       - - - E X P R E S S I O N S - - -
08/16/82 00:00:00; Page 196; Form 12    - - - E X P - - -
ASM14A.EVAL.ASM
                  2: *21*
                  3: *
                  4: *  EXECUTE AN OPERATOR:
                  5: *
                  6: *   AT THIS POINT THE STACK LOOKS LIKE THIS:
                  7: *
                  8: *
                  9: *        SP+1  (OBH)  ==>  RIGHT-OP
                 10: *        SP+2  (OBL)
                 11: *        SP+3  (X:OP) ==>  OPERATOR
                 12: *
                 13: *   IF X:OP IS DYADIC THEN THERE ARE TWO MORE BYTES:
                 14: *        SP+4  (OAH)  ==>  LEFT-OP
                 15: *        SP+5  (OAL)
                 16: *
                 17: *  AFTER THE EXECUTION, RIGHT-OP, OPERATOR AND LEFT-OP ARE POPPED
                 18: *  AND THE STACK LOOKS LIKE THIS:
                 19: *
                 20: *        SP+1  ==> RESULT HIGH
                 21: *        SP+2  ==> RESULT LOW
                 22: *
  0000           23: OBH      EQU      0
  0001           24: OBL      EQU      1
  0002           25: X:OP     EQU      2
  0003           26: OAH      EQU      3
  0004           27: OAL      EQU      4
                 28: *
1BDA A602        29: ES3XO    LDAA     X:OP,X            GET OPERATOR OFF STACK...
                 30:          ;JSR      WHICH             AND FIND OUT WHAT IT IS...
1BDC BD0832      31:          JSR      WHICH
                 32: *
                 33: * NB -- THE ORDER OF OPS IN THIS TABLE DETERMINES HOW QUICKLY
                 34: * AN OPERATOR IS RECOGNIZED...
                 35: *
1BDF 11          36:          FCB      +OP:BOX           <LEFT-ANCHOR>
1BE0 1D0A        37:          FDB      XBOX
1BE2 41          38:          FCB      +OP:ADD           A+B
1BE3 1C2E        39:          FDB      XADD
1BE5 42          40:          FCB      +OP:SUB           A-B
1BE6 1C3E        41:          FDB      XSUB




ASM/6800 1.3H4: 1BE8 ASM/6800 1.4       - - - E X P R E S S I O N S - - -
08/16/82 00:00:00; Page 197; Form 12    - - - E X P - - -
ASM14A.EVAL.ASM
1BE8 51          42:          FCB      +OP:MUL           A*B
1BE9 1D18        43:          FDB      XMUL
1BEB 52          44:          FCB      +OP:DIV           A/B
1BEC 1D23        45:          FDB      XDIV
  0001           46:          IF       SHIFT=1
1BEE 61          47:          FCB      +OP:SHF           A##B
1BEF 1C46        48:          FDB      XSHF
                 49:          FIN
1BF1 21          50:          FCB      +OP:IOR           A!B
1BF2 1C6A        51:          FDB      XIOR
1BF4 24          52:          FCB      +OP:AND           A&B
1BF5 1C72        53:          FDB      XAND
1BF7 22          54:          FCB      +OP:EOR           A!!B
1BF8 1C7A        55:          FDB      XEOR




