ASM14A.IOFM.ASM
                 82:          ;LDX     NEW               NEW:=NEXT(NEW)
2D88 DE4E        83:          LDX      NEW
                 84:          ;LDX     S:NEXT,X
2D8A EE00        85:          LDX      S:NEXT,X
2D8C DF4E        86:          STX      NEW
                 87:          ;LDX     LAST              NEXT(NEXT(LAST)):=THIS
2D8E DE4A        88:          LDX      LAST
                 89:          ;LDX     S:NEXT,X
2D90 EE00        90:          LDX      S:NEXT,X
