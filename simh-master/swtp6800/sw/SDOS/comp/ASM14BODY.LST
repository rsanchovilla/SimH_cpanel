                  6: *
                  7: * GO SORT INDIVIDUAL SUBLISTS THEN SORT THE WHOLE THING
                  8: *
  2CEF            9: SORT     EQU      *
                 10:          ;JSR     TBLSORT           SORT ALL THE SUBLISTS
2CEF BD2D4B      11:          JSR      TBLSORT
                 12: *
                 13: *        NOW MERGE THE CHAINS
                 14: *
                 15:          ;LDX     #0                INITZ DEFINED SYMBOL COUNT TO ZERO
2CF2 CE0000      16:          LDX      #0
2CF5 DF5F        17:          STX      VAL
2CF7 DF46        18:          STX      SCHAIN            SET SORTED LIST TO EMPTY
                 19:          ;LDX     #SCHAIN           SET END OF LIST POINTER TO A(HEAD)
2CF9 CE0046      20:          LDX      #SCHAIN
2CFC DF50        21:          STX      SORTAIL
  2CFE           22: SORT0    ;LDX     #HSHTBL           NOW SCAN THE HASH TABLE
2CFE CE308D      23:          LDX      #HSHTBL
2D01 DF48        24:          STX      BUCKET            REMEMBER WHICH BUCKET WE ARE FOOLING WITH
                 25: * X=BEST BUCKET FOUND SO FAR
2D03 DF4A        26: SORT1    STX      LAST              THIS IS LAST SYMBOL WE LOOKED AT
                 27:          ;LDX     S:NEXT,X          FIND NEXT SYMBOL IN BUCKET CHAIN
2D05 EE00        28:          LDX      S:NEXT,X
2D07 DF4C        29:          STX      THIS
                 30: *
                 31: * LAST - PTR TO BEST BUCKET FOUND
                 32: * THIS - PTR TO FIRST SYM IN BEST BUCKET FOUND
                 33: *
  2D09           34: SORT2    ;LDX     BUCKET            SCAN OTHER BUCKET HEADS...
2D09 DE48        35:          LDX      BUCKET
                 36:          ;LEAX    2,X
  0000           37:          IF       2<0
 *S*             38:          RPT      -2
 *S*             39:          DEX
                 40:          ELSE
