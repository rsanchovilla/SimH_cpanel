ASM/6800 1.3H4: 1AF2 ASM/6800 1.4       - - - E X P R E S S I O N S - - -
08/16/82 00:00:00; Page 181; Form 1     - - - E X P R E S S I O N   E V A L U A T I O N - - -
ASM14A.EVAL.ASM
                  3: *    E X P R E S S I O N   E V A L U A T I O N
                  4: *
                  5: *
                  6: *  EVAL --
                  7: *
                  8: *        EATS EXP POINTED TO BY EXPTR.
                  9: *
                 10: *  EVAF --
                 11: *
                 12: *        EATS EXP POINTED TO BY AFPTR.  IF AFPTR IS ZERO, RETURNS
                 13: *        XTYPE:=0, VAL:=0.
                 14: *
                 15: *  THE FOLLOWING OPERATORS ARE RECOGNIZED:
                 16: *
                 17: *        DYADIC   MONADIC           WIERD
                 18: *        ------   -------           -----
                 19: *         +         +                 (
                 20: *         -         -                 )
                 21: *         *         \ (LOG. COMP)
                 22: *         /         & (TEST INV.)
                 23: *        ## (SHIFT)
                 24: *         !
                 25: *         &
                 26: *         !!
                 27: *         //  (COVERED QUOTIENT)
                 28: *         \   (REMAINDER)
                 29: *         #   (.NE.)
                 30: *         <   (.LT.)
                 31: *         >   (.GT.)
                 32: *         <=  (.LE.)
                 33: *         =<  (.LE.)
                 34: *         >=  (.GE.)
                 35: *         =>  (.GE.)
                 36: *         =   (.EQ.)
                 37: *         <<  (.LO.)
                 38: *         >>  (.HI.)
                 39: *         \<  (.LS.)
                 40: *         >/  (.HS.)
                 41: *




ASM/6800 1.3H4: 1AF2 ASM/6800 1.4       - - - E X P R E S S I O N S - - -
08/16/82 00:00:00; Page 182; Form 2     - - - E X P R E S S I O N   E V A L U A T I O N - - -
ASM14A.EVAL.ASM
                  1: *   PRECEDENCE:
                  2: *   -----------
                  3: *
                  4: *   1.   UNARY  +,-,\,&
                  5: *   2.   ##
                  6: *   3.   *,/,//,\
                  7: *   4.   +,-
                  8: *   5.   RELATIONALS
                  9: *   6.   &,!,!!
                 10: *




ASM/6800 1.3H4: 1AF2 ASM/6800 1.4       - - - E X P R E S S I O N S - - -
08/16/82 00:00:00; Page 183; Form 3     - - - E X P R E S S I O N   E V A L U A T I O N - - -
ASM14A.EVAL.ASM
                  2: *20*
                  3: *
                  4: *  OBJECTS:
                  5: *  --------
                  6: *
                  7: *        1.  SYMBOLS (START W/ A-Z;  CONTAIN A-Z, 0-9, :, %, $, @
                  8: *        2.  $XXXXX  (HEX NUMBER)
                  9: *        3.  @OOOOO  (OCTAL NUMBER)
                 10: *        4.  %BBBBB  (BINARY NUMBER)
                 11: *        5.  DDDDDD  (DECIMAL NUMBER)
                 12: *        6.  "CC"    (STRING)
                 13: *        7.  'C      (ASCII CHARACTER)
                 14: *        8.  DXXXXH  (HEX NUMBER)
                 15: *        9.  00000O  (OCTAL NUMBER)
                 16: *       10.  00000Q  (OCTAL NUMBER)
                 17: *       11.  00000B  (BINARY NUMBER)
                 18: *




ASM/6800 1.3H4: 1AF2 ASM/6800 1.4       - - - E X P R E S S I O N S - - -
08/16/82 00:00:00; Page 184; Form 4     - - - E V A F  /  E V A L - - -
ASM14A.EVAL.ASM
                  2: *47*
                  3: *
                  4: * EVAF
                  5: *        EVALUATE AF IF NO AF - SYNTAX ERROR
                  6: *
                  7: * AFPTR PTS TO THING TO EVAL
                  8: *
  1AF3            9: EVAF     ;LDX      AFPTR             GET POINTER,
1AF3 DE26        10:          LDX      AFPTR
1AF5 DF28        11: EVAFX    STX      EXPTR             AND SHOVE IT.
1AF7 2705        12:          BEQ      EVAF9             B/ NOTHING TO DO...
                 13:          ;CLR      RJOBJ             NO REJECTED OBJECT
1AF9 7F005C      14:          CLR      RJOBJ
1AFC 200A        15:          BRA      EVAF1             B/ POINTER IS GOOD; EVAL EXP.
1AFE 4F          16: EVAF9    CLRA                       ZERO A BUNCH'A CELLS.
1AFF 975F        17:          STAA     VAL               LIKE, VALUE,
1B01 9760        18:          STAA     VAL+1               SECOND BYTE,
1B03 9759        19:          STAA     XTYPE               EXPRESSION TYPE.
                 20:          ;JMP     ILLAF             SYN ERR IF NO AF
1B05 7E086B      21:          JMP      ILLAF
                 22: *
  1B08           23: EVAF1    ;JSR     GNOBJ             PEEK AT FIRST TOKEN.
1B08 BD1E2C      24:          JSR      GNOBJ
                 25:          ;INC     RJOBJ               (I SHOULD'A PUT IN A PEEK-NEXT.)
1B0B 7C005C      26:          INC      RJOBJ
                 27:          ;CMPA    #O:TERM           IS ANYTHING HERE TO EVALUATE?
1B0E 8106        28:          CMPA     #O:TERM
1B10 27EC        29:          BEQ      EVAF9               B/ NO.  ERROR, CLEAR VALUE AND SPLIT.
                 30: 
1B12 8D10        31:          BSR      EVAL              OK.  GO SEE WHAT HAPPENS.
1B14 7D009F      32:          TST      EVAFBIAS          Bias evaluator output?
1B17 2708        33:          BEQ      EVAF3             B/No
                 34:          ;LDX     VAL
1B19 DE5F        35:          LDX      VAL
1B1B 08          36:          INX                        Bias expression value by +1
1B1C DF5F        37:          STX      VAL
                 38:          ;CLR     EVAFBIAS          Reset bias flag
1B1E 7F009F      39:          CLR      EVAFBIAS
  1B21           40: EVAF3    ;LDX      EXPTR             GET EXPRESSION POINTER,
1B21 DE28        41:          LDX      EXPTR




ASM/6800 1.3H4: 1B23 ASM/6800 1.4       - - - E X P R E S S I O N S - - -
08/16/82 00:00:00; Page 185; Form 4     - - - E V A F  /  E V A L - - -
ASM14A.EVAL.ASM
1B23 39          42: EVRTS    RTS                        AND GO HOME.
                 43: *
                 44: *
1B24 8D28        45: EVAL     BSR      EXP               EVALUATE THE EXPRESSION.
                 46:          ;JSR      GNOBJ             GET THE TRAILING OBJECT
1B26 BD1E2C      47:          JSR      GNOBJ
                 48:          ;INC      RJOBJ             AND REJECT IT.
1B29 7C005C      49:          INC      RJOBJ
                 50:          ;CMPA     #O:TERM           IS IT A TERMINATOR?
1B2C 8106        51:          CMPA     #O:TERM
1B2E 27F3        52:          BEQ      EVRTS             B/ YES:  THIS IS OK.
                 53:          ;JMP      SYNTAX            ELSE FLAG ERROR.
1B30 7E0867      54:          JMP      SYNTAX




ASM/6800 1.3H4: 1B30 ASM/6800 1.4       - - - E X P R E S S I O N S - - -
08/16/82 00:00:00; Page 186; Form 5     - - - E V A F C T - - -
ASM14A.EVAL.ASM
                  2: *
                  3: * EVAFCT --
                  4: *        FIND AF, EVALUATE IT, AND CROAK IF AF IS A FWD REF, ETC.
                  5: *
  1B33            6: EVAFCT   ;JSR      FINDAF            FIND THE ARG FIELD.
1B33 BD206C       7:          JSR      FINDAF
1B36 8DBB         8:          BSR      EVAF              EVALUATE,
1B38 2002         9:          BRA      ISCTR
                 10: *
                 11: *
                 12: *  E V A L C T
                 13: *                 EVALUATE AND CHECK TYPE
                 14: *
                 15: *  IF TYPE = FREF OR UNDEF THEN GIVE ILL VAL ERR AND
                 16: * RETURN WITH Z#0
                 17: *
                 18: *
                 19: *
  1B3A           20: EVALCT   EQU      *
1B3A 8DE8        21:          BSR      EVAL
                 22: *
                 23: *
                 24: *  I S C T R
                 25: *
                 26: *
1B3C 9659        27: ISCTR    LDAA     XTYPE             GET THE EXPR. TYPE,
1B3E 8505        28:          BITA     #XT:FREF!XT:UNDF  IS IT A FORWARD REF?
1B40 27E1        29:          BEQ      EVRTS             B/ NO ==> ITS OK.
1B42 4F          30:          CLRA                       BAD EXP:
1B43 975F        31:          STAA     VAL               VAL := 0
1B45 9760        32:          STAA     VAL+1
1B47 9759        33:          STAA     XTYPE             REMEMBER TO ZAP THE TYPE TO NICENESS.
                 34:          ;JSR      ILLVAL            *E* ILLEGAL VALUE.
1B49 BD088B      35:          JSR      ILLVAL
1B4C 4C          36:          INCA                       SET CCZ
1B4D 39          37:          RTS                        AND RETURN.




ASM/6800 1.3H4: 1B4D ASM/6800 1.4       - - - E X P R E S S I O N S - - -
08/16/82 00:00:00; Page 187; Form 6     - - - E X P - - -
ASM14A.EVAL.ASM
                  2: *20*
                  3: *
                  4: *   EXP:
                  5: *
                  6: *        THE EXPRESSION EVALUATOR IS A FINITE STATE MACHINE.
                  7: *
                  8: *        ST0:     PUSH OP:BOX; ==> ST1.
                  9: *
                 10: *        ST1:     READ:  O:VAL ==> ST2; O:OP ==> ST4; '( ==> ST5;
                 11: *                        O:TERM ==> ST8.
                 12: *
                 13: *        ST2:     PUSH VALUE;
                 14: *                 READ:  O:OP ==> ST3; O:VAL ==> ERROR; OTHERWISE ST7.
                 15: *
                 16: *        ST3:     IF PRECEDENCE (OP) > PRECEDENCE(STACKED-OP) THEN
                 17: *                    PUSH OP, ==> ST1
                 18: *                 ELSE EXECUTE STACKED-OP, ==> ST3
                 19: *
                 20: *        ST4:     IF OP = * THEN VAL:=PC, ==> ST2
                 21: *                 IF OP = +,-,&,\ THEN MAKE MONADIC OP, ==> ST3
                 22: *                 ELSE SYNTAX ERROR.
                 23: *
                 24: *        ST5:     RECURSIVELY CALL EXP. ==> ST6
                 25: *
                 26: *        ST6:     READ '), ==> ST2
                 27: *
                 28: *        ST7:     SET OP TO OP:EOX, ==>ST3
                 29: *
                 30: *        ST8:     IS STACKED-OP OP:BOX?  YES, VAL:=0, ==> ST7
                 31: *                 NO ==> SYNTAX ERROR.
                 32: *




ASM/6800 1.3H4: 1B4D ASM/6800 1.4       - - - E X P R E S S I O N S - - -
08/16/82 00:00:00; Page 188; Form 7     - - - E X P - - -
ASM14A.EVAL.ASM
                  2: *20*
                  3: *
                  4: *  EXP IS THE ENTRY WHICH SAVES THE STACK POINTER IN FLAMOUT, SO
                  5: *  WE CAN ABORT IN CASE OF ERROR.  THE LEFT PAREN HANDLER CALLS
                  6: *  EXP THROUGH EXP:R.
                  7: *
                  8: *  EXPSE IS THE ABORT EXIT.  IT LOADS THE STACK POINTER FROM
                  9: *  FLAMOUT AND LEAVES VAL AND XTYPE AS THEY STAND.  IT EXITS THRU
                 10: *  THE SYNTAX ERROR REPORTER.
                 11: *
                 12: *
1B4E 9F2A        13: EXP      STS      FLAMOUT           SAVE THE STACK POINTER.
1B50 4F          14:          CLRA                       ZAP A FEW CELLS...
1B51 9759        15:          STAA     XTYPE             EXPRESSION TYPE,
                 16: *
1B53 8611        17: EXP:R    LDAA     #OP:BOX           PUSH BEGINNING OF EXP MARKER.
1B55 36          18:          PSHA
1B56 8D60        19: EXST1    BSR      GNOB:SJ           SORT-JUMP ON NEXT OBJECT
1B58 02          20:          FCB      +O:NUM            NUMBER?
1B59 1B80        21:          FDB      EXST2             NUMBER ==> STATE 2
                 22: *
  0000           23:          DO       STRINGS=1
 *S*             24:          FCB      +O:STR
 *S*             25:          FDB      EXST2S            STRING ==> ST2 (STRING)
                 26:          FIN
                 27: *
1B5B 01          28:          FCB      +O:SYM
1B5C 1B75        29:          FDB      EXST2SY           SYM ==> ST2(SYM)
1B5E 07          30:          FCB      +O:OP
1B5F 1BBE        31:          FDB      EXST4             UNARY OP ==> ST4
1B61 04          32:          FCB      +O:LP
1B62 1BAD        33:          FDB      EXST5             '( ==> ST5
1B64 06          34:          FCB      +O:TERM
1B65 1BD7        35:          FDB      EXST8             TERMINATOR ==> ST8
1B67 00          36:          FCB      0
                 37: *
                 38: * SYNTAX ERROR
1B68 9E2A        39: EXPSE    LDS      FLAMOUT           RESTORE STACK POINTER,
1B6A 4F          40:          CLRA                       CLEAR THE VALUE IF ERROR
1B6B 975F        41:          STAA     VAL




ASM/6800 1.3H4: 1B6D ASM/6800 1.4       - - - E X P R E S S I O N S - - -
08/16/82 00:00:00; Page 189; Form 7     - - - E X P - - -
ASM14A.EVAL.ASM
1B6D 9760        42:          STAA     VAL+1
                 43:          ;INC     RJOBJ             SAY 'I DIDN'T SEE THE LAST OBJECT'
1B6F 7C005C      44:          INC      RJOBJ
                 45:          ;JMP      SYNTAX            AND EXIT GIVING SYNTAX ERROR
1B72 7E0867      46:          JMP      SYNTAX




ASM/6800 1.3H4: 1B72 ASM/6800 1.4       - - - E X P R E S S I O N S - - -
08/16/82 00:00:00; Page 190; Form 8     - - - E X P - - -
ASM14A.EVAL.ASM
                  1: *
                  2: * SAW A STRING:
  0000            3:          DO       STRINGS=1
 *S*              4: EXST2S   EQU      *
 *S*              5:          CLRB                       CLEAR OVERFLOW BYTE...
 *S*              6:          LDAA     STBUF             GET LENGTH OF STRING:
 *S*              7:          ;CMPA     #2                MAXIMUM FOR SIXTEEN BITS,
 *S*              8:          CMPA     #2
 *S*              9:          BLT      EST2S1            B/ ONE CHARACTER.
 *S*             10:          BEQ      EST2S2            B/ TWO CHARACTERS.
 *S*             11:          ;JSR      OVRFLW            *E* STRING IN EXPRESSION TOO LONG
 *S*             12:          JSR      OVRFLW
 *S*             13: EST2S2   LDAA     STBUF+2           GET L(VAL) = STRING(2)
 *S*             14:          LDAB     STBUF+1           MAKE H(VAL) := STRING(1)
 *S*             15:          BRA      EXST21            GO SAVE VALUE.
 *S*             16: * ONE OR NO CHARACTERS...
 *S*             17: EST2S1   LDAA     STBUF+1           H(VAL)=0, L(VAL)= STRING(1)
 *S*             18:          BRA      EXST21            GO SAVE VALUE
                 19:          FIN



                 21: *
                 22: * SAW A SYMBOL:
  1B75           23: EXST2SY  ;JSR      SYMLK             LOOK IT UP.
1B75 BD2149      24:          JSR      SYMLK
1B78 9661        25:          LDAA     TYPE              MERGE TYPE INTO XTYPE.
1B7A 8405        26:          ANDA     #XT:FREF!XT:UNDF    BUT ONLY THESE BITS SHOULD
1B7C 9A59        27:          ORAA     XTYPE               BE CARRIED, AS OTHERWISE THINGS CAN GET
1B7E 9759        28:          STAA     XTYPE               VERY CONFUSED, IN PARTICULAR EQU'S AND SET'S.



                 30: *
                 31: * SAW A VALUE:
1B80 9660        32: EXST2    LDAA     VAL+1             GET VALUE,
1B82 D65F        33:          LDAB     VAL
1B84 36          34: EXST21   PSHA                       A=L(VAL), B=H(VAL)
1B85 37          35:          PSHB
1B86 8D30        36:          BSR      GNOB:SJ          READ AND FORK




ASM/6800 1.3H4: 1B88 ASM/6800 1.4       - - - E X P R E S S I O N S - - -
08/16/82 00:00:00; Page 191; Form 8     - - - E X P - - -
ASM14A.EVAL.ASM
1B88 07          37:          FCB      +O:OP
1B89 1B97        38:          FDB      EXST31            OP ==> TRY AND EXECUTE IT (JUST TRY)
1B8B 02          39:          FCB      +O:NUM
1B8C 1B68        40:          FDB      EXPSE
1B8E 01          41:          FCB      +O:SYM
1B8F 1B68        42:          FDB      EXPSE
                 43: *
  0000           44:          DO       STRINGS=1
 *S*             45:          FCB      +O:STR
 *S*             46:          FDB      EXPSE
                 47:          FIN
                 48: *
1B91 00          49:          FCB      $0




ASM/6800 1.3H4: 1B91 ASM/6800 1.4       - - - E X P R E S S I O N S - - -
08/16/82 00:00:00; Page 192; Form 9     - - - E X P - - -
ASM14A.EVAL.ASM
                  1: 
                  2: *  END OF EXPRESSION
  1B92            3: EXST7    ;INC      RJOBJ             MARK AS REJECTED.
1B92 7C005C       4:          INC      RJOBJ
1B95 C601         5:          LDAB     #OP:EOX           GET CORRECT OPERATOR (END OF EXP)
1B97 D75D         6: EXST31   STAB     CUROP             SAVE THE OPCODE IN A HANDY PLACE.
                  7: *
                  8: *  OPERATOR SEEN:
1B99 30           9: EXST3    TSX                        GET INDEX INTO STACK:
1B9A D65D        10:          LDAB     CUROP             GET NEW OPERATOR,
1B9C C4F0        11:          ANDB     #$F0              THROW AWAY LSB FOR PRECEDENCE COMPARE
                 12:          ;CMPB     X:OP,X            DO THE COMPARE.
1B9E E102        13:          CMPB     X:OP,X
                 14: *21*
1BA0 2338        15:          BLS      ES3XO             B/ GO EXECUTE THE OPERATOR
                 16: *
                 17: *  THIS OPERATOR HAS HIGHER PRECEDENCE:  STACK IT.
1BA2 96BA        18:          LDAA     OPTF              GET OPTION FLAGS:
1BA4 8501        19:          BITA     #OPT:MCM          MCM/MOTOROLA OPERATOR PRECEDENCE?
1BA6 2632        20:          BNE      ES3XO             B/ YES:  GO DO THAT OPERATOR.
1BA8 D65D        21: ES3SO    LDAB     CUROP             GET THE OPERATOR
1BAA 37          22: ES3SO1   PSHB                       PUT IT ON THE STACK,
1BAB 20A9        23:          BRA      EXST1             AND GO READ AN OPERAND.




ASM/6800 1.3H4: 1BAB ASM/6800 1.4       - - - E X P R E S S I O N S - - -
08/16/82 00:00:00; Page 193; Form 10    - - - E X P - - -
ASM14A.EVAL.ASM
                  1: 
                  2: *
                  3: * STATE 5 --
                  4: *        LEFT PAREN HAS BEEN SEEN.  CALL THE EXPRESSION EVALUATOR
                  5: *        (THAT'S US, GUYS) TO EVALUATE THE ENCLOSED EXPRESSION.  THEN
                  6: *        IF THE CLOSING PAREN IS MISSING, BITCH.
                  7: *
1BAD 8DA4         8: EXST5    BSR      EXP:R             REENTER EXPRESSION
                  9:          ;JSR      GNOBJ
1BAF BD1E2C      10:          JSR      GNOBJ
                 11:          ;CMPA     #O:RP             RIGHT PAREN?
1BB2 8105        12:          CMPA     #O:RP
1BB4 27CA        13:          BEQ      EXST2             GO, BABY, GO.
1BB6 20B0        14:          BRA      EXPSE             B/ ANYTHING ELSE ==> ERROR.
                 15: *
                 16: *
  1BB8           17: GNOB:SJ  ;JSR      GNOBJ
1BB8 BD1E2C      18:          JSR      GNOBJ
                 19:          ;JMP      WHICH
1BBB 7E0832      20:          JMP      WHICH
                 21: **
                 22: *
                 23: *
                 24: *  SAW A MONADIC OP
  1BBE           25: EXST4    ;CMPB     #OP:MUL           IS IT A '*'?
1BBE C151        26:          CMPB     #OP:MUL
1BC0 270F        27:          BEQ      EXPC              RETURN PC
1BC2 17          28:          TBA
                 29:          ;JSR      ISIT              IS IT A VALID MONADIC OP?
1BC3 BD08DE      30:          JSR      ISIT
1BC6 41422453    31:          FCB      OP:ADD,OP:SUB,OP:AND,OP:MOD,0
1BCB 269B        32: EXPSE1   BNE      EXPSE             B/ NO.  DIE.
1BCD CA70        33:          ORAB     #P:UN             GET PROPER PRECEDENCE,
1BCF 20D9        34:          BRA      ES3SO1            AND GO STACK IT.
                 35: *
                 36: * SAW * IN CONTEXT WHICH MEANS 'PC'
                 37: *
  1BD1           38: EXPC
  0001           39:          IFUND    MC6809
  0001           40:          ELSE




