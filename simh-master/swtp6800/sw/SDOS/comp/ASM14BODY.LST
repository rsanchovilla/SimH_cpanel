ASM14A.DREX.ASM
 *S*             42:          JMP      LIST
                 43:          FIN




ASM/6800 1.3H4: 0B05 ASM/6800 1.4       - - -   D E C O D E   L I N E   - - -
08/16/82 00:00:00; Page 70; Form 3      - - -  D O I T E X  - - -
ASM14A.DREX.ASM
                  2: *
                  3: *
                  4: *  D O I T E X
                  5: *
                  6: *        TAKES LINES OF FORM
                  7: *        <EXP>,<EXP>,<EXP>,<EXP>
                  8: *        AND EVALUATES THEM.  IF THE VALUE IS BETWEEN
                  9: *        0 AND 255, IT IS STUCK INTO 1 BYTE; OTHERWISE
                 10: *        IT IS HOSED INTO TWO.
                 11: *
                 12: *
  0B08           13: DOITEX   EQU      *
                 14: *
  0001           15:          DO       NICE=1
                 16: 
                 17:          ;JSR       LFPC            Set LF to value of PC   ; ZZZ Added by Roberto Sa
0B08 BD21DB      18:          JSR      LFPC
                 19:                                                           ; In order to allow assembl
                 20:                                                           ; as generaed by basic comp
                 21: 
                 22:          ;LDX      CFPTR             GET POINTER TO CF(1)
0B0B DE24        23:          LDX      CFPTR
0B0D DF28        24:          STX      EXPTR             INITIALIZE EXPTR,
                 25:          ;CLR      RJOBJ             NO REJECTED OBJECT.
0B0F 7F005C      26:          CLR      RJOBJ
                 27: *
  0B12           28: DOEXPL   EQU      *                 EXPRESSION SCANNING LOOP.
                 29:          ;JSR     GETXC             FIND ANY QUALIFIERS,
0B12 BD1F95      30:          JSR      GETXC
                 31:          ;JSR     WHICH               AND FORK ON SAME.
0B15 BD0832      32:          JSR      WHICH
                 33: 
0B18 2B0B43      34:          '+,DOEX1B                  LEADING PLUS ==> ONE BYTE.
0B1B 2D0B43      35:          '-,DOEX1B                  LEADING MINUS ==> ONE BYTE.
0B1E 230B5A      36:          '#,DOEX2B                  LEADING HASH ==> TWO BYTES.
0B21 00          37:          0                             <END OF LIST>
                 38: 
                 39: *** HANDLE IN DEFAULT FASHION.
                 40:          ;JSR     REJXC             IT'S A GOOD IDEA TO THROW BACK WHAT YOU CANT EAT.
0B22 BD1F9E      41:          JSR      REJXC




ASM/6800 1.3H4: 0B22 ASM/6800 1.4       - - -   D E C O D E   L I N E   - - -
08/16/82 00:00:00; Page 71; Form 3      - - -  D O I T E X  - - -
ASM14A.DREX.ASM
                 42:          ;JSR     EVNUL             EVALUATE 1ST FIELD,
0B25 BD13A9      43:          JSR      EVNUL
0B28 965F        44:          LDAA     VAL               PICK UP HIGH BYTE, IN CASE WE DECIDE TO PUT IT.
0B2A D659        45:          LDAB     XTYPE             IF EXPRESSION IS FWD-REF OR UNDEF,
0B2C C505        46:          BITB     #XT:FREF!XT:UNDF    THEN WE WILL ALWAYS ASSIGN 2 BYTES.
0B2E 2603        47:          BNE      DOEXP0            B/ PUT 2 BYTES.
0B30 4D          48:          TSTA                       OTHERWISE, WE DONT PUT H(VAL) UNLESS
                 49:                                     ; IT'S NON-ZERO.
0B31 2703        50:          BEQ      DOEXP1            B/ ONLY 1.
  0B33           51: DOEXP0   ;JSR      PUTB              ELSE OUTPUT HIGH.
0B33 BD26A5      52:          JSR      PUTB
0B36 9660        53: DOEXP1   LDAA     VAL+1             GET LOW BYTE
                 54:          ;JSR      PUTB              AND OUTPUT IT.
0B38 BD26A5      55:          JSR      PUTB
                 56:          ;JSR      GTCMA             FIND A COMMA
0B3B BD1E1C      57:          JSR      GTCMA
0B3E 29D2        58:          BVS      DOEXPL            B/ FOUND ONE.
                 59:          ;JMP      LIST              ELSE ALL DONE: SPLIT.
0B40 7E220D      60:          JMP      LIST
                 61: 
                 62: 
                 63: *** GENERATE IN ONE BYTE ONLY.
  0B43           64: DOEX1B   EQU      *
                 65:          ;JSR     REJXC             GIVE SIGN BACK TO EXPRESSION EVALUATOR,
0B43 BD1F9E      66:          JSR      REJXC
                 67:          ;JSR     EVAL                YUM...
0B46 BD1B24      68:          JSR      EVAL
0B49 965F        69:          LDAA     VAL               CHECK FOR VALUE IN RANGE.
0B4B 27E9        70:          BEQ      DOEXP1              B/ 0 =< VAL =< $FF, FINE.
                 71:          ;CMPA    #$FF              (HIGH BYTE MUST BE ALL ONES)
0B4D 81FF        72:          CMPA     #$FF
0B4F 2604        73:          BNE      DOEX1B1             B/ NOPE -- OVERFLOW.
0B51 D660        74:          LDAB     VAL+1             (IF SIGN IS ON, SIGN MUST BE ON IN LOW BYTE.)
0B53 2BE1        75:          BMI      DOEXP1              B/ FAR OUT.  VALUE IS GOOD.
                 76: 
  0B55           77: DOEX1B1  EQU      *
                 78:          ;JSR     OVRFLW            *E* REPORT OVERFLOW.
0B55 BD0883      79:          JSR      OVRFLW
0B58 20DC        80:          BRA      DOEXP1              BUT GENERATE IN ONE BYTE ANYWAY.
                 81: 




ASM/6800 1.3H4: 0B58 ASM/6800 1.4       - - -   D E C O D E   L I N E   - - -
08/16/82 00:00:00; Page 72; Form 3      - - -  D O I T E X  - - -
ASM14A.DREX.ASM
                 82: 
                 83: *** GENERATE TWO BYTES FOR "#<EXP>"
  0B5A           84: DOEX2B   EQU      *
                 85:          ;JSR     EVAL              EAT THE EXPRESSION (NOTE THAT NULL EXP IS BAD HER
0B5A BD1B24      86:          JSR      EVAL
0B5D 965F        87:          LDAA     VAL               GET BYTE TO BE OUTPUT,
0B5F 20D2        88:          BRA      DOEXP0            AND OUTPUT TWO BYTES.
  0002           89:          ELSE                       YOU LOSE, BUCKWHEAT...
 *S*             90:          ;JSR      SYNTAX            BARF.
 *S*             91:          JSR      SYNTAX
 *S*             92:          ;JMP      LIST
 *S*             93:          JMP      LIST
                 94:          FIN
                 12:          END      ;UNEXPECTED EOF




