                 89:          ;JSR     PUTT
2AF9 BD2A3F      90:          JSR      PUTT
2AFC 42696E61    91:          FCC      /Binary File=/
2B08 00          92:          FCB      0
2B09 8D2E        93:          BSR      GETNAME           GET A NAME
2B0B 2606        94:          BNE      WANTBO            IF NOT, NULL HANDLE
