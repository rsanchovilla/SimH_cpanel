ASM14A.IOFM.ASM
                  2: *        REHASH
                  3: *        RETURNS A SYMBOL TO ITS HASH CHAIN.
                  4: *        SYMPT POINTS TO A SYMBOL.
                  5: *        USES SPECIAL ENTRY TO HASH.
                  6: *
  2DF0            7: REHASH   EQU      *
                  8:          ;LDX     SYMPT             GET SYMBOL ADDRESS
2DF0 DE38         9:          LDX      SYMPT
                 10:          ;JSR     HASH:PTR          X:=HASH BUCKET ADDRESS
2DF2 BD208B      11:          JSR      HASH:PTR
  2DF5           12: REHASH0  EQU      *
2DF5 6D00        13:          TST      S:NEXT,X          FIND END OF CHAIN
2DF7 2604        14:          BNE      REHASH1
2DF9 6D01        15:          TST      S:NEXT+1,X
2DFB 2704        16:          BEQ      REHASH2
  2DFD           17: REHASH1  EQU      *
                 18:          ;LDX     S:NEXT,X          FOLLOW LINKS TO END OF CHAIN
2DFD EE00        19:          LDX      S:NEXT,X
2DFF 20F4        20:          BRA      REHASH0
                 21: *
  2E01           22: REHASH2  EQU      *
                 23:          ;LDD     SYMPT             TACK THIS SYMBOL ON TO END OF HASH CHAIN
2E01 D639        24:          LDAB     SYMPT+1
2E03 9638        25:          LDAA     SYMPT
                 26:          ;STD     S:NEXT,X
2E05 E701        27:          STAB     (S:NEXT)+1,X
2E07 A700        28:          STAA     S:NEXT,X
                 29:          ;LDX     SYMPT             MARK THIS SYMBOL AS END OF CHAIN
2E09 DE38        30:          LDX      SYMPT
                 31:          ;CLR     S:NEXT,X
2E0B 6F00        32:          CLR      S:NEXT,X
                 33:          ;CLR     S:NEXT+1,X
2E0D 6F01        34:          CLR      S:NEXT+1,X
2E0F 39          35:          RTS




ASM/6800 1.3H4: 2E0F ASM/6800 1.4       - - - S Y M B O L    T A B L E    D U M P - - -
