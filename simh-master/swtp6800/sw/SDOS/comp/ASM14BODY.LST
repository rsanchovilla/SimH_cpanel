ASM14A.IOFM.ASM
298B 39         228:          RTS




ASM/6800 1.3H4: 298B ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 319; Form 25    - - - S e c t o r   N u m - - -
ASM14A.IOFM.ASM
                230: *****************************************************************************
                231: *
                232: * Name:  SectorNum (Address: WORD (*in AB*) )
                233: *
                234: * Function:
                235: *        Given a value in AB that is a pointer into a disk file,
                236: *        SectorREM returns in AB that portion of AB that selects the 
                237: *        sector.  Note that this value is NOT right justified; it is merely
                238: *        isolated in AB.  The other bits will just be set to zero.  The
                239: *        following identity may clarify this:
                240: *
                241: *                 (x) (x = SectorNum(x)+SectorREM(x))
                242: *
                243: *
                244: * Changes:                          Preserves:
                245: *        A, B, C                         X
                246: *
                247: *****************************************************************************
                248: 
                249: **** The bits in AB which correspond to byte-in-sector are CLEARED ****
  298C          250: SectorNum         equ *
298C B4307C     251:          ANDA     SectorMask
298F F4307D     252:          ANDB     SectorMask+1
2992 39         253:          RTS
                254: 




ASM/6800 1.3H4: 2992 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 320; Form 25    - - - S e c t o r   R E M - - -
ASM14A.IOFM.ASM
                256: *****************************************************************************
                257: *
                258: * Name:  SectorREM (Address: WORD (*in AB*) )
                259: *
                260: * Function:
                261: *        Given a value in AB that is a pointer into a disk file,
                262: *        SectorREM returns in AB that portion of AB that selects the byte
                263: *        within a sector.
                264: *
                265: * Changes:                          Preserves:
                266: *        A, B, C                         X
                267: *
                268: *****************************************************************************
                269: 
                270: **** The bits in AB which correspond to sector-number are CLEARED ****
  2993          271: SectorREM         equ *
2993 B4307E     272:          ANDA     NotSectorMask
2996 F4307F     273:          ANDB     NotSectorMask+1
2999 39         274:          RTS
                275: 




ASM/6800 1.3H4: 2999 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 321; Form 26    - - - D o u b l e   P r e c i s i o n   R o u t i n e s - - -
ASM14A.IOFM.ASM
                  2: *****************************************************************************
                  3: *
                  4: * Name:  Double Precision Routines
                  5: *
                  6: * Function:
                  7: *        These routines provide OutputSDOSrecord and friends with some 16-bit
                  8: *        arithmetic operations.  One of the (many) nice features about this
                  9: *        package is that (where it makes sense) these routines return REAL
                 10: *        condition codes (as opposed to what you get out of a CPX, for example).
                 11: *
                 12: *        These routines all have a common calling sequence.  AB are treated as
                 13: *        a 16-bit accumulator, with A being the high-order byte and B being
                 14: *        the low-order byte.  X points to the first byte of the other operand
                 15: *        that is to be added, or whatever, to the accumulator.  If the operations
                 16: *        are done in the correct order, i.e. if B is operated upon before A,
                 17: *        and the routines close by branching to DP$CC, you will get the
                 18: *        appropriate condition code on exit.
                 19: *
                 20: *        The following routines are currently provided:
                 21: *
                 22: *        DP$ADD                     Add (0,X) to AB.
                 23: *        DP$SUB                     Subtract (0,X) from AB.
                 24: *        DP$CMP                     Compare AB to (0,X).
                 25: *        DP$MAX                     If AB << (0,X) then AB := (0,X).
                 26: *        DP$CC                      If CCZ is set and B is not zero, CCZ is reset.
                 27: *
                 28: *****************************************************************************
                 29: 
                 30: 
                 31: **** AB := AB + (0,X) ****
  299A           32: DP$ADD   equ      *
299A EB01        33:          ADDB     1,X
299C A900        34:          ADCA     0,X
                 35: 
  299E           36: DP$CC    equ      *                 Fix condition codes for 16-bit operations
299E 2609        37:          BNE      DP$CC%              The only bit that needs help is the Z bit.
29A0 36          38:          PSHA                         --and that only needs help if A=0.
29A1 07          39:          TPA
29A2 5D          40:          TSTB
29A3 2702        41:          BEQ      DP$CC1




ASM/6800 1.3H4: 29A3 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 322; Form 26    - - - D o u b l e   P r e c i s i o n   R o u t i n e s - - -
ASM14A.IOFM.ASM
                 42:          ;EORA    #(1##2)           Toggle the Z bit iff. low byte (B) was zero.
29A5 8804        43:          EORA     #(1##2)
29A7 06          44: DP$CC1   TAP
29A8 32          45:          PULA
29A9 39          46: DP$CC%   RTS
                 47: 
                 48: **** AB := AB - (0,X) ****
  29AA           49: DP$SUB   equ      *
29AA E001        50:          SUBB     1,X
29AC A200        51:          SBCA     0,X
29AE 20EE        52:          BRA      DP$CC
                 53: 
                 54: **** Compare AB to (0,X); return appropriate condition code ****
  29B0           55: DP$CMP   equ      *
29B0 37          56:          PSHB
29B1 36          57:          PSHA
29B2 8DF6        58:          BSR      DP$SUB
29B4 32          59:          PULA
29B5 33          60:          PULB
29B6 39          61:          RTS
                 62: 
                 63: **** AB := AB max (0,X) ****
  29B7           64: DP$MAX   equ      *
29B7 8DF7        65:          BSR      DP$CMP
29B9 2404        66:          BCC      DP$MAX%
29BB A600        67:          LDAA     0,X
29BD E601        68:          LDAB     1,X
29BF 39          69: DP$MAX%  RTS




ASM/6800 1.3H4: 29BF ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 323; Form 26    - - - G e t   R e c   E n d - - -
ASM14A.IOFM.ASM
                 71: *****************************************************************************
                 72: *
                 73: * Name:  GetNewrecEnd ()
                 74: *
                 75: * Function:
                 76: *        Computes target load address of first byte after segment currently
                 77: *        being processed.  Definition is:
                 78: *
                 79: *                 LET GetNewrecEnd() = GetRecEnd(#NEWREC)
                 80: *
                 81: * Changes:                          Preserves:
                 82: *        A B C X                         ****NONE****
                 83: *
                 84: *****************************************************************************
                 85: 
                 86: **** AB := Target address of last byte in NEWREC ****
  29C0           87: GetNewrecEnd      equ *
                 88:          ;LDX     #NEWREC           Get address of structure base,
29C0 CE3080      89:          LDX      #NEWREC
29C3 2003        90:          BRA      GetRecEnd           go compute address.
                 91: 
                 92: *****************************************************************************
                 93: *
                 94: * Name:  GetCurrecEnd ()
                 95: *
                 96: * Function:
                 97: *        Computes (in AB) the target load address of the first byte
                 98: *        following the current record.  This function is merely:
                 99: *
                100: *                 LET GetCurrecEnd() = GetRecEnd(#CURREC)
                101: *
                102: * Changes:                          Preserves:
                103: *        A B C X                         ****NONE****
                104: *
                105: *****************************************************************************
                106: 
                107: **** AB := Target address of last byte in CURREC ****
  29C5          108: GetCurrecEnd      equ *
                109:          ;LDX     #CURREC           Get address of structure base.
29C5 CE3084     110:          LDX      #CURREC




ASM/6800 1.3H4: 29C5 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 324; Form 26    - - - G e t   R e c   E n d - - -
ASM14A.IOFM.ASM
                111: 
                112: *****************************************************************************
                113: *
                114: * Name:  GetRecEnd (Pointer: ^{either NEWREC or CURREC})
                115: *
                116: * Function:
                117: *        Returns in AB the target load address of the first byte after
                118: *        the specified record/record segment.
                119: *
                120: * Changes:                          Preserves:
                121: *        A, B, C                         X
                122: *
                123: *****************************************************************************
                124: 
                125: **** AB := Target address of last byte in record at (0,X) ****
  29C8          126: GetRecEnd         equ *
29C8 A600       127:          LDAA     R$BASE,X
29CA E601       128:          LDAB     R$BASE+1,X
29CC EB03       129:          ADDB     R$LEN+1,X
29CE A902       130:          ADCA     R$LEN,X
29D0 39         131:          RTS




ASM/6800 1.3H4: 29D0 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 325; Form 26    - - - G e t   R e c o r d   B a s e - - -
ASM14A.IOFM.ASM
                133: *****************************************************************************
                134: *
                135: * Name:  GetNewrecBase ()
                136: *
                137: * Function:
                138: *        Loads AB with the contents of NEWREC+R$BASE; i.e., with the target
                139: *        load address of the record segment being processed.
                140: *
                141: * Changes:                          Preserves:
                142: *        A, B, C                         X
                143: *
                144: *****************************************************************************
                145: 
  29D1          146: GetNewrecBase     equ *
29D1 B63080     147:          LDAA     NEWREC+R$BASE
29D4 F63081     148:          LDAB     NEWREC+R$BASE+1
29D7 39         149:          RTS
                150: 
                151: *****************************************************************************
                152: *
                153: * Name:  GetCurrecBase ()
                154: *
                155: * Function:
                156: *        Loads AB with the contents of CURREC+R$BASE, i.e., with the target
                157: *        load address of the record currently being built.
                158: *
                159: * Changes:                          Preserves:
                160: *        A, B, C                         X
                161: *
                162: *****************************************************************************
                163: 
                164: **** AB := Currec.BASE ****
  29D8          165: GetCurrecBase     equ *
29D8 B63084     166:          LDAA     CURREC+R$BASE
29DB F63085     167:          LDAB     CURREC+R$BASE+1
29DE 39         168:          RTS




ASM/6800 1.3H4: 29DE ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 326; Form 27    - - - G E T C S - - -
ASM14A.IOFM.ASM
                  2: *
                  3: *
                  4: *  G E T C S
                  5: *
                  6: * GET A CHAR FROM SI DEVICE IN A. IF EOF IS HIT, EOFF#0.
                  7: *
                  8: *
  29DF            9: GETCS    EQU      *
29DF 965E        10:          LDAA     RJCH              A CHARACTER WAITING TO BE GIVEN TO THE TURKEY?
29E1 261E        11:          BNE      GETNLF              B/ YUP, GIVE IT HIM.
                 12: 
  29E3           13: GETCS1   EQU      *                 LOOP FOR ACTUAL I/O.
29E3 C601        14:          LDAB     #SI
                 15:          ;JSR     EOF$              SEE IF EOF HIT
29E5 BD012C      16:          JSR      EOF$
29E8 16          17:          TAB
29E9 860D        18:          LDAA     #$D               DEFAULT IF EOF
29EB D795        19:          STAB     EOFF              SAVE FLAG
29ED 2612        20:          BNE      GETNLF            B/EOF
29EF C601        21:          LDAB     #SI               READ FROM SI
                 22:          ;JSR     RASCII$           READ
29F1 BD011A      23:          JSR      RASCII$
29F4 4D          24:          TSTA                       A NULL?
29F5 27EC        25:          BEQ      GETCS1            WE IGNORE THOSE
                 26:          ;CMPA    #$A               A LF?
29F7 810A        27:          CMPA     #$A
29F9 2606        28:          BNE      GETNLF            IF NOT, OK
29FB D6BA        29:          LDAB     OPTF              SEE IF WE IGNORE THOSE
29FD C520        30:          BITB     #OPT:LF           WELL?
29FF 26E2        31:          BNE      GETCS1            IF ON, IGNORE
                 32: 
  2A01           33: GETNLF   EQU      *
                 34:          ;CLR     RJCH              NO CHARACTER REJECTED.
2A01 7F005E      35:          CLR      RJCH
2A04 39          36:          RTS




