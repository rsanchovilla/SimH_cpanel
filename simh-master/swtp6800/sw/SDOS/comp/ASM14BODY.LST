ASM14A.IOFM.ASM
                  2: *
                  3: *
                  4: *   P U T C C
                  5: *
                  6: *        Output ch in A to C device, with minimal editing.
                  7: *        ALL CH <$20 --> UP-ARROW FORM
                  8: *
  2A11            9: PUTCC    EQU      *
2A11 36          10:          PSHA
                 11:          ;CMPA     #$D
2A12 810D        12:          CMPA     #$D
2A14 270C        13:          BEQ      PUTC3
                 14:          ;CMPA     #$20
2A16 8120        15:          CMPA     #$20
2A18 2C08        16:          BGE      PUTC3
2A1A 36          17:          PSHA
2A1B 865E        18:          LDAA     #'^
2A1D 8D07        19:          BSR      PUTC
2A1F 32          20:          PULA
2A20 8B40        21:          ADDA     #$40
                 22: *
2A22 8D02        23: PUTC3    BSR      PUTC
2A24 32          24:          PULA
2A25 39          25:          RTS
                 26: *
                 27: *
                 28: * PUTC : PUT A CHAR IN A TO CONS DEVICE - SAVE B.
                 29: *
2A26 37          30: PUTC     PSHB                       SAVE B
2A27 C600        31:          LDAB     #CONS             GET CORR CHANNEL #
2A29 DF3C        32: WRTOUT   STX      IOXSAVE           SAVE X REG
                 33:          ;JSR     WASCII$           WRITE
2A2B BD0120      34:          JSR      WASCII$
2A2E 200B        35:          BRA      IORET
                 36: *
                 37: * GETC - GET A CHAR FROM CONS DEV. SAVE B.
                 38: *
2A30 37          39: GETC     PSHB                       SAVE B
2A31 DF3C        40:          STX      IOXSAVE           SAVE X REG
2A33 C600        41: GETC2    LDAB     #CONS             GET CH #




