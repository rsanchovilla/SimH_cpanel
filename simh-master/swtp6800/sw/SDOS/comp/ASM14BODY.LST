 *S*              7:          FCC      'ASM/6809 '
                  8:          FIN
258B 31           9:          FCB      (RELEASE/$10&$F)+'0
258C 2E          10:          FCB      '.
258D 34          11:          FCB      (RELEASE&$F)+'0
258E 41          12: ASMPATCH FCB      ASSEMBLY
258F 30          13:          FCB      '0                PATCH NUMBER
                 14:                   ; ASM IS WHICH.....
2590 3A20        15:          FCC      /: /
2592 00          16:          FCB      0
                 17: *
2593 3B205061    18: PNUM     FCC      /; Page /
259A 00          19:          FCB      0
259B 3B20466F    20: FSMI     FCC      /; Form /
25A2 00          21:          FCB      0
                 22: *
  0015           23: HDRNAME  EQU      $15               FIRST COLUMN OF NAME FIELD,
  0028           24: HDRTTL   EQU      40                FIRST COLUMN OF TITLE FIELD.
                 25: 
25A3 152800      26: HDRTABS  FCB      HDRNAME,HDRTTL,0  TAB TABLE FOR HEADER.
                 27:                   ; NECESSARY SINCE DUMP SUPPLIES ITS OWN.




ASM/6800 1.3H4: 25A3 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 279; Form 11    - - - P U T H D R - - -
ASM14A.IOFM.ASM
                  1: *
                  2: *
                  3: *
  25A6            4: PUTHDR   EQU      *
                  5: 
                  6: 
                  7: *** MAKE SURE WE DON'T BLOW UP DUE TO SHORT PAGE LENGTH...
25A6 9655         8:          LDAA     LLTP              THIS COUNTER HAS BEEN SET TO FORM DEPTH.
                  9:          ;CMPA    #MINDEP           IS IT REASONABLE?
25A8 810F        10:          CMPA     #MINDEP
25AA 2207        11:          BHI      PUTHDR1           B/ YUP.  OUTPUT HEADER.
25AC 86FF        12:          LDAA     #$FF              OTHERWISE SET LINES LEFT TO 255,
25AE 9755        13:          STAA     LLTP
                 14:          ;CLR     DEPTH             AND SET PAGE SIZE TO ZERO
25B0 7F00B3      15:          CLR      DEPTH
                 16: 
                 17: *** GET READY TO OUPUT HEADER.
  25B3           18: PUTHDR1  EQU      *
25B3 9684        19:          LDAA     DOCOPY            NEVER COPY HEADER
25B5 36          20:          PSHA     SO SAVE FLAG
                 21:          ;CLR     DOCOPY
25B6 7F0084      22:          CLR      DOCOPY
                 23: *
25B9 96B4        24:          LDAA     TABTBL            SAVE OLD TAB POINTER,
25BB 36          25:          PSHA
25BC 96B5        26:          LDAA     TABTBL+1
25BE 36          27:          PSHA
                 28:          ;LDX     #HDRTABS          SO'S WE CAN USE OUR OWN.
25BF CE25A3      29:          LDX      #HDRTABS
25C2 DFB4        30:          STX      TABTBL            (DON'T TALK TO ME ABOUT LAZY)
                 31: 
                 32: 
                 33: *** AT LAST... START DOING WORK FOR HEADER ***
                 34: 
                 35:          ;LDX     PAGEN             WHICH PAGE IS THIS?
25C4 DE93        36:          LDX      PAGEN
25C6 8C0001      37:          CPX      #1                PAGE # 1?
25C9 2605        38:          BNE      PUTHDR2           B/ NO, USE ORDINARY PUT.
                 39:          ;LDX     #ASMBF1           PAGE # 1:  DON'T SKIP TO BOTTOM OF PAGE.
25CB CE257E      40:          LDX      #ASMBF1




