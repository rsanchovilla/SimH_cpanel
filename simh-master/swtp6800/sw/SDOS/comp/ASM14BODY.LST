1536 813B        95:          CMPA     #$3B
1538 2602        96:          BNE      PAGE0B              B/ NO; GO ON.
153A 8620        97:          LDAA     #BLANK              ELSE CHANGE LEADING SEMICOLON TO
                 98:                                     ; A BLANK; THIS ALLOWS ONE TO CLEAR HEADINGS BY
                 99:                                     ; SAYING "PAGE ;<EOL>".  NOTE ALSO THAT ONE MAY
                100:                                     ; STILL START A TITLE W/ ";" BY SAYING 
                101:                                     ; " TITLE  ;;TEXT BEGINNING W/ SEMI;"  THE TITLE 
                102:                                     ; THEN BE ";TEXT BEGINNING W/ SEMI;".
  153C          103: PAGE0B   EQU      *
                104: * MAKE FIRST TITLE/SUBTITLE/NAME RETROACTIVE TO START OF LISTING
                105: *
                106:          ;LDX     TPTR              GLOM ONTO BUFFER ADDR.
153C DE34       107:          LDX      TPTR
153E E600       108:          LDAB     0,X               ANYTHING IN BUFFER YET?
1540 2704       109:          BEQ      PAGE1             B/ NO:  ALWAYS COPY IN.
1542 D654       110:          LDAB     PASS              SOMETHING THERE, & THIS IS PASS 1?
1544 271A       111:          BEQ      PAGE2             B/ YES:  DON'T COPY.
                112: *
1546 5F         113: PAGE1    CLRB                       ZERO COUNT,
                114:          ;LDX     TPTR              GET BUFFER ADDR AGAIN.
1547 DE34       115:          LDX      TPTR
                116: *
1549 8A80       117: PAGEL    ORAA     #$80              MAKE SURE PRINTED LITERALLY.
154B A700       118:          STAA     0,X               STUFF AWAY.
154D 08         119:          INX
154E 5C         120:          INCB                       BUMP COUNT.
154F DF34       121:          STX      TPTR              AND SAVE POINTER.




