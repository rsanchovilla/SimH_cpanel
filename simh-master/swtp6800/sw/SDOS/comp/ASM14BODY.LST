2D3F D751        96:          STAB     SORTAIL+1
2D41 9750        97:          STAA     SORTAIL
                 98:          ;LDX     #VAL              GET POINTER TO BCD BUFFER
2D43 CE005F      99:          LDX      #VAL
                100:          ;JSR     INCBCD            GO BUMP (SORTED) SYMBOL COUNT
2D46 BD0823     101:          JSR      INCBCD
2D49 20B3       102:          BRA      SORT0




ASM/6800 1.3H4: 2D49 ASM/6800 1.4       - - - S Y M B O L    T A B L E    D U M P - - -
08/16/82 00:00:00; Page 353; Form 41    - - - T B L S O R T - - -
ASM14A.IOFM.ASM
                  2: *        TBLSORT:
                  3: *        SORTS EACH OF THE SUBLISTS IN THE HASH TABLE, USING
                  4: *        THE COMPARISON ROUTINE PASSED IN RTNPTR.  ASSUMES NOTHING.
                  5: *        OUTPUTS IN VAL A 2-BYTE COUNT OF THE # OF DEFINED
                  6: *        SYMBOLS (IN DECIMAL)
                  7: *
                  8: * PICK UP ONE BUCKET AT A TIME AND GIVE IT TO SORTCHAIN
                  9: *
                 10: *
                 11: *
  2D4B           12: TBLSORT  EQU      *
                 13:          ;LDX     #HSHTBL           SCAN THE HASH TABLE
2D4B CE308D      14:          LDX      #HSHTBL
  2D4E           15: TBLSORTL EQU      *
2D4E DF48        16:          STX      BUCKET            PT TO NEXT BUCKET PTR
                 17: *
                 18: *        SORT BUCKET CHAIN
                 19: *
                 20:          ;LDX     0,X               GET HEAD OF CHAIN
2D50 EE00        21:          LDX      0,X
2D52 DF4E        22:          STX      NEW               SAVE IN NEW
                 23:          ;LDX     BUCKET            MARK OUTPUT CHAIN AS NULL
2D54 DE48        24:          LDX      BUCKET
                 25:          ;CLR     0,X               DELINK CHAIN
2D56 6F00        26:          CLR      0,X
                 27:          ;CLR     1,X
2D58 6F01        28:          CLR      1,X
2D5A 8D0A        29:          BSR      SORTCHAIN         THIS GUY DOES ALL THE HARD WORK!
                 30:          ;LDX     BUCKET            DONE WITH THIS BUCKET,...
2D5C DE48        31:          LDX      BUCKET
                 32:          ;LEAX    2,X               DO THE NEXT BUCKET
  0000           33:          IF       2<0
 *S*             34:          RPT      -2
 *S*             35:          DEX
                 36:          ELSE
  0002           37:          RPT      2
2D5E 08          38:          INX
                 39:          FIN
2D60 8C318D      40:          CPX      #HSHEND           ALL BUCKETS PROCESSED ?
2D63 26E9        41:          BNE      TBLSORTL          B/ NO, SORT ANOTHER




ASM/6800 1.3H4: 2D65 ASM/6800 1.4       - - - S Y M B O L    T A B L E    D U M P - - -
08/16/82 00:00:00; Page 354; Form 41    - - - T B L S O R T - - -
ASM14A.IOFM.ASM
2D65 39          42: SORTRTS  RTS
                 43: *
                 44: *        SORTCHAIN:
                 45: *        SORTS A BUCKET CHAIN INTO ORDER
                 46: *
                 47: *
  2D66           48: SORTCHAIN EQU     *
                 49:          ;LDX     NEW               WHILE NEW <> 0 DO:
2D66 DE4E        50:          LDX      NEW
2D68 27FB        51:          BEQ      SORTRTS           B/ ALL DONE
                 52:          ;LDX     BUCKET                 LAST:= BUCKET;
2D6A DE48        53:          LDX      BUCKET
  2D6C           54: SORTCHAIN0        EQU               *
2D6C DF4A        55:          STX      LAST
                 56:          ;LDX     S:NEXT,X          THIS:=NEXT(LAST);
2D6E EE00        57:          LDX      S:NEXT,X
2D70 DF4C        58:          STX      THIS
2D72 270A        59:          BEQ      SORTCHAIN1        B/ GO INSERT
  0001           60:          IF       DUMPV=1
                 61:          ;LDX     RTNPTR                 IF THIS=0 OR GT(THIS,NEW) THEN BREAK
2D74 DE44        62:          LDX      RTNPTR
                 63:          ;JSR     0,X                    END;
2D76 AD00        64:          JSR      0,X
  0002           65:          ELSE
 *S*             66:          ;JSR     SORTNAME
 *S*             67:          JSR      SORTNAME
                 68:          FIN
2D78 2904        69:          BVS      SORTCHAIN1        B/ GO INSERT
                 70:          ;LDX     THIS
2D7A DE4C        71:          LDX      THIS
2D7C 20EE        72:          BRA      SORTCHAIN0
  2D7E           73: SORTCHAIN1 EQU    *
                 74:          ;LDD     NEW               NEXT(LAST):=NEW
2D7E D64F        75:          LDAB     NEW+1
2D80 964E        76:          LDAA     NEW
                 77:          ;LDX     LAST
2D82 DE4A        78:          LDX      LAST
                 79:          ;STD     S:NEXT,X
2D84 E701        80:          STAB     (S:NEXT)+1,X
2D86 A700        81:          STAA     S:NEXT,X




