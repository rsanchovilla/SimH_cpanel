0A01 C502        46:          BITB     #OPT1:6801          NEED TO LOOK?
0A03 270E        47:          BEQ      DOITL$1             B/ NO, THIS IS "NM6801".
0A05 36          48:          PSHA                       6801:  SAVE P REG,
                 49:          ;LDX     #M6801OPS           LOAD @ OF OP TABLE,
0A06 CE0E0F      50:          LDX      #M6801OPS
                 51:          ;JSR     FSYM1               AND SEE IF SYM IS ONE WE KNOW.
0A09 BD20C9      52:          JSR      FSYM1
0A0C 32          53:          PULA                         (SNEAKILY RESTORE P INTO ACCA)
0A0D 2604        54:          BNE      DOITL$1           B/ NO LO SE; TREAT AS 6800 OPCODE.
                 55: 
                 56: **** 6801 OPCODE RECOGNIZED; X POINTS TO SYMBOL BLOCK ****
                 57:          ;LDX     S:VAL,X           FETCH OPCODE, OPCODE GROUP,
0A0F EE02        58:          LDX      S:VAL,X
0A11 202E        59:          BRA      DOOPCX              AND GO JOIN COMMON CODE.
                 60: 
                 61: **** NO 6801 OPCODE.  TRY FOR 6800 OP *****
  0A13           62: DOITL$1  EQU      *
                 63: *
                 64: * POSSIBLY AN OPCODE.  IF 4 CH, THEN LAST MUST "A/B"
0A13 06          65:          TAP                        WHAT WAS THE RESULT
0A14 250B        66:          BCS      DOITO3            B/ ONLY 3 CH
0A16 D666        67:          LDAB     SYM+4             WHAT IS THE 4TH CHARACTER.
0A18 C041        68:          SUBB     #'A               "A"
0A1A 54          69:          LSRB
0A1B 26C3        70:          BNE      DOITDR9           B/ NOT A/B ==> DIRECTIVE.
0A1D C900        71:          ADCB     #0                IF A, THEN RB=0, ELSE 1
0A1F D756        72:          STAB     REG               SAVE RESULT.




ASM/6800 1.3H4: 0A1F ASM/6800 1.4       - - -   D E C O D E   L I N E   - - -
08/16/82 00:00:00; Page 61; Form 2      - - - OPCDODE DECODING - - -
ASM14A.DITL0.ASM
                  2: *
                  3: * GOT A 3 CHAR CF(1) OR 3+A/B
                  4: *
                  5: * LOOK IN SYM TBL TO
                  6: * FIND OP CODE.
  0A21            7: DOITO3   ;LDX      #OPTBL            GET ADDRESS OF TABLE.
0A21 CE0C92       8:          LDX      #OPTBL
0A24 9663         9: DOITOL   LDAA     SYM+1             CHECK NEXT SYM
                 10:          ;CMPA     0,X
0A26 A100        11:          CMPA     0,X
0A28 260C        12:          BNE      DOITO4
0A2A 9664        13:          LDAA     SYM+2
                 14:          ;CMPA     1,X
0A2C A101        15:          CMPA     1,X
0A2E 2606        16:          BNE      DOITO4
0A30 9665        17:          LDAA     SYM+3
                 18:          ;CMPA     2,X
0A32 A102        19:          CMPA     2,X
0A34 2709        20:          BEQ      DOOPC             B/ FOUND A MATCH.
0A36 2368        21: DOITO4   BLS      DOITDR            B/ NOT IN TABLE ==> DIRECTIVE
0A38 08          22:          INX
0A39 08          23:          INX
0A3A 08          24:          INX
0A3B 08          25:          INX
0A3C 08          26:          INX
0A3D 20E5        27:          BRA      DOITOL            TRY NEXT.




ASM/6800 1.3H4: 0A3D ASM/6800 1.4       - - -   D E C O D E   L I N E   - - -
08/16/82 00:00:00; Page 62; Form 3      - - - OPCDODE DECODING - - -
ASM14A.DITL0.ASM
                  2: *10*
                  3: *
                  4: *
                  5: * FOUND OPCODE;  GET GROUP, VALUE
  0A3F            6: DOOPC    ;LDX      3,X
0A3F EE03         7:          LDX      3,X
0A41 DF57         8: DOOPCX   STX      OP                OP & GRP ARE ADJACENT
                  9: *
                 10: * GOT GROUP, VALUE:  CHECK WHETHER TO SCAN FOR REGISTER.
0A43 9658        11:          LDAA     GRP
0A45 2E51        12:          BGT      DOOCNR            B/ NO REGISTER ALLOWED
                 13: * REG ALLOWED
0A47 D656        14:          LDAB     REG               REGISTER ALREADY SEEN?
0A49 2C21        15:          BGE      DOOCGO            B/ GOT REGISTER.
                 16: *
                 17: *GOT OP THAT MAY HAVE REG BUT NO REG YET
                 18: *   3 CHAR OPCODE:  SCAN FOR REGISTER
                 19:          ;JSR      FINDAF            FIND ARGUMENT FIELD
0A4B BD206C      20:          JSR      FINDAF
                 21:          ;JSR      GNOBJ             GET NEXT OBJECT
0A4E BD1E2C      22:          JSR      GNOBJ
                 23:          ;CMPA     #O:SYM            IS IT A SYMBOL?
0A51 8101        24:          CMPA     #O:SYM
0A53 2635        25:          BNE      DOOC2             B/ NO --> NO REGISTER.
                 26:          ;JSR     CKEOF             SEE IF END OF IELD NEXT
0A55 BD1E06      27:          JSR      CKEOF
0A58 2630        28:          BNE      DOOC2             B/ NO --> NO REGISTER
                 29:          ;LDX      #$100+'A          SYMBOL MUST BE "A" OR "B"
0A5A CE0141      30:          LDX      #$100+'A
0A5D 4F          31:          CLRA                       CLEAR THE REGISTER FLAG
0A5E 9C62        32:          CPX      SYM               IS THE SYMBOL "A"?
0A60 2706        33:          BEQ      DOOCR             B/ YES:  RA CONTAINS REG.
0A62 08          34:          INX                        ELSE TRY "B"
0A63 4C          35:          INCA                       AND SET FLAG FOR REG.B
0A64 9C62        36:          CPX      SYM               IS THE SYMBOL "B"?
0A66 2622        37:          BNE      DOOC2             B/ NO:  NO REGISTER.
0A68 9756        38: DOOCR    STAA     REG               SAVE REGISTER FLAG,
0A6A 9658        39:          LDAA     GRP               RESTORE GROUP CODE




ASM/6800 1.3H4: 0A6A ASM/6800 1.4       - - -   D E C O D E   L I N E   - - -
08/16/82 00:00:00; Page 63; Form 3      - - - OPCDODE DECODING - - -
