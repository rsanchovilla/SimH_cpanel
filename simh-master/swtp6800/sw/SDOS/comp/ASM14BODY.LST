ASM14A.MAIN.ASM
                  2: *
                  3: *
                  4: * PINIT
                  5: *        DOES ALL INITIALIZATION REQUIRED AT THE START OF
                  6: *        AN ASSEMBLY PASS.  CLEARS PAGE ZERO BETWEEN PVARZ
                  7: *        AND PVARE, SETS LISTING FLAGS, INITIALIZES PAGE NUMBER AND
                  8: *        PAGE IN FILE.  FORCES RPTF TO -1.  
                  9: *
                 10: *
  1A27           11: PINIT    ;LDX      #PVARZ
1A27 CE0084      12:          LDX      #PVARZ
  1A2A           13: PIN1     ;CLR      0,X
1A2A 6F00        14:          CLR      0,X
1A2C 08          15:          INX
1A2D 8C009F      16:          CPX      #PVARE
1A30 26F8        17:          BNE      PIN1
                 18: *
                 19:          ;LDX      #-1
1A32 CEFFFF      20:          LDX      #-1
1A35 DFA1        21:          STX      RPTF
                 22: *
1A37 8650        23:          LDAA     #LLDFLT           SET DEFAULT LISTING FLAGS.  SETS
                 24:                                     ;  A DEFAULT OF:
                 25:                                     ; PCC 0    (NOT LL:PCC)
                 26:                                     ; PSR 1  (LL:SKIP)
                 27:                                     ; PCA 1      ( LL:PCA)
                 28:                                     ; PGEN 0     (NOT LL:PGEN)
                 29:                                     ; IF YOU WANT DIFFERENT DEFAULTS, 
                 30:                                     ; CHANGE THE CONSTANT BEING LOADED.
1A39 D6BA        31:          LDAB     OPTF
1A3B 53          32:          COMB
1A3C C50A        33:          BITB     #OPT:LO!OPT:LST   ARE BOTH ON?
1A3E 2602        34:          BNE      PIN2
1A40 8A01        35:          ORAA     #LL:LIST
1A42 97A0        36: PIN2     STAA     LIST:P
                 37:          ;LDX      #1                INITIALIZE PAGE
1A44 CE0001      38:          LDX      #1
1A47 DF93        39:          STX      PAGEN
1A49 09          40:          DEX                        <<X := 0>>
1A4A DF8F        41:          STX      FPGE              AND PAGE IN FILE.




