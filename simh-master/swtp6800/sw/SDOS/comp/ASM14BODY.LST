ASM14A.DITL0.ASM
                  2: *
                  3: * MISC BRANCHES TO GET US WHERE WE'RE GOING
                  4: *
0C0F 2086         5: OUT2A1   BRA      OUT2A
0C11 2094         6: DYADR41  BRA      DYADR4
                  7: *
                  8: *
                  9: *
                 10: * SUBROUTINE TO CHECK FOR DIRECT MODE.
  0C13           11: CHDIR    EQU      *                 WHAT'S THE EXPRESSION TYPE?
                 12:          ;JSR      EVAF              EVALUATE AF
0C13 BD1AF3      13:          JSR      EVAF
0C16 9659        14:          LDAA     XTYPE             GET TYPE BACK.
0C18 8507        15:          BITA     #XT:FREF!XT:UNDF!XT:UNEV  IS IT EVALUABLE?
0C1A 26A1        16:          BNE      CHIRTS            B/ NO ==> NOT DIRECT.
0C1C 965F        17:          LDAA     VAL               GET HIGH BYTE OF VAL...
0C1E 269D        18:          BNE      CHIRTS            B/ NOT ZERO ==> CAN'T BE DIRECT.
0C20 31          19:          INS                        ELSE POP RETURN ADDRESS,
0C21 31          20:          INS
0C22 8610        21:          LDAA     #$10              MERGE IN NEAT STUFF
                 22:          ;JMP      OUT2O             AND GO DEPOSIT.
0C24 7E0B95      23:          JMP      OUT2O
                 24: *




