  1303          529: FDIVNORM EQU      *-1               MULTIPLICATIVE FACTOR USED TO NORMALIZE DIVISOR
  0031          530:          RPT      100/2-1           (SEE KNUTH VOL 2 PAGE 237)
1304 32         531:          FCB      100/(*-FDIVNORM+1)
                532: *
                533: *
                534: *        MULTIPLY DIGIT AT (X) BY ML AND ADD (A); STORE BACK AT (X)
                535: *        RETURN (A) = UPPER BASE 100 DIGIT OF @(X)*ML+(A)
                536: *        DECREMENT X
                537: *
  1335          538: FDIVNORMDIGIT     EQU               *
1335 B7101B     539:          STAA     CTNB              SAVE CARRY TO NEXT BYTE
1338 FF101C     540:          STX      FACX              LOOKS LIKE GOOD IDEA...
133B E600       541:          LDAB     0,X               GET DIGIT TO BE MULTIPLIED
                542:          ;JSR     MULBASE100        MULTIPLY IT BY ML, PRODUCT GOES TO (A,B)
133D BD12B0     543:          JSR      MULBASE100
1340 FB101B     544:          ADDB     CTNB              ADD CARRY FROM LAST DIGIT COLUMN
                545:          ;CMPB    #100              DO BASE 100 ADJUST
1343 C164       546:          CMPB     #100
1345 2503       547:          BCS      *+5               B/ DIGIT IS OK
1347 4C         548:          INCA                       BUMP CARRY TO NEXT DIGIT COLUMN
1348 C064       549:          SUBB     #100              MAKE DIGIT VALID
                550:          ;LDX     FACX              STORE MODIFIED DIGIT
134A FE101C     551:          LDX      FACX
134D E700       552:          STAB     0,X
134F 09         553:          DEX                        AS PROMISED
1350 39         554:          RTS                        WITH CARRY TO NEXT BYTE IN (A)
                555: 
                556: 
1351 00000000   557: FZERO    FCB      0,0,0,0,0,0
1357 FF636363   558: MINFINITY         FCB               $FF,99,99,99,99,99,99
135E 7F636363   559: INFINITY FCB      $7F,99,99,99,99,99,99




