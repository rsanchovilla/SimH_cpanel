142B BD21E2      17:          JSR      LFEQU
142E 20F2        18:          BRA      ORG2              AND SPLIT.




ASM/6800 1.3H4: 142E ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 126; Form 20    - - - S E T - - -
ASM14A.MAIN.ASM
  0001            2:          DO       NICE=1
                  3: *
                  4: *
                  5: *   S E T :
                  6: *
                  7: *        Handles SET command.  All of the above (EQU) holds,
                  8: *        except I throw up on forward references.  Be thee
                  9: *        warned...
                 10: *
                 11: *
  1430           12: SET:     EQU      *
                 13:          ;JSR      EVALCT            GET THE VALUE.
1430 BD1B3A      14:          JSR      EVALCT
                 15:          ;JSR     ECKEOF            ERROR IF END OF FIELD NOT NEXT
1433 BD1E15      16:          JSR      ECKEOF
                 17:          ;JSR      LFSET             IF NOT, IT'S ZERO NOW.
1436 BD21E5      18:          JSR      LFSET
1439 20E7        19:          BRA      ORG2              (SAVE A BYTE WHILE YOU CAN)
                 20:          FIN
                 21: 
                 22: 
  0001           23:          IFUND    MC6809
  0001           24:          ELSE
 *S*             25: *
 *S*             26: *
 *S*             27: *   S E T D P R
 *S*             28: *
 *S*             29: *        Set the DPR register value for 6809
 *S*             30: *
 *S*             31: SETDPR:  ;JSR     EVALCT            AF value
 *S*             32:          JSR      EVALCT
 *S*             33:          ;JSR     ECKEOF            Error if not at EOL
 *S*             34:          JSR      ECKEOF
 *S*             35:          ;CLR     VAL+1             Zap low order 8 bits of value
 *S*             36:          CLR      VAL+1
 *S*             37:          LDAA     VAL
 *S*             38:          STAA     DPRSET            Set DPR value
 *S*             39:          BRA      ORG2
                 40:          FIN




ASM/6800 1.3H4: 1439 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 127; Form 21    - - - R M B - - -
ASM14A.MAIN.ASM
                  2: *
                  3: *
                  4: *   R M B :
                  5: *
                  6: *        Handles RMB command.  I do very little idiot checking
                  7: *        here.  The value has to be a control value, but other
                  8: *        than that, I don't really much care.  If you really
                  9: *        want to RMB -3, alright:  but don't complain to me when
                 10: *        someone tells you your code is obscure (not to mention
                 11: *        opaque).
                 12: *
                 13: *
  143B           14: RMB:     EQU      *
                 15:          ;JSR      EVNUL            GET THE VALUE,
143B BD13A9      16:          JSR      EVNUL
                 17:          ;JSR      ISCTR             MAKE IT NOT A FWD REF.
143E BD1B3C      18:          JSR      ISCTR
                 19:          ;JSR      PUTPC             LIST CURRENT PC
1441 BD26F2      20:          JSR      PUTPC
1444 9697        21:          LDAA     PC+1              AND ADD IN THE VALUE.
1446 9B60        22:          ADDA     VAL+1
1448 9797        23:          STAA     PC+1
144A 9696        24:          LDAA     PC
144C 995F        25:          ADCA     VAL
144E 9796        26:          STAA     PC
                 27:          ;JSR      PNCHIT            PUNCH THE BINARY BUFFER,
1450 BD2760      28:          JSR      PNCHIT
1453 20CD        29:          BRA      ORG2                AND PUT VAL IN THE LISTING FIELD.




ASM/6800 1.3H4: 1453 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 128; Form 22    - - - F C C - - -
ASM14A.MAIN.ASM
                  2: *
                  3: *
                  4: *   F C C :
                  5: *
                  6: *        Form constant characters.  This one is a mess.  There
                  7: *        are 2 possible forms of the FCC command.  First, there
                  8: *        is the standard FCC /string/ command.  That's easy;
                  9: *        if the delimiter is not a digit I just eat the string.
                 10: *           If the delimiter is a digit ('0-'9) then we go into
                 11: *        underdrive:  we scan until we find a non-digit; then
                 12: *        if it's not a comma we go off and take the first digit
                 13: *        as the delimiter.  Otherwise, we back up, call GNOBJ to
                 14: *        get us the number, eat the comma and use the next ch as
                 15: *        the delimiter.  Yecch.
                 16: *
                 17: *
  1455           18: FCC:     EQU      *
                 19:          ;LDX      #0                CLEAR # OF BYTES NEEDED
1455 CE0000      20:          LDX      #0
1458 DF5F        21:          STX      VAL
                 22:          ;JSR      GTCHT             GET FIRST CH OF AF, W/ TYPE
145A BD1DB0      23:          JSR      GTCHT
                 24:          ;CMPB     #C:NUM            IS IT A DIGIT
145D C102        25:          CMPB     #C:NUM
145F 261D        26:          BNE      FCC1              B/ NO:  MUST BE DELIMITER
  1461           27: FCC0     ;JSR      GTCHT             ELSE SLURP UP DIGITS
1461 BD1DB0      28:          JSR      GTCHT
                 29:          ;CMPB     #C:NUM
1464 C102        30:          CMPB     #C:NUM
1466 27F9        31:          BEQ      FCC0              LIKE THAT.
                 32:          ;CMPA     #ASCII:COMMA     IS THE TERMINATOR A COMMA?
1468 812C        33:          CMPA     #ASCII:COMMA
146A 2648        34:          BNE      FCCN              B/ NO:  BACK US UP & EAT WHOLE STRIN
                 35: * FOUND  FCC  <NUM>,/STRING/
                 36:          ;LDX      AFPTR             BACK US UP
146C DE26        37:          LDX      AFPTR
                 38:          ;JSR      GNOBX             GET THE NUMBER
146E BD1E38      39:          JSR      GNOBX
1471 965F        40:          LDAA     VAL               WHAT IS IT?
1473 2C03        41:          BGE      FCC01             B/ ITS OK.




ASM/6800 1.3H4: 1473 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 129; Form 22    - - - F C C - - -
ASM14A.MAIN.ASM
                 42:          ;JSR      ILLVAL            *E* WHAT DO YOU MEAN, NEGATIVE?
1475 BD088B      43:          JSR      ILLVAL
  1478           44: FCC01    ;JSR      GETXC             EAT THE COMMA
1478 BD1F95      45:          JSR      GETXC
  147B           46: FCC02    ;JSR      GETXC             AND GET THE DELIMITER.
147B BD1F95      47:          JSR      GETXC
                 48: *
                 49: *  VAL NOW CONTAINS THE NUMBER OF BYTES (TOTAL) TO BE USED;
                 50: *  ACCA NOW HOLDS THE DELIMITER.
                 51: *
147E 16          52: FCC1     TAB                        SAVE THE DELIMITER.
                 53:          ;CMPB     #$D               IS IT A (HORRORS) <EOL> ?
147F C10D        54:          CMPB     #$D
1481 260E        55:          BNE      FCC2              B/ YES: GO EAT THE STRING.
                 56: *  I SAW THE END OF THE STRING.  OUTPUT TRAILING BLANKS
  1483           57: FCCD     EQU      *
                 58:          ;LDX      VAL               GET # OF TRAILING BLANKS LEFT
1483 DE5F        59:          LDX      VAL
1485 2F51        60:          BLE      TABRTS            B/ ALL DONE: RETURN.
1487 09          61:          DEX
1488 DF5F        62:          STX      VAL               SAVE VALUE
148A 8620        63:          LDAA     #BLANK
                 64:          ;JSR      PUTB              AND OUTPUT THE BLANK
148C BD26A5      65:          JSR      PUTB
148F 20F2        66:          BRA      FCCD              ...TRY AGAIN.
                 67: 
                 68: 
                 69: *
                 70: * FCC2 -- OUTPUT THE STRING.
                 71: *
  1491           72: FCC2     ;JSR      GETXC             GET THE NEXT CHARACTER,
1491 BD1F95      73:          JSR      GETXC
1494 847F        74:          ANDA     #$7F                MASK IT TO SEVEN BITS...
1496 11          75:          CBA                        IS IT THE DELIMITER?
1497 27EA        76:          BEQ      FCCD              B/ YES:  ALL DONE.
                 77:          ;CMPA     #$D               A <EOL>?
1499 810D        78:          CMPA     #$D
149B 2605        79:          BNE      FCC3              B/ NO:  THIS IS A GOOD CH.
                 80:          ;JSR      ILLSTR            *E* ILLEGAL STRING
149D BD0897      81:          JSR      ILLSTR




ASM/6800 1.3H4: 14A0 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 130; Form 22    - - - F C C - - -
ASM14A.MAIN.ASM
14A0 20E1        82:          BRA      FCCD              ALL DONE.
                 83: *
14A2 37          84: FCC3     PSHB                       SAVE THE DELIMITER
14A3 E600        85:          LDAB     0,X               BUT FIRST -- MAKE SURE IT LISTS AS STRING CH.
14A5 CA80        86:          ORAB     #$80                BY TURNING ON SIGN BIT,
14A7 E700        87:          STAB     0,X                 AND POKING IT BACK.  (X) SET UP BY GETXC.
                 88:          ;JSR      PUTB              OUTPUT THE CHARACTER
14A9 BD26A5      89:          JSR      PUTB
14AC 33          90:          PULB                       RETRIEVE DELIMITER CHARACTER.
                 91:          ;LDX     VAL               REMEMBER HOW MANY CHARACTERS WE HAVE OUTPUT ALREA
14AD DE5F        92:          LDX      VAL
14AF 09          93:          DEX                          EACH CHARACTER WE OUTPUT NOW MEANS 
14B0 DF5F        94:          STX      VAL                 ONE LESS BLANK TO OUTPUT LATER.
14B2 20DD        95:          BRA      FCC2              GO, GO, GO.
                 96: *
                 97: * BACK UP TO THE START & EAT AS REGULAR STRING
                 98: *
  14B4           99: FCCN     ;LDX      AFPTR             HO HUM...
14B4 DE26       100:          LDX      AFPTR
14B6 DF28       101:          STX      EXPTR
14B8 20C1       102:          BRA      FCC02             GO EAT THE STRING.




ASM/6800 1.3H4: 14B8 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 131; Form 23    - - - T A B S - - -
ASM14A.MAIN.ASM
  0001            2:          IF       NICE=1
                  3: *
                  4: *
                  5: * TABS COMMAND - RESETS TABS TO GIVEN COLUMNS
                  6: *        IF AN ERROR IS ENCOUNTERED, TABS ARE SET TO ORIGINAL DEFAULTS.
                  7: *
                  8: *  TABS MUST BE IN ASCENDING ORDER BETWEEN 2 AND 127 INCLUSIVE.
                  9: *
  14BA           10: TABS:    ;LDX     #TBTB+1           GET USER-TABS POINTER.
14BA CE2F3B      11:          LDX      #TBTB+1
14BD DFB4        12:          STX      TABTBL            SAVE PTR WHERE TO STORE NEXT GIVEN TAB-1
                 13:          ;CLR     1,X               MAKE A HOLE AT THE END....
14BF 6F01        14:          CLR      1,X
                 15:          ;LDX     #NUMSTRT*$100+LSTSTRT  GET INITIAL TWO TABS
14C1 CE0F15      16:          LDX      #NUMSTRT*$100+LSTSTRT
14C4 FF2F3A      17:          STX      TBTB              STORE THEM
  14C7           18: NTAB     ;JSR     EVAL              MAKE SURE IT IS AN OK VALUE
14C7 BD1B24      19:          JSR      EVAL
14CA 9660        20:          LDAA     VAL+1             IS VALUE GIVEN OK?
14CC D65F        21:          LDAB     VAL               WHAT ABOUT THE UPPER BYTE?
14CE 2709        22:          BEQ      TABOK             IF OK - OK
  14D0           23: TABOVF   ;JSR     ILLVAL            REPORT ERROR
14D0 BD088B      24:          JSR      ILLVAL
  14D3           25: TABERR   ;LDX     #TABTB:           LOAD DEFAULT TABLE
14D3 CE253A      26:          LDX      #TABTB:
14D6 DFB4        27: TABRET   STX      TABTBL            SAVE IT
14D8 39          28: TABRTS   RTS
                 29: *
                 30: *
14D9 8B14        31: TABOK    ADDA     #LSTSTRT-1        MAKE VALUE OK
14DB 25F3        32:          BCS      TABOVF              B/ OOPS! TOO BIG.
                 33:          ;LDX     TABTBL            GET PTR TO NEXT TAB
14DD DEB4        34:          LDX      TABTBL
                 35:          ;CMPA    0,X               SEE IF TAB IS GREATER THAN THE ONE BEFORE
14DF A100        36:          CMPA     0,X
14E1 23ED        37:          BLS      TABOVF              B/ NOT, ERROR
14E3 08          38:          INX                        PT TO NEXT TAB
14E4 A700        39:          STAA     0,X               SAVE IT
14E6 DFB4        40:          STX      TABTBL            SAVE PTR FOR NEXT TIME
14E8 8C2F44      41:          CPX      #TBTB+TABMAX+2




ASM/6800 1.3H4: 14EB ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 132; Form 23    - - - T A B S - - -
ASM14A.MAIN.ASM
14EB 27E3        42:          BEQ      TABOVF            IF RAN OUT OF SPACE - ERROR
                 43:          ;CLR     1,X               SET END OF TAB TABLE
14ED 6F01        44:          CLR      1,X
                 45:          ;JSR     GTCMA             GET THE COMMA
14EF BD1E1C      46:          JSR      GTCMA
14F2 29D3        47:          BVS      NTAB              IF FOUND, GO DO NEXT TAB
                 48:          ;LDX     #TBTB             ELSE, LOAD UP RIGHT TABLE ADDR
14F4 CE2F3A      49:          LDX      #TBTB
14F7 20DD        50:          BRA      TABRET            AND GET OUT
                 51:          FIN




ASM/6800 1.3H4: 14F7 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
08/16/82 00:00:00; Page 133; Form 24    - - - P A G E - - -
ASM14A.MAIN.ASM
                  2:    
                  3: *
                  4: *
                  5: *  P A G E :
                  6: *
                  7: *        Handles PAGE command.  Just puts us at bottom-of-form
                  8: *        and returns.
  0001            9:          IF       TITLES=1
                 10: *        IF ARGUMENT FIELD IS NON-ZERO, SETS SUBTITLE AS WELL.
                 11:          FIN
                 12: *
                 13: *
                 14: *  S P A C E :
                 15: *
                 16: *        Handles SPACE / SPC commands.  It skips <EXP> lines, or
                 17: *        to bottom-of-form:  whichever comes first.
                 18: *        If <EXP> is zero, then we skip 1 line.
                 19: *
                 20: *  E J E C T
                 21: *
                 22: *        Functionally equivalent to PAGE command, but for use
                 23: *        by the innards of the assembler.
  0001           24:          IF       TITLES=1
                 25: *
                 26: * T I T L E :
                 27: *
                 28: *        LIKE PAGE, BUT SETS THE TITLE FIELD OF THE PAGE HEADING.
                 29: *
                 30:          FIN
                 31: * N A M E :
                 32: *        EXACTLY LIKE TITLE BUT PUTS THE STRING IN THE NAME BUFFER.
                 33: *
                 34: *
                 35: * FORMAT OF COMMANDS WITH TITLES POSSIBLE:
                 36: *
                 37: *        NAME/PAGE/TITLE     (;)(TITLE DESIRED)
                 38: *
                 39: * IF A ";" IS PRESENT AS THE FIRST CHAR,
                 40: *   IT IS TURNED INTO A SPACE .
                 41: *




ASM/6800 1.3H4: 14F7 ASM/6800 1.4       - - - D I R E C T I V E   P R O C E S S I N G - - -
