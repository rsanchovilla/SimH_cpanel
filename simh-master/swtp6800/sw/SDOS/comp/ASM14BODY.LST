1D2D DE32        21:          LDX      MLD
1D2F 27EF        22:          BEQ      XMUL2               B/ REM. IS 0; RESULT IS GOOD.
1D31 8B01        23:          ADDA     #1                ELSE BUMP QUOTIENT,
1D33 C900        24:          ADCB     #0                  PROPOGATE CARRY,
1D35 20E9        25:          BRA      XMUL2               AND RETURN RESULT.
                 26: *
                 27: * A\B  A MOD B
1D37 8D0A        28: XMOD     BSR      DODIV
1D39 9633        29:          LDAA     MLD+1             RETURN REMAINDER.
1D3B D632        30:          LDAB     MLD
1D3D 20E1        31:          BRA      XMUL2             GO BYE-BYE




ASM/6800 1.3H4: 1D3D ASM/6800 1.4       - - - E X P R E S S I O N S - - -
08/16/82 00:00:00; Page 208; Form 21    - - - D O D I V - - -
ASM14A.EVAL.ASM
                  2: *29*
                  3: *
                  4: * DODIV --
                  5: *        DIVIDES OA BY OB;
                  6: *        QUOTIENT IN MLC
                  7: *        REMAINDER IN MLD
                  8: *
                  9: *        IF ENTERED BY GTMDARG, JUST COPIES ARGS AND RETURNS.
                 10: *
1D3F 8601        11: GMDARG   LDAA     #1                REMEMBER WHAT WE ARE...
1D41 2001        12:          BRA      DODIV1
1D43 4F          13: DODIV    CLRA
1D44 30          14: DODIV1   TSX
                 15:          ;LDX      OAH+2,X           (RETURN @ IS ON STACK)
1D45 EE05        16:          LDX      OAH+2,X
1D47 DF2C        17:          STX      MLA
1D49 30          18:          TSX
                 19:          ;LDX      OBH+2,X
1D4A EE02        20:          LDX      OBH+2,X
1D4C DF2E        21:          STX      MLB
1D4E 4D          22:          TSTA
1D4F 2701        23:          BEQ      DIVIDE            B/ GO DO DIVIDE.
1D51 39          24:          RTS                        ELSE EXIT.




ASM/6800 1.3H4: 1D51 ASM/6800 1.4       - - - E X P R E S S I O N S - - -
08/16/82 00:00:00; Page 209; Form 22    - - -  D I V I D E  - - -
ASM14A.EVAL.ASM
                  2: *
                  3: * DIVIDE --
                  4: *
                  5: *  MLA IS THE DIVIDEND;
                  6: *  MLB IS THE DIVISOR;
                  7: *  MLC IS THE QUOTIENT;
                  8: *  MLD IS THE REMAINDER.
                  9: *
                 10: *  IF DIVISOR IS ZERO, OVERFLOW IS SIGNALED.;  RESULT IS $FFFF
                 11: *
                 12: *
  1D52           13: DIVIDE   EQU      *
                 14:          ;LDX     MLB               CK/ DIVISION BY ZERO?
1D52 DE2E        15:          LDX      MLB
1D54 2607        16:          BNE      DIV1                B/ NOPE.
1D56 DF30        17:          STX      MLC               ...TRYING TO FOOL ME, EH?
1D58 DF32        18:          STX      MLD                 IN THAT CASE, CLEAR REMANDER & QUOTIENT,
                 19:          ;JMP     OVRFLW              FLAG OVERFLOW AND RETURN.
1D5A 7E0883      20:          JMP      OVRFLW
                 21: *
  1D5D           22: DIV1     ;LDX      MLA               INITIALIZE THE REMAINDER;
1D5D DE2C        23:          LDX      MLA
1D5F DF30        24:          STX      MLC
                 25:          ;LDX      #0                ALSO THE QUOTIENT.
1D61 CE0000      26:          LDX      #0
1D64 DF32        27:          STX      MLD               (THIS ALSO MAKES A HANDY CONSTANT)
1D66 C610        28:          LDAB     #16               NUMBER OF DIVIDE STEPS...
                 29: *
1D68 6831        30: DIVL     ASL      MLC+1,X           SHIFT  (REMAINDER,QUOTIENT) LEFT 1
1D6A 6930        31:          ROL      MLC,X
1D6C 6933        32:          ROL      MLD+1,X
1D6E 6932        33:          ROL      MLD,X
1D70 9633        34:          LDAA     MLD+1             COMPARE REMAINDER TO DIVISOR...
1D72 902F        35:          SUBA     MLB+1
1D74 36          36:          PSHA                       (SAVE THE RESULT.)
1D75 9632        37:          LDAA     MLD
1D77 922E        38:          SBCA     MLB
1D79 2509        39:          BCS      DIV2              B/ NO DO SUBTRACT.
1D7B 9732        40:          STAA     MLD               SAVE HIGH QUOTIENT
1D7D 32          41:          PULA                       GET LOW QUOTIENT




ASM/6800 1.3H4: 1D7E ASM/6800 1.4       - - - E X P R E S S I O N S - - -
08/16/82 00:00:00; Page 210; Form 22    - - -  D I V I D E  - - -
ASM14A.EVAL.ASM
1D7E 9733        42:          STAA     MLD+1
                 43:          ;INC      MLC+1,X           NEXT QUOTIENT BIT IS 1
1D80 6C31        44:          INC      MLC+1,X
1D82 2001        45:          BRA      DIV3
                 46: 
1D84 31          47: DIV2     INS
1D85 5A          48: DIV3     DECB                       DECREMENT STEP COUNTER,
1D86 26E0        49:          BNE      DIVL              B/ DO ANOTHER.
1D88 39          50:          RTS                        ELSE ALL DONE.




ASM/6800 1.3H4: 1D88 ASM/6800 1.4       - - - E X P R E S S I O N S - - -
08/16/82 00:00:00; Page 211; Form 23    - - -  M U L T I P L Y  - - -
ASM14A.EVAL.ASM
                  2: *         SPACE
                  3: *
                  4: * MULTPLY --
                  5: *
                  6: * MLA IS MULTIPICAND
                  7: * MLB IS MULTIPLIER
                  8: * MLC IS RESULT
                  9: * MLD IS OVERFLOW WORD
                 10: *
  1D89           11: MULTPLY  EQU      *
1D89 C610        12:          LDAB     #16               GET # OF MULTIPLY STEPS
1D8B D730        13:          STAB     MLC               AND PUT IN A SAFE PLACE.
1D8D 4F          14:          CLRA                       PRESET RESULT TO ZERO
1D8E 5F          15:          CLRB
                 16:          ;LDX      MLB               TRANSFER MULTIPLIER ....
1D8F DE2E        17:          LDX      MLB
1D91 DF32        18:          STX      MLD               ... TO OVERFLOW WORD.
                 19:          ;LDX      #0                GET HANDY CONSTANT.
1D93 CE0000      20:          LDX      #0
                 21: *
1D96 58          22: MULLP    ASLB
1D97 49          23:          ROLA
1D98 6933        24:          ROL      MLD+1,X
1D9A 6932        25:          ROL      MLD,X
1D9C 2404        26:          BCC      MUL1              B/ DON'T DO AN ADD STEP.
1D9E DB2D        27:          ADDB     MLA+1
1DA0 992C        28:          ADCA     MLA
                 29: *
  1DA2           30: MUL1     ;DEC      MLC,X             THIS STEP DONE...
1DA2 6A30        31:          DEC      MLC,X
1DA4 2EF0        32:          BGT      MULLP             B/ SO DO ANOTHER.
1DA6 9730        33:          STAA     MLC               SAVE RESULT
1DA8 D731        34:          STAB     MLC+1
                 35:          ;LDX      MLD               CHECK FOR OVERFLOW.
1DAA DE32        36:          LDX      MLD
1DAC 2701        37:          BEQ      MULV1             B/ NONE.
1DAE 0B          38:          SEV
1DAF 39          39: MULV1    RTS




ASM/6800 1.3H4: 1DAF ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 212; Form 24    - - - G T C H T - - -
ASM14A.EVAL.ASM
                  3: *30*
                  4: *
                  5: *  GET NEXT CH, AND ITS TYPE.
                  6: *        A := CH;  B := TYPE.
                  7: *
  1DB0            8: GTCHT    EQU      *
                  9:          ;JSR      GETXC             GET CHARACTER
1DB0 BD1F95      10:          JSR      GETXC
                 11:          ;JSR      CHRANGE           CHECK FOR IN RANGE.
1DB3 BD0848      12:          JSR      CHRANGE
1DB6 415A        13:          FCB      'A,'Z
1DB8 1DCB        14:          FDB      GTCH1             ALPHABETIC
1DBA 617A        15:          FCB      'a,'z             lower case ==>UPPER CASE
1DBC 1DC9        16:          FDB      GTCH1L
1DBE 3039        17:          FCB      '0,'9
1DC0 1DCE        18:          FDB      GTCH2             DIGIT
1DC2 00          19:          FCB      0
                 20: * WEIRD -- FIND IT IN TABLE.
                 21:          ;LDX      #CHTBL            GET AN INDEX
1DC3 CE1DD1      22:          LDX      #CHTBL
                 23:          ;JMP      FINDAX            AND FIND IN THE TABLE.
1DC6 7E1FF8      24:          JMP      FINDAX
                 25: *
                 26: *
1DC9 8BE0        27: GTCH1L   ADDA     #'A-'a            MAKE IT UPPER CASE.
1DCB C601        28: GTCH1    LDAB     #C:ALPH
1DCD 39          29:          RTS
1DCE C602        30: GTCH2    LDAB     #C:NUM            IT'S A DIGIT
1DD0 39          31:          RTS




ASM/6800 1.3H4: 1DD0 ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 213; Form 25    - - - TABLE OF CHARACTERS AND TYPES - - -
ASM14A.EVAL.ASM
                  2: *
                  3: * CHTBL:
                  4: *        FIRST BYTE OF EACH IS AN ASCII CHARACTER;
                  5: *        SECOND BYTE IS ITS TYPE.  TABLE ENDS W/ A $80 FOR FINDAX;
                  6: *        THUS FORCES ALL OTHER CHARS TO TYPE OF C:UNK.
                  7: *
  1DD1            8: CHTBL    EQU      *
1DD1 3A01         9:          FCB      ':,C:ALPH
1DD3 2401        10:          FCB      '$,C:ALPH
1DD5 4001        11:          FCB      '@,C:ALPH
1DD7 2501        12:          FCB      '%,C:ALPH
                 13: *
  0000           14:          DO       STRINGS=1
 *S*             15:          FCB      '",C:QQ
                 16:          FIN
                 17: *
1DD9 2705        18:          FCB      '',C:Q
1DDB 2806        19:          FCB      '(,C:LP
1DDD 2907        20:          FCB      '),C:RP
1DDF 2009        21:          FCB      BLANK,C:BL
1DE1 0909        22:          FCB      TAB,C:BL
1DE3 0D03        23:          FCB      $D,C:CR
1DE5 3B03        24:          FCB      ';,C:CR
1DE7 2C08        25:          FCB      ',,C:TERM
1DE9 5D08        26:          FCB      '],C:TERM
1DEB 2E01        27:          FCB      '.,C:ALPH
1DED 800A        28:          FCB      $80,C:UNK




ASM/6800 1.3H4: 1DED ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 214; Form 26    - - - T B J M P - - -
ASM14A.EVAL.ASM
                  2: *32*
                  3: *
                  4: * TBJMP --
                  5: *        DOES A TABLE BRANCH.  (B) = WORD INDEX
                  6: *        A-Reg Preserved
                  7: *
  1DEF            8: TBJMP    ;PULX                      Pull return address
1DEF 30           9:          TSX
1DF0 EE00        10:          LDX      0,X
1DF2 31          11:          INS
1DF3 31          12:          INS
1DF4 58          13:          ASLB                       MAKE A WORD INDEX,
  0000           14:          DO       M6809=1
 *S*             15:          ;LDX     ,X                Table address
 *S*             16:          LDX      0,X
 *S*             17:          ;JMP     [B,X]
 *S*             18:          LDX      B,X
 *S*             19:          JMP      0,X
                 20:          ELSE
1DF5 EB01        21:          ADDB     1,X               GET VALUE OF LOW
1DF7 37          22:          PSHB
1DF8 E600        23:          LDAB     0,X
1DFA C900        24:          ADCB     #0
1DFC 37          25:          PSHB
                 26:          ;PULX
1DFD 30          27:          TSX
1DFE EE00        28:          LDX      0,X
1E00 31          29:          INS
1E01 31          30:          INS
                 31:          ;LDX      0,X               GET ACTUAL ADDRESS,
1E02 EE00        32:          LDX      0,X
                 33:          ;JMP      0,X               AND GO TO IT.
1E04 6E00        34:          JMP      0,X
                 35:          FIN




ASM/6800 1.3H4: 1E04 ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 215; Form 27    - - - C K E O F - - -
ASM14A.EVAL.ASM
                  2: *
                  3: * CKEOF - CHECK THAT THE NEXT THING TO BE SCANNED IS
                  4: *        THE END OF A FIELD. (I.E. A TERMINATOR
                  5: *        BUT NOT A COMMA).
                  6: *
                  7: *        IF EOF SEEN -- Z=1
                  8: *        IF NOT      -- Z=0
                  9: *
1E06 8D24        10: CKEOF    BSR      GNOBJ             GET THE OBJ TO LOOK AT
                 11:          ;INC     RJOBJ             REJECT IT
1E08 7C005C      12:          INC      RJOBJ
                 13:          ;CMPA    #O:TERM           A TERM?
1E0B 8106        14:          CMPA     #O:TERM
1E0D 2605        15:          BNE      RTEOF             IF NOT, Z=0 RETURN
                 16:          ;CMPB    #ASCII:COMMA      A COMMA?
1E0F C12C        17:          CMPB     #ASCII:COMMA
1E11 07          18:          TPA                        INVERT THE Z BIT
1E12 8504        19:          BITA     #4
1E14 39          20: RTEOF    RTS
                 21: *
                 22: * ECKEOF - CK IF EOF IS NEXT. IF NOT, GIVE ILLEGAL AF ERR 
                 23: *        AND RETURN. ELSE JUST RETURN.
                 24: *
1E15 8DEF        25: ECKEOF   BSR      CKEOF             CHECK IT
1E17 27FB        26:          BEQ      RTEOF             IF FOUND EOF - JUST RETURN
                 27:          ;JMP     ILLAF             ELSE, GO TELL HIM ABOUT ILLEGAL AF
1E19 7E086B      28:          JMP      ILLAF
                 29: *




ASM/6800 1.3H4: 1E19 ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 216; Form 28    - - - G T C M A - - -
ASM14A.EVAL.ASM
                  2: *
                  3: *   G T C M A
                  4: *
                  5: *        Calls GNOBJ until a terminator is seen; then returns
                  6: *        V=1 if terminator was a comma.  Otherwise, V=0.
                  7: *
  1E1C            8: GTCMA    EQU      *
1E1C 8D0E         9:          BSR      GNOBJ             GET OBJECT
                 10:          ;CMPA     #O:TERM
1E1E 8106        11:          CMPA     #O:TERM
1E20 26FA        12:          BNE      GTCMA
                 13:          ;CMPB     #ASCII:COMMA
1E22 C12C        14:          CMPB     #ASCII:COMMA
1E24 0B          15:          SEV
1E25 2704        16:          BEQ      GTCRET
                 17:          ;INC     RJOBJ             REJECT THIS OBJECT IF A TERM IS SEEN
1E27 7C005C      18:          INC      RJOBJ
1E2A 0A          19:          CLV
1E2B 39          20: GTCRET   RTS




ASM/6800 1.3H4: 1E2B ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 217; Form 29    - - - G N O B J - - -
ASM14A.EVAL.ASM
                  2: *33*
                  3: *
                  4: *
                  5: *   G N O B J   /    G N O B X
                  6: *
                  7: *        GETS NEXT OBJECT FROM STRING POINTED TO BY
                  8: *        EXPTR.  OBJECT IS ONE OF THE FOLLOWING --
                  9: *
                 10: *        OBJ      VALUE RETURNED:
                 11: *        ---      ---------------
                 12: *
                 13: *        SYMBOL   O:SYM;  SYM:=TEXT OF SYMBOL
                 14: *        NUMBER   O:NUM;  VAL:=VALUE
                 15: *        STRING   O:STR;  STBUF:=STRING
                 16: *        (        O:LP;
                 17: *        )        O:RP;
                 18: *        DELIM.   (BLANK, TAB, ';, ',, $D) O:TERM; B:=CH
                 19: *        OPERATOR O:OP; B:=OPERATOR
                 20: *        OTHERS   O:UNK; B:=CH.
                 21: *
                 22: * NB:
                 23: *   ---->NO MATTER HOW HARD YOU TRY, ONCE YOU HAVE GOTTEN TO A $D
                 24: *        YOU CAN'T GO PAST IT.  THE SAME HOLDS TRUE FOR '; NOT IN A STRI
                 25: *   ---->IF RJOBJ IS NON-ZERO, THEN THE LAST OBJECT RETURNED IS
                 26: *        RETURNED AGAIN.
                 27: *   ---->A:=OBJECT; B:= SOME KIND OF TYPE DEPENDENT INFO.
                 28: *
                 29: *        IF ENTERED VIA GNOBX, EXPTR IS SET TO (X); REJECTED OBJECT
                 30: *        IS IGNORED.
                 31: *
                 32: *




ASM/6800 1.3H4: 1E2B ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 218; Form 30    - - - G N O B J - - -
ASM14A.EVAL.ASM
                  2: *33*
1E2C 965C         3: GNOBJ    LDAA     RJOBJ             WAS LAST OBJECT REJECTED?
1E2E 270C         4:          BEQ      GNOB1             B/ NO.  GET A NEW ONE.
                  5: * OBJECT WAS REJECTED; RETURN IT AGAIN
1E30 965A         6:          LDAA     RJA
1E32 D65B         7:          LDAB     RJB
  1E34            8: GNOBC    ;CLR      RJOBJ
1E34 7F005C       9:          CLR      RJOBJ
1E37 39          10:          RTS
                 11: *
                 12: * OH, WELL....  GO GET AN OBJECT.
                 13: *
1E38 DF28        14: GNOBX    STX      EXPTR
1E3A 8DF8        15:          BSR      GNOBC             SAVE A BYTE WHERE YOU CAN...
  1E3C           16: GNOB1    ;JSR      GTCHT
1E3C BD1DB0      17:          JSR      GTCHT
                 18:          ;JSR      TBJMP             AND DO A TABLE JUMP.
1E3F BD1DEF      19:          JSR      TBJMP
1E42 1E42        20:          FDB      GNTBL-2
                 21: *34*
                 22: *
1E44 1F42        23: GNTBL    FDB      GSYM              C:ALPH ==> SYMBOL
1E46 1EC3        24:          FDB      GNUM              C:NUM ==> NUMBER
1E48 1FBF        25:          FDB      GEOL              C:CR ; OR $D
                 26: *
  0000           27:          DO       STRINGS=1
 *S*             28:          FDB      GSTR              C:QQ " ==> STRING
                 29:          ELSE
1E4A 1FC6        30:          FDB      GUNK              *** SHOULD NEVER HAPPEN...
                 31:          FIN
                 32: *
1E4C 1F74        33:          FDB      GCH               C:Q ' ==> CHARACTER
1E4E 1FA4        34:          FDB      GETLP             C:LP ( ==> LEFT PAREN
1E50 1FA8        35:          FDB      GETRP             C:RP ) ==> RIGHT PAREN
1E52 1FBA        36:          FDB      GTRM              C:TERM ==> DELIMITER.
1E54 1FAC        37:          FDB      GBLK              C:BL ==> BLANK.
1E56 1FC6        38:          FDB      GUNK              C:UNK ==> MAYBE OPERATOR.




ASM/6800 1.3H4: 1E56 ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 219; Form 31    - - - G H E X - - -
ASM14A.EVAL.ASM
                  2: *
                  3: *
                  4: *   G H E X
                  5: *
                  6: *        COLLECTS A HEXADECIMAL #.
                  7: *        IF ENTERED THRU GHEX, THEN ACCB SHOULD CONTAIN
                  8: *        THE RADIX OF THE NUMBER-1 ($F, $7 OR $1).  IT IS
                  9: *        ASSUMED THAT A PREQUALIFIER WAS SEEN.
                 10: *
                 11: *        IF ENTERED THRU GHXE, THEN A POST-QUALIFIER WAS
                 12: *        SEEN & GOT US HERE.  THE QUALIFIER DIGIT IS IN (A),
                 13: *        THE RADIX IS IN B.
                 14: *
                 15: *        IN ANY EVENT, EITHER THE POST-QUALIFIER OR A NULL IS
                 16: *        STORED IN RJA FOR WHEN WE FIND THE END OF THE #.
                 17: *
                 18: *
  1E58           19: GHEX     EQU      *                 B CONTAINS RADIX.
1E58 4F          20:          CLRA
1E59 975A        21: GHXE     STAA     RJA               NO QUALIFIER EXPECTED.
1E5B 4F          22:          CLRA
1E5C 975F        23:          STAA     VAL               ACCA BETTER BE ZERO...
1E5E 9760        24:          STAA     VAL+1
1E60 8D40        25:          BSR      GTXD              GET A HEX DIGIT...
1E62 2705        26:          BEQ      GHX0              B/ OK...
                 27:          ;JSR      SYNTAX            *E* QUALIFIER $%@ W/O NUMBER
1E64 BD0867      28:          JSR      SYNTAX
1E67 201B        29:          BRA      GOTNUM
                 30: * GOT 1ST DIGIT.
  1E69           31: GHX0     EQU      *
1E69 11          32:          CBA                        IS DIGIT LEGAL?
1E6A 2E21        33:          BGT      GHXI              B/ NO, TOO BIG.
1E6C 37          34:          PSHB                       SAVE THE DIGIT.
1E6D 780060      35: GHXL     ASL      VAL+1             MULTIPLY BY 2^B
1E70 79005F      36:          ROL      VAL
1E73 2403        37:          BCC      GHX1              B/ NO OVERFLOW...
                 38:          ;JSR      OVRFLW            *E* NUMBER TOO BIG.
1E75 BD0883      39:          JSR      OVRFLW
1E78 54          40: GHX1     LSRB                       ANY SHIFTS LEFT?
1E79 26F2        41:          BNE      GHXL              B/ YUP: GO DO ANOTHER.




ASM/6800 1.3H4: 1E79 ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 220; Form 31    - - - G H E X - - -
ASM14A.EVAL.ASM
                 42: *
1E7B 33          43:          PULB                       GET RADIX BACK.
1E7C 9B60        44:          ADDA     VAL+1             GET NEW DIGIT,
1E7E 9760        45:          STAA     VAL+1             (NO CARRY POSSIBLE)
1E80 8D20        46: GHX2     BSR      GTXD              GET NTH HEX DIGIT
1E82 27E5        47:          BEQ      GHX0              B/ GOT ANOTHER: ACCUMULATE
                 48: *
                 49: * VAL CONTAINS VALUE; RETURN TYPE = NUMBER
1E84 8602        50: GOTNUM   LDAA     #O:NUM            IT'S A NUM
                 51: *         SPACE
1E86 975A        52: GOTOBJ   STAA     RJA
1E88 D75B        53:          STAB     RJB
                 54:          ;LDX      EXPTR
1E8A DE28        55:          LDX      EXPTR
1E8C 39          56:          RTS




ASM/6800 1.3H4: 1E8C ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 221; Form 32    - - - G H E X - - -
ASM14A.EVAL.ASM
                  1: *  WIERD DIGIT FOUND:
  1E8D            2: GHXI     EQU      *
1E8D 36           3:          PSHA                       SAVE THIS DIGIT...
1E8E 8D12         4:          BSR      GTXD              GET A HEX DIGIT...
1E90 2707         5:          BEQ      GHXI1             B/ NOT LAST:  ILLEGAL.
                  6: * THE DIGIT MAY HAVE BEEN QUALIFIER.
1E92 32           7:          PULA                       GET THE DIGIT BACK...
                  8:          ;CMPA     RJA               WAS IT THE QUALIFIER WE WANTED?
1E93 915A         9:          CMPA     RJA
1E95 27ED        10:          BEQ      GOTNUM            B/ YES... # IS OK.
1E97 2004        11:          BRA      GHXI2             ELSE ERROR...
                 12: * ILLEGAL DIGIT...
1E99 31          13: GHXI1    INS                        POP STACK
                 14:          ;JSR      RJXCH             REJECT CHAR.
1E9A BD1F9E      15:          JSR      RJXCH
  1E9D           16: GHXI2    ;JSR      BADDIG            *E* BAD DIGIT
1E9D BD088F      17:          JSR      BADDIG
1EA0 20DE        18:          BRA      GHX2              AND GO ON.




ASM/6800 1.3H4: 1EA0 ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 222; Form 33    - - - G T X D - - -
ASM14A.EVAL.ASM
                  2: *
                  3: *  GTXD--
                  4: *        GET A HEX DIGIT INTO A.  DOES NOT CLOBBER B.
                  5: *        RETURNS A AS HEXADECIMAL VALUE OR AS TERMINATOR.
                  6: *        IF Z IS SET ON RETURN, THEN A IS A VALID HEX DIGIT.
                  7: *
  1EA2            8: GTXD     EQU      *
1EA2 37           9:          PSHB                       SAVE ACCB
                 10:          ;JSR      GTCHT             GET EXPRESSION CH.
1EA3 BD1DB0      11:          JSR      GTCHT
                 12:          ;JSR      CHRANGE           WHAT IS IT?
1EA6 BD0848      13:          JSR      CHRANGE
1EA9 3039        14:          FCB      '0,'9             DIGIT.
1EAB 1EBE        15:          FDB      GTXD1
1EAD 415A        16:          FCB      'A,'Z             DIGIT.
1EAF 1EBC        17:          FDB      GTXD2
1EB1 00          18:          FCB      0
1EB2 865A        19:          LDAA     #'Z               GET A BAD DIGIT,
                 20:          ;CMPB     #C:ALPH           WAS IT ALPHABETIC?
1EB4 C101        21:          CMPB     #C:ALPH
1EB6 2704        22:          BEQ      GTXD2             B/ YES.  GO ON.
                 23: *
1EB8 33          24:          PULB                       NOT A VALID DIGIT:
                 25:          ;JMP      RJXCH             DOES A DEX; CC WILL HAVE Z CLEAR.
1EB9 7E1F9E      26:          JMP      RJXCH
                 27: *
1EBC 8007        28: GTXD2    SUBA     #'A-'0-$A
1EBE 8030        29: GTXD1    SUBA     #'0
                 30: *
1EC0 5F          31:          CLRB                       SET CCZ
1EC1 33          32:          PULB                       AND RESTORE ACCB
1EC2 39          33:          RTS                        AND EXIT.




ASM/6800 1.3H4: 1EC2 ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 223; Form 34    - - - G T X D - - -
ASM14A.EVAL.ASM
                  2: *
                  3: * GET A DECIMAL NUMBER --
                  4: *        CODE TO GET NNNNB, NNNNH, NNNNO WILL ALSO GO HERE.
                  5: *
  1EC3            6: GNUM     ;LDX      EXPTR             SAVE POINTER...
1EC3 DE28         7:          LDX      EXPTR
1EC5 DF34         8:          STX      TPTR              IN CASE IT AINT DECIMAL
1EC7 8030         9:          SUBA     #'0               MAKE A REAL DIGIT,
1EC9 9760        10:          STAA     VAL+1             POKE IT AWAY,
                 11:          ;CLR      VAL               AND CLEAR HIGH BYTE.
1ECB 7F005F      12:          CLR      VAL
  1ECE           13: GNUML    ;JSR      GTCHT             GET NEXT CH W/ TYPE,
1ECE BD1DB0      14:          JSR      GTCHT
                 15:          ;CMPB     #C:NUM            IS IT A DIGIT?
1ED1 C102        16:          CMPB     #C:NUM
1ED3 2621        17:          BNE      GNUMYCH           B/ NO:  MAYBE ALL DONE.
1ED5 8030        18:          SUBA     #'0               MAKE A REAL DIGIT,
1ED7 36          19:          PSHA                       AND SAVE IT.
1ED8 965F        20:          LDAA     VAL               GET H(VAL)
1EDA D660        21:          LDAB     VAL+1             GET L(VAL)
1EDC 58          22:          ASLB                       M
1EDD 49          23:          ROLA                         U
1EDE 37          24:          PSHB                           L
1EDF 36          25:          PSHA                             T
1EE0 58          26:          ASLB                               I
1EE1 49          27:          ROLA                           B     P
1EE2 58          28:          ASLB                       T     Y     L
1EE3 49          29:          ROLA                         E           Y
1EE4 30          30:          TSX                            N
                 31: *
                 32: * STACK NOW LOOKS LIKE THIS:
                 33: *
                 34: *        SP+1 ==> VAL*2
                 35: *        SP+2
                 36: *        SP+3 ==> NEW DIGIT
                 37: *
                 38: *        ACCA ==> VAL*8
                 39: *        ACCB
                 40: *
1EE5 EB01        41:          ADDB     1,X               ADD IN LOW BYTE




ASM/6800 1.3H4: 1EE7 ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 224; Form 34    - - - G T X D - - -
ASM14A.EVAL.ASM
1EE7 8900        42:          ADCA     #0                PROPOGATE CARRY
1EE9 EB02        43:          ADDB     2,X
1EEB A900        44:          ADCA     0,X               AND NEW DIGIT, W/ CARRY
1EED 975F        45:          STAA     VAL
1EEF D760        46:          STAB     VAL+1
                 47:          ;LEAS    3,S               Prune stack
  0000           48:          IF       3<0
 *S*             49:          RPT      -3
 *S*             50:          DES
                 51:          ELSE
  0003           52:          RPT      3
1EF1 31          53:          INS
                 54:          FIN
1EF4 20D8        55:          BRA      GNUML             AND GO GET ANOTHER




ASM/6800 1.3H4: 1EF4 ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 225; Form 35    - - - G T X D - - -
ASM14A.EVAL.ASM
                  2: *
                  3: * NOT A DIGIT:  MAY BE THE END OF THE NUMBER...
                  4: *
  1EF6            5: GNUMYCH  ;JSR      RJXCH             REJECT THIS CHARACTER,
1EF6 BD1F9E       6:          JSR      RJXCH
                  7:          ;CMPB     #C:ALPH           IS IT AN ALPHABETIC CH?
1EF9 C101         8:          CMPB     #C:ALPH
1EFB 2687         9:          BNE      GOTNUM            B/ NO: MUST BE TERMINATOR
                 10: *
                 11: * THIS IS WEIRD:  FIND A NON-ALPHABETIC.
                 12: *        USES RJA AS TEMP FOR LAST CH SEEN;
                 13: *        USES RJB AS TEMP FOR TYPE OF LAST CH SEEN.
                 14: *
1EFD 975A        15: GNUMY1   STAA     RJA               SAFE PLACE
1EFF D75B        16:          STAB     RJB
                 17:          ;JSR      GTCHT             WHAT'S NEXT?
1F01 BD1DB0      18:          JSR      GTCHT
                 19:          ;CMPB     #C:NUM            A DIGIT?
1F04 C102        20:          CMPB     #C:NUM
1F06 27F5        21:          BEQ      GNUMY1            B/ YES: KEEP SLURPING
                 22:          ;CMPB     #C:ALPH           A LETTER?
1F08 C101        23:          CMPB     #C:ALPH
1F0A 27F1        24:          BEQ      GNUMY1            B/ YES: KEEP SLURPING
1F0C 965A        25:          LDAA     RJA               ELSE GET LAST DIGIT OF #
1F0E D65B        26:          LDAB     RJB               WITH TYPE,
                 27:          ;CMPB     #C:ALPH           DID IT END W/ QUALIFIER?
1F10 C101        28:          CMPB     #C:ALPH
1F12 2709        29:          BEQ      GNUMY2            B/ MAYBE.
                 30: *
                 31: * ILLEGAL DIGIT DETECTED...
  1F14           32: GNUMY11  ;JSR      REJCH             REJECT THE TERMINATOR
1F14 BD1F9E      33:          JSR      REJCH
                 34:          ;JSR      BADDIG            *E* ILLEGAL DIGIT
1F17 BD088F      35:          JSR      BADDIG
                 36:          ;JMP      GOTNUM            AND RETURN THE NUMBER.
1F1A 7E1E84      37:          JMP      GOTNUM
                 38: *
                 39: * MAYBE NNNNH, NNNNO, OR NNNNB
                 40: *
  1F1D           41: GNUMY2   EQU      *                 WHAT WAS TERMINATOR?




ASM/6800 1.3H4: 1F1A ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 226; Form 35    - - - G T X D - - -
ASM14A.EVAL.ASM
                 42:          ;LDX      #GNUMQ            @ OF QUALIFIER TABLE.
1F1D CE1F2F      43:          LDX      #GNUMQ
                 44:          ;JSR      FINDAX            GO FIND ACCA.
1F20 BD1FF8      45:          JSR      FINDAX
1F23 29EF        46:          BVS      GNUMY11           B/ NOT A LEGAL TERMINATOR.
                 47: * QUALIFIER WAS FOUND:
                 48: *        B NOW CONTAINS RADIX DIGIT.
                 49: *
                 50:          ;LDX      TPTR              GET @ OF START OF #,
1F25 DE34        51:          LDX      TPTR
1F27 09          52:          DEX                        POINT TO START,
1F28 DF28        53:          STX      EXPTR             AND SAVE.
1F2A 8037        54:          SUBA     #'A-$A            MAKE INTO QUALIFIER DIGIT,
                 55:          ;JMP      GHXE              AND GO EAT IT UP.
1F2C 7E1E59      56:          JMP      GHXE




ASM/6800 1.3H4: 1F2C ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 227; Form 36    - - - G T X D - - -
ASM14A.EVAL.ASM
                  2: *
                  3: * QUALIFIER TABLES:
                  4: *        (1) POST-FIX QUALIFIER
                  5: *
  1F2F            6: GNUMQ    EQU      *
1F2F 480F         7:          FCB      +'H,$F
1F31 4F07         8:          FCB      +'O,$7
1F33 5107         9:          FCB      +'Q,$7
1F35 4201        10:          FCB      +'B,$1
1F37 80          11:          FCB      $80
                 12: *
                 13: *        (2) PRE-FIX QUALIFIERS
                 14: *
  1F38           15: GSYMT    EQU      *
1F38 240F        16:          FCB      '$,$F
1F3A 4007        17:          FCB      '@,$7
1F3C 2501        18:          FCB      '%,$1
1F3E 80          19:          FCB      $80




ASM/6800 1.3H4: 1F3E ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 228; Form 37    - - - G T X D - - -
ASM14A.EVAL.ASM
                  2: *37*
                  3: *
                  4: * GSYM --
                  5: *
                  6: *        GETS A SYMBOL...
                  7: *        DOESN'T LOOK IT UP.
                  8: *
                  9: *        ANYTHING STARTING W/ $, % OR @ IS SHUNTED TO APPROPRIATE ROUTIN
                 10: *
  1F3F           11: GSYM0    ;JMP      GHEX              GET US THERE.
1F3F 7E1E58      12:          JMP      GHEX
  1F42           13: GSYM     EQU      *
                 14:          ;LDX      #GSYMT            CHECK FOR $,%,@
1F42 CE1F38      15:          LDX      #GSYMT
                 16:          ;JSR      FINDAX
1F45 BD1FF8      17:          JSR      FINDAX
1F48 28F5        18:          BVC      GSYM0             AHA!  EAT NUMBER.
                 19: * A GOOD SYMBOL...
1F4A C601        20:          LDAB     #1                GET SIZE
                 21:          ;LDX      #SYM
1F4C CE0062      22:          LDX      #SYM
1F4F 08          23: GSYML    INX
1F50 A700        24:          STAA     0,X               SAVE CH
1F52 D762        25:          STAB     SYM               AND NEW COUNT.
1F54 DF34        26:          STX      TPTR              SAVE IN SAFE PLACE.
  1F56           27: GSYML1   ;JSR      GTCHT             GET A CHARACTER,
1F56 BD1DB0      28:          JSR      GTCHT
                 29:          ;CMPB     #C:ALPH           IS IT ALPHABETIC?
1F59 C101        30:          CMPB     #C:ALPH
1F5B 2704        31:          BEQ      GSYM1             B/ YES: SAVE IT.
                 32:          ;CMPB     #C:NUM            IS IT NUMERIC?
1F5D C102        33:          CMPB     #C:NUM
1F5F 260B        34:          BNE      GSYMD             B/ NO: ALL DONE.
1F61 D662        35: GSYM1    LDAB     SYM               GET SIZE.
                 36:          ;CMPB     #SYMMAX           TOO BIG?
1F63 C121        37:          CMPB     #SYMMAX
1F65 27EF        38:          BEQ      GSYML1            B/ YES, DONT SAVE IT
1F67 5C          39:          INCB
                 40:          ;LDX      TPTR              ELSE GET POINTER,
1F68 DE34        41:          LDX      TPTR




ASM/6800 1.3H4: 1F6A ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 229; Form 37    - - - G T X D - - -
ASM14A.EVAL.ASM
1F6A 20E3        42:          BRA      GSYML             AND SAVE.
                 43: *
1F6C 8601        44: GSYMD    LDAA     #O:SYM            IT'S A SYMBOL
                 45:          ;JSR      RJXCH             REJECT THE LAST CH,
1F6E BD1F9E      46:          JSR      RJXCH
  1F71           47: GOTOBJ1  ;JMP      GOTOBJ            B/ GOT THE OBJECT.
1F71 7E1E86      48:          JMP      GOTOBJ




ASM/6800 1.3H4: 1F71 ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 230; Form 38    - - - G T X D - - -
ASM14A.EVAL.ASM
                  2: *39*
                  3: *
                  4: * GCH --
                  5: *        RETURNS CHARACTER FOLLOWING SQUOTE; MAY BE
                  6: *        ANYTHING EXCEPT $D
                  7: *
  1F74            8: GCH      ;LDX      EXPTR             GET POINTER TO NEXT,
1F74 DE28         9:          LDX      EXPTR
1F76 A600        10:          LDAA     0,X               GET NEXT
                 11:          ;CMPA     #$D               IS IT A CR?
1F78 810D        12:          CMPA     #$D
1F7A 2711        13:          BEQ      GCHD              B/ YES:  BLECH.
1F7C 8A80        14:          ORAA     #$80              MARK AS "IN STRING",
1F7E A700        15:          STAA     0,X               SAVE IT,
1F80 08          16:          INX                        POINT TO NEXT CH.
1F81 DF28        17:          STX      EXPTR             AND SAVE.
1F83 847F        18:          ANDA     #$7F              SCRUB $80 BIT.
1F85 9760        19: GCH1     STAA     VAL+1             AND SAVE VAL.
                 20:          ;CLR      VAL
1F87 7F005F      21:          CLR      VAL
                 22:          ;JMP      GOTNUM            B/ GOT A NUMERIC VALUE.
1F8A 7E1E84      23:          JMP      GOTNUM
  1F8D           24: GCHD     ;JSR      ILLSTR            *E* ' FOLLOWED BY <EOL>
1F8D BD0897      25:          JSR      ILLSTR
1F90 4F          26:          CLRA                       RETURN A NULL
1F91 20F2        27:          BRA      GCH1




ASM/6800 1.3H4: 1F91 ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 231; Form 39    - - - G T X D - - -
ASM14A.EVAL.ASM
                  2: *39*
                  3: *
                  4: * GET A STRING.
                  5: *        STBUF := STRING; BYTE 0= COUNT; "" ==> "
                  6: *
  0000            7:          DO       STRINGS=1
 *S*              8: GSTR     EQU      *
 *S*              9:          CLRB                       CLEAR COUNT,
 *S*             10:          ;LDX      #STBUF            GET POINTER TO BUFFER
 *S*             11:          LDX      #STBUF
 *S*             12:          STAB     1,X               AND PUT A NULL THERE.
 *S*             13: GSTRL    STX      TPTR              SAVE POINTER,
 *S*             14: GSTRL1   BSR      GETXC             AND GET A CHARACTER.
 *S*             15:          ;CMPA     #$D               END OF LINE?
 *S*             16:          CMPA     #$D
 *S*             17:          BEQ      GSTRE             B/ YECCH.
 *S*             18:          ;CMPA     #'"               DQUOTE?
 *S*             19:          CMPA     #'"
 *S*             20:          BEQ      GSTRD             B/ MAYBE "";
 *S*             21: GSTR1    ;LDX      TPTR              GET POINTER
 *S*             22:          LDX      TPTR
 *S*             23:          INCB                       BUMP COUNT
 *S*             24:          BNE      GSTR2             B/ STILL ROOM
 *S*             25:          ;JSR      OVRFLW
 *S*             26:          JSR      OVRFLW
 *S*             27:          DECB                       BACK TO 255
 *S*             28:          BRA      GSTRL1            AND EAT UNTIL DONE.
 *S*             29: GSTR2    INX
 *S*             30:          STAA     0,X               SAVE CHARACTER
 *S*             31:          BRA      GSTRL             AND GET ANOTHER
 *S*             32: *
 *S*             33: GSTRD    BSR      GETXC             GET ANOTHER CHARACTER,
 *S*             34:          ;CMPA     #'"               ANOTHER DQUOTE?
 *S*             35:          CMPA     #'"
 *S*             36:          BEQ      GSTR1             B/ YES: GO SAVE IT.
 *S*             37:          STX      EXPTR             ELSE DELETE CH,
 *S*             38: GSTR3    STAB     STBUF             SAVE COUNT
 *S*             39:          LDAA     #O:STR            GET STRING TYPE
 *S*             40: GOTOBJ2  BRA      GOTOBJ1
 *S*             41: * ERROR IN STRING




ASM/6800 1.3H4: 1F91 ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 232; Form 39    - - - G T X D - - -
ASM14A.EVAL.ASM
 *S*             42: GSTRE    STX      EXPTR             POINT TO OFFENSIVE CHARACTER,
 *S*             43:          CLRB                       NULL STRING,
 *S*             44:          ;JSR      ILLSTR            *E* '" W/O MATCHING '"
 *S*             45:          JSR      ILLSTR
 *S*             46:          BRA      GSTR3             AND LEAVE.
                 47:          ELSE
1F93 20DC        48: GOTOBJ2  BRA      GOTOBJ1
                 49:          FIN




ASM/6800 1.3H4: 1F93 ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 233; Form 40    - - - G T X D - - -
ASM14A.EVAL.ASM
                  2: *39*
                  3: *INC EXPTR AND LOAD UP NEXT CHAR
                  4: *
  1F95            5: GETXC    EQU      *
                  6:          ;LDX      EXPTR             GET POINTER,
1F95 DE28         7:          LDX      EXPTR
1F97 A600         8:          LDAA     0,X               GET NEXT CH,
1F99 08           9:          INX
1F9A DF28        10:          STX      EXPTR             SAVE POINTER,
1F9C 09          11:          DEX
1F9D 39          12:          RTS                        AND LEAVE.
                 13: *
  1F9E           14: REJCH    EQU      *
  1F9E           15: REJXC    EQU      *
  1F9E           16: RJXCH    EQU      *
                 17:          ;LDX      EXPTR
1F9E DE28        18:          LDX      EXPTR
1FA0 09          19:          DEX
1FA1 DF28        20:          STX      EXPTR
1FA3 39          21:          RTS




ASM/6800 1.3H4: 1FA3 ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 234; Form 41    - - - G T X D - - -
ASM14A.EVAL.ASM
                  2: *41*
                  3: *
                  4: * SAW LEFT OR RIGHT PAREN
                  5: *
1FA4 8604         6: GETLP    LDAA     #O:LP             OBJECT IS LEFT PAREN
1FA6 20EB         7:          BRA      GOTOBJ2
1FA8 8605         8: GETRP    LDAA     #O:RP             OBJECT IS RIGHT PAREN.
1FAA 20E7         9:          BRA      GOTOBJ2           AND LEAVE.
                 10: *
                 11: *
                 12: * SAW A BLANK OR A TAB
                 13: *
1FAC 8DE7        14: GBLK     BSR      GETXC             WHATS THE NEXT CHARACTER?
                 15:          ;CMPA     #TAB              IS IT A TAB?
1FAE 8109        16:          CMPA     #TAB
1FB0 27FA        17:          BEQ      GBLK              B/ YES, EAT IT UP.
                 18:          ;CMPA     #BLANK            SAME FOR BLANK.
1FB2 8120        19:          CMPA     #BLANK
1FB4 27F6        20:          BEQ      GBLK
1FB6 DF28        21:          STX      EXPTR             ELSE REJECT CHARACTER.
1FB8 8620        22:          LDAA     #BLANK            AND RETURN STANDARD SEPARATOR.
1FBA 16          23: GTRM     TAB                        COPY TO CORRECT PLACE,
1FBB 8606        24:          LDAA     #O:TERM           GET TYPE,
1FBD 20D4        25:          BRA      GOTOBJ2




ASM/6800 1.3H4: 1FBF ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 235; Form 42    - - - G T X D - - -
ASM14A.EVAL.ASM
1FBF 860D         2: GEOL     LDAA     #$D               RETURN END OF LINE CH,
                  3:          ;JSR      REJCH             REJECT THIS CHARACTER,
1FC1 BD1F9E       4:          JSR      REJCH
1FC4 20F4         5:          BRA      GTRM              AND RETURN A TERMINATOR.
                  6: *41*
                  7: *
                  8: * GUNK --
                  9: *        GCHECKS WHETHER NEXT CH. IS AN OPERATOR;
                 10: *        IF SO RETURNS OP, TYPE; OTHERWISE RETURNS O:UNKN,
                 11: *        CH IN ACCB.
                 12: *
  1FC6           13: GUNK     ;CMPA     #$20              IS IT A CONTROL CH?
1FC6 8120        14:          CMPA     #$20
1FC8 2D0B        15:          BLT      GILGL             B/ YES: ILLEGAL.
                 16:          ;CMPA     #$5F              IS IT TOO BIG FOR TTY?
1FCA 815F        17:          CMPA     #$5F
1FCC 2E07        18:          BGT      GILGL             B/ YES: ILLEGAL.
                 19:          ;LDX      #GOPTB-2          MAYBE AN OPERATOR:
1FCE CE201A      20:          LDX      #GOPTB-2
1FD1 8D25        21:          BSR      FINDAX            GO CHECK.
1FD3 2805        22:          BVC      GOPTR             B/ GO EAT AN OPERATOR
1FD5 16          23: GILGL    TAB
1FD6 8608        24:          LDAA     #O:UNKN
1FD8 20B9        25:          BRA      GOTOBJ2




ASM/6800 1.3H4: 1FD8 ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 236; Form 43    - - - G T X D - - -
ASM14A.EVAL.ASM
                  2: *41*
                  3: *
                  4: * GOPTR--
                  5: *        CHARACTER IN A IS THE START OF AN OPERATOR.
                  6: *        EXTENSION VALUE IS IN B
                  7: *        X CONTAINS THE @ OF THE BYTE PAIR: MATCH, VALUE.
                  8: *        NOW WE NEED TO CHECK WHETHER THE OPERATOR IS A
                  9: *        TWO-CHARACTER OP.
                 10: *
1FDA 5D          11: GOPTR    TSTB                       TEST EXTENSION:
1FDB 2C05        12:          BGE      GOPTR2            B/ NEED TO GET ANOTHER CHARACTER.
1FDD 50          13:          NEGB                       MAKE REAL VALUE,
1FDE 8607        14: GOPTR1   LDAA     #O:OP             GET TYPE
1FE0 20B1        15:          BRA      GOTOBJ2           AND LEAVE.
                 16: *
1FE2 8DB1        17: GOPTR2   BSR      GETXC             GET NEXT CH,
1FE4 8D1B        18:          BSR      LDAXB             GET NEW POINTER IN X
1FE6 2033        19:          FDB      G2OTB             (SECOND TABLE)
1FE8 8D0E        20:          BSR      FINDAX            FIND IN TABLE
1FEA 6D00        21:          TST      0,X
1FEC 2CF0        22:          BGE      GOPTR1            SECOND CH WAS OP.
                 23:          ;JSR     REJXC             ELSE REJECT SECOND CH.
1FEE BD1F9E      24:          JSR      REJXC
1FF1 5D          25:          TSTB                       WAS FIRST CH IN FACT AN OP ?
1FF2 26EA        26:          BNE      GOPTR1            B/ YES:  HANDLE AS ONE.
1FF4 20DF        27:          BRA      GILGL             B/ NO:  IT'S AN UNKNOWN.




ASM/6800 1.3H4: 1FF4 ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 237; Form 44    - - - F I N D A X - - -
ASM14A.EVAL.ASM
                  2: *41*
                  3: *
                  4: * FINDAX
                  5: *        LOOPS THROUGH A TABLE, ASSUMED TO CONSIST OF 2-BYTE
                  6: *        ENTRIES, COMPARING ACCA TO FIRST BYTE.  IF MATCH, THEN,
                  7: *        LEAVES X POINTING TO GOOD ENTRY.  ELSE RETURNS WITH
                  8: *        CCV SET.  IN EITHER CASE, B IS LOADED WITH SECOND
                  9: *        BYTE OF ENTRY WHICH SENT US HOME, BE IT THE $80 OR
                 10: *        A MATCHED BYTE.
                 11: *
                 12: *        NOTE THAT THE TABLE MAY CONSIST ONLY OF A $80 ENTRY.
                 13: *        ALSO, TOP BIT OF (A) MUST BE ZERO, OR ALL BETS ARE OFF!
                 14: *
  1FF6           15: FINDAXL  ;LEAX    2,X
  0000           16:          IF       2<0
 *S*             17:          RPT      -2
 *S*             18:          DEX
                 19:          ELSE
  0002           20:          RPT      2
1FF6 08          21:          INX
                 22:          FIN
  1FF8           23: FINDAX   EQU      *
1FF8 E601        24:          LDAB     1,X               GET SECOND BYTE.
                 25:          ;CMPA     0,X               IS THIS ONE WE WANT?
1FFA A100        26:          CMPA     0,X
1FFC 2902        27:          BVS      FINDAXX           B/ NO: END HIT.
1FFE 26F6        28:          BNE      FINDAXL           B/ NO: MORE TO COME.
2000 39          29: FINDAXX  RTS                        ELSE RETURN.




ASM/6800 1.3H4: 2000 ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 238; Form 45    - - - L D A X B - - -
ASM14A.EVAL.ASM
                  2: *43*
                  3: *
                  4: * LDAXB --
                  5: *        LOADS X WITH SUM OF B REGISTER AND POINTER
                  6: *        FOLLOWING CALL.
                  7: *        ACCB IS CLOBBERED.
                  8: *
2001 30           9: LDAXB    TSX                        GET RETURN ADDRESS
                 10:          ;LDX      0,X               ......
2002 EE00        11:          LDX      0,X
2004 EB01        12:          ADDB     1,X               ADD LOW BYTE OF PTR TO B,
2006 37          13:          PSHB                       TXFER TO STACK.
2007 C600        14:          LDAB     #0                EXTEND ZEROS FOR B.
2009 E900        15:          ADCB     0,X               ADD HIGH BYTE OF PTR,
200B 37          16:          PSHB                       AND SAVE ON STACK.
200C 30          17:          TSX                        NOW, RECOMPUTE RETURN @
200D E603        18:          LDAB     3,X               GET RETURN(L)
200F CB02        19:          ADDB     #2
2011 E703        20:          STAB     3,X
2013 2402        21:          BCC      LDAXB$1
                 22:          ;INC     2,X
2015 6C02        23:          INC      2,X
  2017           24: LDAXB$1  ;LDX      0,X
2017 EE00        25:          LDX      0,X
                 26:          ;LEAS    2,S               Prune stack
  0000           27:          IF       2<0
 *S*             28:          RPT      -2
 *S*             29:          DES
                 30:          ELSE
  0002           31:          RPT      2
2019 31          32:          INS
                 33:          FIN
201B 39          34:          RTS




ASM/6800 1.3H4: 201B ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 239; Form 46    - - - O P E R A T O R   T A B L E S - - -
ASM14A.EVAL.ASM
                  2: *42,43*
                  3: *
                  4: *  OPERATOR TABLES.
                  5: *
201C 2BBF         6: GOPTB    FCB      '+,-OP:ADD&$FF
201E 2DBE         7:          FCB      '-,-OP:SUB&$FF
2020 26DC         8:          FCB      '&,-OP:AND&$FF
2022 2AAF         9:          FCB      '*,-OP:MUL
  0001           10:          IF       (SHIFT=1)
2024 2300        11:          FCB      '#,G2NE
  0001           12:          ELSEIF   CONDASM=1
 *S*             13:          FCB      '#,-OP:NE
                 14:          FIN
2026 2F04        15:          FCB      '/,G2DIV
2028 2108        16:          FCB      '!,G2OR
202A 5C0C        17:          FCB      '\,G2MOD
  0001           18:          IF       CONDASM=1
202C 3C10        19:          FCB      '<,G2LT
202E 3E16        20:          FCB      '>,G2GT
2030 3D1E        21:          FCB      '=,G2EQ
                 22:          FIN
2032 80          23:          FCB      $80               CAUSES OVERFLOW.




ASM/6800 1.3H4: 2032 ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 240; Form 47    - - - O P E R A T O R   T A B L E S - - -
ASM14A.EVAL.ASM
                  2: *
                  3: * EXTENSION TABLES FOR 2-CH OPS.
  2033            4: G2OTB    EQU      *
  0001            5:          IF       SHIFT=1
  0000            6: G2NE     EQU      *-G2OTB           DISPLACEMENT.
2033 2361         7:          FCB      '#,OP:SHF         SHIFT ##
2035 80           8:          FCB      $80
  0001            9:            IF     CONDASM=1
2036 36          10:            FCB    OP:NE
  0002           11:            ELSE   
 *S*             12:            FCB    0
                 13:            FIN
                 14:          FIN
                 15: *
  0004           16: G2DIV    EQU      *-G2OTB
2037 2F54        17:          FCB      '/,OP:CQU         //
2039 8052        18:          FCB      $80,OP:DIV
                 19: *
  0008           20: G2OR     EQU      *-G2OTB
203B 2122        21:          FCB      '!,OP:EOR         !!
203D 8021        22:          FCB      $80,OP:IOR
                 23: *
  000C           24: G2MOD    EQU      *-G2OTB
  0001           25:          IF       CONDASM=1
203F 3C3A        26:          FCB      '<,OP:LS
                 27:          FIN
2041 8053        28:          FCB      $80,OP:MOD
                 29: *
  0001           30:          DO       CONDASM=1
  0010           31: G2LT     EQU      *-G2OTB
2043 3C38        32:          FCB      '<,OP:LO          <<
2045 3D34        33:          FCB      '=,OP:LE          <=
2047 8032        34:          FCB      $80,OP:LT         <
                 35: *
  0016           36: G2GT     EQU      *-G2OTB
2049 3E37        37:          FCB      '>,OP:HI          >>
204B 2F39        38:          FCB      '/,OP:HS          >/
204D 3D33        39:          FCB      '=,OP:GE          >=
204F 8031        40:          FCB      $80,OP:GT         >
                 41: *




ASM/6800 1.3H4: 204F ASM/6800 1.4       - - - G E T    N E X T    O B J E C T - - -
08/16/82 00:00:00; Page 241; Form 47    - - - O P E R A T O R   T A B L E S - - -
ASM14A.EVAL.ASM
  001E           42: G2EQ     EQU      *-G2OTB
2051 3C34        43:          FCB      '<,OP:LE          =<
2053 3E33        44:          FCB      '>,OP:GE          =>
2055 8035        45:          FCB      $80,OP:EQ         =
                 46:          FIN




ASM/6800 1.3H4: 2055 ASM/6800 1.4       - - - S Y M B O L    M A N I P U L A T I O N S - - -
08/16/82 00:00:00; Page 242; Form 48    - - - C H C F S Y M - - -
ASM14A.EVAL.ASM
                  3: *38*
                  4: *
                  5: * CHCFSYM --
                  6: *        CHECKS WHETHER CF(1) IS A SYMBOL;
                  7: *
                  8: * INPUT:
                  9: *        CFPTR    POINTS TO CF
                 10: *
                 11: * OUTPUT:
                 12: *        SYM      CONTAINS SYMBOL IF ONE WAS FOUND.
                 13: *
                 14: * SCRATCH:
                 15: *        EXPTR, RJA, RJB, ETC. FOR GNOBJ
                 16: *
                 17: * INTERFACE:
                 18: *        GNOBJ:   CALLED TO GET OBJECTS.
                 19: *
  2057           20: CHCFSYM  ;LDX      CFPTR             GET POINTER,
2057 DE24        21:          LDX      CFPTR
                 22:          ;JSR      GNOBX             GET FIRST OBJECT.
2059 BD1E38      23:          JSR      GNOBX
                 24:          ;CMPA     #O:SYM            IS IT A SYMBOL?
205C 8101        25:          CMPA     #O:SYM
205E 2605        26:          BNE      CHCFRTS           B/ NO.  RETURN.
                 27:          ;JSR      GNOBJ             GET TERMINATOR
2060 BD1E2C      28:          JSR      GNOBJ
                 29:          ;CMPA     #O:TERM           IS IT A REAL TERMINATOR?
2063 8106        30:          CMPA     #O:TERM
2065 39          31: CHCFRTS  RTS                        AND RETURN.




ASM/6800 1.3H4: 2065 ASM/6800 1.4       - - - S Y M B O L    M A N I P U L A T I O N S - - -
08/16/82 00:00:00; Page 243; Form 49    - - - C H S Y M D - - -
ASM14A.EVAL.ASM
                  2: *
                  3: *
                  4: *  C H S Y M D
                  5: *
                  6: *        Checks whether SYM is a directive.  If so, sets
                  7: *        SYMPT pointing to the directive table entry, sets CCz=1
                  8: *        and returns.
                  9: *
                 10: *        If symbol is not a directive, CCZ=0.
                 11: *
                 12: *        To find the directive:  first the user's directive
                 13: *        chain is searched; if the directive is in the user's
                 14: *        chain, & it is undefined, (i.e. T:FREF is set in the
                 15: *        type byte) then we say, "There is no such directive"
                 16: *        (at least, none defined by the user) and search the
                 17: *        assembler's chain.  If T:FREF is clear, then he has
                 18: *        redefined the directive, so we go to him.
                 19: *        Otherwise we search the assembler's chain; if found
                 20: *        o.k., if not, that's o.k. too.
                 21: *
                 22: *
  2066           23: CHSYMD   EQU      *
  2066           24: CHSYMD1  ;LDX      #D0               ELSE GET HEAD OF SYSTEM CHAIN
2066 CE0EAA      25:          LDX      #D0
                 26:          ;JMP      FSYM1
2069 7E20C9      27:          JMP      FSYM1
                 28: *




ASM/6800 1.3H4: 2069 ASM/6800 1.4       - - - S Y M B O L    M A N I P U L A T I O N S - - -
08/16/82 00:00:00; Page 244; Form 50    - - - C H S Y M D - - -
ASM14A.EVAL.ASM
                  2: *44*
                  3: *
                  4: * FINDAF --
                  5: *        SCANS FROM AFPTR TO END OF FIELD, THEN FINDS FIRST
                  6: *        THING AFTER TERMINATOR; SETS AFPTR TO POINT TO IT.
                  7: *
                  8: * ONLY ALLOWS ONE SYMBOL FOLLOWED BY A TERMINATOR. SYNTAX ERR IF NOT.
                  9: *
                 10: *
  206C           11: FINDAF   ;LDX      AFPTR
206C DE26        12:          LDX      AFPTR
                 13:          ;JSR      GNOBX             GET FIRST OBJECT,
206E BD1E38      14:          JSR      GNOBX
2071 2006        15:          BRA      FINDAF1           AND GO TEST IT
                 16: *
  2073           17: FINDAFE  ;JSR     SYNTAX            ERROR BUT KEEP SCANNING
2073 BD0867      18:          JSR      SYNTAX
  2076           19: FINDAFL  ;JSR      GNOBJ             WHAT'S NEXT.
2076 BD1E2C      20:          JSR      GNOBJ
  2079           21: FINDAF1  ;CMPA    #O:SYM            A SYM?
2079 8101        22:          CMPA     #O:SYM
207B 27F9        23:          BEQ      FINDAFL           IF FOUND SYM - NOW LOOK FOR TERM
                 24:          ;CMPA    #O:TERM           A TERM?
207D 8106        25:          CMPA     #O:TERM
207F 26F2        26:          BNE      FINDAFE           IF NOT, ERROR BUT KEEP SCANNING TO A TERM
                 27:          ;CMPB     #ASCII:COMMA     JUST END OF THIS SUBFIELD?
2081 C12C        28:          CMPB     #ASCII:COMMA
2083 27EE        29:          BEQ      FINDAFE           B/ YES:  KEEP GOING.
2085 DF26        30:          STX      AFPTR             ELSE: SAVE POINTER,
2087 39          31:          RTS                        AND SPLIT.




ASM/6800 1.3H4: 2087 ASM/6800 1.4       - - - S Y M B O L    M A N I P U L A T I O N S - - -
08/16/82 00:00:00; Page 245; Form 51    - - - C H S Y M D - - -
ASM14A.EVAL.ASM
                  2: *49*
                  3: *
                  4: *  HASH--
                  5: *        Computes hash pointer for a symbol in SYM.  The hashing
                  6: *        algorithm used is Out-of-table Chaining; the hash code
                  7: *        is generated by accumulating a weird sum.
                  8: *        HASH:M is a mask which determines the size of the hash
                  9: *        table; note that the first pointer returned is a pointer
                 10: *        to the appropriate hash bucket.
                 11: *        (The above means that S:NEXT must be the first entry in
                 12: *         a symbol).
                 13: *
                 14: ******
                 15: *
                 16: * HASH:PTR WORKS LIKE HASH EXCEPT THAT THE SYMBOL IS NOT IN SYM
                 17: * BUT RATHER IT IS POINTED TO BY THE X REG.
                 18: *      X=START OF SYM BLOCK
                 19: *
  2088           20: HASH     EQU      *
                 21:          ;LDX     #SYM:BLK          LOAD POINTER TO DUMMY SYM BLOCK.
2088 CE005D      22:          LDX      #SYM:BLK
                 23: 
  208B           24: HASH:PTR EQU      *
208B E605        25:          LDAB     S:LEN,X           LOAD LENGTH FOR HASH
208D 4F          26:          CLRA                       CLEAR ACCUMULATED SUM
208E 49          27: HASHL    ROLA                       LEFT-SHIFT SUM,
208F A906        28:          ADCA     S:TEXT,X          ADD THE CARRY IN W/ THE NEXT CH.
2091 08          29:          INX                        POINT TO NEXT
2092 5A          30:          DECB                       ANY LEFT TO SUM?
2093 26F9        31:          BNE      HASHL             B/ YES:  GO.
2095 847F        32:          ANDA     #HASH:M           GET RID OF TRASH BITS;
2097 48          33:          ASLA                       MAKE IT A WORD INDEX
2098 8B8D        34:          ADDA     #HSHTBL&$FF       MAKE LOW BYTE OF ADDRESS,
209A 36          35:          PSHA                       SAVE,
209B 8630        36:          LDAA     #HSHTBL/256       MAKE HIGH BYTE OF ADDRESS,
209D 8900        37:          ADCA     #0
209F 36          38:          PSHA
                 39:          ;PULX                      Get pointer to hash bucket
20A0 30          40:          TSX
20A1 EE00        41:          LDX      0,X




ASM/6800 1.3H4: 20A3 ASM/6800 1.4       - - - S Y M B O L    M A N I P U L A T I O N S - - -
08/16/82 00:00:00; Page 246; Form 51    - - - C H S Y M D - - -
ASM14A.EVAL.ASM
20A3 31          42:          INS
20A4 31          43:          INS
20A5 39          44:          RTS                         and leave




ASM/6800 1.3H4: 20A5 ASM/6800 1.4       - - - S Y M B O L    M A N I P U L A T I O N S - - -
08/16/82 00:00:00; Page 247; Form 52    - - - C H S Y M D - - -
ASM14A.EVAL.ASM
                  2: *50*
                  3: *
                  4: * GTBLK:
                  5: *
                  6: *        GET A BLOCK FROM THE SYMBOL TABLE.
                  7: *        ACCB HOLDS # OF BYTES WANTED;
                  8: *        ON EXIT, A BNE WILL SUCCEED IFF. THE BLOCK WAS OBTAINED.
                  9: *        OTHERWISE, ERROR SYMOV (SYMBOL TABLE OVERFLOW) HAS NOT
                 10: *        BEEN REPORTED AND X IS CLEARED.
                 11: *           IF THE BLOCK WAS OBTAINED, (X) IS THE ADDRESS; THE
                 12: *        ADDRESS IS ALSO SAVED IN STPTR.
                 13: *
  20A6           14: GTBLK    EQU      *
20A6 96AD        15:          LDAA     STPTR+1           CALCULATE NEW POINTER.
20A8 10          16:          SBA                        NEED (B) BYTES.
20A9 D6AC        17:          LDAB     STPTR             GET HIGH BYTE OF POINTER,
20AB C200        18:          SBCB     #0                WITH CARRY
20AD 36          19:          PSHA                       SAVE LOW BYTE,
20AE 37          20:          PSHB                       AND HIGH BYTE.
20AF 90BD        21:          SUBA     STLOW+1           COMPARE TO POINTER TO LAST AVAILABLE
20B1 D2BC        22:          SBCB     STLOW             ...BYTE:
20B3 2206        23:          BHI      GTBLK1            B/ THERE IS ROOM.
                 24:          ;LEAS    2,S               POP POINTER,
  0000           25:          IF       2<0
 *S*             26:          RPT      -2
 *S*             27:          DES
                 28:          ELSE
  0002           29:          RPT      2
20B5 31          30:          INS
                 31:          FIN
                 32:          ;LDX      #0                SIGNAL: NO BLOCK
20B7 CE0000      33:          LDX      #0
20BA 39          34:          RTS                        AND SPLIT.
                 35: *
  20BB           36: GTBLK1   ;PULX                      Get pointer to block
20BB 30          37:          TSX
20BC EE00        38:          LDX      0,X
20BE 31          39:          INS
20BF 31          40:          INS
20C0 DFAC        41:          STX      STPTR             SAVE POINTER,




ASM/6800 1.3H4: 20C2 ASM/6800 1.4       - - - S Y M B O L    M A N I P U L A T I O N S - - -
08/16/82 00:00:00; Page 248; Form 52    - - - C H S Y M D - - -
ASM14A.EVAL.ASM
20C2 39          42:          RTS                        AND SPLIT.




ASM/6800 1.3H4: 20C2 ASM/6800 1.4       - - - S Y M B O L    M A N I P U L A T I O N S - - -
08/16/82 00:00:00; Page 249; Form 53    - - - C H S Y M D - - -
ASM14A.EVAL.ASM
                  2: *48*
                  3: *
                  4: * FSYM
                  5: *        FINDS SYMBOL WHICH IS IN SYM IN THE SYMBOL TABLE AS
                  6: *        A USER SYMBOL.  A HASHING ALGORITHM IS USED;  SEE
                  7: *        HASH (BELOW).  If entered through FINDSYM1, then X
                  8: *        is assumed to contain first link of the chain.  If the
                  9: *        symbol is found, then CCZ = 0, and SYMPT points to first
                 10: *        byte of entry.  Otherwise CCZ = 1, and SYMPT points to
                 11: *        the last entry in the chain.  Entries in the table are
                 12: *        assumed to be of the following form:
                 13: *
                 14: *        S:NEXT   ==> Pointer to next entry in chain, or zero if last.
                 15: *        S:NEXT+1
                 16: *        S:VAL    ==> Value of symbol.
                 17: *        S:VAL+1
                 18: *        S:TYPE   ==>  Type of symbol.
                 19: *        S:LEN    ==>  # of characters in text.
                 20: *        S:TEXT   ==>  Zero or more text characters.
                 21: *
  20C3           22: FSYM     EQU      *
20C3 8DC3        23:          BSR      HASH              GET HASH CODE FOR SYM
20C5 2002        24:          BRA      FSYM1
                 25: 
  20C7           26: FSYME    ;LDX      SYMPT             NEW ITERATION:  GET POINTER,
20C7 DE38        27:          LDX      SYMPT
                 28: *
  20C9           29: FSYM1    EQU      *                 COME HERE W/ YOUR OWN POINTER.
  0001           30:          DO       M6809=0
20C9 9662        31:          LDAA     SYM               Length of target symbol
  0001           32:          ELSE
 *S*             33:          ;LDD     SYM               GET LENGTH OF TARGET SYMBOL
 *S*             34:          LDAB     SYM+1
 *S*             35:          LDAA     SYM
                 36:          FIN
20CB DF38        37: FSYM2    STX      SYMPT             SAVE POINTER
                 38:          ;LDX      S:NEXT,X          GET POINTER TO NEXT.
20CD EE00        39:          LDX      S:NEXT,X
20CF 2724        40:          BEQ      FSYMX             B/ HIT END OF CHAIN.
                 41: *




ASM/6800 1.3H4: 20CF ASM/6800 1.4       - - - S Y M B O L    M A N I P U L A T I O N S - - -
08/16/82 00:00:00; Page 250; Form 53    - - - C H S Y M D - - -
ASM14A.EVAL.ASM
  0001           42:          DO       M6809=0
                 43:          ;CMPA     S:LEN,X           CHECK LENGTH OF THIS SYM...
20D1 A105        44:          CMPA     S:LEN,X
  0001           45:          ELSE
 *S*             46:          ;CMPD    S:LEN,X           Check length and first byte
 *S*             47:          CMPA     S:LEN,X
 *S*             48:          BNE      MACRO:0001
 *S*             49:          CMPB     (S:LEN)+1,X
 *S*             50: MACRO:0001
                 51:          FIN
20D3 26F6        52:          BNE      FSYM2             B/ CAN'T MATCH:  TRY NEXT.
                 53: *
                 54: * FOUND POSSIBLE MATCH:  DO COMPARISON.
                 55: *
20D5 DF38        56:          STX      SYMPT             SAVE POINTER TO ME...
20D7 DF34        57:          STX      TPTR              SAVE TEMP POINTER FOR COMPARISON.
  0001           58:          DO       M6809=0
                 59:          ;LDX      #SYM+1            GET POINTER TO SYM FOR COMPARE.
20D9 CE0063      60:          LDX      #SYM+1
20DC 2002        61:          BRA      FSYM4             AND ENTER LOOP.
  0001           62:          ELSE
 *S*             63:          LEAY     S:TEXT,X          A(1st char of symbol)
 *S*             64:          ;LDX     #SYM+1
 *S*             65:          LDX      #SYM+1
                 66:          FIN
                 67: 
  0001           68:          DO       M6809=0
  20DE           69: FSYM3    ;LDX      TPTR1             GET POINTER TO NEXT CH IN SYM.
20DE DE36        70:          LDX      TPTR1
20E0 E600        71: FSYM4    LDAB     0,X               GET NEXT CH FROM TARGET SYM.
20E2 08          72:          INX                        POINT TO NEXT
20E3 DF36        73:          STX      TPTR1             AND SAVE.
                 74:          ;LDX      TPTR              GET POINTER TO NEXT IN TABLE,
20E5 DE34        75:          LDX      TPTR
                 76:          ;CMPB     S:TEXT,X          IS THIS ONE EQUAL, TOO?
20E7 E106        77:          CMPB     S:TEXT,X
20E9 26DC        78:          BNE      FSYME             B/ NO:  DO NEXT.
20EB 08          79:          INX
20EC DF34        80:          STX      TPTR              POINT TO NEXT,
20EE 4A          81:          DECA                       ALL DONE?




ASM/6800 1.3H4: 20EF ASM/6800 1.4       - - - S Y M B O L    M A N I P U L A T I O N S - - -
08/16/82 00:00:00; Page 251; Form 53    - - - C H S Y M D - - -
ASM14A.EVAL.ASM
20EF 26ED        82:          BNE      FSYM3             B/ NO.
  0001           83:          ELSE
 *S*             84: FSYM3    LDAB     ,X+               Char from SYM
 *S*             85:          ;CMPB    ,Y+                compare with char in table
 *S*             86:          CMPB     
 *S*             87:          BNE      FSYME             B/ No match
 *S*             88:          DECA                       ALL DONE?
 *S*             89:          BNE      FSYM3             B/ NO.
                 90:          FIN
                 91: * FOUND SYM:  SYMPT IS CORRECT.
                 92:          ;LDX      SYMPT             RETURN A POINTER
20F1 DE38        93:          LDX      SYMPT
20F3 4F          94:          CLRA                       SET CCZ
20F4 39          95:          RTS                        SO LEAVE;  Z IS SET.
                 96: *
                 97: * HIT END OF CHAIN:  SYMPT POINTS TO PREVIOUS BLOCK.
                 98: *
  20F5           99: FSYMX    ;LDX      SYMPT             GET POINTER, SETTING CCZ
20F5 DE38       100:          LDX      SYMPT
20F7 39         101:          RTS                        AND EXIT.




ASM/6800 1.3H4: 20F7 ASM/6800 1.4       - - - S Y M B O L    M A N I P U L A T I O N S - - -
08/16/82 00:00:00; Page 252; Form 54    - - - E N T S Y M - - -
ASM14A.EVAL.ASM
                  2: *50.1*
                  3: *
                  4: *  ENTSYM:
                  5: *        ENTER A SYMBOL (FROM SYM) INTO TABLE.
                  6: *
                  7: * CALL:
                  8: *        JSR      ENTSYM
                  9: *
                 10: * INPUT:
                 11: *        SYM      CONTAINS SYMBOL
                 12: *        TYPE     CONTAINS TYPE FOR SYMBOL
                 13: *        VAL      CONTAINS VALUE FOR SYMBOL
                 14: *
                 15: *        STPTR    CONTAINS @ OF LOW END OF TABLE.
                 16: *
                 17: * OUTPUT:
                 18: *        SYMPT    CONTAINS ADDRESS OF SYMBOL BLOCK IN TABLE
                 19: *
                 20: * NOTE THAT VAL, TYPE AND SYM MUST BE ARRANGED TO LOOK LIKE A
                 21: * SYMBOL ENTRY.
                 22: *
  20F8           23: ENTSYM   EQU      *
20F8 D662        24:          LDAB     SYM               GET # OF BYTES IN SYMBOL,
20FA CB06        25:          ADDB     #SENT:L           ADD ON OVERHEAD,
20FC 37          26:          PSHB                       AND SAVE FOR LATER.
                 27:          ;JSR      GTBLK             GO GET A BLOCK
20FD BD20A6      28:          JSR      GTBLK
2100 261D        29:          BNE      ENTSYM1           B/ NOT OUT OF ROOM.
                 30:          ;JSR     SYMOV                  OUT OF ROOM: REPORT TO ERROR HANDLER
2102 BD0893      31:          JSR      SYMOV
                 32:          ;LDX     NULLSYM+1         INITIALIZE THE DUMMY SYMBOL
2105 FE211B      33:          LDX      NULLSYM+1
2108 FF2F36      34:          STX      NULLTMP+1
                 35:          ;LDX     NULLSYM+2+1
210B FE211D      36:          LDX      NULLSYM+2+1
210E FF2F38      37:          STX      NULLTMP+2+1
                 38:          ;LDX     #NULLTMP-2        LOAD PTR TO DUMMY ENTRY
2111 CE2F33      39:          LDX      #NULLTMP-2
                 40:          ;CLR     NULLTMP
2114 7F2F35      41:          CLR      NULLTMP




ASM/6800 1.3H4: 2117 ASM/6800 1.4       - - - S Y M B O L    M A N I P U L A T I O N S - - -
08/16/82 00:00:00; Page 253; Form 54    - - - E N T S Y M - - -
ASM14A.EVAL.ASM
2117 31          42:          INS                        POP SIZE,
2118 202C        43:          BRA      ENTSYM2           AND LEAVE.
                 44: *
  211A           45: NULLSYM  EQU      *
211A 0000        46:          FDB      0                 VALUE
211C 04          47:          FCB      T:UNDF            TYPE=UNDEF
211D 013F        48:          FCB      1,'?              SYMBOL NAME
                 49: *
                 50: * FOUND ROOM TO PUT THE SYMBOL IN:
                 51: *
  211F           52: ENTSYM1  EQU      *                 (REMEMBER: X HOLDS POINTER TO BLOCK)
211F DF34        53:          STX      TPTR              SAVE FOR LATER;
2121 33          54:          PULB                       GET LENGTH BACK,
                 55:          ;LDX      #SYM:BLK          GET POINTER TO FIRST BYTE TO COPY,
2122 CE005D      56:          LDX      #SYM:BLK
  2125           57: ENTSYML  EQU      *
2125 DF36        58:          STX      TPTR1             AND SAVE IT.
2127 A600        59:          LDAA     0,X               GET NEXT BYTE OF ENTRY,
                 60:          ;LDX      TPTR              GET POINTER INTO TABLE,
2129 DE34        61:          LDX      TPTR
212B A700        62:          STAA     0,X
212D 08          63:          INX
212E DF34        64:          STX      TPTR              AND SAVE (TPTR)+
                 65:          ;LDX      TPTR1             GET NEW POINTER,
2130 DE36        66:          LDX      TPTR1
2132 08          67:          INX                        POINT TO NEXT,
2133 5A          68:          DECB
2134 26EF        69:          BNE      ENTSYML           B/ GO COPY ANOTHER.
                 70:          ;LDX      SYMPT             LINK THIS SYMBOL INTO CHAIN:
2136 DE38        71:          LDX      SYMPT
2138 96AC        72:          LDAA     STPTR             GET NEW ADDRESS,
213A A700        73:          STAA     S:NEXT,X          POKE IT IN.
213C 96AD        74:          LDAA     STPTR+1
213E A701        75:          STAA     S:NEXT+1,X        DITTO FOR LOW BYTE.
                 76:          ;LDX      STPTR             NOW, POINT TO NEW SYM,
2140 DEAC        77:          LDX      STPTR
                 78:          ;CLR      S:NEXT,X          AND MAKE IT THE LAST.
2142 6F00        79:          CLR      S:NEXT,X
                 80:          ;CLR      S:NEXT+1,X
2144 6F01        81:          CLR      S:NEXT+1,X




ASM/6800 1.3H4: 2144 ASM/6800 1.4       - - - S Y M B O L    M A N I P U L A T I O N S - - -
08/16/82 00:00:00; Page 254; Form 54    - - - E N T S Y M - - -
ASM14A.EVAL.ASM
                 82: *
2146 DF38        83: ENTSYM2  STX      SYMPT             SAVE POINTER TO THIS SYM,
2148 39          84:          RTS                        AND EXIT.




ASM/6800 1.3H4: 2148 ASM/6800 1.4       - - - S Y M B O L    M A N I P U L A T I O N S - - -
08/16/82 00:00:00; Page 255; Form 55    - - - S Y M L K - - -
ASM14A.EVAL.ASM
                  2: *51*
                  3: *
                  4: * NAME:  SYMLK
                  5: *        LOOK UP SYM IN SYMBOL TABLE, ENTER IT IF IT ISN'T THERE.
                  6: *
                  7: * INPUT:
                  8: *        SYM,     CONTAINS SYMBOL TO LOOK FOR.
                  9: *
                 10: * OUTPUT:
                 11: *        TYPE,    CONTAINS TYPE OF SYMBOL.
                 12: *        VAL,     CONTAINS VALUE OF SYMBOL.
                 13: *        SYMPT,   POINTS TO SYMBOL IN TABLE.
                 14: *        XTYPE,   MODIFIED TO ACCOUNT FOR SYMBOL'S TYPE.
                 15: *
                 16: * ERRORS:
                 17: *        IF SYMBOL IS UNDEFINED, THEN *UNDEF* IS FLAGGED.
                 18: *        IF SYMBOL IS A DOUBLE-DEF, THEN *DDEF-USE* IS FLAGGED.
                 19: *
  2149           20: SYMLK    ;JSR      FSYM              LOOK FOR THE SYMBOL IN THE TABLE.
2149 BD20C3      21:          JSR      FSYM
214C 270B        22:          BEQ      SYMLK1            B/ FOUND IT:  CHECK TYPES.
                 23: *
                 24: * NEED TO ENTER SYM IN TABLE:
                 25: *
214E 8604        26:          LDAA     #T:UNDF           IT'S UNDEFINED,
2150 9761        27:          STAA     TYPE
                 28:          ;LDX      #0                W/ NO VALUE.
2152 CE0000      29:          LDX      #0
2155 DF5F        30:          STX      VAL
2157 8D9F        31:          BSR      ENTSYM            ENTER IT.  SYMPT WILL BE GOOD.
                 32: *
                 33: * (X) NOW POINTS TO SYMBOL ENTRY.
                 34: *
  2159           35: SYMLK1   EQU      *
2159 A604        36:          LDAA     S:TYPE,X
215B 9761        37:          STAA     TYPE              COPY THE TYPE TO APPROPRIATE PLACE.
215D 8A08        38:          ORAA     #T:USED           IT HAS BEEN USED;
215F A704        39:          STAA     S:TYPE,X          REMEMBER THAT.
                 40:          ;LDX      S:VAL,X           ALONG W/ THE VALUE.
2161 EE02        41:          LDX      S:VAL,X




ASM/6800 1.3H4: 2163 ASM/6800 1.4       - - - S Y M B O L    M A N I P U L A T I O N S - - -
08/16/82 00:00:00; Page 256; Form 55    - - - S Y M L K - - -
ASM14A.EVAL.ASM
2163 DF5F        42:          STX      VAL
2165 8504        43:          BITA     #T:UNDF           IS IT UNDEFINED?
2167 2703        44:          BEQ      SYMLK2A           B/ NO.
                 45:          ;JSR      UNDEF             ELSE FLAG UNDEFINED SYMBOL.
2169 BD086F      46:          JSR      UNDEF
216C 8510        47: SYMLK2A  BITA     #T:DDEF           IS IT A DBL-DEF?
216E 2703        48:          BEQ      SYMLK3            B/ NO.
                 49:          ;JSR      UDDEF             *E* USE OF DBL-DEF.
2170 BD0877      50:          JSR      UDDEF
  2173           51: SYMLK3   EQU      *
2173 39          52:          RTS                        >>>ALL DONE, GO HOME.<<<




ASM/6800 1.3H4: 2173 ASM/6800 1.4       - - - S Y M B O L    M A N I P U L A T I O N S - - -
08/16/82 00:00:00; Page 257; Form 56    - - - S Y M D E F - - -
ASM14A.EVAL.ASM
                  2: *51*
                  3: *
                  4: * NAME:  SYMDEF
                  5: *        DEFINES A SYMBOL; CHECKS FOR DOUBLE DEFS, ETC.
                  6: *
                  7: * ENTRY:  SYMEQU
                  8: *        EQUATES SYM TO VAL, TYPE
                  9: *
                 10: * ENTRY:  SYMSET
                 11: *        SETS SYM TO VAL, TYPE:  CAN BE RESET.
                 12: *
                 13: * INPUT:
                 14: *        (A)      TYPE BIT: EITHER T:SET OR ZERO.
                 15: *        SYM      SYMBOL TO BE DEFINED.
                 16: *        VAL      VALUE TO BE GIVEN TO SYMBOL.
                 17: *        TYPE     TYPE TO BE GIVEN TO SYMBOL.
                 18: *
                 19: * ERRORS:
                 20: *        IF SYMBOL WAS PREVIOUSLY EQU'ED, OR IF SYMBOL WAS
                 21: *        SET AND NOW IS BEING EQU'ED, THEN
                 22: *        *DDEF* IS FLAGGED.
                 23: *
                 24: *
  2174           25: ENTIT    ;JMP     ENTSYM            HOP,HOP,HOP,HOP
2174 7E20F8      26:          JMP      ENTSYM
                 27: *
2177 8602        28: SYMSET   LDAA     #T:SET            GET TYPE BITS
2179 2001        29:          BRA      SYMEQU1
                 30: 
217B 4F          31: SYMEQU   CLRA                       IT'S AN EQUATE.
217C 9A61        32: SYMEQU1  ORAA     TYPE              SAVE TYPE BITS.
217E 9761        33:          STAA     TYPE
                 34: *
  2180           35: SYMDEF   EQU      *
                 36:          ;JSR      FSYM              IS SYMBOL DEFINED?
2180 BD20C3      37:          JSR      FSYM
2183 2709        38:          BEQ      OLDSYM            IF SO, GO ON
2185 9654        39:          LDAA     PASS              CK/ SYMBOL DEF ATTEMPTED DURING PASS 2?
2187 27EB        40:          BEQ      ENTIT               B/ NO, THIS IS PASS 1.  ENTER IT.
                 41:          ;JSR     PHASERR           YES: REPORT **PHASE ERROR**,




ASM/6800 1.3H4: 2189 ASM/6800 1.4       - - - S Y M B O L    M A N I P U L A T I O N S - - -
08/16/82 00:00:00; Page 258; Form 56    - - - S Y M D E F - - -
ASM14A.EVAL.ASM
2189 BD089B      42:          JSR      PHASERR
218C 20E6        43:          BRA      ENTIT               BUT ENTER IT ANYWAY.
                 44: *
  218E           45: OLDSYM   EQU      *
                 46: *
                 47: * CHECK WHETHER IT IS LEGAL TO REDEFINE THE SYMBOL.
                 48: *
218E A604        49:          LDAA     S:TYPE,X          GET THE TYPE BITS.
2190 8507        50:          BITA     #T:UNDF!T:FREF!T:SET  IS IT LEGAL TO REDEFINE?
2192 273C        51:          BEQ      SYMDEF2           B/ NO:  ERROR.
2194 8510        52:          BITA     #T:DDEF           CK/ WAS DDEF DETECTED IN PASS 2?
2196 2706        53:          BEQ      SYMDEF0             B/ NO.  NO ERROR.
2198 8D3E        54:          BSR      SYMDDEF           **DOUBLE DEF** BUT SET VALUE HERE ANYWAY.
                 55: *
                 56: * MAYBE IT'S LEGAL TO REDEFINE THIS.
                 57: *
                 58:          ;LDX     SYMPT             IT IS A GOOD IDEA TO HAVE A REASONABLE PTR HERE;
219A DE38        59:          LDX      SYMPT
219C A604        60:          LDAA     S:TYPE,X          A GOOD TYPE IS HELPFUL TOO.
219E 8502        61: SYMDEF0  BITA     #T:SET            CK/ WAS SYMBOL PREVIOUSLY SET?
21A0 2628        62:          BNE      SYMDEF3             B/ YES: MAKE SURE THIS IS A SET OPERATION.
                 63: *
                 64: * FORWARD REF RESOLUTION:
                 65: *   (I DON'T LIKE THIS CODE VERY MUCH, BUT AH, WELL...)
                 66: *
21A2 8504        67:          BITA     #T:UNDF           CK/ IS SYMBOL TRULY UNDEFINED?
21A4 2611        68:          BNE      SYMDEF1             B/ YES.  ALWAYS GIVE NEW VALUE.
21A6 D661        69:          LDAB     TYPE              GET TYPE OF OPERATION (INPUT AS ARGUMENT).
21A8 C502        70:          BITB     #T:SET              CK/ ARE WE DOING A SET?
21AA 2624        71:          BNE      SYMDEF2             B/ YUP.  NOT KOSHER TO SET A PREV. EQU'D SYM.  
                 72: *
                 73: * IT'S AN FREF
                 74: *
                 75:          ;LDX     SYMPT             ELSE CHECK FOR PHASE ERROR
21AC DE38        76:          LDX      SYMPT
                 77:          ;LDX     S:VAL,X             IS VALUE SUPPLIED SAME AS OLD
21AE EE02        78:          LDX      S:VAL,X
21B0 9C5F        79:          CPX      VAL                 VALUE OF SYMBOL?
21B2 2703        80:          BEQ      SYMDEF1           B/ YES:  NO PHASE ERROR HAS OCCURED.
                 81:          ;JSR     PHASERR           ELSE REPORT PHASE ERROR AND SET VAL ANYWAY.




ASM/6800 1.3H4: 21B4 ASM/6800 1.4       - - - S Y M B O L    M A N I P U L A T I O N S - - -
08/16/82 00:00:00; Page 259; Form 56    - - - S Y M D E F - - -
ASM14A.EVAL.ASM
21B4 BD089B      82:          JSR      PHASERR
  21B7           83: SYMDEF1  ;LDX      SYMPT             MAKE SURE WE HAVE THE RIGHT POINTER
21B7 DE38        84:          LDX      SYMPT
21B9 A604        85:          LDAA     S:TYPE,X          GET SYMBOL TYPE,
21BB 8418        86:          ANDA     #T:USED!T:DDEF     THESE ATTRIBUTES ARE PRESERVED
21BD 9A61        87:          ORAA     TYPE              ACROSS REDEFINITION.
21BF A704        88:          STAA     S:TYPE,X
21C1 965F        89:          LDAA     VAL
21C3 A702        90:          STAA     S:VAL,X
21C5 9660        91:          LDAA     VAL+1
21C7 A703        92:          STAA     S:VAL+1,X
21C9 39          93:          RTS
                 94: *
                 95: * THIS SYMBOL WAS OPERATED ON BY A SET BEFORE:  IS THIS A
                 96: * SET OPERATION?
                 97: *
21CA 9661        98: SYMDEF3  LDAA     TYPE
21CC 8502        99:          BITA     #T:SET
21CE 26E7       100:          BNE      SYMDEF1           B/ YES:  GO DO IT.
                101: *
                102: * ATTEMPT ILLEGALLY TO REDEFINE A SYMBOL.
                103: *
21D0 A604       104: SYMDEF2  LDAA     S:TYPE,X
21D2 84FE       105:          ANDA     #\T:FREF          FORWARD NO MORE! (OR SLAPSTICK?)
21D4 8A10       106:          ORAA     #T:DDEF           REMEMBER DOUBLE DEFINITION.
21D6 A704       107:          STAA     S:TYPE,X          AND SAVE.
  21D8          108: SYMDDEF  ;JMP     DDEF              *E* DOUBLE DEF!
21D8 7E0873     109:          JMP      DDEF




ASM/6800 1.3H4: 21D8 ASM/6800 1.4       - - - S Y M B O L    M A N I P U L A T I O N S - - -
08/16/82 00:00:00; Page 260; Form 57    - - L F E Q U - - -
ASM14A.EVAL.ASM
                  2: *52*
                  3: *
                  4: * NAME:  LFEQU
                  5: *        EQUATES ALL OF LF TO VALUE, XTYPE
                  6: *
                  7: * ENTRY:  LFSET
                  8: *        SETS ALL OF LF TO VAL
                  9: *
                 10: * ENTRY:  LFPC
                 11: *        EQUATES ALL OF LF TO PC
                 12: *
  21DB           13: LFPC     EQU      *
                 14:          ;LDX      PC
21DB DE96        15:          LDX      PC
21DD DF5F        16:          STX      VAL               QUICK KLUDGE...
21DF 4F          17:          CLRA                       MAKE SURE TYPE IS SET CORRECTLY.
21E0 9759        18:          STAA     XTYPE               I.E., NON-FREF, ABS, EQU.
  21E2           19: LFEQU    EQU      *
21E2 4F          20:          CLRA                       THIS IS AN EQU..
21E3 2002        21:          BRA      LFSET1
                 22: 
  21E5           23: LFSET    EQU      *
21E5 8602        24:          LDAA     #T:SET            THIS IS A SET...
21E7 9A59        25: LFSET1   ORAA     XTYPE             MERGE INTO EXP. TYPE.
21E9 9761        26: LFEQ0    STAA     TYPE              SAVE THE TYPE,
                 27:          ;LDX      LFPTR             GET POINTER TO LF,
21EB DE22        28:          LDX      LFPTR
                 29:          ;JSR      GNOBX             GET FIRST OBJECT.
21ED BD1E38      30:          JSR      GNOBX
                 31:          ;INC      RJOBJ             REJECT IT.
21F0 7C005C      32:          INC      RJOBJ
  21F3           33: LFEQL    ;JSR      GNOB:SJ           GET OBJ AND FORK.
21F3 BD1BB8      34:          JSR      GNOB:SJ
21F6 06          35:          FCB      +O:TERM           A TERMINATOR?
21F7 2200        36:          FDB      LFEQ1             B/ YES:  MAYBE DONE.
21F9 01          37:          FCB      +O:SYM            A SYMBOL?
21FA 2205        38:          FDB      LFEQ2             B/ YES:  DEFINE IT.
21FC 00          39:          FCB      +0                END OF LIST.         
  21FD           40: LFEQE    ;JMP      ILLF              *E* ILLEGAL LABEL FIELD.
21FD 7E0863      41:          JMP      ILLF




ASM/6800 1.3H4: 21FD ASM/6800 1.4       - - - S Y M B O L    M A N I P U L A T I O N S - - -
08/16/82 00:00:00; Page 261; Form 57    - - L F E Q U - - -
ASM14A.EVAL.ASM
                 42: *
  2200           43: LFEQ1    ;CMPB     #ASCII:COMMA     A COMMA?
2200 C12C        44:          CMPB     #ASCII:COMMA
2202 27EF        45:          BEQ      LFEQL             B/ YES: GO ON EATING LF.
2204 39          46:          RTS                        OTHERWISE: ALL DONE.
                 47: *
  2205           48: LFEQ2    ;JSR      SYMDEF            GO DEFINE THE SYMBOL,
2205 BD2180      49:          JSR      SYMDEF
2208 20E9        50:          BRA      LFEQL             AND GO ON.
                111:          END      ;UNEXPECTED EOF
                  0:          INCLUDE  ASM14A.IOFM.ASM




ASM/6800 1.3H4: 2208 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
