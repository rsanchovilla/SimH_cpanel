ASM/6800 1.3H4: 2D9A ASM/6800 1.4       - - - S Y M B O L    T A B L E    D U M P - - -
08/16/82 00:00:00; Page 356; Form 42    - - - S P S T - - -
ASM14A.IOFM.ASM
                  2: *
                  3: *
                  4: * SPTST - CHECK IF EITHER OF THE SYMBOLS GIVEN TO THE SORT ROUTINES
                  5: *        ARE NULL POINTERS. (I.E. NO SYMBOLS AT ALL)
                  6: *
                  7: * IF SO, THE V CC IS SET AS FOLLOWS:
                  8: *
                  9: *        NEW=0  --> V=0, regardless of state of THIS.
                 10: *        NEW<>0, THIS=0 --> V=1
                 11: *
  2D9C           12: SPTST    ;LDX     NEW               GET 1ST PTR
2D9C DE4E        13:          LDX      NEW
2D9E 2708        14:          BEQ      NNEW              INDICATE IT IS NULL
                 15:          ;LDX     THIS              LOAD 2ND PTR
2DA0 DE4C        16:          LDX      THIS
2DA2 2603        17:          BNE      SPOK              IF NOT NULL EITHER, JUST RETURN(X=THIS)
                 18:          ;LEAS    2,S               ELSE, POP RETURN ADDR
  0000           19:          IF       2<0
 *S*             20:          RPT      -2
 *S*             21:          DES
                 22:          ELSE
  0002           23:          RPT      2
2DA4 31          24:          INS
                 25:          FIN
2DA6 0B          26: SEV      SEV                        SET V=1
2DA7 39          27: SPOK     RTS                        RETURN
                 28: *
  2DA8           29: NNEW     ;LEAS    2,S               POP RETURN ADDR
  0000           30:          IF       2<0
 *S*             31:          RPT      -2
 *S*             32:          DES
                 33:          ELSE
  0002           34:          RPT      2
2DA8 31          35:          INS
                 36:          FIN
2DAA 0A          37: CLV      CLV                        SET V=0
2DAB 39          38:          RTS                        RETURN
                 39: *




ASM/6800 1.3H4: 2DAB ASM/6800 1.4       - - - S Y M B O L    T A B L E    D U M P - - -
08/16/82 00:00:00; Page 357; Form 43    - - - S O R T   C O M P A R I S O N   R O U T I N E S - - -
ASM14A.IOFM.ASM
                  2: *
                  3: *
                  4: *
                  5: *        1) ALWAYS RETURNS V SET IF "THIS" SHOULD FOLLOW "NEW"
                  6: *        2) ALWAYS DESTROY (A,B)
                  7: *
  0001            8:          IF       DUMPV=1
                  9: *        SORTVAL -- SORTS ON VALUE FIELD.  BY 16 BIT MAGNITUDE.
                 10:          FIN
                 11: *
                 12: *        SORTNAME -- SORTS ON NAME FIELD; ASCII COLLATING SEQUENCE.
                 13: *
                 14: *
  0001           15:          IF       DUMPV=1
  2DAC           16: SORTVAL  EQU      *
2DAC 8DEE        17:          BSR      SPTST             GO SEE IF ANY PTRS ARE NULL
                 18:          ;LDD     S:VAL,X           GET VALUE OF THIS NODE
2DAE E603        19:          LDAB     (S:VAL)+1,X
2DB0 A602        20:          LDAA     S:VAL,X
                 21:          ;LDX     NEW               GET ADDRESS OF OTHER NODE
2DB2 DE4E        22:          LDX      NEW
                 23:          ;CMPA    S:VAL,X
2DB4 A102        24:          CMPA     S:VAL,X
2DB6 22EE        25:          BHI      SEV               B/ HI ==> THIS > NEXT, INSERT HERE
2DB8 26F0        26:          BNE      CLV               B/ LOW ==> THIS < NEXT
                 27:          ;CMPB    S:VAL+1,X         B/ H(THIS)=H(NEXT), COMPARE L(THIS):L(NEXT)
2DBA E103        28:          CMPB     S:VAL+1,X
2DBC 22E8        29:          BHI      SEV               B/ HI ==> THIS >= NEXT, INSERT HERE
2DBE 26EA        30:          BNE      CLV               IF EQUAL DROP THROUGH TO NAME SORT
                 31:          FIN
                 32: *
                 33: *
                 34: *
                 35: *
  2DC0           36: SORTNAME EQU      *
2DC0 8DDA        37:          BSR      SPTST             SEE IF EITHER ARG IS NULL
2DC2 DF34        38:          STX      TPTR              SAVE SYMBOL NAME SCAN POINTER
2DC4 E605        39:          LDAB     S:LEN,X           AND LENGTH OF FIRST SYMBOL
                 40:          ;LDX     NEW               NOW FOR THE OTHER SYMBOL
2DC6 DE4E        41:          LDX      NEW




ASM/6800 1.3H4: 2DC8 ASM/6800 1.4       - - - S Y M B O L    T A B L E    D U M P - - -
08/16/82 00:00:00; Page 358; Form 43    - - - S O R T   C O M P A R I S O N   R O U T I N E S - - -
ASM14A.IOFM.ASM
2DC8 DF36        42:          STX      TPTR1             SAVE POINTER TO IT, TOO...
                 43:          ;CMPB    S:LEN,X           FIGURE OUT WHICH IS LONGER
2DCA E105        44:          CMPB     S:LEN,X
2DCC 07          45:          TPA                        NEWT'S EYE AND HAIR OF BAT...
2DCD 36          46:          PSHA                       THAR BE FUNNY STUFF HERE, MATEY!
2DCE 2302        47:          BLS      SORTNAM1          IF YOU UNDERSTAND THIS GIZMO...
2DD0 E605        48:          LDAB     S:LEN,X           PLEASE TELL US WHAT IT DOES!
                 49: *
                 50: *                 A RUMOR INDICATES GET MIN(LEN(THIS),LEN(NEW))
                 51: *        GOD HELP YOU IF ANY ZERO LENGTH SYMBOLS ARE MIXED UP IN THIS
                 52: *
                 53: * B=MIN(LEN(THIS),LEN(NEW))
                 54: *
                 55: *
  2DD2           56: SORTNAM1 EQU      *
                 57:          ;LDX     TPTR              GET POINTER TO THIS SYMBOL NAME
2DD2 DE34        58:          LDX      TPTR
2DD4 A606        59:          LDAA     S:TEXT,X          GET NEXT CH OF SYMBOL NAME
2DD6 08          60:          INX
2DD7 DF34        61:          STX      TPTR              BUMP AND UPDATE SYMBOL SCAN POINTER
                 62:          ;LDX     TPTR1             NOW GET A BYTE FROM OTHER SYMBOL
2DD9 DE36        63:          LDX      TPTR1
                 64:          ;CMPA    S:TEXT,X          DECIDE WHICH IS LEXICOGRAPHICALLY SMALLER
2DDB A106        65:          CMPA     S:TEXT,X
2DDD 2705        66:          BEQ      SORTNAM2          THERE IS ALWAYS THIS POSSIBILITY
2DDF 31          67:          INS                        WHAT'S IN THE STACK ?
2DE0 22C4        68:          BHI      SEV               ONE IS BIGGER!
2DE2 20C6        69:          BRA      CLV               OR IT IS SMALLER...
  2DE4           70: SORTNAM2 EQU      *                 RATS, BOTH CHARACTERS WERE THE SAME!
2DE4 08          71:          INX                        BUMP POINTER TO 2ND SYMBOL NAME
2DE5 DF36        72:          STX      TPTR1
2DE7 5A          73:          DECB                       DOWN COUNT THE LENGTHS
2DE8 26E8        74:          BNE      SORTNAM1          B/MORE BYTES TO COMPARE
                 75: *
                 76: *        ALL COMPARED TEXT IS EQUAL, CHOOSE SHORTER SYM.
                 77: *
                 78: *
                 79: *
                 80: *
2DEA 32          81:          PULA                       TERRY CAN GET HERE!




