ASM14A.IOFM.ASM
                 38: *****************************************************************************
                 39: *
                 40: * Name:  FinishCurrec(LAST)
                 41: *
                 42: * Function:
                 43: *        Finishes build process for current SDOS load record by writing its
                 44: *        header into the file.
                 45: *
                 46: * Arguments:
                 47: *        ACCA     "LAST"            Flag, designating whether this should be
                 48: *                                     a LOAD record (if 0) or a LOADGO record
                 49: *                                     (if non-zero).
                 50: *
                 51: * Changed:
                 52: *        A, B, C, X
                 53: *
                 54: * Input:
                 55: *        CURREC+R$VALID             Flag, indicating (if non-zero) that we have
                 56: *                                     a record that we need to terminate; or
                 57: *                                     (if zero) that we should/need do nothing
                 58: *                                     in this routine.
                 59: *
                 60: *        CURREC+R$FILEBASE          File-pointer, (4 bytes), gives the address
                 61: *                                     of the first data byte in the current
                 62: *                                     record.  We assume that 5 bytes of space
                 63: *                                     have been left in front of this for a
                 64: *                                     record header.
                 65: *
                 66: *        CURREC+R$BASE              Target load address for first byte in this
                 67: *                                     record.
                 68: *
                 69: *        CURREC+R$LEN               Number of bytes in this record.
                 70: *




ASM/6800 1.3H4: 2912 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 313; Form 25    - - - F i n i s h   C u r r e c - - -
ASM14A.IOFM.ASM
                 72: *
                 73: * Output:
                 74: *        CURREC+R$VALID             Set to zero, indicating that we have no
                 75: *                                     current record.
                 76: *
                 77: *        CURREC+R$FILEBASE          Updated to point to the first free byte in
                 78: *                                     the file.
                 79: *
                 80: *****************************************************************************
                 81: 
  2913           82: FinishCurrec      EQU *
2913 F6308C      83:          LDAB     CURREC+R$VALID
2916 273A        84:          BEQ      FinishCurrec%
                 85: 
                 86: **** Subtract 5 from Filebase to get to where header should go ****
2918 36          87:          PSHA                       (Save "Last Record Flag")
                 88:          ;LDX     #CURREC+R$FILEBASE
2919 CE3088      89:          LDX      #CURREC+R$FILEBASE
291C 4F          90:          CLRA                       Load AB w/ 5...
291D C605        91:          LDAB     #5                  ....,
291F 8D53        92:          BSR      SubFilebase         which we then subtract from CURREC.FILEBASE.
                 93: 
                 94: **** Position file to where header should go ****
2921 C603        95:          LDAB     #BO               Position the binary channel, silly!
                 96:          ;JSR     POSITION$
2923 BD0126      97:          JSR      POSITION$
                 98: 
                 99: **** Write appropriate record type mark, followed by the rest of the header ****
2926 32         100:          PULA                       Restore "Last Record Flag" to ACCA.
                101:          ;LDX     #CURREC+R$LEN+1
2927 CE3087     102:          LDX      #CURREC+R$LEN+1
  292A          103: FinishCurrec1     equ *
292A E600       104:          LDAB     0,X
292C 09         105:          DEX
292D 37         106:          PSHB
292E 8C3083     107:          CPX      #CURREC+R$BASE-1  Done yet?
2931 26F7       108:          BNE      FinishCurrec1
                109: 
2933 C602       110:          LDAB     #RTYPE$LOAD       Assume not last record, but just in case:
2935 4D         111:          TSTA                       Check "last-record" flag




ASM/6800 1.3H4: 2936 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
08/16/82 00:00:00; Page 314; Form 25    - - - F i n i s h   C u r r e c - - -
ASM14A.IOFM.ASM
2936 2702       112:          BEQ      FinishCurrec2       B/ Not last record.
2938 C603       113:          LDAB     #RTYPE$LOADGO     Oops!  Last record.  Set type & proceed.
                114: 
  293A          115: FinishCurrec2     equ *
293A 37         116:          PSHB                       Save type byte,
293B 30         117:          TSX                          get pointer to built record,
293C 8605       118:          LDAA     #5                  set count,
293E C603       119:          LDAB     #BO                 set channel,
                120:          ;JSR     WRITEREC$           write a buncha bytes.
2940 BD0123     121:          JSR      WRITEREC$
                122: 
                123: **** Make Currec point to next spare byte in file ****
                124:          ;CLR     CURREC+R$VALID    Mark record as closed.
2943 7F308C     125:          CLR      CURREC+R$VALID
2946 4F         126:          CLRA                       Restore Filebase,
2947 C605       127:          LDAB     #5
2949 8DB1       128:          BSR      UpdateFilebase      by adding 5.
                129: 
                130: **** Clean up stack & exit ****
                131:          ;LEAS    3,S               Prune 3 bytes from stack
  0000          132:          IF       3<0
 *S*            133:          RPT      -3
 *S*            134:          DES
                135:          ELSE
  0003          136:          RPT      3
294B 31         137:          INS
                138:          FIN
294E 32         139:          PULA                       Now, read the length off the stack,
294F 33         140:          PULB
2950 8DAA       141:          BSR      UpdateFilebase      and add it to the filepointer.
                142: 
  2952          143: FinishCurrec%     equ *
2952 39         144:          RTS




ASM/6800 1.3H4: 2952 ASM/6800 1.4       - - - I / O    S E C T I O N - - -
