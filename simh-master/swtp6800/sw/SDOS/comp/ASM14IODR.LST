                753:          ;LDX     #SETERRBLOCK
05C4 CE03B2     754:          LDX      #SETERRBLOCK
05C7 A702       755:          STAA     SETERROR:CODE,X
05C9 E703       756:          STAB     SETERROR:CODE+1,X
                757:          ;JSR     ISCONSOLE         ARE WE IN A DO FILE??
