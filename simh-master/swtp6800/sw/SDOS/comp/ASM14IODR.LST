  05DB          767: CALLSYSCALLIO     ;JSR              SYSCALLIO
05DB BD0636     768:          JSR      SYSCALLIO
05DE 2501       769:          BCS      IOERROR::
05E0 39         770:          RTS
                771: 
  05E1          772: IOERROR::         EQU               *
05E1 DF00       773:          STX      TEMPX             LOAD ERROR
05E3 9600       774:          LDAA     TEMPX              CODE IN
05E5 D601       775:          LDAB     TEMPX+1             A & B REGS
                776:          ;JMP     IOERR             GO TO FLAMOUT ROUTINE
05E7 7E0103     777:          JMP      IOERR
                778: 
05EA FF03B0     779: CRAPOUT  STX      ERREXIT+SCBLK:PARAMS     SAVE ERROR CODE
  05ED          780: CRAPOUT1 ;LDX     #ERREXIT
05ED CE03AE     781:          LDX      #ERREXIT
                782:          ;JSR     SYSCALL$
05F0 BD00FB     783:          JSR      SYSCALL$




ASM/6800 1.3H4: 05F0 ASMIODRIVER        - - - I/O Package for MAL/6800-6809   1.4 - - -
08/16/82 00:00:00; Page 47; Form 1      OLD I/O PACKAGE CALL SIMULATION
ASM14IODR.ASM
                785: *
                786: *  READ CLOCK INTO DATE$BUF.  SET CARRY & EXIT IF PROBLEMS.
                787: *
  05F3          788: CLOCKGET ;LDX     #OPENCLK          START ISSUING SYSCALLS
05F3 CE0330     789:          LDX      #OPENCLK
05F6 8D08       790:          BSR      SYSCALL$1           LIKE CRAZY, USING SDOS'S
                791:          ;LDX     #READCLK            WONDER RETURN CONVENTION TO GET US
05F8 CE033E     792:          LDX      #READCLK
05FB 8D03       793:          BSR      SYSCALL$1           OUT OF HERE IF WE HAVE PROBLEMS.
                794:          ;LDX     #CLOSECLK
05FD CE034C     795:          LDX      #CLOSECLK
  0600          796: SYSCALL$1         ;JMP              SYSCALL$
0600 7E00FB     797:          JMP      SYSCALL$
                798: 
                799: 
                800: **** READ THE DATE *****
0603 8DEE       801: DATE     BSR      CLOCKGET          READ THE CLOCK; THE BCS **MUST** FOLLOW;
0605 2505       802:          BCS      DATERR              B/ COULDN'T DO IT.
                803:          ;LDX     #DATE$BUF+9       POINT TO THE DATE PORTION OF THE MESSAGE,
0607 CE0314     804:          LDX      #DATE$BUF+9
060A 2003       805:          BRA      DATETIME            AND JOIN THE COMMON FLOW.
                806: 
  060C          807: DATERR   ;LDX     #DUMDATE          LOAD DUMMY DATE FOR ERRORS,
060C CE0618     808:          LDX      #DUMDATE
                809: 
060F 8608       810: DATETIME LDAA     #8                LOAD USUAL COUNT
0611 39         811:          RTS                          AND GO AWAY.
                812: 
                813: **** DUMMY DATE/TIME BUFFERS *****
0612 434C4F43   814: CLOCKNAME         FCC               "CLOCK:"
0618 2A2A4441   815: DUMDATE  FCC      "**DATE**"
0620 2A2A5449   816: DUMTIME  FCC      "**TIME**"
                817: 
                818: 
                819: 
                820: **** READ THE TIME *****
0628 8DC9       821: TIME     BSR      CLOCKGET          READ THE CLOCK.
062A 2505       822:          BCS      TIMERR              B/ NOPE.
                823:          ;LDX     #DATE$BUF         POINT TO THE TIME PORTION OF THE NONSENSE,
062C CE030B     824:          LDX      #DATE$BUF




