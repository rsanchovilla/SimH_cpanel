  0001          645: LOAD:TYPE1      EQU     1       STARTUP RECORD
  0002          646: LOAD:TYPE2      EQU     2       LOAD BYTES RECORD
  0003          647: LOAD:TYPE3      EQU     3       LOAD BYTES AND STOP RECORD
  0005          648: LOAD:ENCRYPTED  EQU     5       "THIS FILE IS ENCRYPTED" LOAD RECORD
                649: *
                650: *       BOOT SECTOR DISPLACEMENTS
                651: *
  0000          652:         ORG     0
0000 0010       653: BOOT:IPLDATA    RMB     16      CONTAINS "JMP BOOTSIZE" OR OTHER BOOTSTRAP DATA
0010 0000       654: BOOT:DISKINFO   RMB     0       SPACE FOR DISKINFO TABLES
  0010          655: BOOT:DISKINFOLEN        EQU     16
0010 0001       656: BOOT:FILESYSTEMVERSION  RMB     1       SDOS FILE SYSTEM FORMAT VERSION NUMBER $AB =
0011 0001       657: BOOT:NSPC       RMB     1       NUMBER OF SECTORS PER CLUSTER
0012 0002       658: BOOT:MINALLOC   RMB     LCN:SIZE        ALLOCATION MINIMUM FOR NEW FILES
0014 0002       659: BOOT:MIDALLOC   RMB     LCN:SIZE        ALLOCATION MIN FOR FILE EXTENSION
0016 0002       660: BOOT:MAPALGORITHM       RMB     2       LOGICAL TO PHYSICAL CONVERSION ALGORITHM #
0018 0003       661: BOOT:CREATIONDATE       RMB     3       DD/MM/YY IN HEX
001B 0003       662: BOOT:DIRLSN     RMB     LSN:SIZE        LSN OF DIRECTORY SECTOR CONTAINING "DIRECTOR
001E 0001       663:         RMB     BOOT:DISKINFOLEN+BOOT:DISKINFO-*-1
001F 0001       664: BOOT:CHECKSUM   RMB     1       SUCH THAT SUM OF DISKINFO BYTES (INCL CKSUM) = $FF
  0020          665: BOOT:DISKIDSIZE EQU     32      # BYTES RESERVED FOR ASCII DISK IDENTIFICATION
0020 0020       666: BOOT:DISKID     RMB     BOOT:DISKIDSIZE TEXT NAME OF DISK (TRAILING BLANK PADDED)
  0040          667: BOOT:SIZE       EQU     *




