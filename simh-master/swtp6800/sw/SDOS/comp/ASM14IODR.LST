  04B7          557: WRITEA$OK1        EQU               *
                558:          ;LDX     CCB:CBP,X         GRAB THE CURRENT POINER,
04B7 EE03       559:          LDX      CCB:CBP,X
04B9 A700       560:          STAA     0,X                 SHOVE IN A CHARACTER.
04BB 39         561:          RTS                          SPLIT.
                562: 
  04BC          563: WRITEA$FLUSH      EQU *
04BC 36         564:          PSHA                       SAVE ACCA,
04BD 37         565:          PSHB                         AND CHANNEL #.
04BE A605       566:          LDAA     CCB:CBL,X         GET LENGTH OF BUFFER,
04C0 0C         567:          CLC                          CLEAR CARRY IN CASE OF EARLY EXIT.
04C1 2726       568:          BEQ      WRITEA$FLX          B/ NOTHING TO DO, SPLIT NOW.
04C3 FF03C2     569:          STX      WRITEA$XSV        GOING TO WRITE:  SAVE X,
                570:          ;LDX     CCB:BBP,X           AND FETCH BASE ADDRESS OF BUFFER.
