ASM/6800 1.3H4: 0594 ASMIODRIVER        - - - I/O Package for MAL/6800-6809   1.4 - - -
08/16/82 00:00:00; Page 45; Form 1      OLD I/O PACKAGE CALL SIMULATION
ASM14IODR.ASM
0594 A6B8       713:          LDAA     EOFTABLE&$FF,X
  0001          714:          IF       SDOSBINARY=1
0596 39         715:          RTS
                716: *
0597 8604       717: GETTYPE  LDAA     #SC:GETTYPE       LOAD COMMAND.
  0599          718: GETSTS   ;LDX     #STATUSBLOCK
0599 CE039E     719:          LDX      #STATUSBLOCK
059C E702       720:          STAB     STATUS:CHANNEL,X
059E 37         721:          PSHB                       SAVE CHANNEL #.
059F A703       722:          STAA     SCBLK:PARAMS+1,X
05A1 8D38       723:          BSR      CALLSYSCALLIO     SEND ALL ERRORS ELSEWHERE.
05A3 B603BE     724:          LDAA     BUFFER            LOAD DEVICE TYPE,
05A6 33         725:          PULB                         RESTORE CHANNEL #,
05A7 39         726:          RTS                          AND SPLIT.
                727: 
                728: 
                729: **** GETSIZE -- RETURNS NBPS FOR SPECIFIED CHANNEL, IN AB ****
  05A8          730: GETSIZE  EQU      *
05A8 8DED       731:          BSR      GETTYPE           GET DEVICE TYPE IN A.
                732:          ;LDX     #ASME.NOTFILE     PRESET ERROR CODE.
05AA CE0069     733:          LDX      #ASME.NOTFILE
                734:          ;CMPA    #DVTYP.FILE         ...DISK FILE?
05AD 8100       735:          CMPA     #DVTYP.FILE
05AF 2630       736:          BNE      IOERROR::           B/ NO:  REPORT ERROR.
                737: 
                738: **** DO GETPARAMS, RETURN FIRST TWO BYTES OF BUFFER IN AB ****
  05B1          739: GETPARAMS EQU     *
05B1 8605       740:          LDAA     #SC:GETPARAMS     LOAD FUNCTION CODE,
05B3 8DE4       741:          BSR      GETSTS              READ STATUS.
                742:          ;LDX     #BUFFER           RETURN POINTER TO BUFFER,
05B5 CE03BE     743:          LDX      #BUFFER
05B8 A600       744:          LDAA     DVDAT:NBPS,X        FIRST TWO BYTES.
05BA E601       745:          LDAB     DVDAT:NBPS+1,X      ....
                746:          FIN      SDOSBINARY=1
05BC 39         747: RESET    RTS
                748: *
  05BD          749: ERROR::  ;LDX     #ERREXIT          SAVE FOR POSSIBLE ABORT
05BD CE03AE     750:          LDX      #ERREXIT
05C0 A702       751:          STAA     SCBLK:PARAMS,X
05C2 E703       752:          STAB     SCBLK:PARAMS+1,X




