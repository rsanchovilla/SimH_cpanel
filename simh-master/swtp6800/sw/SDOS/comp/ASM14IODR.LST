SDOSUSERDEFS.ASM
                 51:         PAGE
                 52: *
                 53: *       SYSCALL BLOCK DISPLACEMENTS
                 54: *
  0000           55:         ORG     0
0000 0001        56: SCBLK:OPCODE    RMB     1       PRIMARY SYSCALL FUNCTION (OPEN, READ, ETC.)
0001 0001        57: SCBLK:WLEN      RMB     1       WAIT FLAG BIT (0=WAIT) AND SYSCALL BLOCK LENGTH (0..
0002 0002        58: SCBLK:PARAMS    RMB     2       PARAMETER BYTES TO OPCODE (SECONDARY OPCODE, CHANNEL
0004 0002        59: SCBLK:WRBUF     RMB     2       POINTER TO WRITE DATA BUFFER
0006 0002        60: SCBLK:WRLEN     RMB     2       NUMBER OF BYTES IN WRITE DATA BUFFER
0008 0002        61: SCBLK:RPLEN     RMB     2       LENGTH OF REPLY (RESULT OF SYSCALL)
000A 0002        62: SCBLK:RDBUF     RMB     2       POINTER TO READ DATA BUFFER (WHERE RESULT GOES)
000C 0002        63: SCBLK:RDLEN     RMB     2       CEILING ON SIZE OF REPLY (READ DATA BUFFER)
000E 0000        64: SCBLK:DATA      RMB     0       OTHER PARAMETERS FOR SYSCALL; UP TO 127-12 BYTES
000E 0000        65: SCBLK:END       RMB     0       END OF SYSCALL BLOCK; ASSERT SCBLK:WLEN[1..7]=SCBLK:
                 66: *
                 67: *       SYSCALL PARAMETER LIST DEFINITIONS
                 68: *
  0002           69: OPEN:CHANNEL    EQU     SCBLK:PARAMS    CHANNEL NUMBER
  0006           70: OPEN:LENGTH     EQU     SCBLK:WRLEN     FILE NAME LENGTH
  0004           71: OPEN:NAMEP      EQU     SCBLK:WRBUF     POINTER TO FILE NAME
  000E           72: OPEN:SCLEN      EQU     SCBLK:DATA      OPEN SYSCALL BLOCK LENGTH
                 73: *
  0002           74: CREATE:CHANNEL  EQU     SCBLK:PARAMS    CHANNEL NUMBER
  0006           75: CREATE:LENGTH   EQU     SCBLK:WRLEN     FILE NAME LENGTH
  0004           76: CREATE:NAMEP    EQU     SCBLK:WRBUF     POINTER TO FILE NAME
  000E           77: CREATE:SCLEN    EQU     SCBLK:DATA      CREATE SYSCALL BLOCK LENGTH
  000E           78: CREATE:FILESIZE EQU     SCBLK:DATA      4 BYTE FILE SIZE INITIAL ALLOCATION
  0012           79: CREATE:FILESIZESCLEN    EQU     CREATE:FILESIZE+4       END OF CREATE BLOCK WITH FIL
                 80: *
  0002           81: CLOSE:CHANNEL   EQU     SCBLK:PARAMS    CHANNEL NUMBER
  0003           82: CLOSE:SCLEN     EQU     SCBLK:PARAMS+1  CLOSE SYSCALL BLOCK LENGTH
                 83: *
  0002           84: RENAME:CHANNEL  EQU     SCBLK:PARAMS    CHANNEL NUMBER
  0006           85: RENAME:LENGTH   EQU     SCBLK:WRLEN     NEW FILE NAME LENGTH
  0004           86: RENAME:NAMEP    EQU     SCBLK:WRBUF     POINTER TO NEW FILE NAME
  000E           87: RENAME:SCLEN    EQU     SCBLK:DATA      RENAME SYSCALL BLOCK LENGTH
                 88: *
  0006           89: DELETE:LENGTH   EQU     SCBLK:WRLEN     FILE NAME LENGTH
  0004           90: DELETE:NAMEP    EQU     SCBLK:WRBUF     POINTER TO NAME




