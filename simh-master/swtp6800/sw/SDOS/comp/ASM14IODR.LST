04D9 DF00       583:          STX      TEMPX               AND ERROR CODE (IF ANY).
                584:          ;LDX     WRITEA$XSV        RESTORE CCB POINTER,
04DB FE03C2     585:          LDX      WRITEA$XSV
04DE E600       586:          LDAB     CCB:BBP,X           AND INITIALIZE CURRENT BUFFER POINTER
04E0 E703       587:          STAB     CCB:CBP,X
04E2 E601       588:          LDAB     CCB:BBP+1,X
04E4 E704       589:          STAB     CCB:CBP+1,X
                590:          ;CLR     CCB:CBL,X           ...AND CURRENT BUFFER LENGTH.
04E6 6F05       591:          CLR      CCB:CBL,X
04E8 06         592:          TAP                        RESTORE CARRY FLAG,




