  0AED          217: MINIT   EQU     *
                218: *
                219: *       DO CHECKSUM OVER COMPILER
                220: *
                221:         ;LDX    #CODE
0AED CE0100     222:         LDX     #CODE
0AF0 4F         223:         CLRA            = SUM
0AF1 AB00       224: CKSUML1 ADDA    0,X     SUM OVER METAMACHINE
0AF3 08         225:         INX
0AF4 8C0BE3     226:         CPX     #METAMCODEEND
0AF7 26F8       227:         BNE     CKSUML1
                228:         ;LDX    METACODE        SUM OVER META INSTRUCTIONS
0AF9 FE0C8D     229:         LDX     METACODE
0AFC AB00       230: CKSUML2 ADDA    0,X
0AFE 08         231:         INX
0AFF BC0C89     232:         CPX     DICT
0B02 26F8       233:         BNE     CKSUML2
                234:         ;TFR    A,B     COMPUTE PROPER VALUE FOR CHECKSUM BYTE IN CASE IT'S WRONG
0B04 16         235:         TAB
0B05 50         236:         NEGB
0B06 FB0103     237:         ADDB    CHECKSUM
                238:         ;STB    CHECKSUM
0B09 F70103     239:         STAB    CHECKSUM
0B0C 4D         240:         TSTA            IS CHECKSUM CORRECT ?
0B0D 260B       241:         BNE     MINITDISPLAY    B/ CHECKSUM WRONG, GO DISPLAY BANNER AND DIE...
  0001          242:         IF      M6800!M6801
                243:         ;LDB    #$01    = 6800/6801 NOP INSTRUCTION
0B0F C601       244:         LDAB    #$01
  0001          245:         ELSE    (M6809)
 *S*            246:         ;LDB    #$12    = 6809 NOP INSTRUCTION
 *S*            247:         LDAB    #$12
                248:         FIN
                249:         ;STB    MINITCKFAULT    CHECKSUM IS OK, KILL THE FAULT DISPLAY LOGIC
0B11 F70B2E     250:         STAB    MINITCKFAULT
                251:         ;STB    MINITCKFAULT+1
0B14 F70B2F     252:         STAB    MINITCKFAULT+1
                253:         ;STB    MINITCKFAULT+2
0B17 F70B30     254:         STAB    MINITCKFAULT+2
                255: *
                256: *       DISPLAY THE BANNER




