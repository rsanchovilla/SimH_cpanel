                211:         ;JMP    METAINCPC2
01DD 7E0388     212:         JMP     METAINCPC2
                213: *
                214: *       MQUERYSTATE -- QUERY STATE VARIABLE
                215: *       SETS FLAG TO "TRUE" IF MATCH
                216: *       (:3B) (8 BIT STATE VARIABLE NUMBER) (8 BIT VALUE)
                217: *
  01E0          218: MQUERYSTATE     ;CLR    FLAG    ASSUME THE WORST!
01E0 7F0022     219:         CLR     FLAG
01E3 8D0A       220:         BSR     GETSTATEADDRESS LIKEWISE...
                221:         ;CMPB   STATEVARS&$FF,X
01E5 E149       222:         CMPB    STATEVARS&$FF,X
01E7 2603       223:         BNE     MQUERYSTATE1    B/ NO MATCH
                224:         ;INC    FLAG    A MATCH, REMEMBER THAT!
01E9 7C0022     225:         INC     FLAG
  01EC          226: MQUERYSTATE1    ;JMP    METAINCPC2
01EC 7E0388     227:         JMP     METAINCPC2
                228: *
