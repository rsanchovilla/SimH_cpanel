SDOSUSERDEFS.ASM
                  2: *       SDOS 1.1 DEFINITIONS FILE (AS OF 8/16/82)
                  3: *
  0011            4: SDOSVERSION     EQU     $11     1.1 IN HEX
                  5: *
                  6: *
                  7: *       The Definitions are broken into 3 parts:
                  8: *               A) THOSE NEEDED TO ASSEMBLE SDOS PROPER OR SYSTEM PROGRAMS
                  9: *               B) THOSE NEEDED TO BUILD AN I/O PACKAGE (A SUBSET OF "A")
                 10: *               C) THOSE NEEDED BY EVERYDAY USER PROGRAMS (A SUBSET OF "B")
                 11: *
  00FB           12: SYSCALL$        EQU     $FB     JMP TO SDOS; RESERVED SYSCALL ENTRY POINT
                 13: *       CONTENTS OF ($FC,$FD) POINTS TO END OF USER RAM
                 14: *       CONTENTS OF ($FE,$FF) ARE SACRED; THEY BELONG TO THE ROM




ASM/6800 1.4A0: 0000 METAM14C.ASM       
08/16/82 00:00:00; Page 3; Form 1       *** SDOS 1.1 DEFINITIONS ***
SDOSUSERDEFS.ASM
                 16: *       SYSCALL$ OPCODE DEFINITIONS
                 17: *
  0000           18:         ORG     0
0000 0001        19: SYSCALL:OPEN    RMB     1       OPEN FILE
0001 0001        20: SYSCALL:CREATE  RMB     1       CREATE A NEW FILE
0002 0001        21: SYSCALL:CLOSE   RMB     1       CLOSE A FILE
0003 0001        22: SYSCALL:RENAME  RMB     1       RENAME A FILE
0004 0001        23: SYSCALL:DELETE  RMB     1       DELETE A FILE
0005 0001        24: SYSCALL:LOAD    RMB     1       LOAD AN OVERLAY
0006 0001        25: SYSCALL:CHAIN   RMB     1       CHAIN TO A FILE
0007 0001        26: SYSCALL:CREATELOG       RMB     1       CREATE THE LOG FILE
0008 0001        27: SYSCALL:CLOSELOG        RMB     1       CLOSE THE LOG FILE
0009 0001        28: SYSCALL:DISKDEFAULT     RMB     1       SELECT DEFAULT DISK DEVICE
000A 0001        29: SYSCALL:READA   RMB     1       READ ASCII BYTES FROM A FILE
000B 0001        30: SYSCALL:READB   RMB     1       READ BINARY BYTES FROM A FILE
000C 0001        31: SYSCALL:WRITEA  RMB     1       WRITE ASCII BYTES TO A FILE
000D 0001        32: SYSCALL:WRITEB  RMB     1       WRITE BINARY BYTES TO A FILE
000E 0001        33: SYSCALL:CONTROL RMB     1       PERFORM A CONTROL OPERATION ON A FILE/DEVICE
000F 0001        34: SYSCALL:STATUS  RMB     1       READ FILE/DEVICE STATUS
0010 0001        35: SYSCALL:WAITDONE        RMB     1       WAIT FOR I/O ON CHANNEL TO COMPLETE
0011 0001        36: SYSCALL:EXIT    RMB     1       GIVE CONTROL BACK TO THE OPERATING SYSTEM
0012 0001        37: SYSCALL:ERROREXIT       RMB     1       EXIT TO SYSTEM WITH ERROR CODE
0013 0001        38: SYSCALL:SETERROR        RMB     1       REPORT AN ERROR TO THE SYSTEM
0014 0001        39: SYSCALL:GETERROR        RMB     1       READ BACK THE LAST ERROR CODE
0015 0001        40: SYSCALL:DISPERROR       RMB     1       DISPLAY ERROR MESSAGE CORRESPONDING TO LAST ER
0016 0001        41: SYSCALL:KILLPROOF       RMB     1       PREVENT USER PROGRAM FROM BEING KILLED
0017 0001        42: SYSCALL:KILLENABLE      RMB     1       ALLOW USER PROGRAM TO BE KILLED
0018 0001        43: SYSCALL:DEBUG   RMB     1       CALL SYSTEM DEBUGGER
0019 0001        44: SYSCALL:ATTNCHECK       RMB     1       OPERATOR ATTENTION REQUEST CHECK
001A 0001        45: SYSCALL:ISCONSOLE       RMB     1       CHECK FOR CHANNEL 0 INPUT DEVICE = CONSOLE:
001B 0001        46: SYSCALL:INTERLOCK       RMB     1       PERFORM INTERLOCK FUNCTIONS ON OBJECTS
001C 0001        47: SYSCALL:DELAY   RMB     1       DELAY FOR n 1/60ths OF A SECOND
001D 0001        48: SYSCALL:READLUN RMB     1       CONVERT LOGICAL UNIT NUMBER TO DEVICE NAME
001E 0001        49: SYSCALL:GETSERIALNUMBER RMB     1       GET PROCESSOR SERIAL NUMBER
001F 0001        50: SYSCALL:JOBCONTROL      RMB     1       CREATE/TEST/DESTROY OTHER JOBS




