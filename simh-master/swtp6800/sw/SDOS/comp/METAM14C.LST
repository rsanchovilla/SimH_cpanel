  03F3          674: MPARAMSL        ;JSR    REALIZELABEL    FORCE LABEL GENERATION
03F3 BD060C     675:         JSR     REALIZELABEL
                676:         ;LDD    INCLBL  SAVE IT IN THE STACK SO WE GET IT BACK WHEN WE RETURN
03F6 D627       677:         LDAB    INCLBL+1
03F8 9626       678:         LDAA    INCLBL
                679:         ;STD    1,S     THIS IS WHERE IT IS!
03FA 30         680:         TSX
03FB E702       681:         STAB    (1)+1,X
03FD A701       682:         STAA    1,X
                683:         ;LDX    POINTER1        MUST GET PARAMETER LIST LENGTH AGAIN
03FF DE35       684:         LDX     POINTER1
0401 E602       685:         LDAB    2,X     GET THE LIST LENGTH
0403 C47F       686:         ANDB    #$7F    DUMP THE "PASS GEN'D LABEL#" FLAG
0405 2014       687:         BRA     MPARAMS0
                688: 
  0407          689: MPARAMS ;LDX    3,S     SEE IF ANY PARAMETERS (GET THE RETURN METAPC)
0407 30         690:         TSX
0408 EE03       691:         LDX     3,X
040A E601       692:         LDAB    1,X     GET THE METAOP AT THE RETURN ADDRESS
                693:         ;CMPB   #:MPARAMS       AND SEE IF ANY PARAMETERS
040C C138       694:         CMPB    #:MPARAMS
040E 2643       695:         BNE     MPARAMS5        B/ NO
0410 DF35       696:         STX     POINTER1        YES, REMEMBER THE PARAMETER LIST
0412 E602       697:         LDAB    2,X     GET THE LIST LENGTH
0414 2BDD       698:         BMI     MPARAMSL        B/ MUST PASS GENERATED LABEL NUMBER, TOO!
                699:         ;LDX    #0      SET THE INCARNATION LABEL TO 'NONE'
0416 CE0000     700:         LDX     #0
0419 DF26       701:         STX     INCLBL
041B D725       702: MPARAMS0        STAB    NUMSTR  REMEMBER THE LIST LENGTH
                703: *                       BUMP THE RETURN METAPC PAST THE ARG LIST
041D 4F         704:         CLRA            EXTEND LIST LENGTH TO 16 BITS
