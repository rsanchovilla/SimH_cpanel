ASM/6800 1.4A0: 0991 METAM14C.ASM       
08/16/82 00:00:00; Page 80; Form 3      *** SDOS 1.1 DEFINITIONS ***
M.ASM
                  1: 
                  2: *
                  3: *       FILL UP THE INPUT BUFFER (WELL, FILL SOME OF IT, ANYWAY)
                  4: *       ALWAYS READS A FULL LINE SO THAT ERROR PRINT-OUT IS POSSIBLE
                  5: *       THERE ARE TWO CASES:
                  6: *       1) THE FILL POINTER IS < THE EMPTY POINTER
                  7: *               READ EMPTYPOINTER-FILLPOINTER-1 BYTES
                  8: *               INTO THE BUFFER AT FILLPOINTER
                  9: *       2) THE EMPTY POINTER IS <= THE FILL POINTER
                 10: *               READ BUFFEREND-FILLPOINTER BYTES
                 11: *               INTO THE BUFFER AT FILLPOINTER
                 12: *
  0992           13: FILLTHEBUFFER   ;LDD    EMPTYPOINTER    DECIDE WHICH CASE
0992 D63E        14:         LDAB    EMPTYPOINTER+1
0994 963D        15:         LDAA    EMPTYPOINTER
                 16:         ;SUBD   FILLPOINTER
0996 D03C        17:         SUBB    FILLPOINTER+1
0998 923B        18:         SBCA    FILLPOINTER
099A 2505        19:         BCS     FILLTHEBUFFER0  B/ CASE 2
                 20:         ;BNED   FILLTHEBUFFER1  B/ NOPE, CASE 1
099C 2612        21:         BNE     FILLTHEBUFFER1
099E 5D          22:         TSTB
099F 260F        23:         BNE     FILLTHEBUFFER1
                 24: *
                 25: *       CASE 2, FILL TO END OF BUFFER
                 26: *
  09A1           27: FILLTHEBUFFER0  ;LDD    #INPUTBUFFEREND
09A1 C634        28:         LDAB    #(INPUTBUFFEREND)&$FF
09A3 860C        29:         LDAA    #(INPUTBUFFEREND)/256
                 30:         ;SUBD   FILLPOINTER
09A5 D03C        31:         SUBB    FILLPOINTER+1
09A7 923B        32:         SBCA    FILLPOINTER
                 33:         ;LDX    EMPTYPOINTER    WATCH OUT FOR SPECIAL CASE:
09A9 DE3D        34:         LDX     EMPTYPOINTER
09AB 8C0A9E      35:         CPX     #INPUTBUFFER    WE DON'T WANT FILL POINTER TO CATCH UP...
09AE 2604        36:         BNE     FILLTHEBUFFER1A WITH EMPTY POINTER (B/ NOT SPECIAL CASE)
  09B0           37: FILLTHEBUFFER1  ;SUBD   #1      SO THAT FILL POINTER CAN'T CATCH UP WITH THE EMPTY POI
09B0 C001        38:         SUBB    #(1)&$FF
09B2 8200        39:         SBCA    #(1)/256
  09B4           40: FILLTHEBUFFER1A ;STD    FILLBLOCKL




ASM/6800 1.4A0: 09B4 METAM14C.ASM       
08/16/82 00:00:00; Page 81; Form 3      *** SDOS 1.1 DEFINITIONS ***
M.ASM
09B4 F70A30      41:         STAB    FILLBLOCKL+1
09B7 B70A2F      42:         STAA    FILLBLOCKL
                 43:         ;LDX    FILLBLOCKL      HOW MANY BYTES ARE WE REQUESTING ?
09BA FE0A2F      44:         LDX     FILLBLOCKL
09BD 272A        45:         BEQ     FILLTHEBUFFERF  B/ ZERO, BUFFER HAS NO ROOM!
  09BF           46: FILLTHEBUFFER5  ;LDX    FILLPOINTER     TELL HIM WHERE TO PUT IT
09BF DE3B        47:         LDX     FILLPOINTER
09C1 FF0A2D      48:         STX     FILLBLOCKB
                 49:         ;LDX    #FILLBLOCK      NO, GO AHEAD AND READ
09C4 CE0A23      50:         LDX     #FILLBLOCK
                 51:         ;JSR    SYSCALL$
09C7 BD00FB      52:         JSR     SYSCALL$
09CA 2432        53:         BCC     FILLTHEBUFFER2  B/ ALL DONE
09CC 8C03E9      54:         CPX     #ERR:EOFHIT     END OF FILE ENCOUNTERED ?
09CF 2665        55:         BNE     CALLSYSCALL1    B/ NO, I CAN'T HANDLE IT
                 56:         ;LDX    FILLBLOCK+READA:ACTUALCOUNT DID WE GET ANY BYTES ?
09D1 FE0A2B      57:         LDX     FILLBLOCK+READA:ACTUALCOUNT
09D4 2628        58:         BNE     FILLTHEBUFFER2  B/ YES, GET THE HELL OUT OF HERE!
09D6 B60A25      59:         LDAA    SICHANNEL       EOF ON THE PRIMARY INPUT CHANNEL?
                 60:         ;CMPA   #SI
09D9 8102        61:         CMPA    #SI
09DB 2214        62:         BHI     FILLTHEBUFFER4  B/ NO, KEEP GOING
                 63:         ;JSR    PURGEBUFFER     SO IRA CAN SEE HOW FAR WE GOT, EXACTLY...
09DD BD094A      64:         JSR     PURGEBUFFER
                 65:         ;LDX    #M:EOFHIT       WE'RE DEAD
09E0 CE0829      66:         LDX     #M:EOFHIT
  09E3           67: FILLTHEBUFFER5A ;JSR    PRINT   THE ERROR MESSAGE
09E3 BD08B0      68:         JSR     PRINT
                 69:         ;JMP    CROAK1
09E6 7E08CA      70:         JMP     CROAK1
                 71: 
  09E9           72: FILLTHEBUFFERF  ;JSR    PURGEBUFFER     JUST TO BE NICE
09E9 BD094A      73:         JSR     PURGEBUFFER
                 74:         ;LDX    #M:LINETOOLONG  AND I DON'T KNOW WHAT TO DO ABOUT IT...
09EC CE0896      75:         LDX     #M:LINETOOLONG
09EF 20F2        76:         BRA     FILLTHEBUFFER5A SO I'LL STICK YOU WITH THE PROBLEM
                 77: 
09F1 B70A46      78: FILLTHEBUFFER4  STAA    CLOSEIFILECHANNEL
                 79:         ;LDX    #CLOSEIFILE
09F4 CE0A44      80:         LDX     #CLOSEIFILE




