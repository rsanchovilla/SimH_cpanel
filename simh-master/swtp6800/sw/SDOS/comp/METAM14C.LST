                245: *
                246: *       COMPUTEHASH -- COMPUTE POINTER TO HASH BUCKET FOR STRING...
                247: *       (X) POINTS TO STRING BODY; (B) CONTAINS STRING LENGTH
                248: *
0654 D701       249: COMPUTEHASH     STAB    TEMPB   SAVE COUNT
0656 4F         250:         CLRA
                251: *       CLC             (PREVIOUS INSTRUCTION DID THIS)
0657 48         252: HASH    ASLA            SHIFT THE BITS AROUND TO HELP GARBLE THINGS
                253:         ;LDB    ,X+     GET THE NEXT STRING BYTE
0658 E600       254:         LDAB    0,X
065A 08         255:         INX
065B C45F       256:         ANDB    #%01011111      DROP UPPER/LOWER CASE BIT
065D C900       257:         ADCB    #0      FEED BACK SHIFTED OUT MSB (CAN'T CARRY OUT!
065F 1B         258:         ABA             SUM SHIFTED HASH AND NEW CHARACTER
0660 8C0C34     259:         CPX     #INPUTBUFFEREND (NOTE: THIS DESTROYS C BIT ON 6809!)
0663 2603       260:         BNE     HASH1
                261:         ;LDX    #INPUTBUFFER
0665 CE0A9E     262:         LDX     #INPUTBUFFER
  0668          263: HASH1   ;DEC    TEMPB   DOWN COUNT # BYTES NOT HASHED YET
0668 7A0001     264:         DEC     TEMPB
066B 26EA       265:         BNE     HASH
                266:         ;TFR    A,B     TO MAKE FOLLOWING CODE EFFICIENT ON '09
066D 16         267:         TAB
066E C41F       268:         ANDB    #$1F    CHOP TO 32 BUCKETS
0670 58         269:         ASLB            BUCKET NUMBER * 2
0671 4F         270:         CLRA            MAKE UNSIGNED 16 BIT OFFSET
                271:         ;ADDD   #HASHTABLE-STRINGNODE:NEXT
0672 CB5B       272:         ADDB    #(HASHTABLE-STRINGNODE:NEXT)&$FF
0674 890A       273:         ADCA    #(HASHTABLE-STRINGNODE:NEXT)/256
                274:         ;STD    TOKENPOINTER
0676 D730       275:         STAB    TOKENPOINTER+1
0678 972F       276:         STAA    TOKENPOINTER
067A 39         277:         RTS




