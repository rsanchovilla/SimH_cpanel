096C 27F8       602:         BEQ     GETTOKENCHAR0   B/ YES, GO GET SOME MORE!
                603:         ;LDA    ,X+
096E A600       604:         LDAA    0,X
0970 08         605:         INX
0971 8C0C34     606:         CPX     #INPUTBUFFEREND
0974 2603       607:         BNE     GETTOKENCHAR2
                608:         ;LDX    #INPUTBUFFER
0976 CE0A9E     609:         LDX     #INPUTBUFFER
0979 DF3F       610: GETTOKENCHAR2   STX     SCANPOINTER
097B 39         611:         RTS
                612: *
