08/16/82 00:00:00; Page 82; Form 3      *** SDOS 1.1 DEFINITIONS ***
M.ASM
09F7 8D38        81:         BSR     CALLSYSCALL
                 82:         ;DEC    SICHANNEL
09F9 7A0A25      83:         DEC     SICHANNEL
09FC 20C1        84:         BRA     FILLTHEBUFFER5
                 85: 
  09FE           86: FILLTHEBUFFER2  ;LDD    FILLPOINTER     UPDATE THE FILL POINTER
09FE D63C        87:         LDAB    FILLPOINTER+1
0A00 963B        88:         LDAA    FILLPOINTER
                 89:         ;ADDD   FILLBLOCK+READA:ACTUALCOUNT
0A02 FB0A2C      90:         ADDB    FILLBLOCK+READA:ACTUALCOUNT+1
0A05 B90A2B      91:         ADCA    FILLBLOCK+READA:ACTUALCOUNT
                 92:         ;STD    FILLPOINTER
0A08 D73C        93:         STAB    FILLPOINTER+1
0A0A 973B        94:         STAA    FILLPOINTER
                 95:         ;LDX    FILLPOINTER
0A0C DE3B        96:         LDX     FILLPOINTER
0A0E 09          97:         DEX             SEE IF LAST CHARACTER READ IS <CR>
0A0F A600        98:         LDAA    0,X     GRAB LAST CHARACTER READ FOR LATER INSPECTION
0A11 8C0C33      99:         CPX     #INPUTBUFFEREND-1
0A14 2605       100:         BNE     FILLTHEBUFFER3
                101:         ;LDX    #INPUTBUFFER
0A16 CE0A9E     102:         LDX     #INPUTBUFFER
0A19 DF3B       103:         STX     FILLPOINTER
  0A1B          104: FILLTHEBUFFER3 ; NOW CHECK THAT A COMPLETE LINE HAS BEEN READ
                105:         ;CMPA   #ASCII:CR
0A1B 810D       106:         CMPA    #ASCII:CR
0A1D 2601       107:         BNE     FILLTHEBUFFERBRA        B/ DIDN'T READ COMPLETE LINE, READ ANOTHER CHU
0A1F 39         108:         RTS             NEXT TIME, I'LL HANDLE ANY EOF
  0A20          109: FILLTHEBUFFERBRA
                110:         ;JMP    FILLTHEBUFFER   B/ DIDN'T READ COMPLETE LINE, READ ANOTHER CHUNK
0A20 7E0992     111:         JMP     FILLTHEBUFFER
                112: *
0A23 0A         113: FILLBLOCK       FCB     SYSCALL:READA   SYSCALL OPCODE
0A24 0E         114:         FCB     READA:SCLEN     LENGTH OF SYSCALL BLOCK
0A25 02         115: SICHANNEL       FCB     SI      CONSOLE INPUT CHANNEL
0A26 01         116:         FCB     1       LINE INPUT MODE
0A27 0000       117:         FDB     IGNORED WRITE BUFFER
0A29 0000       118:         FDB     IGNORED WRITE BUFFER LENGTH
0A2B 0000       119:         FDB     CHANGED ACTUAL # OF BYTES READ
0A2D 0000       120: FILLBLOCKB      FDB     0       READ BUFFER




