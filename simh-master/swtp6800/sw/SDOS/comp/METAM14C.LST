                452:         ;LDX    METAPC  GET A CHAR FROM THE META STRING
0317 DE20       453:         LDX     METAPC
0319 08         454:         INX
031A DF20       455:         STX     METAPC
                456:         ;CMPA   0,X
031C A100       457:         CMPA    0,X
031E 27F4       458:         BEQ     MTEST1  B/ MATCHED SO FAR, KEEP GOING
                459:         ;CMPA   #'a     DIDN'T MATCH, PERHAPS CASE IS INCORRECT
0320 8161       460:         CMPA    #'a
0322 2D0A       461:         BLT     MTEST1A B/ STRINGS DON'T MATCH
                462:         ;CMPA   #'z     ...(checking for lower case)
0324 817A       463:         CMPA    #'z
0326 2E06       464:         BGT     MTEST1A B/ STRINGS DON'T MATCH
0328 8020       465:         SUBA    #'a-'A  CONVERT TO UPPER CASE
                466:         ;CMPA   0,X     MATCH AGAINST STRING ?
032A A100       467:         CMPA    0,X
032C 27E6       468:         BEQ     MTEST1  B/ MATCHED SO FAR, KEEP GOING
032E E600       469: MTEST1A LDAB    0,X     WAS THIS THE LAST CHAR?
0330 2A07       470:         BPL     MTEST2  B/ NOPE, NO MATCH
0332 C47F       471:         ANDB    #$7F    YES, COMPARE IT AGAIN
0334 11         472:         CBA
0335 270C       473:         BEQ     MTEST3  B/ STRING MATCHES
0337 2005       474:         BRA     MTEST2A
                475: 
0339 08         476: MTEST2  INX
033A A600       477:         LDAA    0,X
033C 2AFB       478:         BPL     MTEST2  B/ NOT DONE YET
033E 08         479: MTEST2A INX             FAILED TO MATCH
033F DF20       480:         STX     METAPC
0341 2083       481:         BRA     FAILRETURN




