                355:         ;LDX    KEYWORDCHAIN    NOW, ADD ALL THE KEYWORDS...
0BA5 FE0C8B     356:         LDX     KEYWORDCHAIN
0BA8 2733       357:         BEQ     MINITDONE       (B/ NO KEYWORDS!)
0BAA DF39       358: KEYWORDINSERT   STX     SAVEX   TO THE TOKEN DICTIONARY
0BAC E605       359:         LDAB    STRINGNODE:KEYLEN,X
                360:         ;LEAX   STRINGNODE:BODY,X
  0000          361:         IF      STRINGNODE:BODY<0
 *S*            362:         RPT     -STRINGNODE:BODY
 *S*            363:         DEX
                364:         ELSE
  0006          365:         RPT     STRINGNODE:BODY
0BAE 08         366:         INX
                367:         FIN
0BB4 C47F       368:         ANDB    #$7F    MASK OFF "KEYWORD" BIT
                369:         ;JSR    COMPUTEHASH     FIGURE OUT THE PROPER BUCKET
0BB6 BD0654     370:         JSR     COMPUTEHASH
                371:         ;LDX    SAVEX   MAKE THIS KEYWORD POINT TO REST OF BUCKET C
0BB9 DE39       372:         LDX     SAVEX
                373:         ;LDD    STRINGNODE:NEXT,X (AHA! FIRST, FIGURE OUT WHERE NEXT KEYWORD
0BBB E604       374:         LDAB    (STRINGNODE:NEXT)+1,X
0BBD A603       375:         LDAA    STRINGNODE:NEXT,X
                376:         ;STD    TEMPX
0BBF D701       377:         STAB    TEMPX+1
0BC1 9700       378:         STAA    TEMPX
                379:         ;LDX    TOKENPOINTER    (THIS IS SET BY COMPUTEHASH)
0BC3 DE2F       380:         LDX     TOKENPOINTER
                381:         ;LDD    STRINGNODE:NEXT,X
0BC5 E604       382:         LDAB    (STRINGNODE:NEXT)+1,X
0BC7 A603       383:         LDAA    STRINGNODE:NEXT,X
                384:         ;LDX    SAVEX
0BC9 DE39       385:         LDX     SAVEX
                386:         ;STD    STRINGNODE:NEXT,X
0BCB E704       387:         STAB    (STRINGNODE:NEXT)+1,X
0BCD A703       388:         STAA    STRINGNODE:NEXT,X
                389:         ;LDX    TOKENPOINTER    MAKE BUCKET HEAD POINT TO KEYWORD MODE
0BCF DE2F       390:         LDX     TOKENPOINTER
                391:         ;LDD    SAVEX




