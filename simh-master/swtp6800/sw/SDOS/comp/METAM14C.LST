0BD1 D63A       392:         LDAB    SAVEX+1
0BD3 9639       393:         LDAA    SAVEX
                394:         ;STD    STRINGNODE:NEXT,X
0BD5 E704       395:         STAB    (STRINGNODE:NEXT)+1,X
0BD7 A703       396:         STAA    STRINGNODE:NEXT,X
                397:         ;LDX    TEMPX   NOW, GET NEXT KEYWORD ADDRESS AND GO INSERT
