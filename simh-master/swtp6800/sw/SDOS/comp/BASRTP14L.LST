2EF7 09         798: FINT5              DEX
2EF8 EA06       799:                    ORAB    6,X             (B) <>0 --> FRACTION
                800:                    ;CLR    6,X             ZERO FRACTIONAL PART
2EFA 6F06       801:                    CLR     6,X
2EFC 4A         802:                    DECA
2EFD 26F8       803:                    BNE     FINT5
                804:                    ;LDA    MSIGN           IF <0 AND FRACTIONAL PART, SUBTRACT 1
2EFF 96AE       805:                    LDAA    MSIGN
2F01 2AEB       806:                    BPL     FINT3           # IS POSITIVE
2F03 5D         807:                    TSTB
2F04 27E8       808:                    BEQ     FINT3           # IS NEGATIVE, BUT NO FRACTION, DONE
                809:                    ;LDX    #FMONE          SIGH..., SUBTRACT 1 FROM #
2F06 CE2375     810:                    LDX     #FMONE
                811:                    ;JSR    FLOAD
2F09 BD2999     812:                    JSR     FLOAD
                813:                    ;JSR    FADD            SUBTRACT 1, NO OVERFLOW POSSIBLE
2F0C BD278F     814:                    JSR     FADD
2F0F 20DD       815:                    BRA     FINT3




ASM/6800 1.4A0: 2F0F RTP6800V1.4l       SD BASIC Version 1.4l Runtime Package (c) 1980 Software Dynamics
08/16/82 00:00:00; Page 353; Form 16    BINARY VALUE TO/FROM STRING CONVERSION ROUTINES
RTP.ASM
                  2: *                  <OPBVAL>
                  3: *
                  4: *                  TOS CONTAINS STRING DESCRIPTOR FOR STRING OF LENGTH 0 TO 4
                  5: *                  RETURNS VALUE OF STRING BYTES ZERO PADDED TO 4 BYTES
                  6: *
  2F11            7: XOPBVAL ; EXECUTE <OPBVAL> OPCODE
                  8:                    ;LEAS   2,S             THROW AWAY STRING DESCRIPTOR TAG
  0000            9:                    IF      2<0
 *S*             10:                    RPT     -2
 *S*             11:                    DES
                 12:                    ELSE
  0002           13:                    RPT     2
2F11 31          14:                    INS
2F12 31
                 15:                    FIN
                 16:                    ;PULX                   GET STRING ADDRESS
2F13 30          17:                    TSX
2F14 EE00        18:                    LDX     0,X
2F16 31          19:                    INS
2F17 31          20:                    INS
                 21:                    ;PULD                   GET STRING COUNT
2F18 32          22:                    PULA
2F19 33          23:                    PULB
                 24:                    ;CMPD   #$FFFF          = "THE ENTIRE STRING" ?
2F1A 81FF        25:                    CMPA    #($FFFF)/256
2F1C 2602        26:                    BNE     MACRO:0011
2F1E C1FF        27:                    CMPB    #($FFFF)&$FF
  2F20           28: MACRO:0011
2F20 2604        29:                    BNE     XOPBVAL1        B/ NO, TRUE COUNT IN (D)
                 30:                    ;LDD    CURLEN,X        YES, FETCH CURRENT LENGTH OF STRING
2F22 E603        31:                    LDAB    (CURLEN)+1,X
2F24 A602        32:                    LDAA    CURLEN,X
  2F26           33: XOPBVAL1 ; (D) HAS ACTUAL STRING SIZE, (X) POINTS TO STRING HEAD
  0001           34:                    IF      M6800!M6801
2F26 4D          35:                    TSTA                     >255 BYTES ?
2F27 263B        36:                    BNE     XOPBVALERR      B/ YES, CAN'T TAKE VALUE
                 37:                    ;CMPB   #5               >=5 BYTES ?
2F29 C105        38:                    CMPB    #5
                 39:                    ;BHS    XOPBVALERR      B/ YES, CAN'T TAKE VALUE
2F2B 2437        40:                    BCC     XOPBVALERR
  0001           41:                    ELSE    (M6809)
 *S*             42:                    ;CMPD   #5              STRINGS EQUAL OR LARGER THAN THIS ARE UNACCEPTABLE
 *S*             43:                    CMPA    #(5)/256
 *S*             44:                    BNE     MACRO:0012
 *S*             45:                    CMPB    #(5)&$FF
 *S*             46: MACRO:0012
 *S*             47:                    ;BHS    XOPBVALERR      B/ STRING IS TOO LONG
 *S*             48:                    BCC     XOPBVALERR
                 49:                    FIN
                 50:                    ;TFR    B,A              SAVE STRING LENGTH IN (A)
2F2D 17          51:                    TBA
                 52:                    ;LEAX   STRING,X        SO (X) POINTS TO MS BYTE OF STRING VALUE
  0000           53:                    IF      STRING<0
 *S*             54:                    RPT     -STRING
 *S*             55:                    DEX




ASM/6800 1.4A0: 2F2D RTP6800V1.4l       SD BASIC Version 1.4l Runtime Package (c) 1980 Software Dynamics
08/16/82 00:00:00; Page 354; Form 16    BINARY VALUE TO/FROM STRING CONVERSION ROUTINES
RTP.ASM
                 56:                    ELSE
  0004           57:                    RPT     STRING
2F2E 08          58:                    INX
2F2F 08
2F30 08
2F31 08
                 59:                    FIN
                 60:                    ;ABX                     NOW (X) POINTS TO LS BYTE OF STRING VALUE, +1
2F32 DF00        61:                    STX     TEMPX
2F34 DB01        62:                    ADDB    TEMPB
2F36 D701        63:                    STAB    TEMPB
2F38 D600        64:                    LDAB    TEMPA
2F3A C900        65:                    ADCB    #0
2F3C D700        66:                    STAB    TEMPA
2F3E DE00        67:                    LDX     TEMPX
2F40 9700        68:                    STAA    TEMPA            SAVE SIZE OF STRING
2F42 2707        69:                    BEQ     XOPBVAL3        B/ ZERO LENGTH, GO PUSH ZERO FILLER BYTES
  2F44           70: XOPBVAL2 ; PUSH STRING CONTENT ONTO STACK
                 71:                    ;LDB    ,-X              FETCH BYTE OF STRING TO PUSH
2F44 09          72:                    DEX
2F45 E600        73:                    LDAB    0,X
2F47 37          74:                    PSHB                     PUSH ONTO STACK
2F48 4A          75:                    DECA                     PUSHED ALL OF STRING YET ?
2F49 26F9        76:                    BNE     XOPBVAL2        B/ NO, GO PUSH SOME MORE
  2F4B           77: XOPBVAL3 ; STRING CONTENT PUSHED, NOW NEED TO ZERO FILL TO 4 BYTES
2F4B 9600        78:                    LDAA    TEMPA            GET STRING LENGTH
2F4D 8004        79:                    SUBA    #4               = - # ZEROS TO PUSH
2F4F 2705        80:                    BEQ     XOPBVAL5        B/ 4 BYTES ALREADY PUSHED
2F51 5F          81:                    CLRB                    MAKE A ZERO BYTE TO PUSH
  2F52           82: XOPBVAL4 ; PUSH A ZERO BYTE UNTIL TOTAL OF 4 BYTES PUSHED
2F52 37          83:                    PSHB                    PUSH A ZERO BYTE
2F53 4C          84:                    INCA                    DECREMENT # ZEROS TO PUSH
2F54 26FC        85:                    BNE     XOPBVAL4        B/ MORE TO PUSH
  2F56           86: XOPBVAL5 ; 32 BIT INTEGER VALUE NOW ON TOS
                 87:                    ;JSR    FLOAT            GO FLOAT THE ANSWER
2F56 BD2CF0      88:                    JSR     FLOAT
                 89:                    ;JMP    NTRPT2          DONE
2F59 7E02EF      90:                    JMP     NTRPT2




ASM/6800 1.4A0: 2F59 RTP6800V1.4l       SD BASIC Version 1.4l Runtime Package (c) 1980 Software Dynamics
08/16/82 00:00:00; Page 355; Form 16    BINARY VALUE TO/FROM STRING CONVERSION ROUTINES
RTP.ASM
                 92: *                  <OPBSTR>
                 93: *
                 94: *                  TOS CONTAINS NUMERIC VALUE
                 95: *                  CONVERTS TO 4 BYTE STRING VALUE CONTAINING 32 BIT INTEGER
                 96: *
  2F5C           97: XOPBSTR            ;JSR    FORCEFLOAT      FORCE FLOATING POINT VALUE
2F5C BD1C80      98:                    JSR     FORCEFLOAT
                 99:                    ;JSR    FIX              FORCE TO 32 BIT FORMAT
2F5F BD2BEB     100:                    JSR     FIX
2F62 2004       101:                    BRA     XOPBSTR1        B/ RANGE IS OK
  2F64          102: XOPBVALERR ; STRING SIZE TOO LARGE FOR <OPBVAL> OPCODE
                103:                    ;JSR    RTPERR
2F64 BD15BA     104:                    JSR     RTPERR
2F67 07         105:                    :CONVER                 CAN'T CONVERT NUMBER
                106: 
  2F68          107: XOPBSTR1           ;PULD                   COPY STRING TO OUTPUT BUFFER AREA
2F68 32         108:                    PULA
2F69 33         109:                    PULB
                110:                    ;STD    OUTBUF
2F6A D796       111:                    STAB    OUTBUF+1
2F6C 9795       112:                    STAA    OUTBUF
                113:                    ;PULD
2F6E 32         114:                    PULA
2F6F 33         115:                    PULB
                116:                    ;STD    OUTBUF+2
2F70 D798       117:                    STAB    OUTBUF+2+1
2F72 9797       118:                    STAA    OUTBUF+2
2F74 8604       119:                    LDAA    #4               = SIZE OF RESULTING STRING
                120:                    ;JMP    NUM2             PUSH STRING DESCRIPTOR FOR 4 BYTES IN OUTBUF
2F76 7E1C70     121:                    JMP     NUM2
                122: 
  2F79          123: BASICRTPEND$       EQU     *




ASM/6800 1.4A0: 2F76 RTP6800V1.4l       SD BASIC Version 1.4l Runtime Package (c) 1980 Software Dynamics
08/16/82 00:00:00; Page 356; Form 17    BINARY VALUE TO/FROM STRING CONVERSION ROUTINES
RTP.ASM
  3000            1:                    ORG     (*//256)*256    SKIP UP TO NEXT PAGE BOUNDARY
                  2: *                  CHAIN AND GO
                  3: *                  MODELS THE FOLLOWING BASIC PROGRAM:
                  4: *                          DIM PROGRAM$(50)
                  5: *                          INPUT '' PROGRAM$
                  6: *                          CHAIN PROGRAM$
                  7: *                          END
                  8: *
  3000            9: CHAINGO            ;JSR    $100            OFF TO THE RTP!
3000 BD0100      10:                    JSR     $100
3003 14          11:                    +VERSION                 VERSION NUMBER
3004 0000        12:                    #0                      FREF LABEL CHAIN
3006 0100        13:                    #$100                   CAT BUF SIZE REQUIRED (FOR INPUT LINE)
3008 3012        14:                    #CHAINGOEND             BASE OF SCALAR VARS (USELESS, HERE!)
300A 3012        15:                    #CHAINGOEND              TOP OF DATA SPACE
300C 69          16:                    OPZCHN                  ZERO THE CHANNEL NUMBER
300D 4E          17:                    OPINL                   INPUT A LINE FROM THE KEYBOARD
300E 3010        18:                    #:1                     WHERE TO GO IF EOF ERROR
3010 3E          19: :1                 OPINS                   PUSH DESCRIPTOR FOR INPUT STRING
3011 61          20:                    OPCHAIN                 AND CHAIN TO IT!
  3012           21: CHAINGOEND         EQU     *
                 22:                    END     CHAINGO




