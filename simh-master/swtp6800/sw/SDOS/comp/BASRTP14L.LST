26D3 9BC1       770:                    ADDA    MINUSDIVISORDIGIT GENERATE 8TH QUOTIENT BIT
                771: *                  BCS     *+4             WE DON'T CARE ABOUT REMAINDER,
                772: *                  SUBA    MINUSDIVISORDIGIT SO DON'T BOTHER WITH THESE
26D5 59         773:                    ROLB                    SHIFT IN LAST QUOTIENT BIT
                774: *                  ROLA                    WE DON'T NEED THIS AT ALL...
26D6 2604       775:                    BNE     GUESSD2         B/ DIGIT IS NONZERO
                776:                    ;STB    ,X+             STORE QUOTIENT DIGIT OF ZERO
26D8 E700       777:                    STAB    0,X
26DA 08         778:                    INX
26DB 39         779:                    RTS




