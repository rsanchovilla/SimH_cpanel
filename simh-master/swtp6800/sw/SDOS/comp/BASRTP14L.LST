RTP.ASM
                683: *                  MAKEBOTHLOGICAL -- FORCE BOTH OPERANDS TO 16 BIT INTEGER FORM
                684: *                  OR CAUSE ERROR
                685: *
  0678          686: MAKEBOTHLOGICAL    EQU     *               FORCE BOTH OPERANDS TO BE "LOGICAL" OR ERROR
                687:                    ;PULD                   GET RETURN ADDRESS
0678 32         688:                    PULA
0679 33         689:                    PULB
                690:                    ;STD    RTPRET          AND SAVE IT
067A D765       691:                    STAB    RTPRET+1
067C 9764       692:                    STAA    RTPRET
067E 8D17       693:                    BSR     FIXTOS          MAKE SURE TOS IS FIXED
                694:                    ;LDA    R2TYPE,S        CHECK OUT TOS-1
0680 30         695:                    TSX
0681 A606       696:                    LDAA    R2TYPE,X
0683 270E       697:                    BEQ     MAKEBOTHLOGICAL2 B/ TOS-1 IS FIXED ALREADY!
                698:                    ;LDX    #OPPOLYARG      SIGH... SAVE TOS SOMEWHERE SAFE
0685 CE007E     699:                    LDX     #OPPOLYARG
                700:                    ;JSR    FSTORE
0688 BD23D3     701:                    JSR     FSTORE
068B 8D0A       702:                    BSR     FIXTOS          FORCE OLD TOS-1 TO BE INTEGER
                703:                    ;LDX    #OPPOLYARG      GET OLD TOS BACK
068D CE007E     704:                    LDX     #OPPOLYARG
                705:                    ;JSR    FLOAD
0690 BD2999     706:                    JSR     FLOAD
  0693          707: MAKEBOTHLOGICAL2   EQU     *
                708:                    ;JMP    [RTPRET]        AND EXIT
0693 DE64       709:                    LDX     RTPRET
0695 6E00       710:                    JMP     0,X




ASM/6800 1.4A0: 0695 RTP6800V1.4l       SD BASIC Version 1.4l Runtime Package (c) 1980 Software Dynamics
08/16/82 00:00:00; Page 89; Form 3      *****  A R I T H M E T I C   G R O U P  *****
RTP.ASM
                712: *                  FIXTOS -- CONVERTS TOS TO 16 BIT INTEGER FORM
                713: *                  CAUSES ERROR IF NOT CONVERTABLE
                714: *
  0697          715: FIXTOS             EQU     *
                716:                    ;LDA    R1TYPE+2,S      IS IT ALREADY INTEGER ?
