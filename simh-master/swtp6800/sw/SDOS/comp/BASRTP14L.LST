0452 E608      1220:                    LDAB    (RTP:TOPOFDATASPACE)+1,X
0454 A607      1221:                    LDAA    RTP:TOPOFDATASPACE,X
               1222:                    ;SUBD   CATBUF
0456 D0E7      1223:                    SUBB    CATBUF+1
0458 92E6      1224:                    SBCA    CATBUF
045A 2417      1225:                    BCC     DATASPACEERROR
               1226:                    ;LDD    BPC
045C D62F      1227:                    LDAB    BPC+1
045E 962E      1228:                    LDAA    BPC
