                581: *
                582: *                  NOW "NORMALIZE" THE DIVISOR (I.E., MAKE MSD >= 50; SEE KNUTH)
                583: *
                584:                    ;LDA    MS2             MSD OF DIVISOR (<>0 BECAUSE THIS IS F.P.)
2613 96BC       585:                    LDAA    MS2
                586:                    ;CMPA   #100/2          IS DIVISOR NORMALIZED ?
2615 8132       587:                    CMPA    #100/2
2617 242B       588:                    BCC     FDIVGN          B/ YES, GO DO THE DIVIDE!
  0001          589:                    IF      M6800!M6801
                590:                    ;STA    TEMPB           NO, LOOK NORMALIZATION MULTIPLIER UP IN THE TABLE
2619 9701       591:                    STAA    TEMPB
                592:                    ;LDA    #FDIVNORM/256
261B 8625       593:                    LDAA    #FDIVNORM/256
                594:                    ;STA    TEMPA
261D 9700       595:                    STAA    TEMPA
                596:                    ;LDX    TEMPX
261F DE00       597:                    LDX     TEMPX
                598:                    ;LDA    FDIVNORM&$FF,X
2621 A690       599:                    LDAA    FDIVNORM&$FF,X
  0001          600:                    ELSE    (M6809)
 *S*            601:                    ;LDX    #FDIVNORM       GET ADDRESS OF NORMALIZING MULTIPLIER TABLE
 *S*            602:                    LDX     #FDIVNORM
 *S*            603:                    ;LDA    A,X             FETCH NORMALIZING MULTIPLIER
 *S*            604:                    LDAA    A,X
                605:                    FIN
                606:                    ;STA    ML              SAVE MULTIPLICATIVE FACTOR
2623 97A7       607:                    STAA    ML
                608:                    ;LDX    #MS6            MULTIPLY DIVISOR BY (ML)
2625 CE00C0     609:                    LDX     #MS6
2628 4F         610:                    CLRA                    ZERO CARRY INTO FIRST DIGIT
2629 8D9D       611:                    BSR     FDIVNORMDIGIT   GAURANTEES MSD DIVISOR >= 100/2
262B 8D9B       612:                    BSR     FDIVNORMDIGIT   SINCE BOTH DIVISOR AND DIVIDEND ARE MULTIPLIED...
262D 8D99       613:                    BSR     FDIVNORMDIGIT   BY SAME VALUE, THE QUOTIENT REMAINS THE SAME
262F 8D97       614:                    BSR     FDIVNORMDIGIT
2631 8D95       615:                    BSR     FDIVNORMDIGIT
                616:                    ;LDX    #FAC6           MULTIPLY DIVIDENT BY NORMALIZING FACTOR
2633 CE00B5     617:                    LDX     #FAC6
                618: *                  ASSERT (A)=0 HERE BECAUSE WE NORMALIZED MULTIPLIER
2636 8D90       619:                    BSR     FDIVNORMDIGIT
2638 8D8E       620:                    BSR     FDIVNORMDIGIT
263A 8D8C       621:                    BSR     FDIVNORMDIGIT
263C 8D8A       622:                    BSR     FDIVNORMDIGIT
263E 8D88       623:                    BSR     FDIVNORMDIGIT
                624:                    ;STA    FAC1            NEW MSD OF FAC (MAY BE NON-ZERO)
2640 97B0       625:                    STAA    FAC1
                626:                    ;LDA    MS2             GRAB MSD OF DIVISOR
2642 96BC       627:                    LDAA    MS2
2644 40         628: FDIVGN             NEGA                    COMPUTE NEGATIVE FOR USE IN GUESS QUOTIENT DIGIT ROUTINE
                629:                    ;STA    MINUSDIVISORDIGIT
2645 97C1       630:                    STAA    MINUSDIVISORDIGIT
                631:                    ;LDX    #FAC1           WHERE TO PLACE 1ST QUOTIENT DIGIT
2647 CE00B0     632:                    LDX     #FAC1




