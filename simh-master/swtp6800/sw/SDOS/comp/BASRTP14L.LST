                142:                    ;LDB    #RSESIZ*2       = # BYTES TO PULL OFF THE STACK
169B C60C       143:                    LDAB    #RSESIZ*2
  169D          144: STORESTEPANDLIMITL EQU     *
169D 32         145:                    PULA                    NOT WORTH OPTIMIZING BECAUSE WE ARE TIGHT ON SPACE
                146:                    ;STA    ,X+
169E A700       147:                    STAA    0,X
16A0 08         148:                    INX
16A1 5A         149:                    DECB
16A2 26F9       150:                    BNE     STORESTEPANDLIMITL YOU FIGURE IT OUT
  0001          151:                    ELSE    (M6809)
 *S*            152:                    ;LDB    #RSESIZ         = # WORDS TO PULL OFF THE STACK
 *S*            153:                    LDAB    #RSESIZ
 *S*            154: STORESTEPANDLIMITL EQU     *
 *S*            155:                    PULS    U               WORTH OPTIMIZING ON 6809 BECAUSE OPTIMIZATION IS FREE
 *S*            156:                    STU     ,X++
 *S*            157:                    DECB
 *S*            158:                    BNE     STORESTEPANDLIMITL YOU FIGURE IT OUT
                159:                    FIN
  0001          160:                    IF      M6800!M6801
                161:                    ;JMP    [RTPRET]
16A4 DE64       162:                    LDX     RTPRET
16A6 6E00       163:                    JMP     0,X
  0001          164:                    ELSE    (M6809)
 *S*            165:                    ;JMP    ,Y
 *S*            166:                    JMP     
                167:                    FIN
