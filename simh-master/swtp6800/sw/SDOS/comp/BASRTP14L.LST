  0001            1:                    IF      M6800!M6801
  0022            2: FROMPOINTER        EQU     SCRATCHPAD+2
  0020            3: TOPOINTER          EQU     SCRATCHPAD+0
  0024            4: BLOCKMOVEX         EQU     SCRATCHPAD+4    TEMP HOLDING AREA
  0026            5: LIMIT              EQU     SCRATCHPAD+6
                  6: 
  0F3D            7: BLOCKMOVEDOWNS     ;LEAX   STRING,X        MOVE STRING, COMPUTE POINTER TO 1ST BYTE
  0000            8:                    IF      STRING<0
 *S*              9:                    RPT     -STRING
 *S*             10:                    DEX
                 11:                    ELSE
  0004           12:                    RPT     STRING
0F3D 08          13:                    INX
0F3E 08
0F3F 08
0F40 08
                 14:                    FIN
                 15: *
                 16: *                  BLOCKMOVEDOWN -- MOVE BLOCK AT (X) TO (Y) FOR (D) BYTES
                 17: *                  (Y) = SCRATCHPAD LOCATION ZERO
                 18: *                  COPIES LARGE BLOCKS AT 17uS. PER BYTE FOR 1Mhz 6800
                 19: *                  FOR 6801, LARGE BLOCKS MOVED AT RATE OF 8uS. PER BYTE
                 20: *                  ASSUMES THAT COPY-TO REGION DOES NOT OVERLAP COPY-FROM REGION
                 21: *                  OR THAT "FROM" >= "TO"
                 22: *
  0F41           23: BLOCKMOVEDOWN      EQU     *
0F41 DF22        24:                    STX     FROMPOINTER     SAVE WHERE TO COPY FROM
                 25:                    ;ADDD   FROMPOINTER     COMPUTE ADDRESS OF BYTE PAST END OF FROM RE
0F43 DB23        26:                    ADDB    FROMPOINTER+1
0F45 9922        27:                    ADCA    FROMPOINTER
                 28:                    ;STD    LIMIT           SAVE AS LIMIT ADDRESS
0F47 D727        29:                    STAB    LIMIT+1
0F49 9726        30:                    STAA    LIMIT
0F4B D023        31:                    SUBB    FROMPOINTER+1   (B):= COUNT MOD 256
0F4D C403        32:                    ANDB    #%00000011      GOING TO MOVE TO A MULTIPLE OF 4 BYTES ?
0F4F 2711        33:                    BEQ     BLOCKMOVEDOWNA  B/ YES
                 34: *
                 35: *                  MOVE 1 BYTE AT A TIME UNTIL A MULTIPLE OF 4 BYTES TO MOVE REMAINS
                 36: *                  COPY RATE = 43uS. PER BYTE
                 37: *
  0F51           38: BLOCKMOVEDOWN1     ;LDA    ,X+             FETCH BYTE FROM FROM AREA
0F51 A600        39:                    LDAA    0,X
0F53 08          40:                    INX
0F54 DF22        41:                    STX     FROMPOINTER
                 42:                    ;LDX    TOPOINTER       STORE BYTE INTO "TO" AREA
0F56 DE20        43:                    LDX     TOPOINTER
                 44:                    ;STA    ,X+
0F58 A700        45:                    STAA    0,X
0F5A 08          46:                    INX
0F5B DF20        47:                    STX     TOPOINTER
                 48:                    ;LDX    FROMPOINTER     GET SET FOR NEXT LOOP ITERATION
0F5D DE22        49:                    LDX     FROMPOINTER
0F5F 5A          50:                    DECB                    DOWN COUNT # BYTES LEFT MOVE, 1 AT A TIME
0F60 26EF        51:                    BNE     BLOCKMOVEDOWN1  B/ MOVE SOME MORE THIS WAY
  0F62           52: BLOCKMOVEDOWNA     ;LDB    FROMPOINTER+1   DO WE STILL HAVE TO MOVE A MULTIPLE OF 16 BYTES




ASM/6800 1.4A0: 0F62 RTP6800V1.4l       SD BASIC Version 1.4l Runtime Package (c) 1980 Software Dynamics
08/16/82 00:00:00; Page 159; Form 6     *****  S T O R E  *****
