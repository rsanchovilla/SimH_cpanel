ASM/6800 1.4A0: 0000 RTP6800V1.4l       SD BASIC Version 1.4l Runtime Package (c) 1980 Software Dynamics
08/16/82 00:00:00; Page 3; Form 1       *** SDOS 1.1 DEFINITIONS ***
SDOSUSERDEFS.ASM
                  2: *       SDOS 1.1 DEFINITIONS FILE (AS OF 8/16/82)
                  3: *
  0011            4: SDOSVERSION     EQU     $11     1.1 IN HEX
                  5: *
                  6: *
                  7: *       The Definitions are broken into 3 parts:
                  8: *               A) THOSE NEEDED TO ASSEMBLE SDOS PROPER OR SYSTEM PROGRAMS
                  9: *               B) THOSE NEEDED TO BUILD AN I/O PACKAGE (A SUBSET OF "A")
                 10: *               C) THOSE NEEDED BY EVERYDAY USER PROGRAMS (A SUBSET OF "B")
                 11: *
  00FB           12: SYSCALL$        EQU     $FB     JMP TO SDOS; RESERVED SYSCALL ENTRY POINT
                 13: *       CONTENTS OF ($FC,$FD) POINTS TO END OF USER RAM
                 14: *       CONTENTS OF ($FE,$FF) ARE SACRED; THEY BELONG TO THE ROM




ASM/6800 1.4A0: 0000 RTP6800V1.4l       SD BASIC Version 1.4l Runtime Package (c) 1980 Software Dynamics
08/16/82 00:00:00; Page 4; Form 1       *** SDOS 1.1 DEFINITIONS ***
SDOSUSERDEFS.ASM
                 16: *       SYSCALL$ OPCODE DEFINITIONS
                 17: *
  0000           18:         ORG     0
0000 0001        19: SYSCALL:OPEN    RMB     1       OPEN FILE
0001 0001        20: SYSCALL:CREATE  RMB     1       CREATE A NEW FILE
0002 0001        21: SYSCALL:CLOSE   RMB     1       CLOSE A FILE
0003 0001        22: SYSCALL:RENAME  RMB     1       RENAME A FILE
0004 0001        23: SYSCALL:DELETE  RMB     1       DELETE A FILE
0005 0001        24: SYSCALL:LOAD    RMB     1       LOAD AN OVERLAY
0006 0001        25: SYSCALL:CHAIN   RMB     1       CHAIN TO A FILE
0007 0001        26: SYSCALL:CREATELOG       RMB     1       CREATE THE LOG FILE
0008 0001        27: SYSCALL:CLOSELOG        RMB     1       CLOSE THE LOG FILE
0009 0001        28: SYSCALL:DISKDEFAULT     RMB     1       SELECT DEFAULT DISK DEVICE
000A 0001        29: SYSCALL:READA   RMB     1       READ ASCII BYTES FROM A FILE
000B 0001        30: SYSCALL:READB   RMB     1       READ BINARY BYTES FROM A FILE
000C 0001        31: SYSCALL:WRITEA  RMB     1       WRITE ASCII BYTES TO A FILE
000D 0001        32: SYSCALL:WRITEB  RMB     1       WRITE BINARY BYTES TO A FILE
000E 0001        33: SYSCALL:CONTROL RMB     1       PERFORM A CONTROL OPERATION ON A FILE/DEVICE
000F 0001        34: SYSCALL:STATUS  RMB     1       READ FILE/DEVICE STATUS
0010 0001        35: SYSCALL:WAITDONE        RMB     1       WAIT FOR I/O ON CHANNEL TO COMPLETE
0011 0001        36: SYSCALL:EXIT    RMB     1       GIVE CONTROL BACK TO THE OPERATING SYSTEM
0012 0001        37: SYSCALL:ERROREXIT       RMB     1       EXIT TO SYSTEM WITH ERROR CODE
0013 0001        38: SYSCALL:SETERROR        RMB     1       REPORT AN ERROR TO THE SYSTEM
0014 0001        39: SYSCALL:GETERROR        RMB     1       READ BACK THE LAST ERROR CODE
0015 0001        40: SYSCALL:DISPERROR       RMB     1       DISPLAY ERROR MESSAGE CORRESPONDING TO LAST ERROR CODE
0016 0001        41: SYSCALL:KILLPROOF       RMB     1       PREVENT USER PROGRAM FROM BEING KILLED
0017 0001        42: SYSCALL:KILLENABLE      RMB     1       ALLOW USER PROGRAM TO BE KILLED
0018 0001        43: SYSCALL:DEBUG   RMB     1       CALL SYSTEM DEBUGGER
0019 0001        44: SYSCALL:ATTNCHECK       RMB     1       OPERATOR ATTENTION REQUEST CHECK
001A 0001        45: SYSCALL:ISCONSOLE       RMB     1       CHECK FOR CHANNEL 0 INPUT DEVICE = CONSOLE:
001B 0001        46: SYSCALL:INTERLOCK       RMB     1       PERFORM INTERLOCK FUNCTIONS ON OBJECTS
001C 0001        47: SYSCALL:DELAY   RMB     1       DELAY FOR n 1/60ths OF A SECOND
001D 0001        48: SYSCALL:READLUN RMB     1       CONVERT LOGICAL UNIT NUMBER TO DEVICE NAME
001E 0001        49: SYSCALL:GETSERIALNUMBER RMB     1       GET PROCESSOR SERIAL NUMBER
001F 0001        50: SYSCALL:JOBCONTROL      RMB     1       CREATE/TEST/DESTROY OTHER JOBS




ASM/6800 1.4A0: 001F RTP6800V1.4l       SD BASIC Version 1.4l Runtime Package (c) 1980 Software Dynamics
08/16/82 00:00:00; Page 5; Form 1       *** SDOS 1.1 DEFINITIONS ***
SDOSUSERDEFS.ASM
                 52: *
                 53: *       SYSCALL BLOCK DISPLACEMENTS
                 54: *
  0000           55:         ORG     0
0000 0001        56: SCBLK:OPCODE    RMB     1       PRIMARY SYSCALL FUNCTION (OPEN, READ, ETC.)
0001 0001        57: SCBLK:WLEN      RMB     1       WAIT FLAG BIT (0=WAIT) AND SYSCALL BLOCK LENGTH (0..127)
0002 0002        58: SCBLK:PARAMS    RMB     2       PARAMETER BYTES TO OPCODE (SECONDARY OPCODE, CHANNEL #)
0004 0002        59: SCBLK:WRBUF     RMB     2       POINTER TO WRITE DATA BUFFER
0006 0002        60: SCBLK:WRLEN     RMB     2       NUMBER OF BYTES IN WRITE DATA BUFFER
0008 0002        61: SCBLK:RPLEN     RMB     2       LENGTH OF REPLY (RESULT OF SYSCALL)
000A 0002        62: SCBLK:RDBUF     RMB     2       POINTER TO READ DATA BUFFER (WHERE RESULT GOES)
000C 0002        63: SCBLK:RDLEN     RMB     2       CEILING ON SIZE OF REPLY (READ DATA BUFFER)
000E 0000        64: SCBLK:DATA      RMB     0       OTHER PARAMETERS FOR SYSCALL; UP TO 127-12 BYTES
000E 0000        65: SCBLK:END       RMB     0       END OF SYSCALL BLOCK; ASSERT SCBLK:WLEN[1..7]=SCBLK:END-SCBLK:PARAMS
                 66: *
                 67: *       SYSCALL PARAMETER LIST DEFINITIONS
                 68: *
  0002           69: OPEN:CHANNEL    EQU     SCBLK:PARAMS    CHANNEL NUMBER
  0006           70: OPEN:LENGTH     EQU     SCBLK:WRLEN     FILE NAME LENGTH
  0004           71: OPEN:NAMEP      EQU     SCBLK:WRBUF     POINTER TO FILE NAME
  000E           72: OPEN:SCLEN      EQU     SCBLK:DATA      OPEN SYSCALL BLOCK LENGTH
                 73: *
  0002           74: CREATE:CHANNEL  EQU     SCBLK:PARAMS    CHANNEL NUMBER
  0006           75: CREATE:LENGTH   EQU     SCBLK:WRLEN     FILE NAME LENGTH
  0004           76: CREATE:NAMEP    EQU     SCBLK:WRBUF     POINTER TO FILE NAME
  000E           77: CREATE:SCLEN    EQU     SCBLK:DATA      CREATE SYSCALL BLOCK LENGTH
  000E           78: CREATE:FILESIZE EQU     SCBLK:DATA      4 BYTE FILE SIZE INITIAL ALLOCATION
  0012           79: CREATE:FILESIZESCLEN    EQU     CREATE:FILESIZE+4       END OF CREATE BLOCK WITH FILE SIZE ALLOCATION
                 80: *
  0002           81: CLOSE:CHANNEL   EQU     SCBLK:PARAMS    CHANNEL NUMBER
  0003           82: CLOSE:SCLEN     EQU     SCBLK:PARAMS+1  CLOSE SYSCALL BLOCK LENGTH
                 83: *
  0002           84: RENAME:CHANNEL  EQU     SCBLK:PARAMS    CHANNEL NUMBER
  0006           85: RENAME:LENGTH   EQU     SCBLK:WRLEN     NEW FILE NAME LENGTH
  0004           86: RENAME:NAMEP    EQU     SCBLK:WRBUF     POINTER TO NEW FILE NAME
  000E           87: RENAME:SCLEN    EQU     SCBLK:DATA      RENAME SYSCALL BLOCK LENGTH
                 88: *
  0006           89: DELETE:LENGTH   EQU     SCBLK:WRLEN     FILE NAME LENGTH
  0004           90: DELETE:NAMEP    EQU     SCBLK:WRBUF     POINTER TO NAME
  000E           91: DELETE:SCLEN    EQU     SCBLK:DATA      DELETE SYSCALL BLOCK LENGTH
                 92: *
  0006           93: LOAD:LENGTH     EQU     SCBLK:WRLEN     LENGTH OF FILE NAME
  0004           94: LOAD:NAMEP      EQU     SCBLK:WRBUF     POINTER TO FILE NAME
  000E           95: LOAD:SCLEN      EQU     SCBLK:DATA      LOAD SYSCALL BLOCK LENGTH
                 96: *
  0006           97: CHAIN:LENGTH    EQU     SCBLK:WRLEN     LENGTH OF FILE NAME
  0004           98: CHAIN:NAMEP     EQU     SCBLK:WRBUF     POINTER TO FILE NAME
  000E           99: CHAIN:SCLEN     EQU     SCBLK:DATA      CHAIN SYSCALL BLOCK LENGTH
                100: *
  0006          101: CREATELOG:LENGTH        EQU     SCBLK:WRLEN     LENGTH OF FILE NAME
  0004          102: CREATELOG:NAMEP EQU     SCBLK:WRBUF     POINTER TO FILE NAME
  000E          103: CREATELOG:SCLEN EQU     SCBLK:DATA      CREATELOG SYSCALL BLOCK LENGTH
                104: *
  0002          105: CLOSELOG:SCLEN  EQU     SCBLK:PARAMS    CLOSELOG SYSCALL BLOCK LENGTH
                106: *




