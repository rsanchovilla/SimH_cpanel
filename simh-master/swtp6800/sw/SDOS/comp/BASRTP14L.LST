                  2: *
                  3: *                  FIX16 -- CONVERT NON-ZERO FP NUM ON TOS TO 4 BYTE INTEGER..
                  4: *                  IN RANGE 0..65535
                  5: *                  SKIP 2 BYTES AT EXIT IF CAN'T FIX OR NOT AN INTEGER IN PROPER RANGE
                  6: *
  2BB1            7: FIX16
  0001            8:                    IF      M6800           GET POINTER TO VALUE TO FIX
                  9:                    ;LDB    7,S             IS THERE A FRACTIONAL PART OR MORE SIGIFICANCE THAN WE CAN FIX ?
2BB1 30          10:                    TSX
2BB2 E607        11:                    LDAB    7,X
2BB4 EA06        12:                    ORAB    6,X             ...?
2BB6 264D        13:                    BNE     FIXERRJ         B/ YEP
                 14:                    ;LDA    2,X             GET EXPONENT BYTE (ASSERT: TOS IS NONZERO FP NUM)
2BB8 A602        15:                    LDAA    2,X
  0001           16:                    ELSE    M6801!M6809
 *S*             17:                    ;LDD    6,S
 *S*             18:                    TSX
 *S*             19:                    LDAB    (6)+1,X
 *S*             20:                    LDAA    6,X
 *S*             21:                    BNE     FIXERRJ
 *S*             22:                    IF      M6809
 *S*             23:                    ;LDA    2,S
 *S*             24:                    TSX
 *S*             25:                    LDAA    2,X
 *S*             26:                    ELSE    M6801
 *S*             27:                    ;LDA    2,X
 *S*             28:                    LDAA    2,X
 *S*             29:                    FIN
                 30:                    FIN
2BBA 2B49        31:                    BMI     FIXERRJ         B/ < 0, CAN'T FIX16
                 32:                    ;CMPA   #$43            MAX FIXABLE EXPONENT ?
2BBC 8143        33:                    CMPA    #$43
2BBE 2245        34:                    BHI     FIXERRJ         B/ CAN'T FIX16
2BC0 2710        35:                    BEQ     FIX16A          B/ YES, GO CHECK FOR > 65536
                 36:                    ;CMPA   #$41            SINGLE DIGIT RESULT ?
2BC2 8141        37:                    CMPA    #$41
2BC4 253F        38:                    BCS     FIXERRJ         B/ FRACTIONAL, CAN'T FIX16
2BC6 2202        39:                    BHI     FIX16$42        B/ CAN FIX IF NO FRACTIONAL PART!
  0001           40:                    IF      M6800!M6801
2BC8 EA04        41:                    ORAB    4,X             SEE IF FRACTIONAL PART EXISTS
2BCA EA05        42: FIX16$42           ORAB    5,X             ...
  0001           43:                    ELSE    M6809
 *S*             44:                    ORAB    4,S
 *S*             45: FIX16$42           ORAB    5,S
                 46:                    FIN
2BCC 2637        47:                    BNE     FIXERRJ         B/ CAN'T FIX16
                 48:                    ;TFR    A,B             IT CAN BE FIXED!
2BCE 16          49:                    TAB
                 50:                    ;JMP    FIX1            SO GO DO IT
2BCF 7E2C08      51:                    JMP     FIX1
                 52: 
  2BD2           53: FIX16A
  0001           54:                    IF      M6800!M6801
                 55:                    ;LDB    3,X             MAX EXPONENT FOUND, CHK <=65535
2BD2 E603        56:                    LDAB    3,X




