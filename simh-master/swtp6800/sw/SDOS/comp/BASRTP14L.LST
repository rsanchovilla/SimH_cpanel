ASM/6800 1.4A0: 16AC RTP6800V1.4l       SD BASIC Version 1.4l Runtime Package (c) 1980 Software Dynamics
08/16/82 00:00:00; Page 219; Form 10    *****  F O R - N E X T  *****
RTP.ASM
                181: *                  OPNXT -- DO END OF LOOP PROCESSING FOR "FOR/NEXT" LOOP
                182: *                  (OPNXT)(OPFOR ADDR FOR MATCHING INDEX VAR)
                183: *
                184: *                  NOTE: INTEGER PATH HAS BEEN OPTIMIZED TO DEATH!
                185: *
  16AE          186: XOPNEXT            EQU     *
  0001          187:                    IF      M6800!M6801
                188:                    ;LDX    BPC             FIND "OPFOR" OPCODE
16AE DE2E       189:                    LDX     BPC
                190:                    FIN
                191:                    ;LDX    ILADD,X
16B0 EE00       192:                    LDX     ILADD,X
16B2 DF2E       193:                    STX     BPC             AND REMEMBER WHERE IT IS
                194:                    ;LDX    ILADD+5,X       GRAB POINTER TO STEP VALUE
16B4 EE05       195:                    LDX     ILADD+5,X
                196:                    ;LDA    FSTYPE,X        IS STEP AN INTEGER ?
16B6 A600       197:                    LDAA    FSTYPE,X
16B8 AA06       198:                    ORAA    FLTYPE,X        (ARE BOTH STEP AND LIMIT INTEGERS ?)
16BA 2660       199:                    BNE     NEXTF           B/ NO, FLOATING OPERATIONS ARE REQUIRED
                200:                    ;LDD    FISTEP1,X       MOVE INTEGER STEP TO (A,B)
16BC E605       201:                    LDAB    (FISTEP1)+1,X
16BE A604       202:                    LDAA    FISTEP1,X
                203: *                  NOTE: IF USER FLOATED THE INDEX VAR, HE'LL BE SORRY!
  16C0          204: NEXTICHECK         ;LDX    FILIM1,X        GRAB LOOP LIMIT
16C0 EE0A       205:                    LDX     FILIM1,X
16C2 DF00       206:                    STX     TEMPX           SAVE IT A MOMENT
                207:                    ;LDX    BPC             NOW ADD LOOP INDEX VALUE...
16C4 DE2E       208:                    LDX     BPC
                209:                    ;LDX    ILADD+3,X       TO STEP VALUE
16C6 EE03       210:                    LDX     ILADD+3,X
16C8 6D00       211:                    TST     VTYPE,X         CHECK FOR EXTREMELY UNUSUAL CASE
16CA 2639       212:                    BNE     NEXTIF          B/ USER FLOATED INDEX VARIABLE, SOMEHOW!
                213:                    ;ADDD   VINT1,X         (A,B):= NEXT INDEX VARIABLE VALUE
16CC EB05       214:                    ADDB    (VINT1)+1,X
16CE A904       215:                    ADCA    VINT1,X
16D0 2510       216:                    BCS     NEXTIOV         B/ NEW INDEX VALUE > 65535, RATS!
                217:                    ;STD    VINT1,X         SAVE UPDATED LOOP INDEX VALUE
16D2 E705       218:                    STAB    (VINT1)+1,X
16D4 A704       219:                    STAA    VINT1,X
16D6 0D         220:                    SEC                     CHECK: LOOP INDEX VALUE <= LIMIT ?
16D7 D201       221:                    SBCB    TEMPX+1         ...?
16D9 9200       222:                    SBCA    TEMPX           ...?
16DB 2417       223:                    BCC     NEXTEXIT        B/ NOPE, TIME TO LEAVE THE LOOP!
  16DD          224: NEXTITERATION      EQU     *
                225:                    ;LDB    #7              DO NEXT ITERATION OF LOOP, 7 IS LENGTH OF "OPFOR" OPCODE
16DD C607       226:                    LDAB    #7
                227:                    ;JMP    NTRADB          START EXECUTION FOLLOWING OPFOR OPCODE AGAIN
16DF 7E0318     228:                    JMP     NTRADB




