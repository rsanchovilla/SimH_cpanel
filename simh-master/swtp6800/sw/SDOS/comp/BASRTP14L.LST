0462 822F      1231:                    SBCA    #(BASICRTPEND$+3)/256
0464 2513      1232:                    BCS     OVERLAPERROR
               1233:                    FIN
               1234:                    ;LDD    RTP:BASEOFSCALARVARS,X
0466 E606      1235:                    LDAB    (RTP:BASEOFSCALARVARS)+1,X
0468 A605      1236:                    LDAA    RTP:BASEOFSCALARVARS,X
               1237:                    ;STD    VARTABLE
