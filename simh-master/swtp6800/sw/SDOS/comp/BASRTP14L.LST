                 52: *                  DO SINGLE SUBSCRIPT (SUBROUTINE)
                 53: *                          (X) POINTS TO VECTOR
                 54: *                          (A,B) CONTAINS VECTOR INDEX AS INTEGER
                 55: *                  RETURNS (A,B), (X) AND STORETARGET WITH POINTER TO VECTOR SLOT
                 56: *                  VECTOR STRUCTURE:       (# SLOTS) (6*# SLOTS BYTES)
                 57: *                  NOTE: SUBSCRIPT LOGIC ASSUMES VECTORS/ARRAYS FIT INTO MEMORY!
                 58: *
  0CD2           59: DOSINGLESUBSCRIPT  EQU     *
                 60:                    ;CMPD   ,X              CHECK FOR SUBSCRIPT OUT OF BOUNDS
0CD2 A100        61:                    CMPA    0,X
0CD4 2602        62:                    BNE     MACRO:000A
0CD6 E101        63:                    CMPB    (0)+1,X
  0CD8           64: MACRO:000A
0CD8 2304        65:                    BLS     DOSS2           IF <= THEN WE'RE OK!
  0CDA           66: DOSSE              ;JSR    RTPERR
0CDA BD15BA      67:                    JSR     RTPERR
0CDD 09          68:                    FCB     :ARYRNG
                 69: 
  0CDE           70: DOSS2              ;STD    TEMPX
0CDE D701        71:                    STAB    TEMPX+1
0CE0 9700        72:                    STAA    TEMPX
                 73:                    ;ASLD                   INDEX *2 (ASSERT: CAN'T OVERFLOW)
0CE2 58          74:                    ASLB
0CE3 49          75:                    ROLA
                 76:                    ;ADDD   TEMPX           *3 (ASSERT: CAN'T OVERFLOW)
0CE4 DB01        77:                    ADDB    TEMPX+1
0CE6 9900        78:                    ADCA    TEMPX
                 79:                    ;ASLD                   *6 (ASSERT: CAN'T OVERFLOW)
0CE8 58          80:                    ASLB
0CE9 49          81:                    ROLA
0CEA DF00        82:                    STX     TEMPX           +VECTOR NAME
                 83:                    ;ADDD   TEMPX           ASSERT: CAN'T OVERFLOW
0CEC DB01        84:                    ADDB    TEMPX+1
0CEE 9900        85:                    ADCA    TEMPX
                 86:                    ;ADDD   #2              ADD BIAS TO SKIP SLOT COUNT (CAN'T OVERFLOW)
0CF0 CB02        87:                    ADDB    #(2)&$FF
0CF2 8900        88:                    ADCA    #(2)/256
                 89:                    ;STD    STORETARGET
0CF4 D7E0        90:                    STAB    STORETARGET+1
0CF6 97DF        91:                    STAA    STORETARGET
                 92:                    ;LDX    STORETARGET
0CF8 DEDF        93:                    LDX     STORETARGET
0CFA 39          94:                    RTS




