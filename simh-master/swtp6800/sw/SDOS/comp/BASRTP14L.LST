  1247            4: SYSCALLONCHANNELA  ;STA    SCBLK+SCBLK:PARAMS
1247 9753         5:                    STAA    SCBLK+SCBLK:PARAMS
                  6: *                  JMP     ISYSCALL
                  7: *                  I(NTERNAL) SYSCALL
                  8: *
                  9: *                  SUPRESS EOF ERRORS ON CHANNELS 0-31
                 10: *                  ONLY RETURNS ON ERROR IF CALLING ROUTINE HAS BCS OR BCC
                 11: *                  AFTER THE JSR (OR BSR).  OTHERWISE TRAPS ERROR TO IOERROR
                 12: *
                 13: *
  1249           14: ISYSCALL           EQU     *
                 15: *
                 16: *                  FIRST, CLEAR EOF FLAG
                 17: *
1249 4F          18:                    CLRA
                 19:                    ;CLR    EOFHITFLAG      ASSUME 'NO EOF HIT'
124A 7F00DE      20:                    CLR     EOFHITFLAG
                 21:                    ;LDB    SCBLK+SCBLK:PARAMS CHANNEL #=>0
124D D653        22:                    LDAB    SCBLK+SCBLK:PARAMS
124F C5E0        23:                    BITB    #$E0            B<32?
1251 2607        24:                    BNE     EXECISYSCALL    B/ NO, SO CAN'T DO A THING
1253 8D3C        25:                    BSR     EOFBGEN         MAKE ME AN EOF BIT AND X-REG
1255 43          26:                    COMA                    MAKE A MASK
1256 A400        27:                    ANDA    ,X              RESET 'EOF HIT' BIT
                 28:                    ;STA    ,X
1258 A700        29:                    STAA    0,X
                 30: 
  125A           31: EXECISYSCALL       ;LDX    #SCBLK          NOW DO SYSCALL
125A CE0051      32:                    LDX     #SCBLK
                 33:                    ;JSR    SYSCALL$
125D BD00FB      34:                    JSR     SYSCALL$
1260 2501        35:                    BCS     RATS            B/ GOT AN ERROR 
1262 39          36:                    RTS                     ALL DONE!
                 37: 




