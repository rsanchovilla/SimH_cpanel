                516: *
                517: *                  TWO BYTE (EXTENDED) OPCODE
                518: *                          SECOND BYTE CONTAINS SECONDARY OPCODE
                519: *                          PRIMARILY USED FOR RARELY INVOKED FUNCTIONS
                520: *
  02A9          521: XOPEXTENDED        EQU     *
  0001          522:                    IF      M6800
                523:                    ;LDB    [BPC]           FETCH 2ND BYTE OF OPCODE
02A9 DE2E       524:                    LDX     BPC
02AB E600       525:                    LDAB    0,X
02AD 58         526:                    ASLB                    DOUBLE TO MAKE JUMP TABLE INDEX
                527:                    ;LDA    #EXTENDEDJMPTBL/256
02AE 8602       528:                    LDAA    #EXTENDEDJMPTBL/256
                529:                    ;STD    TEMPX           (ASSERT: 2ND BYTE <= 127)
02B0 D701       530:                    STAB    TEMPX+1
02B2 9700       531:                    STAA    TEMPX
                532:                    ;LDX    TEMPX
02B4 DE00       533:                    LDX     TEMPX
                534:                    ;LDX    EXTENDEDJMPTBL&$FF,X
02B6 EE34       535:                    LDX     EXTENDEDJMPTBL&$FF,X
                536:                    ;JMP    ,X
02B8 6E00       537:                    JMP     0,X
  0001          538:                    ELSEIF  M6801
 *S*            539:                    ;LDB    [BPC]           FETCH 2ND BYTE OF OPCODE
 *S*            540:                    LDX     BPC
 *S*            541:                    LDAB    0,X
 *S*            542:                    ASLB                    DOUBLE TO MAKE JUMP TABLE INDEX
 *S*            543:                    ;LDX    #EXTENDEDJMPTBL FETCH TABLE ADDRESS
 *S*            544:                    LDX     #EXTENDEDJMPTBL
 *S*            545:                    ;ABX                    DETERMINE PROPER TABLE SLOT
 *S*            546:                    STX     TEMPX
 *S*            547:                    ADDB    TEMPB
 *S*            548:                    STAB    TEMPB
 *S*            549:                    LDAB    TEMPA
 *S*            550:                    ADCB    #0
 *S*            551:                    STAB    TEMPA
 *S*            552:                    LDX     TEMPX
 *S*            553:                    ;JMP    0,X
 *S*            554:                    JMP     0,X
 *S*            555:                    ELSE    (M6809)
 *S*            556:                    ;LDB    ,X              GET 2ND BYTE OF OPCODE
 *S*            557:                    LDAB    0,X
 *S*            558:                    ASLB                    DOUBLE TO MAKE WORD INDEX
 *S*            559:                    LDU     #EXTENDEDJMPTBL
 *S*            560:                    ;JMP    [B,U]           ASSERT: (B) <= 126
 *S*            561:                    LDX     B
 *S*            562:                    JMP     0,X
                563:                    FIN




