                207: *                  BLOCKMOVEUP -- MOVE BLOCK AT (X) TO (Y) FOR (D) BYTES
                208: *                  (Y) = SCRATCHPAD LOCATION ZERO
                209: *                  COPIES LARGE BLOCKS AT 17uS. PER BYTE
                210: *                  ASSUMES THAT COPY-TO REGION DOES NOT OVERLAP COPY-FROM REGION
                211: *                  OR THAT "FROM" <= "TO"
                212: *
  101D          213: BLOCKMOVEUP        EQU     *
101D DF22       214:                    STX     FROMPOINTER     COMPUTE END OF COPY-FROM REGION, -16
101F DF26       215:                    STX     LIMIT
                216:                    ;PSHD                   (SAVE COUNT)
1021 37         217:                    PSHB
1022 36         218:                    PSHA
                219:                    ;ADDD   FROMPOINTER
1023 DB23       220:                    ADDB    FROMPOINTER+1
1025 9922       221:                    ADCA    FROMPOINTER
                222:                    ;SUBD   #16
1027 C010       223:                    SUBB    #(16)&$FF
1029 8200       224:                    SBCA    #(16)/256
                225:                    ;STD    FROMPOINTER
102B D723       226:                    STAB    FROMPOINTER+1
102D 9722       227:                    STAA    FROMPOINTER
                228:                    ;PULD                   GET COUNT
102F 32         229:                    PULA
1030 33         230:                    PULB
1031 37         231:                    PSHB                    SAVE LSB 8 BITS
                232:                    ;ADDD   TEMPX           COMPUTE END OF COPY-TO REGION, -16
1032 DB01       233:                    ADDB    TEMPX+1
1034 9900       234:                    ADCA    TEMPX
                235:                    ;SUBD   #16
1036 C010       236:                    SUBB    #(16)&$FF
1038 8200       237:                    SBCA    #(16)/256
                238:                    ;STD    TOPOINTER
103A D721       239:                    STAB    TOPOINTER+1
103C 9720       240:                    STAA    TOPOINTER
                241:                    ;LDD    LIMIT           SET LIMIT = LOWEST ADDRESS BYTE OF COPY-FROM REGION,-16
103E D627       242:                    LDAB    LIMIT+1
1040 9626       243:                    LDAA    LIMIT
                244:                    ;SUBD   #16
1042 C010       245:                    SUBB    #(16)&$FF
1044 8200       246:                    SBCA    #(16)/256
                247:                    ;STD    LIMIT
1046 D727       248:                    STAB    LIMIT+1
1048 9726       249:                    STAA    LIMIT
104A 33         250:                    PULB
                251:                    ;LDX    FROMPOINTER     = WHERE TO COPY FROM
