  13D8          141: SUBFUNENTRY        EQU     *
                142:                    ;LDX    ,S              = RETURN ADDRESS FROM JSR
13D8 30         143:                    TSX
13D9 EE00       144:                    LDX     0,X
                145:                    ;LDB    RTP:VERSIONNUMBER,X CHECK VERSION NUMBER
13DB E600       146:                    LDAB    RTP:VERSIONNUMBER,X
                147:                    ;CMPB   #VERSION
13DD C114       148:                    CMPB    #VERSION
13DF 26F4       149:                    BNE     VERSIONERRJ     B/ WRONG VERSION NUMBER
                150:                    ;CMPA   RTP:ARGCOUNT,X  IS ARG COUNT CORRECT ?
13E1 A109       151:                    CMPA    RTP:ARGCOUNT,X
13E3 26E7       152:                    BNE     ARGCOUNTERROR   B/ NO, GO YELL AND SCREAM AND DIE...
13E5 DF6A       153:                    STX     BPCSAV          REMEMBER ROUGHLY WHERE BPC IS (CALL SITE)
                154:                    ;LEAS   4,S             POP $106 ENTRY POINT JSR RETURN ADDRESS OFF POP RETURN ADDRESS PUSHE
  0000          155:                    IF      4<0
 *S*            156:                    RPT     -4
 *S*            157:                    DES
                158:                    ELSE
