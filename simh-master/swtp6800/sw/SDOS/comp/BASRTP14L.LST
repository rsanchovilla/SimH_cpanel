RTP.ASM
                  2: *                  DO DOUBLE SUBSCRIPT (SUBROUTINE)
                  3: *                          (X) POINTS TO ARRAY
                  4: *                          (A,B) CONTAINS 2ND SUBSCRIPT
                  5: *                          TWORD:= (A,B) * ROW DIMENSION
                  6: *                          ARRAY STRUCTURE:  (# OF ROWS) (# COLUMNS) 6*(#COLS+1)*(#ROWS)
                  7: *
  0CAB            8: DODOUBLESUBSCRIPT  EQU     *
0CAB DFDF         9:                    STX     STORETARGET     SAVE ARRAY BASE
                 10:                    ;CMPD   2,X
0CAD A102        11:                    CMPA    2,X
0CAF 2602        12:                    BNE     MACRO:0008
0CB1 E103        13:                    CMPB    (2)+1,X
  0CB3           14: MACRO:0008
0CB3 2225        15:                    BHI     DOSSE
  0CB5           16: DODS1A             ;LDX    ,X
0CB5 EE00        17:                    LDX     0,X
0CB7 08          18:                    INX                     ACTUAL # ROWS = DIM'D # ROWS + 1
                 19:                    ;JSR    MLTPLY          ASSERT: CAN'T OVERFLOW!
0CB8 BD1EC5      20:                    JSR     MLTPLY
                 21:                    ;STD    TWORD           SAVE ROW BASE
0CBB D752        22:                    STAB    TWORD+1
0CBD 9751        23:                    STAA    TWORD
0CBF 39          24:                    RTS
                 25: *
                 26: *                  FINISHDBLSUBSCRIPT (SUBROUTINE)
                 27: *                          STORETARGET POINTS TO ARRAY BASE
                 28: *                          (A,B) CONTAINS 2ND SUBSCRIPT
                 29: *
  0CC0           30: FINISHDBLSUBSCRIPT EQU     *
                 31:                    ;LDX    STORETARGET     GET ARRAY ADDRESS
0CC0 DEDF        32:                    LDX     STORETARGET
                 33:                    ;CMPD   ,X              CHECK ROW SUBSCRIPT BOUNDS
0CC2 A100        34:                    CMPA    0,X
0CC4 2602        35:                    BNE     MACRO:0009
0CC6 E101        36:                    CMPB    (0)+1,X
  0CC8           37: MACRO:0009
0CC8 2210        38:                    BHI     DOSSE           B/ ROW SUBSCRIPT OUT OF RANGE
  0CCA           39: DODS2A             ;ADDD   TWORD           ADD ROW BASE
0CCA DB52        40:                    ADDB    TWORD+1
0CCC 9951        41:                    ADCA    TWORD
                 42:                    ;LEAX   2,X             MAKE ARRAY LOOK LIKE VECTOR
  0000           43:                    IF      2<0
 *S*             44:                    RPT     -2
 *S*             45:                    DEX
                 46:                    ELSE
  0002           47:                    RPT     2
0CCE 08          48:                    INX
0CCF 08
                 49:                    FIN
0CD0 200C        50:                    BRA     DOSS2




ASM/6800 1.4A0: 0CD0 RTP6800V1.4l       SD BASIC Version 1.4l Runtime Package (c) 1980 Software Dynamics
