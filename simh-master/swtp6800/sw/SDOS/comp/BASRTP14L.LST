                825: *                  LOAD SCALAR--OPCODE CONTAINS SCALAR NUMBER (0..63) TO
                826: *                  LOAD (OR STORE).  IF OPCODE IS STORE, CALL XOPSSCALAR
                827: *
  032B          828: XOPLSCALAR         EQU     *
  0001          829:                    IF      M6800!M6801
032B 17         830:                    TBA                     C=?, A=/<OP>NNNNNNN0/
032C 48         831:                    ASLA                    C=OP, A=/NNNNNN00/
032D 252D       832:                    BCS     XOPSSCALAR      BRANCH ON OP (1--> STORE!)
032F 1B         833:                    ABA                     SINCE OP=0, A=6*N
0330 16         834:                    TAB
                835:                    ;LDA    #0              CARRY NOT CHANGED
0331 8600       836:                    LDAA    #0
0333 49         837:                    ROLA                    A,B=N*6
  0334          838: XOPLSCALAR1
                839:                    ;ADDD   VARTABLE        POINTER TO THING TO LOAD, -$80
0334 DB31       840:                    ADDB    VARTABLE+1
0336 9930       841:                    ADCA    VARTABLE
                842:                    ;STD    TEMPX
0338 D701       843:                    STAB    TEMPX+1
033A 9700       844:                    STAA    TEMPX
                845:                    ;LDX    TEMPX
033C DE00       846:                    LDX     TEMPX
  0001          847:                    ELSE    (M6809)
 *S*            848:                    PSHB                    C=?, A=/<OP>NNNNNN0/
 *S*            849:                    ASLB                    C=OP, A=/NNNNNN00/
 *S*            850:                    BCS     XOPSSCALAR      B/ OPCODE = "STORE SCALAR"
 *S*            851:                    ADDB    ,S+             (CARRY,B) = SCALAR NUMBER * 6
 *S*            852:                    ;LDA    #0              CAPTURE CARRY BIT IN (A)
 *S*            853:                    LDAA    #0
 *S*            854:                    ROLA
 *S*            855: XOPLSCALAR1        ;LDX    VARTABLE        ADD BASE OF SCALAR VARIABLES
 *S*            856:                    LDX     VARTABLE
 *S*            857:                    ;LEAX   D,X
 *S*            858:                    IF      D<0
 *S*            859:                    RPT     -D
 *S*            860:                    DEX
 *S*            861:                    ELSE
 *S*            862:                    RPT     D
 *S*            863:                    INX
 *S*            864:                    FIN
                865:                    FIN
                866:                    ;LDD    VFLT5,X         GET LAST BYTE PAIR
033E E605       867:                    LDAB    (VFLT5)+1,X
0340 A604       868:                    LDAA    VFLT5,X
                869:                    ;PSHD                   MUST PUSH 16 BITS MINIMUM
0342 37         870:                    PSHB
0343 36         871:                    PSHA
                872:                    ;LDA    VTYPE,X         WHAT ARE YOU?
0344 A600       873:                    LDAA    VTYPE,X
0346 270D       874:                    BEQ     XOPLSCALAR2     STEP THIS WAY MR. INTEGER
  0001          875:                    IF      M6800
                876:                    ;LDB    VFLT4,X         FLOATING POINT: PUSH THE HARD WAY
0348 E603       877:                    LDAB    VFLT4,X
034A 37         878:                    PSHB
                879:                    ;LDB    VFLT3,X




