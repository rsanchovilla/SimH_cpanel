0414 CE0100    1157:                    LDX     #CODE
0417 5F        1158:                    CLRB
  0418         1159: TOTALRTPSUM        ; LOOP TO ACCUMULATE CHECKSUM OVER RUNTIME PACKAGE
  0001         1160:                    IF      M6800!M6801
0418 EB00      1161:                    ADDB    0,X
041A 08        1162:                    INX
  0001         1163:                    ELSE    (M6809)
 *S*           1164:                    ADDB    ,X+             ADD A BYTE
               1165:                    FIN
041B 8C2F79    1166:                    CPX     #BASICRTPEND$
041E 26F8      1167:                    BNE     TOTALRTPSUM     B/ MORE BYTES TO SUM
0420 F00133    1168:                    SUBB    DOLLARSIGN      IS CHECKSUM OK, IGNORING VALUE OF DOLLARSIGN ?
               1169: *                  SET RTPTOTALCKSUM:=RTPTOTALCKSUM-(B) AT THIS POINT
0423 2614      1170:                    BNE     INITCKERR        B/ WRONG CHECKSUM!
               1171:                    ;LDD    #RTP:POPCODESTART COMPUTE POINTER TO 1ST POPCODE
0425 C609      1172:                    LDAB    #(RTP:POPCODESTART)&$FF
0427 8600      1173:                    LDAA    #(RTP:POPCODESTART)/256
               1174:                    ;ADDD   BPC
0429 DB2F      1175:                    ADDB    BPC+1
042B 992E      1176:                    ADCA    BPC
               1177:                    ;STD    BPC
042D D72F      1178:                    STAB    BPC+1
042F 972E      1179:                    STAA    BPC
               1180:                    ;STD    LINEADDR        FOR PROPER ERROR HANDLING PRIOR TO LINE NUMBER (SEE PRINTLINEADDR)
0431 D72D      1181:                    STAB    LINEADDR+1
0433 972C      1182:                    STAA    LINEADDR
               1183:                    ;JMP    XOPLINE0        GO LOOK AT LINE FLAGS
0435 7E1523    1184:                    JMP     XOPLINE0
               1185: 
               1186: **********************************************************************
0438 00        1187:                    FCB     RTPTOTALCKSUM   *** THIS NEEDS PATCHING AFTER ASSEMBLY ***
               1188: **********************************************************************
               1189: 
  0439         1190: INITCKERR          ;JSR    RTPERR          WRONG SUM, GIVE UP NOW!
0439 BD15BA    1191:                    JSR     RTPERR
043C 0A        1192:                    FCB     :BADRTP




