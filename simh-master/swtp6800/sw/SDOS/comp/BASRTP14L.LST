                 64:                    ;LDX    ,X              AND 1ST AND 2ND BYTES FROM THE "FROM" AREA
0F6E EE00        65:                    LDX     0,X
0F70 DF24        66:                    STX     BLOCKMOVEX      SAVE 1ST AND 2ND BYTES
                 67:                    ;LDX    TOPOINTER       NO STORE 4 BYTES TO "TO" AREA
0F72 DE20        68:                    LDX     TOPOINTER
                 69:                    ;STD    2,X             STORE 2ND AND 3RD BYTE
0F74 E703        70:                    STAB    (2)+1,X
0F76 A702        71:                    STAA    2,X
                 72:                    ;LDD    BLOCKMOVEX
0F78 D625        73:                    LDAB    BLOCKMOVEX+1
0F7A 9624        74:                    LDAA    BLOCKMOVEX
                 75:                    ;STD    ,X              STORE 1ST AND SECOND BYTES
0F7C E701        76:                    STAB    (0)+1,X
0F7E A700        77:                    STAA    0,X
                 78:                    ;LDB    TOPOINTER+1     ADVANCE POINTERS BY 4 BYTES
0F80 D621        79:                    LDAB    TOPOINTER+1
0F82 CB04        80:                    ADDB    #4
                 81:                    ;STB    TOPOINTER+1
0F84 D721        82:                    STAB    TOPOINTER+1
0F86 2403        83:                    BCC     *+5
                 84:                    ;INC    TOPOINTER
0F88 7C0020      85:                    INC     TOPOINTER
                 86:                    ;LDB    FROMPOINTER+1
0F8B D623        87:                    LDAB    FROMPOINTER+1
0F8D CB04        88:                    ADDB    #4
                 89:                    ;STB    FROMPOINTER+1
0F8F D723        90:                    STAB    FROMPOINTER+1
0F91 2403        91:                    BCC     *+5
                 92:                    ;INC    FROMPOINTER
0F93 7C0022      93:                    INC     FROMPOINTER
                 94:                    ;LDX    FROMPOINTER     SET UP FOR NEXT LOOP ITERATION
0F96 DE22        95:                    LDX     FROMPOINTER
  0000           96:                    IF      SAVESPACE
 *S*             97: BLOCKMOVEDOWNB     CPX     LIMIT           ALL DONE MOVING BYTES ?
 *S*             98:                    BNE     BLOCKMOVEDOWN4  B/ NO, GO MOVE SOME MORE!
                 99:                    ELSE
0F98 D027       100:                    SUBB    LIMIT+1         MULTIPLE OF 16 BYTES LEFT TO MOVE ?
0F9A C50F       101:                    BITB    #%00001111      ....?
0F9C 26CC       102:                    BNE     BLOCKMOVEDOWN4  B/ NOPE, MOVE ANOTHER 4 BYTES
0F9E 9C26       103: BLOCKMOVEDOWNB     CPX     LIMIT           YES, ALL DONE MOVING BYTES ?
0FA0 277A       104:                    BEQ     BLOCKMOVEDOWND  B/ YES, LEAVE!
                105: *
                106: *                  MOVE 16 BYTES AT A TIME UNTIL TRANSFER IS COMPLETE
                107: *                  COPY RATE IS 17.1 uS. PER BYTE




