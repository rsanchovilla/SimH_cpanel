                603:                    ;LDX    MAXLEN,X        USE MAX ON TARGET STRING
0EBF EE00       604:                    LDX     MAXLEN,X
0EC1 DF54       605: STORES2            STX     S1LEN
                606:                    ;CLR    LOOPX           ASSUME ZERO BLANKS REQUIRED TO PAD STRING
