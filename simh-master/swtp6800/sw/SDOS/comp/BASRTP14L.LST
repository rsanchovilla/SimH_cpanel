                212: *                  FORMATTED PRINT
                213: *                  SUBROUTINE FOR XOPPV, XOPNUMF
                214: *
                215: *                  A HAS # OF DIGITS LEFT OF DP IF E WERE = 0 (SEE FCONVO)
                216: *                  X POINTS TO WHERE TO PUT THE STUFF
                217: *                  (ISFORMAT SETS UP THE FOLLOWING:)
                218: *                  LDOLLAR CONTAINS LEFT DOLLAR COUNT
                219: *                  LMINUS CONTAINS LEFT MINUS COUNT
                220: *                  LSHARP CONTAINS LEFT SHARP COUNT
                221: *                  DP CONTAINS DP COUNT
                222: *                  RSHARP CONTAINS RIGHT SHARP COUNT
                223: *                  RMINUS CONTAINS RIGHT MINUS COUNT
                224: *                  RCARET CONTAINS RIGHT CARET COUNT
                225: *                  FLENGTH CONTAINS LENGTH OF ENTIRE FORMAT
                226: *                  FAC1-FAC6               CONTAINS "S.DDDD"
                227: *                  FACEXT1-FACEXT5         CONTAINS "DDDDDD"
                228: *                  MS1-MS6 CONTAINS        "DESXXX"
                229: *                  WHERE   S IS A '-' OR '+'
                230: *                  . IS A '.'
                231: *                  D IS AN ASCII DIGIT IN THE RANGE '0'-'9'
                232: *                  E IS A 'E'
                233: *                  X IS AN ASCII EXPONENT DIGIT IN THE RANGE '0'-'9'
                234: *                  ON EXIT A RETURNS LENGTH
                235: *                  X POINTS PAST OUTPUT
                236: *
                237: *                  CASE 1  E-TYPE FORMAT
                238: *                  OVERFLOW IF NO '-' SPEC & VALUE IS NEGATIVE OR
                239: *                  ABS(A-LSHARP) > 100 & RCARET < 5 (3 EXP DIGITS) OR
                240: *                  100 > ABS(A-LSHARP) > 10 & RCARET < 4 (2 EXP DIGITS)
                241: *                  # SPACES = 1 IF LMINUS <> 0 & FAC1 = '+', ELSE = 0
                242: *                  PRINT LEADING SPACES
                243: *                  PRINT '-' IF LMINUS <> 0 & FAC1 = '-'
                244: *                  PRINT LSHARP DIGITS
                245: *                  PRINT '.' IF DP <> 0
                246: *                  PRINT RSHARP DIGITS (MAY BE NONE)
                247: *                  PRINT 'E'
                248: *                  LET EXP = A - LSHARP
                249: *                  PRINT SIGN(EXP) ('-' OR '+')
                250: *                  PRINT RCARET - 2 EXP DIGITS
                251: *
                252: *                  CASE 2  NOT E-TYPE FORMAT
                253: *                  OVERFLOW IF NO '-' SPEC & VALUE IS NEGATIVE OR
                254: *                  A > 0 & LSHARP - A < 0 
                255: *                  IF A <= 0 THEN
                256: *                  # SPACES = LSHARP (+ 1 IF LMINUS <> 0 & FAC1 = '+')...
                257: *                                          ...-1*SGN(LSHARP)
                258: *                  IF A > 0 THEN
                259: *                  # SPACES = LSHARP - A (+ 1 IF LMINUS <> 0 & FAC1 = '+')
                260: *                  IF NUMBER OF LEADING SPACES > 0, THEN PRINT THEM
                261: *                  PRINT '$' IF LDOLLAR <> 0
                262: *                  PRINT '-' IF LMINUS <> 0 & FAC1 = '-'
                263: *                  PRINT A DIGITS ('0' IF A<=0 & LSHARP<>0 )
                264: *                  PRINT '.' IF DP <> 0
                265: *                  PRINT RSHARP DIGITS (MAY BE NONE)
                266: *                  PRINT '-' IF RMINUS <> 0 & FAC1 = '-', ELSE PRINT ' '




ASM/6800 1.4A0: 1AED RTP6800V1.4l       SD BASIC Version 1.4l Runtime Package (c) 1980 Software Dynamics
08/16/82 00:00:00; Page 243; Form 11    *****  P R I N T  *****
RTP.ASM
