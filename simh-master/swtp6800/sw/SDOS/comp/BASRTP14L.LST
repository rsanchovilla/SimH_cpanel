                822: *
                823: *                  DO TAB TO NEXT PRINT COLUMN
                824: *
  1D2C          825: XOPTABCOL          ;LDB    CHANEL
1D2C D63A       826:                    LDAB    CHANEL
1D2E 8DD3       827:                    BSR     GETCOL
1D30 C012       828: COLMN0             SUBB    #18             REDUCE COLUMN COUNT MODULO 18
1D32 24FC       829:                    BCC     COLMN0
1D34 50         830:                    NEGB                    = # BLANKS TO OUTPUT (>=1)
  1D35          831: COLMN1             ;STB    TBYTE
1D35 D74B       832:                    STAB    TBYTE
                833:                    ;JSR    SETSCOP         SET UP SYSCALL OPCODE
1D37 BD088C     834:                    JSR     SETSCOP
1D3A 0C         835:                    FCB     SYSCALL:WRITEA  WRITE ASCII
1D3B 08         836:                    FCB     WRITEA:SCLEN
1D3C 0000       837:                    FCB     CHANGED,IGNORED
  1D3E          838: COLMNL             ; WRITE BLOCKS OF BLANKS
                839:                    ;CLR    SYSCALLWRLEN
1D3E 7F0057     840:                    CLR     SYSCALLWRLEN
                841:                    ;LDB    TBYTE           ASSUME WRITE BUF LENGTH = COUNT
1D41 D64B       842:                    LDAB    TBYTE
                843:                    ;STB    SYSCALLWRLEN+1
1D43 D758       844:                    STAB    SYSCALLWRLEN+1
                845:                    ;LDB    #BLANKSTRINGEND-BLANKSTRING
1D45 C612       846:                    LDAB    #BLANKSTRINGEND-BLANKSTRING
                847:                    ;CMPB   TBYTE           IS ACTUAL STRING SIZE < COUNT ?
1D47 D14B       848:                    CMPB    TBYTE
1D49 2402       849:                    BCC     COLMN4          B/ NO
                850:                    ;STB    SYSCALLWRLEN+1  YES, USE LENGTH OF BLANK CONSTANT
1D4B D758       851:                    STAB    SYSCALLWRLEN+1
  1D4D          852: COLMN4             ;LDX    #BLANKSTRING    SET UP WRITE BUFFER
1D4D CE1D5E     853:                    LDX     #BLANKSTRING
1D50 DF55       854:                    STX     SYSCALLWRBUF
                855:                    ;JSR    SYSCALLONUSERCHAN AND DO THE SYSTEM CALL!
1D52 BD1245     856:                    JSR     SYSCALLONUSERCHAN
                857:                    ;LDB    TBYTE           SUBTRACT # BLANKS PRINTED...
1D55 D64B       858:                    LDAB    TBYTE
1D57 D058       859:                    SUBB    SYSCALLWRLEN+1  FROM ACTUAL COUNT
1D59 26DA       860:                    BNE     COLMN1          B/ MOVE TO PRINT.
  1D5B          861: COLMN3             ;JMP    NTRPT1
1D5B 7E02CE     862:                    JMP     NTRPT1
1D5E 20202020   863: BLANKSTRING        FCC     "                  "
1D62 20202020
1D66 20202020
1D6A 20202020
1D6E 2020
  1D70          864: BLANKSTRINGEND     EQU     *




