               1416: *                  NUMBER POINTED TO IS PUSHED ONTO THE STACK
               1417: *                  STORE RETURN ADDRESS IN RETADD AND EXITS THRU RETADD
               1418: *
  2999         1419: FLOAD
               1420:                    ;PULD                   POP RETURN ADDRESS OFF THE STACK
2999 32        1421:                    PULA
299A 33        1422:                    PULB
               1423:                    ;STD    RETADD
299B D7CE      1424:                    STAB    RETADD+1
299D 97CD      1425:                    STAA    RETADD
  299F         1426: FLOAD1             ;LDD    4,X             GET LS 16 BITS
299F E605      1427:                    LDAB    (4)+1,X
29A1 A604      1428:                    LDAA    4,X
               1429:                    ;PSHD
29A3 37        1430:                    PSHB
29A4 36        1431:                    PSHA
               1432:                    ;LDD    2,X
29A5 E603      1433:                    LDAB    (2)+1,X
29A7 A602      1434:                    LDAA    2,X
               1435:                    ;PSHD
29A9 37        1436:                    PSHB
29AA 36        1437:                    PSHA
               1438:                    ;LDD    ,X              GET MSBYTE (SIGN-EXPONENT BYTE)
29AB E601      1439:                    LDAB    (0)+1,X
29AD A600      1440:                    LDAA    0,X
               1441:                    ;PSHD
29AF 37        1442:                    PSHB
29B0 36        1443:                    PSHA
  29B1         1444: FLOAD2
               1445:                    ;JMP    [RETADD]
29B1 DECD      1446:                    LDX     RETADD
29B3 6E00      1447:                    JMP     0,X




ASM/6800 1.4A0: 29B3 RTP6800V1.4l       SD BASIC Version 1.4l Runtime Package (c) 1980 Software Dynamics
