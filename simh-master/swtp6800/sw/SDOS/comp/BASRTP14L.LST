               1380: *                  ROUND & FIX TOS TO POSITIVE NUMBER
               1381: *                  PLACE ROUNDED & FIXED TOS IN (A,B)
               1382: *                  CALL FORMAT:
               1383: *                          JSR             RNDTOS
               1384: *                          FDB             cantround
               1385: *                          ...continue here with (A,B) containing integer...
               1386: *
               1387: *                  SKIP EXIT IF 0 <= (ROUNDED TOS) <= 65535
               1388: *                  "CAN'T ROUND" EXIT IF (ROUNDED TOS) <0 OR (ROUNDED TOS) > 65535
               1389: *                  IN EITHER CASE, TOS IS POPPED
               1390: *
  0B9D         1391: RNDTOS             ;LDA    R1TYPE+2,S      SEE IF WE CAN GET OUT OF HERE FAST
0B9D 30        1392:                    TSX
0B9E A602      1393:                    LDAA    R1TYPE+2,X
0BA0 2737      1394:                    BEQ     RNDTOSI         B/ INTEGER, GET OUT QUICK!
               1395:                    ;PULD                   SIGH... ITS A FLOAT, DO IT THE HARD WAY
0BA2 32        1396:                    PULA
0BA3 33        1397:                    PULB
               1398:                    ;STD    RTPRET
0BA4 D765      1399:                    STAB    RTPRET+1
0BA6 9764      1400:                    STAA    RTPRET
               1401:                    ;JSR    FIX16           TRY TO FIX IT FIRST...
0BA8 BD2BB1    1402:                    JSR     FIX16
0BAB 2026      1403:                    BRA     RNDTOS1         B/ IT FIXED!
               1404:                    ;LDX    #FPOINT5        WON'T FIX, SO ROUND FIRST...
0BAD CE2381    1405:                    LDX     #FPOINT5
               1406:                    ;JSR    FLOAD
0BB0 BD2999    1407:                    JSR     FLOAD
               1408:                    ;JSR    FADD            NO OVERFLOW POSSIBLE HERE
0BB3 BD278F    1409:                    JSR     FADD
               1410:                    ;LDA    R1TYPE,S
0BB6 30        1411:                    TSX
0BB7 A600      1412:                    LDAA    R1TYPE,X
0BB9 2B05      1413:                    BMI     RNDERR
               1414:                    ;JSR    FIX             CONVERT TO INTEGER BY THROWING FRACTION PART AWAY
0BBB BD2BEB    1415:                    JSR     FIX
0BBE 200C      1416:                    BRA     RNDTOS2         ALL IS WELL
  0BC0         1417: RNDERR             ;LEAS   2,S             CAN'T FIX, JUST GET RID OF TOS
  0000         1418:                    IF      2<0
 *S*           1419:                    RPT     -2
 *S*           1420:                    DES
               1421:                    ELSE
  0002         1422:                    RPT     2
0BC0 31        1423:                    INS
0BC1 31
               1424:                    FIN
  0BC2         1425: RNDERR4            ;LEAS   4,S
  0000         1426:                    IF      4<0
 *S*           1427:                    RPT     -4
 *S*           1428:                    DES
               1429:                    ELSE
  0004         1430:                    RPT     4
0BC2 31        1431:                    INS
0BC3 31
0BC4 31




