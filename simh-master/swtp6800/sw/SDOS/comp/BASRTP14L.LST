 *S*            643:                    RPT     STRING
 *S*            644:                    INX
 *S*            645:                    FIN
 *S*            646: BLOCKMOVEUP ; ENTRY POINT TO BLOCKMOVE FOR 6809
 *S*            647: *       (X) = from address
 *S*            648: *       (Y) = to address
 *S*            649: *       (D) = count (0..65535)
 *S*            650: *
 *S*            651: *       On exit, (X) has old (X)+(D); (Y) has old (Y)+(D)
 *S*            652: *       Assumes that Copy-to region does NOT overlap Copy-from region
 *S*            653: *       or, if there is an overlap, that FROM <= TO.
 *S*            654: *
 *S*            655:         leau    16,x    to counter offsets used in MoveUpLoop
 *S*            656:         ; = center of last block of 16 bytes to transfer
 *S*            657:         stu     tempx   save for loop limit comparison
 *S*            658:         ;leax    d,x     compute "end of source address"
 *S*            659:                    IF      d<0
 *S*            660:                    RPT     -d
 *S*            661:                    DEX
 *S*            662:                    ELSE
 *S*            663:                    RPT     d
 *S*            664:                    INX
 *S*            665:                    FIN
 *S*            666:         leay    d,y     compute "ending destination address"
 *S*            667:         pshs    x,y     save as exit results
 *S*            668:         bitb    #1      moving an even number of bytes ?
 *S*            669:         beq     BlockMoveUp0         b/ yes
 *S*            670:         ldaa    ,-x     take care of moving odd byte
 *S*            671:         staa    ,-y
 *S*            672: BlockMoveUp0 ; even number of bytes left to move
 *S*            673:         andb    #%11110 take xfer count mod 32 (assert: count is even!)
 *S*            674:         ;tfr     b,a     adjust source and destination pointers...
 *S*            675:                    Tba
 *S*            676:         nega            compute -(count mod 32)
 *S*            677:         adda    #16     determine offset to location A, above
 *S*            678:         ;leax    a,x     adjust (X) so A is at offset -16
 *S*            679:                    IF      a<0
 *S*            680:                    RPT     -a
 *S*            681:                    DEX
 *S*            682:                    ELSE
 *S*            683:                    RPT     a
 *S*            684:                    INX
 *S*            685:                    FIN
 *S*            686:         leay    a,y     corresponding computation needed for (Y)
 *S*            687:         ;eorb    #%11110 complement so 0 maps to 15
 *S*            688:                    EORB    #%11110
 *S*            689:         aslb            shift to make multiple of 4
 *S*            690:         ldu     #BlockMoveUp32+4 set up to jump into loop
 *S*            691:         ;jmp     b,u     jmp to LDD instruction
 *S*            692:                    JMP     b
 *S*            693: ; Note: block count of 2 takes us to LDD -16,x




ASM/6800 1.4A0: 111C RTP6800V1.4l       SD BASIC Version 1.4l Runtime Package (c) 1980 Software Dynamics
08/16/82 00:00:00; Page 171; Form 6     *****  S T O R E  *****
RTP.ASM
 *S*            694: ;       block count which is multiple of 32 jmps to CMPX
 *S*            695: ;
 *S*            696: ; BytesToMove   Enter Loop at           Add To X,Y
 *S*            697: ;              BlockMoveUp32+...
 *S*            698: ;
 *S*            699: ;    32               0                     16 (or -16)
 *S*            700: ;    30               4                     -14
 *S*            701: ;    28               8                     -12
 *S*            702: ;                 .........
 *S*            703: ;     2              60                     +14
 *S*            704: ;     0              64                     +16
 *S*            705:                    page
 *S*            706: ;  Following picture is state of affairs at BlockMoveUp0
 *S*            707: ;
 *S*            708: ;                !----------!
 *S*            709: ;  entry (X) --> !          !   (offset -16)
 *S*            710: ;                !  final   !
 *S*            711: ;    (TEMPX) --> !  block   !   (offset 0)
 *S*            712: ;                !  copied  !   (Generally) Block of 32 bytes
 *S*            713: ;                !          !
 *S*            714: ;                !          !   (offset +14)
 *S*            715: ;                !----------!
 *S*            716: ;                !          !
 *S*            717: ;                !          !
 *S*            718: ;                    ...        Multiple blocks of 32 bytes
 *S*            719: ;                !          !
 *S*            720: ;                !          !
 *S*            721: ;                !----------!
 *S*            722: ;  ^          A  !  first   !   (needs to be offset -16)
 *S*            723: ;  |             !  block   !   This block is EVEN (odd byte already done)
 *S*            724: ; count mod 32   !  copied  !   but usually NOT 32 bytes in size
 *S*            725: ;  |             !----------!
 *S*            726: ;  v    (X) -->  !  bytes   !
 *S*            727: ;                !   not    !
 *S*            728: ;                !  copied  !
 *S*            729: ;                !----------!
 *S*            730: ;
 *S*            731: ;  Our intent is that each loop iteration copies 32 bytes, because
 *S*            732: ;  we can do this efficiently using 5 bit index register offsets.
 *S*            733: ;  The first loop copies just enough so the rest of the iterations can
 *S*            734: ;  always copy 32 bytes.  Each iterations backs up (X) and (Y) by 32
 *S*            735: ;  (we must do it this way to handle the fact that FROM <= TO, or we
 *S*            736: ;  may scramble some of the data when moving it), so the last loop iteration
 *S*            737: ;  has the address of (X) on entry at offset -16.
 *S*            738: ;  The loop terminates when (X) points to middle of last block that needs
 *S*            739: ;  data transferred. To do this, we need to arrange things so that the
 *S*            740: ;  point labelled A has offset -16 from (X) when we enter the loop.
 *S*            741: ;  (X)-(count mod 32)+16 is the address we desire.
 *S*            742:         page
 *S*            743: BlockMoveUpLoop ; come here to move next block of 32 bytes
 *S*            744:         ;leax    -32,x   (4+1~) "advance" source pointer
 *S*            745:                    IF      -32<0
 *S*            746:                    RPT     --32
 *S*            747:                    DEX
 *S*            748:                    ELSE




ASM/6800 1.4A0: 111C RTP6800V1.4l       SD BASIC Version 1.4l Runtime Package (c) 1980 Software Dynamics
08/16/82 00:00:00; Page 172; Form 6     *****  S T O R E  *****
RTP.ASM
 *S*            749:                    RPT     -32
 *S*            750:                    INX
 *S*            751:                    FIN
 *S*            752:         leay    -32,y   (4+1~) "advance" destination pointer
 *S*            753: BlockMoveUp32 ; move block of 32 bytes centered around (X)
 *S*            754:         ;ldd      14,x   (5+1~) fetch source pair
 *S*            755:                    LDAB    (14)+1,X
 *S*            756:                    LDAA    14,X
 *S*            757:         ;std      14,y   (5+1~) store destination pair
 *S*            758:                    STAB    14+1
 *S*            759:                    STAA    14
 *S*            760:         ;ldd      12,x   (5+1~) fetch source pair
 *S*            761:                    LDAB    (12)+1,X
 *S*            762:                    LDAA    12,X
 *S*            763:         ;std      12,y   (5+1~) store destination pair
 *S*            764:                    STAB    12+1
 *S*            765:                    STAA    12
 *S*            766:         ;ldd      10,x   (5+1~) fetch source pair
 *S*            767:                    LDAB    (10)+1,X
 *S*            768:                    LDAA    10,X
 *S*            769:         ;std      10,y   (5+1~) store destination pair
 *S*            770:                    STAB    10+1
 *S*            771:                    STAA    10
 *S*            772:         ;ldd       8,x   (5+1~) fetch source pair
 *S*            773:                    LDAB    (8)+1,X
 *S*            774:                    LDAA    8,X
 *S*            775:         ;std       8,y   (5+1~) store destination pair
 *S*            776:                    STAB    8+1
 *S*            777:                    STAA    8
 *S*            778:         ;ldd       6,x   (5+1~) fetch source pair
 *S*            779:                    LDAB    (6)+1,X
 *S*            780:                    LDAA    6,X
 *S*            781:         ;std       6,y   (5+1~) store destination pair
 *S*            782:                    STAB    6+1
 *S*            783:                    STAA    6
 *S*            784:         ;ldd       4,x   (5+1~) fetch source pair
 *S*            785:                    LDAB    (4)+1,X
 *S*            786:                    LDAA    4,X
 *S*            787:         ;std       4,y   (5+1~) store destination pair
 *S*            788:                    STAB    4+1
 *S*            789:                    STAA    4
 *S*            790:         ;ldd       2,x   (5+1~) fetch source pair
 *S*            791:                    LDAB    (2)+1,X
 *S*            792:                    LDAA    2,X
 *S*            793:         ;std       2,y   (5+1~) store destination pair
 *S*            794:                    STAB    2+1
 *S*            795:                    STAA    2
 *S*            796:         ;ldd       0,x   (5+1~) fetch source pair
 *S*            797:                    LDAB    (0)+1,X
 *S*            798:                    LDAA    0,X
 *S*            799:         ;std       0,y   (5+1~) store destination pair
 *S*            800:                    STAB    0+1
 *S*            801:                    STAA    0
 *S*            802:         ;ldd      -2,x   (5+0~) fetch source pair
 *S*            803:                    LDAB    (-2)+1,X




ASM/6800 1.4A0: 111C RTP6800V1.4l       SD BASIC Version 1.4l Runtime Package (c) 1980 Software Dynamics
08/16/82 00:00:00; Page 173; Form 6     *****  S T O R E  *****
RTP.ASM
 *S*            804:                    LDAA    -2,X
 *S*            805:         ;std      -2,y   (5+0~) store destination pair
 *S*            806:                    STAB    -2+1
 *S*            807:                    STAA    -2
 *S*            808:         ;ldd      -4,x   (5+1~) fetch source pair
 *S*            809:                    LDAB    (-4)+1,X
 *S*            810:                    LDAA    -4,X
 *S*            811:         ;std      -4,y   (5+1~) store destination pair
 *S*            812:                    STAB    -4+1
 *S*            813:                    STAA    -4
 *S*            814:         ;ldd      -6,x   (5+1~) fetch source pair
 *S*            815:                    LDAB    (-6)+1,X
 *S*            816:                    LDAA    -6,X
 *S*            817:         ;std      -6,y   (5+1~) store destination pair
 *S*            818:                    STAB    -6+1
 *S*            819:                    STAA    -6
 *S*            820:         ;ldd      -8,x   (5+1~) fetch source pair
 *S*            821:                    LDAB    (-8)+1,X
 *S*            822:                    LDAA    -8,X
 *S*            823:         ;std      -8,y   (5+1~) store destination pair
 *S*            824:                    STAB    -8+1
 *S*            825:                    STAA    -8
 *S*            826:         ;ldd     -10,x   (5+1~) fetch source pair
 *S*            827:                    LDAB    (-10)+1,X
 *S*            828:                    LDAA    -10,X
 *S*            829:         ;std     -10,y   (5+1~) store destination pair
 *S*            830:                    STAB    -10+1
 *S*            831:                    STAA    -10
 *S*            832:         ;ldd     -12,x   (5+1~) fetch source pair
 *S*            833:                    LDAB    (-12)+1,X
 *S*            834:                    LDAA    -12,X
 *S*            835:         ;std     -12,y   (5+1~) store destination pair
 *S*            836:                    STAB    -12+1
 *S*            837:                    STAA    -12
 *S*            838:         ;ldd     -14,x   (5+1~) fetch source pair
 *S*            839:                    LDAB    (-14)+1,X
 *S*            840:                    LDAA    -14,X
 *S*            841:         ;std     -14,y   (5+1~) store destination pair
 *S*            842:                    STAB    -14+1
 *S*            843:                    STAA    -14
 *S*            844:         ;ldd     -16,x   (5+1~) fetch source pair
 *S*            845:                    LDAB    (-16)+1,X
 *S*            846:                    LDAA    -16,X
 *S*            847:         ;std     -16,y   (5+1~) store destination pair
 *S*            848:                    STAB    -16+1
 *S*            849:                    STAA    -16
 *S*            850:         cmpx     tempx  (6~) check limit
 *S*            851:         bne     BlockMoveUpLoop (3~) b/ limit not reached
 *S*            852: ;                       --------
 *S*            853: ;                       15*(6+6)+5+5+5+5+6+3 = 209~/32 bytes --> 6.53~/byte
 *S*            854:         puls     x,y    set (X) and (Y) to end addresses after transfer
 *S*            855:         rts             done!
                856:                    FIN




