RTP.ASM
                114: *
                115: *                  OPSQR -- COMPUTE SQUARE ROOT OF TOS
                116: *                  ESTIMATES SQR(100^X*M):
                117: *                  = 100^(X/2)*SQR(M)      IF X IS EVEN
                118: *                  = 100^(X/2)*SQR(M)*10   IF X IS ODD
                119: *                  ESTIMATES SQR(M) == SQR(AVERAGE(M)) == SQR(AVERAGE(.01,.99)) == SQR(.5) == .7
                120: *                  USES ESTIMATE IN NEWTON-RAPHSON ITERATION TO GET ACTUAL SQUARE ROOT
                121: *
  1FBB          122: XOPSQERR           ;JSR    RTPERR          SQRT OF NEGATIVE NUMBER
1FBB BD15BA     123:                    JSR     RTPERR
1FBE 16         124:                    FCB     :SQTERR
                125: 
  1FBF          126: XOPSQR             ;LDA    VTYPE,S
1FBF 30         127:                    TSX
1FC0 A600       128:                    LDAA    VTYPE,X
1FC2 2BF7       129:                    BMI     XOPSQERR        B/ TOUGH SHIT, CHARLIE
1FC4 2609       130:                    BNE     XOPSQ1          B/ HE'S FLOATING AND NOT ZERO
  0001          131:                    IF      M6800
                132:                    ;LDA    VINT1,X         TAKE EASY WAY OUT IF NUMBER IS ZERO
1FC6 A604       133:                    LDAA    VINT1,X
1FC8 AA05       134:                    ORAA    VINT2,X
  0001          135:                    ELSEIF  M6801
 *S*            136:                    ;LDD    VINT1,X
 *S*            137:                    LDAB    (VINT1)+1,X
 *S*            138:                    LDAA    VINT1,X
 *S*            139:                    ELSE    M6809
 *S*            140:                    ;LDD    VINT1,S
 *S*            141:                    TSX
 *S*            142:                    LDAB    (VINT1)+1,X
 *S*            143:                    LDAA    VINT1,X
                144:                    FIN
1FCA 27EC       145:                    BEQ     XOPSQXIT        B/ IT IS
                146:                    ;JSR    BFLOAT          MAKE SURE HE'S FLOATING
1FCC BD1C85     147:                    JSR     BFLOAT
  1FCF          148: XOPSQ1             ;JSR    XBSUBR          DUPLICATE VALUE SO WE CAN GENERATE ESTIMATE...
1FCF BD2106     149:                    JSR     XBSUBR
1FD2 11         150:                    OPDUP                   OF SQUARE ROOT
1FD3 70         151:                    OPASM                   = (VALUE MANTISSA)*100^(EXPONENT/2)
                152:                    ;LDA    VTYPE,S         GO GET THE EXPONENT
1FD4 30         153:                    TSX
1FD5 A600       154:                    LDAA    VTYPE,X
1FD7 8040       155:                    SUBA    #$40            CONVERT FROM EXCESS 64 TO SIGNED
1FD9 47         156:                    ASRA                    DIVIDE BY 2, PRESERVE SIGN
                157:                    ;LDB    #70             EVEN EXPONENT --> USE .7 AS ESTIMATE
1FDA C646       158:                    LDAB    #70
1FDC 2402       159:                    BCC     XOPSQ2          B/ EVEN EXPONENT
                160:                    ;LDB    #07             ODD EXPONENT --> USE .7*10 AS ESTIMATE
1FDE C607       161:                    LDAB    #07
1FE0 8940       162: XOPSQ2             ADCA    #$40            CONVERT BACK TO EXCESS 64
  0001          163:                    IF      M6800!M6801
                164:                    ;STD    VTYPE,X         TOS NOW HAS VERY ROUGH SQRT
1FE2 E701       165:                    STAB    (VTYPE)+1,X
1FE4 A700       166:                    STAA    VTYPE,X
  0001          167:                    ELSE    (M6809)
 *S*            168:                    ;STD    VTYPE,S         STORE ESTIMATED MANTISSA




ASM/6800 1.4A0: 1FE4 RTP6800V1.4l       SD BASIC Version 1.4l Runtime Package (c) 1980 Software Dynamics
