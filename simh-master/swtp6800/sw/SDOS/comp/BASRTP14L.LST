07C7 EE06       174:                    LDX     R1SDC1+2,X
07C9 8CFFFF     175:                    CPX     #$FFFF          = "ALL" ?
07CC 2605       176:                    BNE     SCMP1           B/ NO, (X) = LENGTH
                177:                    ;LDX    R1SDA+2,S       YES, GET ACTUAL STRING LENGTH
07CE 30         178:                    TSX
07CF EE04       179:                    LDX     R1SDA+2,X
                180:                    ;LDX    CURLEN,X
07D1 EE02       181:                    LDX     CURLEN,X
07D3 DF56       182: SCMP1              STX     S2LEN
                183:                    ;LDX    R2SDC1+2,S      GET S1 LENGTH
07D5 30         184:                    TSX
07D6 EE0C       185:                    LDX     R2SDC1+2,X
07D8 8CFFFF     186:                    CPX     #$FFFF          USE CURRENT LENGTH?
07DB 2605       187:                    BNE     SCMP2           NO
                188:                    ;LDX    R2SDA+2,S       GET S2 ADDRESS
07DD 30         189:                    TSX
07DE EE0A       190:                    LDX     R2SDA+2,X
                191:                    ;LDX    CURLEN,X        GET CURRENT LENGTH
07E0 EE02       192:                    LDX     CURLEN,X
07E2 DF54       193: SCMP2              STX     S1LEN           TAKE MIN( LEN(S1), LEN(S2) )
07E4 9C56       194:                    CPX     S2LEN           LENGTHS = ?
07E6 2715       195:                    BEQ     SCMP7
                196:                    ;LDD    S1LEN           S1LEN <> S2LEN
07E8 D655       197:                    LDAB    S1LEN+1
07EA 9654       198:                    LDAA    S1LEN
                199:                    ;SUBD   S2LEN
07EC D057       200:                    SUBB    S2LEN+1
07EE 9256       201:                    SBCA    S2LEN
07F0 46         202:                    RORA                    MAKE -1 OR $7F
07F1 8A7F       203:                    ORAA    #$7F
                204:                    ;STA    TBYTE
07F3 974B       205:                    STAA    TBYTE
07F5 2A09       206:                    BPL     SCMP3           B/ LEN(S1) >= LEN(S2)
                207:                    ;LDX    S1LEN           LEN(S1) < LEN(S2)
07F7 DE54       208:                    LDX     S1LEN
07F9 27C5       209:                    BEQ     SCMPLS          B/ LEN(S1) = 0 --> S1 < S2
07FB 2007       210:                    BRA     SCMP6
                211: 




