                447: *
                448: *                  STORETOS -- STORES NUMERIC VALUE ON TOS AT (X)
                449: *                  FIXES TO 16 BITS IF POSSIBLE
                450: *                  POPS TOS VALUE
                451: *
  0E3A          452: STORETOS           EQU     *
                453:                    ;PULD                   SAVE RETURN ADDRESS
0E3A 32         454:                    PULA
0E3B 33         455:                    PULB
                456:                    ;STD    RTPRET
0E3C D765       457:                    STAB    RTPRET+1
0E3E 9764       458:                    STAA    RTPRET
0E40 32         459:                    PULA                    EXPONENT BYTE
                460:                    ;STA    VFLT1,X         SAVE IT AT TARGET
0E41 A700       461:                    STAA    VFLT1,X
0E43 2724       462:                    BEQ     STORETOSI       B/ AN INTEGER, TAKE FAST PATH
0E45 36         463:                    PSHA                    FLOAT, PUSH EXPONENT BYTE BACK ON STACK
0E46 DFDF       464:                    STX     STORETARGET     SAVE WHERE TO PUT RESULT
                465:                    ;JSR    FIX16           TRY TO FIX IT
0E48 BD2BB1     466:                    JSR     FIX16
0E4B 2016       467:                    BRA     STORETOSF       B/ IT FIXED!
                468:                    ;LDX    STORETARGET     WON'T FIX, GET TARGET ADDRESS AGAIN
0E4D DEDF       469:                    LDX     STORETARGET
0E4F 31         470:                    INS                     WE ALREADY STORED THE EXPONENT BYTE
0E50 32         471:                    PULA                    FINISH STORING THE F.P. VALUE
                472:                    ;STA    VFLT2,X
0E51 A701       473:                    STAA    VFLT2,X
                474:                    ;PULD
0E53 32         475:                    PULA
0E54 33         476:                    PULB
                477:                    ;STD    VFLT3,X
0E55 E703       478:                    STAB    (VFLT3)+1,X
0E57 A702       479:                    STAA    VFLT3,X
                480:                    ;PULD
0E59 32         481:                    PULA
0E5A 33         482:                    PULB
                483:                    ;STD    VFLT5,X
0E5B E705       484:                    STAB    (VFLT5)+1,X
0E5D A704       485:                    STAA    VFLT5,X
                486:                    ;JMP    [RTPRET]        AND GET OUT
0E5F DE64       487:                    LDX     RTPRET
0E61 6E00       488:                    JMP     0,X




