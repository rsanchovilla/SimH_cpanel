                  2: *****  R A N D O M   N U M B E R  G E N E R A T I O N *****
                  3: *
                  4: *                  SET SEED (OPSETSEED): COMPILER STMT "LET RND=exp"
                  5: *
  1F30            6: XOPSETSEED         ;JSR    FORCEFLOAT      SO ALL THE SIGNIFICANCE IS IN LEFTMOST 4 BYTES
1F30 BD1C80       7:                    JSR     FORCEFLOAT
                  8:                    ;LDX    #SEED           AND STORE THE VALUE
1F33 CE0084       9:                    LDX     #SEED
                 10:                    ;JSR    FSTORE          (XOPRND ONLY USES 1ST 4 BYTES OF "SEED")
1F36 BD23D3      11:                    JSR     FSTORE
                 12:                    ;JMP    NTRPT2
1F39 7E02EF      13:                    JMP     NTRPT2
                 14: 
                 15: *
                 16: *                  OPRND-- GENERATE RANDOM NUMBER BETWEEN 0 AND 1
                 17: *                  PUSH VALUE ONTO STACK
                 18: *                  USES SEED':=(SEED*A+C) MOD M
                 19: *                  RESULT = SEED'/2^31
                 20: *                  A = 2^23+2^14+2^2+1, C=1, M=2^31 (SEE KNUTH)
                 21: *
  1F3C           22: XOPRND             ;LDD    SEED+2          SET SEED':=SEED
1F3C D687        23:                    LDAB    SEED+2+1
1F3E 9686        24:                    LDAA    SEED+2
                 25:                    ;PSHD                   (SEED' IS TOP 4 BYTES OF STACK)
1F40 37          26:                    PSHB
1F41 36          27:                    PSHA
                 28:                    ;LDA    SEED+1
1F42 9685        29:                    LDAA    SEED+1
1F44 36          30:                    PSHA
                 31:                    ;LDA    SEED
1F45 9684        32:                    LDAA    SEED
1F47 36          33:                    PSHA
1F48 30          34:                    TSX                     NOW (X) POINTS TO SEED'
1F49 58          35:                    ASLB                    TEMP:=SEED*2^2
1F4A 790086      36:                    ROL     SEED+2
1F4D 790085      37:                    ROL     SEED+1
1F50 790084      38:                    ROL     SEED
1F53 58          39:                    ASLB
1F54 790086      40:                    ROL     SEED+2
1F57 790085      41:                    ROL     SEED+1
1F5A 790084      42:                    ROL     SEED
1F5D 0D          43:                    SEC                     SEED':=SEED'+TEMP+1
                 44:                    ;TFR    B,A             (B CONTAINS LOWER 8 BITS OF SEED)
1F5E 17          45:                    TBA
1F5F A903        46:                    ADCA    3,X
                 47:                    ;STA    3,X
1F61 A703        48:                    STAA    3,X
                 49:                    ;LDA    2,X
1F63 A602        50:                    LDAA    2,X
1F65 9986        51:                    ADCA    SEED+2
                 52:                    ;STA    2,X
1F67 A702        53:                    STAA    2,X
                 54:                    ;LDA    1,X
1F69 A601        55:                    LDAA    1,X
1F6B 9985        56:                    ADCA    SEED+1




