 *S*            124:                    ;ORA    R2TYPE+2,S
 *S*            125:                    TSX
 *S*            126:                    ORAA    R2TYPE+2,X
 *S*            127:                    BNE     ACMPF
 *S*            128:                    ;LDX    ,S              GET RETURN
 *S*            129:                    TSX
 *S*            130:                    LDX     0,X
 *S*            131:                    ;LDD    R2INT1+2,S
 *S*            132:                    TSX
 *S*            133:                    LDAB    (R2INT1+2)+1,X
 *S*            134:                    LDAA    R2INT1+2,X
 *S*            135:                    ;SUBD   R1INT1+2,S      COMPUTE INTEGER DIFFERENCE, SETTING CC BITS
 *S*            136:                    TSX
 *S*            137:                    SUBB    (R1INT1+2)+1,X
 *S*            138:                    SBCA    R1INT1+2,X
 *S*            139:                    BEQ     ACMP5           B/ RESULT IS ZERO, CC IS SET PROPERLY
 *S*            140:                    TPA                     MUST CONVERT UNSIGNED COMPARE CC BITS...
 *S*            141:                    RORA                    TO SIGNED COMPARE CC
 *S*            142:                    RORA                    (MOVE BORROW BIT TO SIGN BIT)
 *S*            143:                    ;ORA    #1              ENSURE ANSWER IS "NOT ZERO", RESET OVERFLOW
 *S*            144:                    ORAA    #1
 *S*            145: ACMP5              ;LEAS   RSESIZ*2+2,S    POP RETURN, 1 ENTRY AND 4 BYTES OF OTHER ENTRY
 *S*            146:                    IF      RSESIZ*2+2<0
 *S*            147:                    RPT     -RSESIZ*2+2
 *S*            148:                    DES
 *S*            149:                    ELSE
 *S*            150:                    RPT     RSESIZ*2+2
 *S*            151:                    INS
 *S*            152:                    FIN
 *S*            153:                    ;JMP    ,X
 *S*            154:                    JMP     0,X
                155:                    FIN




