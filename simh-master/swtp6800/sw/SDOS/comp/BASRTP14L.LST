  0001          419:                    ELSE    (M6809)
 *S*            420:                    PAGE
 *S*            421: BLOCKMOVEDOWNS     ;LEAX   STRING,X        MOVE STRING, COMPUTE POINTER TO 1ST BYTE
 *S*            422:                    IF      STRING<0
 *S*            423:                    RPT     -STRING
 *S*            424:                    DEX
 *S*            425:                    ELSE
 *S*            426:                    RPT     STRING
 *S*            427:                    INX
 *S*            428:                    FIN
 *S*            429: BLOCKMOVEDOWN ; ENTRY POINT TO BLOCKMOVE FOR 6809
 *S*            430: *       (X) = from address
 *S*            431: *       (Y) = to address
 *S*            432: *       (D) = count (0..65535)
 *S*            433: *
 *S*            434: *       On exit, (X) has old (X)+(D); (Y) has old (Y)+(D)
 *S*            435: *       Assumes that Copy-to region does NOT overlap Copy-from region
 *S*            436: *       or, if there is an overlap, that FROM >= TO.
 *S*            437: *
 *S*            438:         leau    d,x     compute "end of transfer address"
 *S*            439:         leau    -16,u   to counter offsets used in MoveDownLoop
 *S*            440:         ; = center of last block of 16 bytes to transfer
 *S*            441:         stu     tempx   save for loop limit comparison
 *S*            442:         bitb    #1      moving an even number of bytes ?
 *S*            443:         beq     BlockMoveDown0         b/ yes
 *S*            444:         ldaa    ,x+     take care of moving odd byte
 *S*            445:         staa    ,y+
 *S*            446: BlockMoveDown0 ; even number of bytes left to move
 *S*            447:         andb    #%11110 take xfer count mod 32 (assert: count is even!)
 *S*            448:         ;tfr     b,a     adjust source and destination pointers...
 *S*            449:                    Tba
 *S*            450:         adda    #-16    to point to middle of block of 32 bytes
 *S*            451:         ;leax    a,x     add (count mod 32)-16
 *S*            452:                    IF      a<0
 *S*            453:                    RPT     -a
 *S*            454:                    DEX
 *S*            455:                    ELSE
 *S*            456:                    RPT     a
 *S*            457:                    INX
 *S*            458:                    FIN
 *S*            459:         leay    a,y
 *S*            460:         ;eorb    #%11110 complement so 0 maps to 15
 *S*            461:                    EORB    #%11110
 *S*            462:         aslb            shift to make multiple of 4
 *S*            463:         ldu     #BlockMoveDown32+4 set up to jump into loop
 *S*            464:         ;jmp     b,u     jmp to LDD instruction
 *S*            465:                    JMP     b
 *S*            466: ; Note: block count of 2 takes us to LDD 14,x
 *S*            467: ;       block count which is multiple of 32 jmps to CMPX
 *S*            468: ;
 *S*            469: ; BytesToMove   Enter Loop at           Add To X,Y
 *S*            470: ;              BlockMoveDown32+...
 *S*            471: ;
 *S*            472: ;    32               0                     16
 *S*            473: ;    30               4                     14




ASM/6800 1.4A0: 111C RTP6800V1.4l       SD BASIC Version 1.4l Runtime Package (c) 1980 Software Dynamics
08/16/82 00:00:00; Page 167; Form 6     *****  S T O R E  *****
RTP.ASM
 *S*            474: ;    28               8                     12
 *S*            475: ;                 .........
 *S*            476: ;     2              60                    -14
 *S*            477: ;     0              64                    -16
 *S*            478:                    page
 *S*            479: ;  Following picture is state of affairs at BlockMoveDown0
 *S*            480: ;
 *S*            481: ;                !----------!
 *S*            482: ; ^   (X) -->    !          !
 *S*            483: ; |              !  first   !
 *S*            484: ; |              !  block   !   This block is EVEN (odd byte already done)
 *S*            485: ; count mod 32   !  copied  !   but usually NOT 32 bytes in size
 *S*            486: ; |              !          !
 *S*            487: ; |              !----------!
 *S*            488: ; v          A   !          !   (offset -16)
 *S*            489: ;                !          !
 *S*            490: ;                    ...        Multiple blocks of 32 bytes
 *S*            491: ;                !          !
 *S*            492: ;                !          !
 *S*            493: ;                !----------!
 *S*            494: ;                !          !   (offset -16)
 *S*            495: ;                !  final   !
 *S*            496: ;    (TEMPX) --> !  block   !   (offset 0)
 *S*            497: ;                !  copied  !   (Generally) Block of 32 bytes
 *S*            498: ;                !          !
 *S*            499: ;                !          !   (offset +14)
 *S*            500: ;                !----------!
 *S*            501: ;    (X)+(D) --> !          !
 *S*            502: ;                    ....
 *S*            503: ;
 *S*            504: ;  Our intent is that each loop iteration copies 32 bytes, because
 *S*            505: ;  we can do this most efficiently using 5 bit index register offsets.
 *S*            506: ;  The first loop copies just enough so the rest of the iterations can
 *S*            507: ;  always copy 32 bytes. Each iteration advances (X) and (Y) by 32
 *S*            508: ;  (we must do it this because FROM >= TO, or we may scramble the data
 *S*            509: ;  we are moving), so that the last loop iteration has (X)+16 pointing to
 *S*            510: ;  the end-of-transfer address.  The loop terminates when (X) points to
 *S*            511: ;  the middle of last block that needs data transferred. To do this, we
 *S*            512: ;  need to arrange things so that the point labelled A has offset -16
 *S*            513: ;  on the second iteration of the loop.  Setting (X)-16+(count mod 32)
 *S*            514: ;  accomplishes this nicely.
 *S*            515:         page
 *S*            516: BlockMoveDownLoop ; come here to move next block of 32 bytes
 *S*            517:         ;leax     32,x   (4+1~) advance source pointer
 *S*            518:                    IF      32<0
 *S*            519:                    RPT     -32
 *S*            520:                    DEX
 *S*            521:                    ELSE
 *S*            522:                    RPT     32
 *S*            523:                    INX
 *S*            524:                    FIN
 *S*            525:         leay     32,y   (4+1~) advance destination pointer
 *S*            526: BlockMoveDown32 ; move block of 32 bytes centered around (X)
 *S*            527:         ;ldd     -16,x   (5+1~) fetch source pair
 *S*            528:                    LDAB    (-16)+1,X




