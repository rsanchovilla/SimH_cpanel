                400: *                  DIGIT MULTIPLY
                401: *                  MULTIPLIES REG B BY ML, RETURNS RESULT IN A,B
                402: *
  24F4          403: MULBASE100         EQU     *               ML*(B) -> (A,B) BASE 100 WITH BINARY DIGITS
  0001          404:                    IF      M6800
24F4 4F         405:                    CLRA                    ZERO PARTIAL PRODUCT
24F5 56         406:                    RORB                    LOOK AT LSB OF MULTIPLIER
24F6 2402       407:                    BCC     *+4             B/ =0, LEAVE PARTIAL PRODUCT AS ZERO
                408:                    ;LDA    ML              USE MULTIPLICAND AS 1ST PARTIAL PRODUCT
24F8 96A7       409:                    LDAA    ML
24FA 44         410:                    LSRA                    SHIFT PARTIAL PRODUCT ONE BIT RIGHT
24FB 56         411:                    RORB                    SHIFT OUT MULTIPLIER BIT
24FC 2402       412:                    BCC     *+4             B/ MULTIPLIER BIT IS ZERO
24FE 9BA7       413:                    ADDA    ML              IS ONE, ADD MULTIPLICAND TO PARTIAL PRODUCT
2500 46         414:                    RORA                    SHIFT PARTIAL PRODUCT ONE BIT RIGHT
2501 56         415:                    RORB                    SHIFT OUT MULTIPLIER BIT
2502 2402       416:                    BCC     *+4             B/ MULTIPLIER BIT IS ZERO
2504 9BA7       417:                    ADDA    ML              IS ONE, ADD MULTIPLICAND TO PARTIAL PRODUCT
2506 46         418:                    RORA                    SHIFT PARTIAL PRODUCT ONE BIT RIGHT
2507 56         419:                    RORB                    SHIFT OUT MULTIPLIER BIT
2508 2402       420:                    BCC     *+4             B/ MULTIPLIER BIT IS ZERO
250A 9BA7       421:                    ADDA    ML              IS ONE, ADD MULTIPLICAND TO PARTIAL PRODUCT
250C 46         422:                    RORA                    SHIFT PARTIAL PRODUCT ONE BIT RIGHT
250D 56         423:                    RORB                    SHIFT OUT MULTIPLIER BIT
250E 2402       424:                    BCC     *+4             B/ MULTIPLIER BIT IS ZERO
2510 9BA7       425:                    ADDA    ML              IS ONE, ADD MULTIPLICAND TO PARTIAL PRODUCT
2512 46         426:                    RORA                    SHIFT PARTIAL PRODUCT ONE BIT RIGHT
2513 56         427:                    RORB                    SHIFT OUT MULTIPLIER BIT
2514 2402       428:                    BCC     *+4             B/ MULTIPLIER BIT IS ZERO
2516 9BA7       429:                    ADDA    ML              IS ONE, ADD MULTIPLICAND TO PARTIAL PRODUCT
2518 46         430:                    RORA                    SHIFT PARTIAL PRODUCT ONE BIT RIGHT
2519 56         431:                    RORB                    SHIFT OUT MULTIPLIER BIT
251A 2402       432:                    BCC     *+4             B/ MULTIPLIER BIT IS ZERO
251C 9BA7       433:                    ADDA    ML              IS ONE, ADD MULTIPLICAND TO PARTIAL PRODUCT
251E 46         434:                    RORA                    ONE MORE RIGHT SHIFT COMPLETE 6809 COMPATIBLE MULTIPLY
251F 56         435:                    RORB                    BINARY PRODUCT OF (A)*(B) IS IN (A,B)
2520 44         436:                    LSRA                    AND ANOTHER FOR BETTER LUCK
