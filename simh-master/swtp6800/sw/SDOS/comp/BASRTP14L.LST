                 98:                    ;LDA    R2INT2+2,X
079F A60D        99:                    LDAA    R2INT2+2,X
07A1 A007       100:                    SUBA    R1INT2+2,X
07A3 2707       101:                    BEQ     ACMP4
07A5 2403       102: ACMPCC             BCC     ACMPGT
  07A7          103: ACMPLS             ;LDA    #-1
07A7 86FF       104:                    LDAA    #-1
07A9 8C         105:                    SK2
  07AA          106: ACMPGT             ;LDA    #1
07AA 8601       107:                    LDAA    #1
  07AC          108: ACMP4              ;LDX    ,X              FETCH RETURN ADDRESS
07AC EE00       109:                    LDX     0,X
07AE 9F00       110:                    STS     TEMPX           POP 2 ENTRIES OFF THE STACK
                111:                    ;LDB    #RSESIZ*2+2
07B0 C60E       112:                    LDAB    #RSESIZ*2+2
07B2 DB01       113:                    ADDB    TEMPX+1
                114:                    ;STB    TEMPX+1
07B4 D701       115:                    STAB    TEMPX+1
