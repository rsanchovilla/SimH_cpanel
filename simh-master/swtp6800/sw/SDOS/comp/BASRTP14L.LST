                589:                    ;LDX    R2SDC1,X        GET LENGTH OF S1
0EB3 EE0A       590:                    LDX     R2SDC1,X
  0001          591:                    ELSE    (M6809)
 *S*            592:                    STS     TWORD
 *S*            593:                    ;LDX    R2SDC1,S
 *S*            594:                    TSX
 *S*            595:                    LDX     R2SDC1,X
                596:                    FIN
0EB5 8CFFFF     597:                    CPX     #$FFFF
