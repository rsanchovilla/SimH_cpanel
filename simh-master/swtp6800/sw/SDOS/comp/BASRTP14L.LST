                887: *                  THIS ROUTINE MULTIPLIES THE QUOTIENT DIGIT ML BY REG B
                888: *                  AND SUBTRACTS IT FROM 0,X THEN DEX & RTS
                889: *
275D 2604       890: FDIVSS             BNE     FDIVSS1         B/ DIGIT (B) IS NON-ZERO
275F 4F         891:                    CLRA                    DIGIT IS ZERO --> PRODUCT IS ZERO
                892:                    ;JMP    FDIVSS1A        SKIP INTO LOOP AT CORRECT PLACE
2760 7E276A     893:                    JMP     FDIVSS1A
                894: 
  2763          895: FDIVSS1            EQU     *
2763 DFC3       896:                    STX     FACX
                897:                    ;JSR    MULBASE100      PRODUCE BASE 100 PRODUCT
2765 BD24F4     898:                    JSR     MULBASE100
                899:                    ;LDX    FACX
2768 DEC3       900:                    LDX     FACX
276A 09         901: FDIVSS1A           DEX                     --> USE 1,X INSTEAD OF 0,X
276B DBC2       902:                    ADDB    CTNB            TOTAL TO SUBTRACT; ASSERT (B)<=200
276D 0D         903: FDIVSSL            SEC                     ADD THE NEGATIVE TO GET A SUBTRACT
276E 53         904:                    COMB
276F E906       905:                    ADCB    5+1,X           (0..99)-(0..201) => (99..-201)
2771 2508       906:                    BCS     FDIVSSA         B/ ANSWER IS OK AS IT
                907:                    ;CMPB   #-100           OOPS, ANSWER IS NEGATIVE
2773 C19C       908:                    CMPB    #-100
2775 2409       909:                    BCC     FDIVSS2         B/ 0>ANSWER>=-100
2777 8B02       910:                    ADDA    #2              ANSWER < -100, ADJUST PROPERLY
2779 CBC8       911:                    ADDB    #200
  277B          912: FDIVSSA            ;STA    CTNB            MIGHT BE AS LARGE AS 101
277B 97C2       913:                    STAA    CTNB
                914:                    ;STB    5+1,X           SAVE RESULT DIGIT
277D E706       915:                    STAB    5+1,X
277F 39         916:                    RTS
                917: 
2780 4C         918: FDIVSS2            INCA                    ADJUST BORROW TO NEXT BYTE
2781 CB64       919:                    ADDB    #100            MAKE DIGIT POSITIVE
                920:                    ;STA    CTNB            STORE BORROW
2783 97C2       921:                    STAA    CTNB
                922:                    ;STB    5+1,X           SAVE RESULT DIGIT LAST TO MAKE EASY TEST
2785 E706       923:                    STAB    5+1,X
2787 39         924:                    RTS




