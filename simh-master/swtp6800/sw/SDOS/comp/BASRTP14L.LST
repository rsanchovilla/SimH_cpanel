                373: *
                374: *                  STORE TOS USING INLINE ADDRESS
                375: *                  OPSTD,ADDRESSOFSCALAR
                376: *
  0DF8          377: XOPSTD             ; STORE DIRECT
  0001          378:                    IF      M6800!M6801
                379:                    ;LDX    BPC
0DF8 DE2E       380:                    LDX     BPC
                381:                    FIN
                382:                    ;LDX    ILADD,X         GET "WHERE TO PUT RESULT"
0DFA EE00       383:                    LDX     ILADD,X
0DFC 32         384:                    PULA                    GRAB EXPONENT BYTE
                385:                    ;STA    VFLT1,X         SAVE IT IN TARGET
0DFD A700       386:                    STAA    VFLT1,X
0DFF 2725       387:                    BEQ     XOPSTDI         B/ AN INTEGER, TAKE OPTIMIZED PATH
0E01 36         388:                    PSHA                    ITS FLOAT, PUSH EXPONENT BYTE BACK ON
                389:                    ;JSR    FIX16           TRY TO FIX TO 16 BITS
0E02 BD2BB1     390:                    JSR     FIX16
0E05 2017       391:                    BRA     XOPSTD2         B/ IT FIXED!
                392:                    ;LDX    [BPC]           WON'T FIX, JUST STORE IT LIKE IT IS
0E07 DE2E       393:                    LDX     BPC
0E09 EE00       394:                    LDX     0,X
0E0B 31         395:                    INS                     POP EXPONENT BYTE OFF STACK, WE ALREADY STORED IT
0E0C 32         396:                    PULA                    STORE REST OF VALUE INTO TARGET
                397:                    ;STA    VFLT2,X
0E0D A701       398:                    STAA    VFLT2,X
                399:                    ;PULD
0E0F 32         400:                    PULA
0E10 33         401:                    PULB
                402:                    ;STD    VFLT3,X
0E11 E703       403:                    STAB    (VFLT3)+1,X
0E13 A702       404:                    STAA    VFLT3,X
                405:                    ;PULD
0E15 32         406:                    PULA
0E16 33         407:                    PULB
                408:                    ;STD    VFLT5,X
0E17 E705       409:                    STAB    (VFLT5)+1,X
0E19 A704       410:                    STAA    VFLT5,X
                411:                    ;JMP    NTRPT3
0E1B 7E0316     412:                    JMP     NTRPT3
                413: 
  0E1E          414: XOPSTD2            ;LDX    [BPC]           TOS FORM IS (0,0,V,V); GET WHERE TO PUT VALUE
0E1E DE2E       415:                    LDX     BPC
0E20 EE00       416:                    LDX     0,X
                417:                    ;CLR    VTYPE,X         MARK AS INTEGER
0E22 6F00       418:                    CLR     VTYPE,X
0E24 2001       419:                    BRA     XOPSTD3         SKIP OVER EXTRANEOUS "POP"
  0E26          420: XOPSTDI            EQU     *               STORE INTEGER OPTIMIZED PATH
0E26 31         421:                    INS                     TOS FORM IS (X,X,X,V,V)
  0E27          422: XOPSTD3            ;LEAS   2,S             TOS FORM IS (X,X,V,V), POP THE X,X GARBAGE OFF
  0000          423:                    IF      2<0
 *S*            424:                    RPT     -2
 *S*            425:                    DES
                426:                    ELSE
  0002          427:                    RPT     2




