RTP.ASM
                100: *                  PARAMETERIZED SUBROUTINE/FUNCTION ENTRY POINT
                101: *
                102: *                  JSR $106                WITH (A) = # ARGUMENTS PASSED BY CALLER
                103: *                  FCB     version
                104: *                  FDB     forwardreflabelchain
                105: *                  FDB     pointer to first byte of last parameter variable storage
                106: *                                          Argument variables are allocated contiguously
                107: *                  FDB     baseofscalarvariables
                108: *                  FDB     address of 1st byte above the data space
                109: *                  FCB     #arguments given by SUBROUTINE/FUNCTION definition
                110: *                          ...basic opcodes...
                111: *
                112: *
                113: *                  1) CHECK ARG COUNT AND COMPLAIN IF INCORRECT
                114: *                  2) COPY ARGS OFF STACK INTO PARAMETER VARIABLES
                115: *                  3) PUSH RETURN ADDRESS (BPC) ONTO STACK ALONG WITH:
                116: *                          SCALAR VARIABLE TABLE BASE
                117: *                          LAST ENCOUNTERED LINE NUMBER/LABEL OPCODE ADDRESS
                118: *                          CURRENT VALUE OF ERROR TRAP ADDRESS
                119: *                          OLD STACKFRAMEBASE, ERRORRECOVERYSTACK
                120: *                  4) GO DO AN XOPSETLABEL
                121: *
                122: *                  NOTE: ON A RETURN STATEMENT, CONTROL IS NOT PASSED BACK TO XOPCALL!
                123: *                  THIS IS BECAUSE XOPCALL WILL ATTEMPT TO CLEAN OFF THE STACK,
                124: *                  AND THIS WILL HAVE ALREADY BEEN DONE.
                125: *
  0000          126:                    IF      OPLINE=$BD
 *S*            127:                    ?can't tell JSR from OPLINE?
                128:                    FIN
                129: 
  13CC          130: ARGCOUNTERROR      EQU     *
                131:                    ;LDX    #0              KILL OFF THE ERROR TRAP ADDRESS
13CC CE0000     132:                    LDX     #0
13CF DF32       133:                    STX     ERTRAP          SO THE ERROR IS FATAL
                134:                    ;JSR    RTPERR
13D1 BD15BA     135:                    JSR     RTPERR
13D4 1B         136:                    FCB     :ARGCNTERR
                137: 
  13D5          138: VERSIONERRJ        ;JMP    VERSIONERROR
13D5 7E03F5     139:                    JMP     VERSIONERROR




