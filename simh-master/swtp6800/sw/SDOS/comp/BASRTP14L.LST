                  2: *                  UNFORMATTED PRINT
                  3: *                  SUBROUTINE FOR XOPPV, XOPNUM
                  4: *
                  5: *                  A HAS # OF DIGITS LEFT OF THE DP IF E WERE = 0 (# OF INT DIGITS)
                  6: *                  B HAS # OF SIGNIFICANT DIGITS (10 - # OF RIGHTMOST ZEROES)
                  7: *                  X POINTS TO WHERE THE STUFF IS TO BE PUT
                  8: *                  LDOLLAR CONTAINS LEFT DOLLAR COUNT
                  9: *                  LMINUS CONTAINS LEFT MINUS COUNT
                 10: *                  LSHARP CONTAINS LEFT SHARP COUNT
                 11: *                  DP CONTAINS DP COUNT
                 12: *                  RSHARP CONTAINS RIGHT SHARP COUNT
                 13: *                  RMINUS CONTAINS RIGHT MINUS COUNT
                 14: *                  RCARET CONTAINS RIGHT CARET COUNT
                 15: *                  FLENGTH CONTAINS LENGTH OF ENTIRE FORMAT
                 16: *                  FAC1-FAC6               CONTAINS "S.DDDD"
                 17: *                  FACEXT1-FACEXT5         CONTAINS "DDDDDD"
                 18: *                  MS1-MS6 CONTAINS        "DESXXX"
                 19: *                  WHERE   S IS A '-' OR '+'
                 20: *                  . IS A '.'
                 21: *                  D IS AN ASCII DIGIT IN THE RANGE '0'-'9'
                 22: *                  E IS A 'E'
                 23: *                  X IS AN ASCII EXPONENT DIGIT IN THE RANGE '0'-'9'
                 24: *                  ON EXIT, A RETURNS LENGTH
                 25: *                  X POINTS PAST OUTPUT
                 26: *
                 27: *                  CASE1   (ZERO)
                 28: *                  A = 0 & ALL DIGITS ARE ZERO
                 29: *                  (B = 0 SUFFICIENT)
                 30: *                  PRINT ' 0'
                 31: *
                 32: *                  CASE2   (INTEGER)
                 33: *                  10 >= A >= 1 & RIGHTMOST 10-A DIGITS ARE ZERO
                 34: *                  (A >= B)
                 35: *                  PRINT SIGN, A DIGITS
                 36: *
                 37: *                  CASE3   (INT W/FRAC)
                 38: *                  9 >= A >=0 & RIGHTMOST 10-A DIGITS ARE NON-ZERO
                 39: *                  (A < B)
                 40: *                  PRINT SIGN, A DIGITS, '.' B DIGITS
                 41: *
                 42: *                  CASE4   (SMALL FRACTION ONLY)
                 43: *                  -1 >= A >= -5
                 44: *                  PRINT SIGN, '.' (ABS(A)) ZEROES, B DIGITS
                 45: *
                 46: *                  CASE5   (ALL ELSE)
                 47: *                  PRINT SIGN, '.', B DIGITS
                 48: *                  PRINT 'E', ESIGN, UP TO 3 DIGITS LEAD ZERO SUPPRESS
                 49: *
1A31 DF51        50: UFPRINT            STX     TWORD           REMEMBER WHERE TO PUT THE RESULT
                 51:                    ;CLR    TBYTE           CLEAR THE LENGTH COUNTER
1A33 7F004B      52:                    CLR     TBYTE
1A36 5D          53:                    TSTB                    ANY SIGNIFICANCE?
1A37 2607        54:                    BNE     UFPRNT1         YES
1A39 4C          55:                    INCA
1A3A 8D52        56: UFPRNT0            BSR     UFPRSN          CASE 2, PRINT SIGN




