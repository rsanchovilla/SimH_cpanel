               1213: *                  QUICK MULTIPLY (UNSIGNED)
               1214: *                  A,B CONTAIN MULTIPLICAND
               1215: *                  X CONTAINS MULTIPLIER, SMALLER PREFERRED
               1216: *                  A,B WILL CONTAIN RESULT
               1217: *                  SKIP RETURN IF OVERFLOW
               1218: *
1EC5 DFA8      1219: MLTPLY             STX     MR1             SAVE MULTIPLIER
1EC7 2728      1220:                    BEQ     MLTPLY0         B/ MULTIPLIER IS 0 --> PRODUCT IS ZERO
               1221:                    ;STB    MS2             SAVE LOWER 8 BITS OF MULTIPLICAND
1EC9 D7BC      1222:                    STAB    MS2
               1223:                    ;STA    MS1
1ECB 97BB      1224:                    STAA    MS1
1ECD 2718      1225:                    BEQ     MLTPLYA         B/ MS1 IS ZERO!
               1226:                    ;LDB    MR1             MAKE SURE MR1=0
1ECF D6A8      1227:                    LDAB    MR1
1ED1 2623      1228:                    BNE     MOVF            B/ PRODUCT WOULD BE >= 2^16
               1229:                    ;LDB    MR2             MR2 MUST BE NON-ZERO HERE!
1ED3 D6A9      1230:                    LDAB    MR2
  0001         1231:                    IF      M6800
1ED5 8D26      1232: MLTPLYU            BSR     MUL6809         DO 6809 STYLE MULTIPLY OF (A) AND (B)
  0001         1233:                    ELSE    M6801!M6809
 *S*           1234: MLTPLYU            ;MUL
 *S*           1235:                    JSR     MUL6809         CALL USER-SUPPLIED CODE
               1236:                    FIN
1ED7 4D        1237:                    TSTA                    IS PRODUCT >= 2^16 ?
1ED8 261C      1238:                    BNE     MOVF            B/ YES, BYE!
               1239:                    ;STB    MS1             SAVE UPPER 8 BITS
1EDA D7BB      1240:                    STAB    MS1
  1EDC         1241: MLTPLYL            ;LDA    MS2             MS1 <> 0, DON'T BOTHER CHECKING MS2
1EDC 96BC      1242:                    LDAA    MS2
               1243:                    ;LDB    MR2             MR2 <> 0!
1EDE D6A9      1244:                    LDAB    MR2
  0001         1245:                    IF      M6800
1EE0 8D1B      1246:                    BSR     MUL6809
  0001         1247:                    ELSE    M6801!M6809
 *S*           1248:                    ;MUL
 *S*           1249:                    JSR     MUL6809         CALL USER-SUPPLIED CODE
               1250:                    FIN
1EE2 9BBB      1251:                    ADDA    MS1             ADD PARTIAL PRODUCT FROM OTHER CROSS PRODUCT
1EE4 2510      1252:                    BCS     MOVF            B/ SUM >= 2^16
1EE6 39        1253:                    RTS                     PRODUCT IS OK
               1254: 
1EE7 5D        1255: MLTPLYA            TSTB                    MS1=0, CHECK MS2
1EE8 270B      1256:                    BEQ     MLTPLY0RTS      B/ PRODUCT IS ZERO
               1257:                    ;LDA    MR1
1EEA 96A8      1258:                    LDAA    MR1
1EEC 27EE      1259:                    BEQ     MLTPLYL         MS1,MR1 = 0
               1260:                    ;JMP    MLTPLYU         MR1, MS2 <>0, GO COMPUTE UPPER CROSS PRODUCT
1EEE 7E1ED5    1261:                    JMP     MLTPLYU
               1262: 
  1EF1         1263: MLTPLY0            ;LDD    #0              PRODUCT IS ZERO
1EF1 C600      1264:                    LDAB    #(0)&$FF
1EF3 8600      1265:                    LDAA    #(0)/256
1EF5 39        1266: MLTPLY0RTS         RTS
               1267: 




