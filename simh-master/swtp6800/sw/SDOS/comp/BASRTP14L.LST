                 73: *                  XOPFOR -- SETS UP A FOR/NEXT LOOP
                 74: *                  ON THE VALUE STACK IS:
                 75: *                  TOS     STEP
                 76: *                  TOS-1   LIMIT
                 77: *                  TOS-2   INITIAL VALUE FOR LOOP VARIABLE
                 78: *                  (OPFOR)(OPNEXT ADDR+3)(INDEXVAR ADDR)(STEP/LIMIT VALUE ADDR)
                 79: *
  1665           80: XOPFOR
  0001           81:                    IF      M6800!M6801
                 82:                    ;LDX    BPC
1665 DE2E        83:                    LDX     BPC
                 84:                    FIN
1667 09          85:                    DEX                     MAKE BPC POINT TO FOR OPCODE
1668 DF2E        86:                    STX     BPC
                 87:                    ; ARE STEP, LIMIT, AND INITIAL VALUES ALL INTEGER ?
                 88:                    ;LDA    R1TYPE,S        ...?
166A 30          89:                    TSX
166B A600        90:                    LDAA    R1TYPE,X
  0001           91:                    IF      M6800!M6801
166D AA06        92:                    ORAA    R2TYPE,X
166F AA0C        93:                    ORAA    R3TYPE,X
  0001           94:                    ELSE    (M6809)
 *S*             95:                    ORAA    R2TYPE,S
 *S*             96:                    ORAA    R3TYPE,S
                 97:                    FIN
1671 270B        98:                    BEQ     FORINT          B/ YES, THIS IS THE EASY CASE!
                 99:                    ;JSR    MAKEBOTHFLOAT   NO, FORCE STEP AND LIMIT TO BE FLOATING
1673 BD057E     100:                    JSR     MAKEBOTHFLOAT
1676 8D19       101:                    BSR     STORESTEPANDLIMIT AND SAVE THEM
                102:                    ;JSR    FORCEFLOAT      FORCE INITIAL VALUE TO BE FLOAT
1678 BD1C80     103:                    JSR     FORCEFLOAT
                104:                    ;JMP    NEXTFS          GO SAVE IT AND CHECK AGAINST LIMIT
167B 7E1731     105:                    JMP     NEXTFS
                106: 
  167E          107: FORINT             EQU     *               STEP, LIMIT AND INITIAL VALUE ARE ALL INTEGER!
167E 8D11       108:                    BSR     STORESTEPANDLIMIT SAVE STEP AND LIMIT VALUES
                109:                    ;LDX    BPC             STORE INITIAL VALUE
1680 DE2E       110:                    LDX     BPC
                111:                    ;LDX    ILADD+3,X       GET LOOP INDEX ADDRESS
1682 EE03       112:                    LDX     ILADD+3,X
                113:                    ;JSR    FSTORE          IT DOESN'T HURT TO BE A LITTLE SLOW HERE, WE ONLY DO THIS ONCE!
1684 BD23D3     114:                    JSR     FSTORE
                115:                    ;LDX    BPC             GET SET TO CHECK INITIAL VALUE AGAINST LOOP LIMIT
1687 DE2E       116:                    LDX     BPC
                117:                    ;LDX    ILADD+5,X
1689 EE05       118:                    LDX     ILADD+5,X
                119:                    ;LDD    #0              CHEAT: FAKE STEP VALUE OF ZERO FOR BACK DOOR ENTRY
168B C600       120:                    LDAB    #(0)&$FF
168D 8600       121:                    LDAA    #(0)/256
168F 202F       122:                    BRA     NEXTICHECK      GO CHECK LOOP LIMIT




