               1558: *                  OPSSA -- SUBSCRIPT STRING ARRAY TO PRODUCE STRING DESCRIPTOR ON TOS
               1559: *                  TOS CONTAINS STRING SUBSCRIPT, TOS-1 CONTAINS STRING ARRAY ADDRESS
               1560: *                  STRING ARRAY FORMAT: (# STRINGS) (STRING)(STRING)(STRING)....
               1561: *
  0C33         1562: XOPSSA             EQU     *
               1563:                    ;JSR    RNDTOS
0C33 BD0B9D    1564:                    JSR     RNDTOS
0C36 0CDA      1565:                    FDB     DOSSE           ARRAY SUBSCRIPT ERROR IF NOT AN INTEGER!
               1566:                    ;SUBD   #1              MAP 0 INTO LARGE NUMBER, CONVERT TO ZERO OR
0C38 C001      1567:                    SUBB    #(1)&$FF
0C3A 8200      1568:                    SBCA    #(1)/256
               1569:                    ;LDX    R1ADD,S         GET STRING ARRAY ADDRESS
0C3C 30        1570:                    TSX
0C3D EE04      1571:                    LDX     R1ADD,X
               1572:                    ;CMPD   ,X              CHECK SUBSCRIPT BOUNDS
0C3F A100      1573:                    CMPA    0,X
0C41 2602      1574:                    BNE     MACRO:0007
0C43 E101      1575:                    CMPB    (0)+1,X
  0C45         1576: MACRO:0007
0C45 240B      1577:                    BCC     DOSSEJ          B/ TOO BIG!
               1578:                    ;LDX    MAXLEN+2,X      GRAB SIZE OF STRING
0C47 EE02      1579:                    LDX     MAXLEN+2,X
               1580:                    ;LEAX   STRING,X        ADJUST TO INCLUDE STRING HEAD
  0000         1581:                    IF      STRING<0
 *S*           1582:                    RPT     -STRING
 *S*           1583:                    DEX
               1584:                    ELSE
  0004         1585:                    RPT     STRING
0C49 08        1586:                    INX
0C4A 08
0C4B 08
0C4C 08
               1587:                    FIN
               1588:                    ;JSR    MLTPLY          COMPUTE DISPLACEMENT INTO STRING ARRAY
0C4D BD1EC5    1589:                    JSR     MLTPLY
0C50 2003      1590:                    BRA     XOPSSA1
  0C52         1591: DOSSEJ             ;JMP    DOSSE
0C52 7E0CDA    1592:                    JMP     DOSSE
               1593: 
  0C55         1594: XOPSSA1            ;ADDD   #2              ADJUST DISPLACEMENT TO INCLUDE # STRINGS CO
0C55 CB02      1595:                    ADDB    #(2)&$FF
0C57 8900      1596:                    ADCA    #(2)/256
               1597: *                                          ASSERT: MLTPLY CAN'T OVERFLOW!
               1598:                    ;ADDD   R1ADD,S         ADD STRING ARRAY BASE
0C59 30        1599:                    TSX
0C5A EB05      1600:                    ADDB    (R1ADD)+1,X
0C5C A904      1601:                    ADCA    R1ADD,X
  0001         1602:                    IF      M6800!M6801
               1603:                    ;STD    R1SDA,X         NOW CONVERT TOS INTO STRING DESCRIPTOR
0C5E E703      1604:                    STAB    (R1SDA)+1,X
0C60 A702      1605:                    STAA    R1SDA,X
               1606:                    ;LDD    #$FFFF          ...FOR THE ENTIRE STRING...
0C62 C6FF      1607:                    LDAB    #($FFFF)&$FF
0C64 86FF      1608:                    LDAA    #($FFFF)/256
               1609:                    ;STD    R1SDC,X




