                447: *                  DIVIDE TOS INTO TOS-1
                448: *
  05BE          449: XOPDIV             ;LDA    R1TYPE,S        ARE BOTH OPERANDS INTEGERS ?
05BE 30         450:                    TSX
05BF A600       451:                    LDAA    R1TYPE,X
  0001          452:                    IF      M6800!M6801
05C1 AA06       453:                    ORAA    R2TYPE,X
05C3 2616       454:                    BNE     DIV1            B/ NO, MUST DO FLOATING DIVIDE
                455:                    ;LDD    R2INT1,X        FETCH DIVIDEND
05C5 E60B       456:                    LDAB    (R2INT1)+1,X
05C7 A60A       457:                    LDAA    R2INT1,X
                458:                    ;LDX    R1INT1,X        AND THE DIVISOR
05C9 EE04       459:                    LDX     R1INT1,X
  0001          460:                    ELSE    (M6809)
 *S*            461:                    ORAA    R2TYPE,S
 *S*            462:                    BNE     DIV1
 *S*            463:                    ;LDD    R2INT1,S
 *S*            464:                    TSX
 *S*            465:                    LDAB    (R2INT1)+1,X
 *S*            466:                    LDAA    R2INT1,X
 *S*            467:                    ;LDX    R1INT1,S
 *S*            468:                    TSX
 *S*            469:                    LDX     R1INT1,X
                470:                    FIN
05CB 2768       471:                    BEQ     FLOATOVFLOW     B/ DIVISION BY ZERO!!! (GULP)
05CD DFBB       472:                    STX     MS1             SAVE DIVISOR
05CF 7400BB     473: DIVQL              LSR     MS1             NOW DO QUICK DIVIDE IF DIVISOR IS POWER OF TWO
05D2 7600BC     474:                    ROR     MS2             THIS LOOP TERMINATES BECAUSE DIVISOR IS NON-ZERO
05D5 2511       475:                    BCS     DIVQD           B/ NON-ZERO DIVISOR BIT FELL OUT
                476:                    ;LSRD                   DIVIDE DIVIDEND BY TWO
05D7 44         477:                    LSRA
05D8 56         478:                    RORB
05D9 24F4       479:                    BCC     DIVQL           B/ NO REMAINDER SO FAR
  05DB          480: DIV1               ;JSR    MAKEBOTHFLOAT   MUST DO FLOATING DIVIDE, RATS!!
05DB BD057E     481:                    JSR     MAKEBOTHFLOAT
                482:                    ;LDX    #FLOATOVFLOW
05DE CE0635     483:                    LDX     #FLOATOVFLOW
05E1 DF28       484:                    STX     FPTRAP
                485:                    ;JSR    FDIV
05E3 BD25E0     486:                    JSR     FDIV
05E6 20D3       487:                    BRA     MULX
05E8 26F1       488: DIVQD              BNE     DIV1            B/ REST OF DIVISOR <>0, CANNOT BE POWER OF TWO
05EA 7D00BB     489:                    TST     MS1             CHECK UPPER 8 BITS OF DIVISOR
05ED 2720       490:                    BEQ     TSXSUB3         B/ DIVISOR WAS POWER OF TWO, GO STORE ANSWER
05EF 20EA       491:                    BRA     DIV1            NO SUCH LUCK, GO DO IT THE HARD WAY




