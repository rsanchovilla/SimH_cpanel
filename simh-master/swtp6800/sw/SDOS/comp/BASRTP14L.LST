ASM/6800 1.4A0: 2672 RTP6800V1.4l       SD BASIC Version 1.4l Runtime Package (c) 1980 Software Dynamics
08/16/82 00:00:00; Page 309; Form 13    *** F L O A T I N G   P O I N T ***
RTP.ASM
                672: *                  THIS ROUTINE WILL FIND THE QUOTIENT DIGIT
                673: *                  AND SUBTRACT (QUO DIG * DIVISOR) FROM DIVIDEND
                674: *
  2675          675: FDIVS              EQU     *
                676: *
                677: *                  FIRST, GUESS THE QUOTIENT DIGIT (SEE KNUTH VOL 2 PAGE 237)
                678: *                  BY COMPUTING ((B)*100+(A))/MS2
                679: *                  NOTE: (B)<=MS2; MS2 >=50
                680: *
  2675          681: GUESSD             ;CMPB   MS2             QUOTIENT DIGIT = 99 ?
2675 D1BC       682:                    CMPB    MS2
2677 2605       683:                    BNE     GUESSD1         B/ NO, COMPUTE IT THE HARD WAY
                684:                    ;LDB    #99             YES, GRAB IT
2679 C663       685:                    LDAB    #99
                686:                    ;JMP    GUESSD2         GO USE IT
267B 7E26DC     687:                    JMP     GUESSD2
                688: 
  0001          689:                    IF      M6800
  267E          690: GUESSD1            ;STD    TEMPA           (B)<MS2; MULTIPLY (B) BY 100 AND ADD (A)
267E D701       691:                    STAB    TEMPA+1
2680 9700       692:                    STAA    TEMPA
2682 4F         693:                    CLRA                    ZERO UPPER PART OF B*100
2683 58         694:                    ASLB                    ASSERT: <=198
2684 DB01       695:                    ADDB    TEMPB           3*(B) <= 297
2686 49         696:                    ROLA
                697:                    ;ASLD                   (A,B):=6*B
2687 58         698:                    ASLB
2688 49         699:                    ROLA
                700:                    ;ASLD                   (A,B):=12*B
2689 58         701:                    ASLB
268A 49         702:                    ROLA
                703:                    ;ASLD                   (A,B):=24*B
268B 58         704:                    ASLB
268C 49         705:                    ROLA
268D DB01       706:                    ADDB    TEMPB           25*B
268F 8900       707:                    ADCA    #0
                708:                    ;ASLD                   (A,B):=50*B
2691 58         709:                    ASLB
2692 49         710:                    ROLA
                711:                    ;ASLD                   (A,B):=100*B
2693 58         712:                    ASLB
2694 49         713:                    ROLA
  0001          714:                    ELSE    M6801!M6809
 *S*            715: GUESSD1            ;STA    TEMPA
 *S*            716:                    STAA    TEMPA
 *S*            717:                    ;LDA    #100
 *S*            718:                    LDAA    #100
 *S*            719:                    ;MUL
 *S*            720:                    JSR     MUL6809         CALL USER-SUPPLIED CODE
                721:                    FIN
2695 DB00       722:                    ADDB    TEMPA           (A,B):=100*B+A <= 9999
2697 8900       723:                    ADCA    #0              NOTE: NOW B REGISTER <= 39
                724:                    ;ASLD                   GENERATE QUOTIENT DIGIT (8 BITS)
2699 58         725:                    ASLB
269A 49         726:                    ROLA




