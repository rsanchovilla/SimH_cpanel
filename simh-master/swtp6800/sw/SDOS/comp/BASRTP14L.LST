RTP.ASM
                209: *
                210: *                  OPOWER -- COMPUTE TOS-1 (Y) RAISED TO TOS POWER (X)
                211: *
  2015          212: XOPOWER            ;JSR    XBSUBR          ANALYZE POWER PART
2015 BD2106     213:                    JSR     XBSUBR
2018 11         214:                    OPDUP                   STORE POWER IN CASE OF Y ^ NON-INTEGER
2019 6E         215:                    OPSTORE
201A 0078       216:                    FDB     TTEMP2
201C 11         217:                    OPDUP                   SIGNZ:=SGN(POWER)
201D 6F         218:                    OPSGN
201E 6E         219:                    OPSTORE
201F 006C       220:                    FDB     SIGNZ
2021 7A07       221:                    OPABS                   NOW COMPUTE ABS(POWER)
2023 11         222:                    OPDUP                   DIVIDE POWER INTO INTEGER AND FRACTION PARTS
2024 5C         223:                    OPINT                   INTX:=INT(X) (**WHAT IF FLOAT ?**)
2025 11         224:                    OPDUP
2026 6E         225:                    OPSTORE
2027 0072       226:                    FDB     TTEMP1          = INT(ABS(POWER))
2029 2B         227:                    OPEQ                    COMPARE INT(X) TO X...
202A 70         228:                    OPASM                   AT THIS POINT STACK CONTAINS ONLY (Y)
                229:                    ;LDA    FLAG            IS EXPONENT AN INTEGER ?
202B 964C       230:                    LDAA    FLAG
202D 2715       231:                    BEQ     XOPOWER1        NO, DO EXP(LOG(TOS-1)*TOS)
                232:                    ;LDA    TTEMP1          YES, IS IT > 65535 ?
202F 9672       233:                    LDAA    TTEMP1
2031 2611       234:                    BNE     XOPOWER1        YES, DO EXP(LOG(TOS-1)*TOS)
                235:                    ;JSR    FORCEFLOAT      NO, GENERATE Y^X BY MULTIPLICATIVE PROCESS
