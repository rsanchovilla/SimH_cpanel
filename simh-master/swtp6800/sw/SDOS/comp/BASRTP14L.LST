                786: *                  OPFIND, FIND OCCURENCE OF TOS SD IN TOS-1 SD
                787: *                  RETURN 0 IF NOT THERE, ELSE RETURN INDEX IN TOS-1
                788: *                  IF LEN(S1: STRING TO BE SEARCHED) = 0, RETURN 0
                789: *                  IF LEN(S2: STRING TO SEARCH FOR) = 0, RETURN 1
                790: *                  POP BOTH
                791: *
  09CE          792: OPFINDNULL         ;LDD    #1              NULL STRING ALWAYS FOUND AT INDEX 1
09CE C601       793:                    LDAB    #(1)&$FF
09D0 8600       794:                    LDAA    #(1)/256
                795:                    ;JMP    OPFINDXIT
09D2 7E0A56     796:                    JMP     OPFINDXIT
                797: 
  09D5          798: XOPFIND            ;JSR    GSTRCNT         SET TEMP:= LENGTH OF STRING TO FIND
09D5 BD18DE     799:                    JSR     GSTRCNT
09D8 27F4       800:                    BEQ     OPFINDNULL
                801:                    ;LDX    R2SDC1,S        GET LENGTH OF STRING TO BE SEARCHED
09DA 30         802:                    TSX
09DB EE0A       803:                    LDX     R2SDC1,X
09DD 8CFFFF     804:                    CPX     #$FFFF
09E0 2605       805:                    BNE     OPFIND2
                806:                    ;LDX    R2SDA,S
09E2 30         807:                    TSX
09E3 EE08       808:                    LDX     R2SDA,X
                809:                    ;LDX    CURLEN,X
09E5 EE02       810:                    LDX     CURLEN,X
09E7 DF54       811: OPFIND2            STX     S1LEN           = LENGTH OF STRING TO BE SEARCHED
                812:                    ;LDD    S1LEN           FIND LEN(S1) - LEN(S2) + 1
09E9 D655       813:                    LDAB    S1LEN+1
09EB 9654       814:                    LDAA    S1LEN
                815:                    ;SUBD   TEMPX
09ED D001       816:                    SUBB    TEMPX+1
09EF 9200       817:                    SBCA    TEMPX
09F1 2525       818:                    BCS     OPFINDCANT      CAN'T COMPARE, LEN(S2) > LEN(S1)
                819:                    ;ADDD   #1
09F3 CB01       820:                    ADDB    #(1)&$FF
09F5 8900       821:                    ADCA    #(1)/256
09F7 5D         822:                    TSTB                    SET UP COUNT TO MAKE (DECB,DEC TWORD) BELOW EASY
09F8 2701       823:                    BEQ     OPFIND2A        B/ DON'T HAVE TO INC UPPER HALF
09FA 4C         824:                    INCA
  09FB          825: OPFIND2A           ;STA    TWORD           SAVE UPPER 8 BITS OF COUNT
09FB 9751       826:                    STAA    TWORD
                827:                    ;LDX    R2SDA,S
09FD 30         828:                    TSX
09FE EE08       829:                    LDX     R2SDA,X
  0001          830:                    IF      M6800!M6801
0A00 DF58       831:                    STX     S1ADD           STRING TO BE SEARCHED
                832:                    ;LDX    R1SDA,S
0A02 30         833:                    TSX
0A03 EE02       834:                    LDX     R1SDA,X
0A05 DF5C       835:                    STX     S2ADD           STRING TO SEARCH FOR
                836:                    ;LDA    STRING,X        GET FIRST BYTE OF "SEARCH-FOR" STRING
0A07 A604       837:                    LDAA    STRING,X
                838:                    ;LDX    S1ADD           = NEXT PLACE TO LOOK
0A09 DE58       839:                    LDX     S1ADD
  0A0B          840: OPFIND1ST          ;CMPA   STRING,X        FIND MATCH FOR 1ST BYTE




