                175:                    ;STB    2,X
13F7 E702       176:                    STAB    2,X
13F9 33         177:                    PULB
                178:                    ;STB    3,X
13FA E703       179:                    STAB    3,X
13FC 33         180:                    PULB
                181:                    ;STB    4,X
13FD E704       182:                    STAB    4,X
13FF 33         183:                    PULB
                184:                    ;STB    5,X
1400 E705       185:                    STAB    5,X
                186:                    ;LEAX   -RSESIZ,X
