                109:                    ;CMPA   #$40
2BF5 8140       110:                    CMPA    #$40
2BF7 2E0F       111:                    BGT     FIX1
2BF9 4F         112:                    CLRA                    # < 1, LOAD ZERO
                113:                    ;STA    4,X             RETURN ONLY 4 BYTES HERE
2BFA A704       114:                    STAA    4,X
                115:                    ;STA    5,X
2BFC A705       116:                    STAA    5,X
                117:                    ;STA    6,X
2BFE A706       118:                    STAA    6,X
                119:                    ;STA    7,X
2C00 A707       120:                    STAA    7,X
                121:                    ;JMP    FIX8
2C02 7E2CE1     122:                    JMP     FIX8
                123: 
  2C05          124: FIXERRJ            ;JMP    FIXERR
2C05 7E2CE9     125:                    JMP     FIXERR
                126: 
  2C08          127: FIX1
  0000          128:                    IF      M6809
 *S*            129:                    ;TFR    S,X             SIGH... THIS IS THE MOST CONVENIENT WAY TO DO THIS...
 *S*            130:                    TS0
                131:                    FIN
2C08 4F         132:                    CLRA
                133:                    ;STA    FAC3
2C09 97B2       134:                    STAA    FAC3
                135:                    ;STA    FAC4
2C0B 97B3       136:                    STAA    FAC4
                137:                    ;STA    FAC5
2C0D 97B4       138:                    STAA    FAC5
                139:                    ;LDA    3,X             USE 1ST F.P. DIGIT ON 1ST ITERATION
2C0F A603       140:                    LDAA    3,X
                141:                    ;STA    FAC6
2C11 97B5       142:                    STAA    FAC6
2C13 C407       143:                    ANDB    #7              LOOP CNTR, 5 >= B >= 1
2C15 5A         144:                    DECB                    ONLY ONE DIGIT ?
                145:                    ;STB    TEMPB           SET UP LOOP COUNT
2C16 D701       146:                    STAB    TEMPB
2C18 2603       147:                    BNE     FIX2            B/ MORE THAN 1 DIGIT TO PROCESS
                148:                    ;JMP    FIX4A           B/ ONLY ONE DIGIT, TAKE FAST EXIT




