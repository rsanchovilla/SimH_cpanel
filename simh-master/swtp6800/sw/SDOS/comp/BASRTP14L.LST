0789 D667        79:                    LDAB    ACMRET+1
078B 9666        80:                    LDAA    ACMRET
                 81:                    ;PSHD
078D 37          82:                    PSHB
078E 36          83:                    PSHA
                 84:                    ;JMP    FCMP
078F 7E23F5      85:                    JMP     FCMP
                 86: *
  0792           87: ACMP               ;LDA    R1TYPE+2,S      THIS IS MAIN ENTRY POINT OF SUBROUTINE
0792 30          88:                    TSX
0793 A602        89:                    LDAA    R1TYPE+2,X
  0001           90:                    IF      M6800!M6801
0795 AA08        91:                    ORAA    R2TYPE+2,X
