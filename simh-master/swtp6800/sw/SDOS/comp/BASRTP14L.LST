                380: *                  MAKEBOTHFLOAT -- ENSURES THAT TOS, TOS-1 ARE BOTH IN FLOATING POINT FORMAT
                381: *
  057E          382: MAKEBOTHFLOAT      ;PULD                   SAVE RETURN ADDRESS
057E 32         383:                    PULA
057F 33         384:                    PULB
                385:                    ;STD    RTPRET
0580 D765       386:                    STAB    RTPRET+1
0582 9764       387:                    STAA    RTPRET
                388:                    ;JSR    FORCEFLOAT      FLOAT TOS
0584 BD1C80     389:                    JSR     FORCEFLOAT
                390:                    ;LDA    R2TYPE,S        NOW, CHECK TOS-1 FOR FLOAT
0587 30         391:                    TSX
0588 A606       392:                    LDAA    R2TYPE,X
058A 260F       393:                    BNE     MFLOAT2
                394:                    ;LDX    #OPPOLYARG
058C CE007E     395:                    LDX     #OPPOLYARG
                396:                    ;JSR    FSTORE
058F BD23D3     397:                    JSR     FSTORE
                398:                    ;JSR    BFLOAT          FLOAT TOS-1
0592 BD1C85     399:                    JSR     BFLOAT
                400:                    ;LDX    #OPPOLYARG
0595 CE007E     401:                    LDX     #OPPOLYARG
                402:                    ;JSR    FLOAD
0598 BD2999     403:                    JSR     FLOAD
  059B          404: MFLOAT2            ;JMP    [RTPRET]        DONE
059B DE64       405:                    LDX     RTPRET
059D 6E00       406:                    JMP     0,X
                407: *
                408: *                  MULTIPLY TOS BY TOS-1
                409: *                  A,B WILL CONTAIN MULTIPLICAND
                410: *                  X WILL CONTAIN MULTIPLIER
                411: *                  A,B WILL CONTAIN THE PRODUCT
                412: *
  059F          413: XOPMUL             ;LDA    R1TYPE,S        ARE BOTH OPERANDS INTEGERS ?
059F 30         414:                    TSX
05A0 A600       415:                    LDAA    R1TYPE,X
  0001          416:                    IF      M6800!M6801
05A2 AA06       417:                    ORAA    R2TYPE,X
05A4 260B       418:                    BNE     MUL1            B/ NO, MUST DO FLOATING MULTIPLY
                419:                    ;LDD    R2INT1,X        YES, GRAB LEFT HAND OPERAND
05A6 E60B       420:                    LDAB    (R2INT1)+1,X
05A8 A60A       421:                    LDAA    R2INT1,X
                422:                    ;LDX    R1INT1,X        GET MULTIPLIER
05AA EE04       423:                    LDX     R1INT1,X
  0001          424:                    ELSE    (M6809)
 *S*            425:                    ORAA    R2TYPE,S
 *S*            426:                    BNE     MUL1
 *S*            427:                    ;LDD    R2INT1,S
 *S*            428:                    TSX
 *S*            429:                    LDAB    (R2INT1)+1,X
 *S*            430:                    LDAA    R2INT1,X
 *S*            431:                    ;LDX    R1INT1,S
 *S*            432:                    TSX
 *S*            433:                    LDX     R1INT1,X
                434:                    FIN




