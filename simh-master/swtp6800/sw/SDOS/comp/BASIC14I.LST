1828 2603      1485:                    BNE     FNUM1           B/ NOPE
182A BD0107    1486:                    JSR     GETTOKENCHAR    ACCEPT "-", GET NEXT BYTE
182D 8D41      1487: FNUM1              BSR     FDIGITS1        LOOK FOR DIGIT STRING
182F 2431      1488:                    BCC     FNUMF           B/ NO LEAD DIGITS, MUST BE FRACTION SYNTAX
1831 812E      1489:                    CMPA    #'.             DECIMAL POINT?
1833 2602      1490:                    BNE     FNUM2           B/ NO DECIMAL POINT
1835 8D36      1491:                    BSR     FDIGITS         COLLECT FRACTIONAL PART
1837 8145      1492: FNUM2              CMPA    #'E
1839 2704      1493:                    BEQ     FNUME           B/ LOOKS LIKE ONE COMING UP
183B 8165      1494:                    CMPA    #'E+$20         'E
183D 260E      1495:                    BNE     FNUMSUCCESS     NO EXPONET, GET OUT QUICK!
183F BD0107    1496: FNUME              JSR     GETTOKENCHAR    SEE IF DIGITS FOLLOW EXPONENT "E"
1842 812B      1497:                    CMPA    #'+             CHECK FOR SIGN
1844 270C      1498:                    BEQ     FNUMES          B/ SIGN IS INCLUDED
1846 812D      1499:                    CMPA    #'-             CHECK FOR - SIGN
1848 2708      1500:                    BEQ     FNUMES          B/ SIGN IS INCLUDED
184A BD1870    1501:                    JSR     FDIGITS1        LOOK FOR DIGIT STRING
184D BD010A    1502: FNUMSUCCESS        JSR     BACKUP          'E' NOT PART OF NUMBER
1850 0D        1503:                    SUCCESS 
1851 39        1504:                    RTS
               1505: 
1852 BD186D    1506: FNUMES             JSR     FDIGITS         EXPONENT HAS SIGN, LOOK FOR DIGITS
1855 25F6      1507:                    BCS     FNUMSUCCESS     B/ GOOD EXPONENT FOUND
1857 BD010A    1508:                    JSR     BACKUP          "E+<X>" IS APPARANTLY NOT AN EXPONENT
185A BD010A    1509:                    JSR     BACKUP
185D BD010A    1510:                    JSR     BACKUP
1860 0D        1511:                    SUCCESS                 BUT THE REST OF THE NUMBER LOOKS OK
1861 39        1512:                    RTS
               1513: 
1862 812E      1514: FNUMF              CMPA    #'.             MIGHT BE FRACTION ONLY F.P. NUMBER
1864 2605      1515:                    BNE     FNUMFAIL        B/ NO SUCH LUCK.
1866 BD186D    1516:                    JSR     FDIGITS         MUST HAVE DIGITS IN FRACTION PART
1869 25CC      1517:                    BCS     FNUM2           B/ GOT DIGITS, LOOKS OK
186B 0C        1518: FNUMFAIL           FAILURE                 NOT AN F.P. NUMBER
186C 39        1519:                    RTS
