



ASM/6800 1.4A0: 0000                    
08/16/82 00:00:00; Page 1; Form 1       
LOADER.ASM
                  1: ;* 
                  2: ;* Loader for Software Dynamics SDOS 1.1 Operating System
                  3: ;* I/O Routines for MF68 Floppy Disk
                  4: ;*
                  5: ;* (C) Roberto Sancho, Jun/2022
                  6: ;*
                  7: 
                  8: ;* Added fixes from MAY/2023 by Mike Douglas to work on real hardware
                  9: ;* The MF68 does not support dosuble side operations, so it has been made to work
                 10: ;* on Peripheral Technologies FD-2 Floppy controller (controller chip is WD2797)
                 11: ;* which supports double side and is compatible with MF68
                 12: ;*
                 13: ;* Modified to support standar FLEX2 disk on which trak0 sectors are numbered
                 14: ;* as follows: 0,1,3,4 .. 18.  
                 15: ; this loader is implemented to work with D command from SWTBUG ROM
                 16: ; D command loads sector zero into addr $2400, and branch to it
                 17: ; Sector zero of disk is the boot sector of SDOS. It has 16 bytes of prog
                 18: ; then 16 bytes for disk info, then 32 bytes for disk name (ascii)
                 19: ; the rest of sector is prog. 
                 20: 
                 21: 
  2400           22:        org  $2400
                 23: 
2400 CE245F      24:        ldx  #base+5             ; 8 bytes to setup and branch
2403 DF00        25:        stx  $00         
2405 7E2440      26:        jmp  st0
                 27:        
2408 31323334    28:        fcc  "1234----"          ;  8 bytes      This space is reserved. will be overwritten
2410 31323334    29:        fcc  "1234----5678----"  ; 16 bytes      with boot info. It is important that this
2420 31323334    30:        fcc  "1234----5678----"  ; 16 bytes      occupies exactly 8+8+16*3=64 bytes. No one more
2430 31323334    31:        fcc  "1234----5678----"  ; 16 bytes      no one less
                 32: 
                 33: 
                 34:        ; the boot prog continues here
                 35:         
2440 DE00        36: st0    ldx  $00                 ; this prog places the loaded (starting at LoaderStart)
2442 8C2598      37:        cpx  #base+5+LoaderLen   ; into its execution address 
2445 2603        38:        bne  st1                 ; and the branch to it
2447 7E5000      39:        jmp  LoaderStart
244A A600        40: st1    ldaa 0,x       
244C 08          41:        inx
244D DF00        42:        stx $00
244F FE245B      43:        ldx  base+1     ; dest
2452 A700        44:        staa 0,x
2454 08          45:        inx
2455 FF245B      46:        stx  base+1     
2458 20E6        47:        bra st0
                 48: 
  245A           49: base   equ  *
                 50: 
  5000           51:        org  $5000
  5800           52: buf    equ  $5800       
                 53: 
  5000           54: LoaderStart  equ *
                 55: 




ASM/6800 1.4A0: 2458                    
08/16/82 00:00:00; Page 2; Form 1       
LOADER.ASM
                 56:                         ; at last, we are at loader on the correct execution address. Go on ...
                 57:                         ; this is the entry point when called from SWTBUG "D" command
                 58:                         ; in this case, all the program is loaded at $2400 and onwards
                 59:                         ; track zero on disk has sectors numbered a 0,1, 3,... (weird, isn't it?)
                 60: 
5000 B62411      61: boot   ldaa $2411       ; get num of sectors per cluster
5003 4C          62:        inca             ; after the incr, a=first sector of Cluster 1
5004 B750BF      63:        staa sect        ; the first sector to read (is the first sector of sdos.sys)      
5007 CE5880      64:        ldx #buf+128
500A FF50C1      65:        stx ddata
500D 7F50BC      66:        clr goflag
                 67:        
5010 7D50BC      68: rdty   tst  goflag
5013 262F        69:        bne  go
5015 BD507A      70:        jsr  rdbyte      ; get load record type
5018 8100        71:        cmpa #0          ; .*echo type:a
501A 270C        72:        beq  rdty0       ; br if type 0 (fill record)
501C 8101        73:        cmpa #1
501E 261C        74:        bne rd0b
5020 BD506D      75: rdty1  jsr  rdword      ; type 1 record: skip 4 bytes
5023 BD506D      76:        jsr  rdword      
5026 20E8        77:        bra rdty
5028 BD506D      78: rdty0  jsr  rdword      ; type 0 record (fill record). get length
502B FF50BA      79:        stx  plen        ; .*echo ..skip:x
502E FE50BA      80: rd0a   ldx  plen
5031 27DD        81:        beq  rdty        ; br if record done, to read next one
5033 09          82:        dex
5034 FF50BA      83:        stx  plen
5037 BD507A      84:        jsr  rdbyte      ; read byte and discard it
503A 20F2        85:        bra  rd0a       
503C 8102        86: rd0b   cmpa #2
503E 270A        87:        beq  rdty2       ; br if type 2 (load record)
5040 8103        88:        cmpa #3
5042 2703        89:        beq  rdty3       ; br if type 3 (last load record)
5044 7E2000      90: go     jmp  $2000       ; start sdos.sys execution .*echo Start
5047 7C50BC      91: rdty3  inc  goflag       
504A BD506D      92: rdty2  jsr  rdword      ; type 2 start addr
504D FF50B8      93:        stx  pdata       ; .*echo ..addr:x
5050 BD506D      94:        jsr  rdword      ; type 2 length
5053 FF50BA      95:        stx  plen        ; .*echo ..len:x
5056 FE50BA      96: rd2    ldx  plen        ; copy type 2 record data
5059 27B5        97:        beq  rdty        ; br if record done, to read next one
505B 09          98:        dex
505C FF50BA      99:        stx  plen
505F BD507A     100:        jsr  rdbyte
5062 FE50B8     101:        ldx  pdata
5065 A700       102:        staa  0,x        ; .*echo ......addr:x
5067 08         103:        inx              ; .*echo .........data:a
5068 FF50B8     104:        stx  pdata
506B 20E9       105:        bra  rd2
                106: 
506D BD507A     107: rdword jsr  rdbyte      
5070 9700       108:        staa $00 
5072 BD507A     109:        jsr  rdbyte
5075 9701       110:        staa $01




ASM/6800 1.4A0: 5077                    
08/16/82 00:00:00; Page 3; Form 1       
LOADER.ASM
5077 DE00       111:        ldx $00
5079 39         112:        rts
                113: 
507A FE50C1     114: rdbyte  ldx ddata       
507D 8C5880     115:         cpx #buf+128
5080 2608       116:         bne rdbyte1
5082 8D0D       117:         bsr rdsk        ; read disk on disk buf empty
5084 CE5800     118:         ldx #buf        ; point again to start of buf
5087 FF50C1     119:         stx ddata
508A A600       120: rdbyte1 ldaa 0,x
508C 08         121:         inx
508D FF50C1     122:         stx ddata
5090 39         123:         rts             
                124: 
5091 CE5800     125: rdsk    ldx #buf        
5094 FF50C1     126:         stx ddata
5097 BD50C4     127:         jsr rdsec       ; **troff
509A F650BF     128:         ldab sect       ; **tron
509D C112       129:         cmpb #18        ; if just read sector 18 (last on on tracks)
509F 2613       130:         bne rdsk1       ; then incr track number, reset sector num to 1
50A1 7D50C0     131:         tst side
50A4 2605       132:         bne rdsk0a
50A6 7C50C0     133:         inc side
50A9 2006       134:         bra rdsk0b
50AB 7F50C0     135: rdsk0a  clr side
50AE 7C50BE     136:         inc trk
50B1 7F50BF     137: rdsk0b  clr sect
50B4 7C50BF     138: rdsk1   inc sect
50B7 39         139:         rts     
                140: 
50B8 0000       141: PDATA   fdb 0        
50BA 0000       142: PLEN    fdb 0         
50BC 00         143: GOFLAG  fcb 0
                144: 
                145: ; DISK DRIVERS FOR SOUTHWEST TECHNICAL PRODUCTS MF-68
                146: ; (FD-2 CONTROLLER)
                147: 
                148: ; INPUT PARAMS
                149: 
50BD 00         150: DRV    fcb 0         ; DRIVE TO OPERATE ON
50BE 00         151: TRK    fcb 0         ; TRACK TO READ/WRITE
50BF 00         152: SECT   fcb 0         ; SECTOR TO READ/WRITE
50C0 00         153: SIDE   fcb 0         ; SIDE TO READ/WRITE
50C1 0000       154: DDATA  fdb 0         ; POINTER TO DATA BUFFER (MUST HAVE 128 BYTES)
                155: 
                156: ; COMMANDS FOR WD1771 CONTROLLER CHIP
                157: ;
  0008          158: FDRSC  EQU $08       ; RESTORE
  0018          159: FDSKI  EQU $18       ; SEEK
  0088          160: FDRDC  EQU $88       ; READ A SECTOR
  00A8          161: FDWRC  EQU $A8       ; WRITE A SECTOR
                162: 
                163: ; ADDR OF WD1771 CONTROLLER CHIP REGISTERS 
                164: 
  8014          165: DRVREG EQU $8014




ASM/6800 1.4A0: 50C1                    
08/16/82 00:00:00; Page 4; Form 1       
LOADER.ASM
  8018          166: CMDREG EQU $8018
  8019          167: TRKREG EQU $8019
  801A          168: SECREG EQU $801A
  801B          169: DATREG EQU $801B
                170: 
                171: ; DRIVER VARS
                172: 
50C3 00         173: RCNT   FCB  0         ; RETRY COUNT
                174: 
                175: ; READ A SECTOR
                176: ;
50C4 BD511F     177: RDSEC  JSR SELDRV     ; SELECT DRIVE AND SIDE
50C7 BD50D3     178: RDSEC1 JSR READ       ; READ A SECTOR
50CA 2706       179:        BEQ RDEXIT     ; OK
50CC 7A50C3     180:        DEC RCNT       ; RETRY AGAIN?
50CF 26F6       181:        BNE RDSEC1     ; YES
50D1 4D         182:        TSTA           ; A=ERROR STATUS
50D2 39         183: RDEXIT RTS
                184: 
                185: ; READ A SECTOR (A=TRK, B=SECTOR)
                186: ;
50D3 BD50F7     187: READ   JSR SEEK
50D6 8688       188:        LDAA #FDRDC    ; READ COMMAND
50D8 B78018     189:        STAA CMDREG     
50DB BD5112     190:        JSR DEL56U     ; DELAY
50DE FE50C1     191:        LDX DDATA      ; GET BUFFER ADDRESS
                192: 
50E1 B68018     193: READ1  LDAA CMDREG     
50E4 8502       194:        BITA #$02      ; DATA REG FULL?
50E6 2607       195:        BNE READ2      ; YES
50E8 8501       196:        BITA #1        ; BUSY?
50EA 26F5       197:        BNE READ1      ; LOOP IF BUSY, ELSE ERROR
                198: 
50EC 841C       199:        ANDA #$1C      ; MASK OFF STATUS BITS
50EE 39         200:        RTS             
                201: 
50EF B6801B     202: READ2  LDAA DATREG    ; GET A BYTE
50F2 A700       203:        STAA 0,X       ; STORE IN BUFFER
50F4 08         204:        INX             
50F5 26EA       205:        BNE READ1      ; LOOP TO READ NEXT BYTE
                206:                        
                207: ; SEEK A=TRACK, B=SECTOR
                208: 
50F7 F7801A     209: SEEK   STAB SECREG    ; SET SECTOR
50FA B18019     210:        CMPA TRKREG    ; ON TRACK?
50FD 2712       211:        BEQ CMDEX      ; YES
                212: 
50FF B7801B     213:        STAA DATREG    ; NO, STORE TRACK#
5102 8618       214:        LDAA #FDSKI    ; SEEK COMMAND
5104 B78018     215: DOCMD  STAA CMDREG
5107 BD5112     216:        JSR DEL56U
                217: 
510A B68018     218: WBUSY  LDAA CMDREG
510D 8501       219:        BITA #1
510F 26F9       220:        BNE WBUSY




ASM/6800 1.4A0: 5111                    
08/16/82 00:00:00; Page 5; Form 1       
LOADER.ASM
5111 39         221: CMDEX  RTS
                222: 
                223: ; DEL56U- DELAY 56us INCLUDING THE CALL TO DELAY56U
                224: 
5112 BD5115     225: DEL56U JSR DELAY2
5115 BD5118     226: DELAY2 JSR DELAY3
5118 39         227: DELAY3 RTS
                228: 
                229: ; RESTORE SEEK TRACK0
                230: 
5119 8D04       231: RESTOR BSR SELDRV     ; SELECT THE DRIVE
511B 8608       232:        LDAA #FDRSC    ; RESTORE COMMAND
511D 20E5       233:        BRA DOCMD      ; EXEC DISK CONTROLLER CMD
                234: 
                235: ; SELECT THE DRIVE
                236: ; RETURN A=TRACK, B=SECTOR
                237: 
511F B650BD     238: SELDRV LDAA DRV       ; GET DRIVE 
5122 7D50C0     239:        TST  SIDE
5125 2702       240:        BEQ  DOSEL
5127 8A40       241:        ORAA #$40
5129 B78014     242: DOSEL  STAA DRVREG    ; SELECT THE DRIVR
                243: 
512C 8605       244:        LDAA #5        ; SET RETRY COUNT
512E B750C3     245:        STAA RCNT       
5131 B650BE     246:        LDAA TRK       ; GET TRACK#        
5134 F650BF     247:        LDAB SECT      ; GET SECTOR#
5137 39         248:        RTS            
                249: 
  0139          250: LoaderLen equ   *-LoaderStart+1
                251:         
  6000          252:        org $6000        ; this is the entry point when LOADER is bring to ram as S19 file using SWTBUG "L" comm
                253:                         ; in this case, the program is loaded at its assembled address
                254:                         ; track zero on disk has sectors numbered a 1,2,3,... (the expected SDOS numbering)
                255:        
6000 8601       256: boot2  ldaa #1
6002 B750BF     257:        staa sect
6005 7F50C0     258:        clr  side
6008 7F50BE     259:        clr  trk
600B BD5091     260:        jsr  rdsk
600E B65811     261:        ldaa buf+$11     ; this is the number of sectors pre cluster
6011 B72411     262:        staa $2411
6014 7E5000     263:        jmp  boot
                264: 
                265:        ; to start the LOADER with SWTBUG "G" command
  A048          266:        ORG $A048
A048 6000       267:        FDB boot2       
                268: 
                269:        END




