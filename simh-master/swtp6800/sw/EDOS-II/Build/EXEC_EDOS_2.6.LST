00566 04B8 84 08          AND A  #$08     IF THERE WAS A CRC ERROR 
00567 04BA 27 0F          BEQ    WRTS3    THEN (SUCCESS EXIT, A = 0)
00568 04BC BD EA38        JSR    RFLAG    RESET ERROR FLAG ON DISK I/F
00569 04BF 7A 0155        DEC    TRYCT    IF RETRY COUNT RUN OUT
00570 04C2 26 E7          BNE    WRTS2    THEN
00571 04C4 86 0E          LDA A  #$0E     ASK DISK TO MARK THIS SECTOR  
