00715 0597 39             RTS             AND RETURN (FAILURE)
00716 0598 81 FF   CREA1  CMP A  #$FF     IF DIRECTORY IS FULL (NO EOD  
00717 059A 27 03          BEQ    CREA2    THEN
00718 059C 86 01          LDA A  #$1      DEFINE FLAG VALUE = NO ROOM
00719 059E 39             RTS             AND RETURN (FAILURE)
00720 059F DE CE   CREA2  LDX    SESP1    LOAD SCAN POINTER
00721 05A1 86 1A          LDA A  #26      THERE ARE 26 SECTORS PER TRAC 
00722 05A3 B7 0155        STA A  SECCT    PREPARE TO COUNT BY <SECTOR>< 
00723 05A6 4F             CLR A           STARTING FROM
00724 05A7 5F             CLR B           0, COUNT OFF SECTOR MODULUS
00725 05A8 AB 06   CREA3  ADD A  $6,X     TIMES THE TRACKS
00726 05AA C9 00          ADC B  #$0      ALREADY USED
00727 05AC 7A 0155        DEC    SECCT    GIVING THE NO. OF SECTORS
00728 05AF 26 F7          BNE    CREA3    ALREADY USED (TO THIS TRACK)
00729 05B1 AB 07          ADD A  $7,X     THEN ADD THE SECTORS ALREADY  
00730 05B3 C9 00          ADC B  #$0      THIS TRACK, GIVING SECTORS US 
00731 05B5 B7 0156        STA A  SECCT+1  PUT AWAY THE CALCULATED
00732 05B8 F7 0155        STA B  SECCT    NUMBER OF SECTORS ALREADY USE 
00733 05BB CE 07D0        LDX    #2000    THERE ARE 2000 SECTORS AVAILA 
00734 05BE DF CA          STX    SECAV    CALCULATE
00735 05C0 D6 CA          LDA B  SECAV    THAT THE
00736 05C2 96 CB          LDA A  SECAV+1  AVAILABLE SECTORS
00737 05C4 B0 0156        SUB A  SECCT+1  MINUS THE USED
00738 05C7 F2 0155        SBC B  SECCT    SECTORS GIVES THE FREE SECTOR 
00739 05CA D7 CA          STA B  SECAV    SAVE THE NEW
00740 05CC 97 CB          STA A  SECAV+1  FREE SECTORS
00741 05CE 90 C8          SUB A  FILRQ+1  SUBTRACT THE NEW FILE'S SECTO 
00742 05D0 D2 C7          SBC B  FILRQ    IF NOT ENOUGH SECTORS ARE FRE 
00743 05D2 2A 05          BPL    CREA4    THEN
00744 05D4 DE CA          LDX    SECAV    DEFINE HOW MANY SECTORS ARE A 
00745 05D6 86 03          LDA A  #$3      FLAG "NOT ENOUGH ROOM ON DISK 
00746 05D8 39             RTS             RETURN TO CALLER (FAILURE)
