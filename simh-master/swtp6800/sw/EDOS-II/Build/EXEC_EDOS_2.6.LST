00404              *START ADDRESS IS IN X, NUMBER OF CHARACTERS IN B
00405              *
00406 03C1 A6 00   PRINS  LDA A  $0,X     GET A CHARACTER
00407 03C3 BD F018        JSR    PRINC    PRINT IT OUT
00408 03C6 08             INX             STEP TO NEXT CHARACTER
00409 03C7 5A             DEC B           WHILE CHARACTERS
00410 03C8 26 F7          BNE    PRINS    CONTINUE
00411 03CA 39             RTS             RETURN TO CALLER
00412              *
00413              *
00414              *THIS ROUTINE PRODUCES <CR> <LF> ON THE CONSOLE
00415              *(ESTABLISH A NEW LINE FOR THE NEXT FUNCTION)
00416              *
00417 03CB 86 0D   CRLF   LDA A  #CR      DEFINE AN ASCII <CR>
00418 03CD 20 09          BRA    ECHO1    BORROW THE ECHO FUNCTION
00419              *
00420              *THIS ROUTINE ECHOS INPUT CHARACTERS, EXCEPT RUBOUT 
00421              *THE PARITY BIT IS STRIPPED, AND <CR> IS AMPLIFIED T
00422              *THE INPUT CHARACTER IS PASSED THROUGH THIS ROUTINE
00423              *
00424 03CF BD 03E9 ECHOC  JSR    GETCH    GET AN INPUT CHARACTER
00425 03D2 84 7F          AND A  #$7F     STRIP OFF THE PARITY BIT
00426 03D4 81 7F          CMP A  #$7F     IF NOT A RUBOUT OR "BREAK"
00427 03D6 27 10          BEQ    ECHO2    THEN
00428 03D8 36      ECHO1  PSH A           SAVE THE CHARACTER
00429 03D9 BD F018        JSR    PRINC    PRINT THE CHARACTER
00430 03DC 32             PUL A           RESTORE THE CHARACTER
00431 03DD 81 0D          CMP A  #CR      IF IT IS ASCII <CR>
00432 03DF 26 07          BNE    ECHO2    THEN
00433 03E1 36             PSH A           SAVE THE CHARACTER AGAIN
00434 03E2 86 0A          LDA A  #LF      DEFINE AN ASCII <LF>
00435 03E4 BD F018        JSR    PRINC    AND DO A CONSOLE LINE FEED
00436 03E7 32             PUL A           RESTORE THE CHARACTER
00437 03E8 39      ECHO2  RTS             RETURN TO CALLER
00438              *
00439              *
00440              *THIS ROUTINE LOOPS ON THE ACIA STATUS REGISTER DONE
00441              *A CHARACTER.  THE CPU WAITS HERE UNTIL A CHARACTER 
00442              *A CHARACTER IS PRESENTED, IT IS RETURNED TO CALLER 
00443              *
00444 03E9 B6 FCF4 GETCH  LDA A  ACIAS    READ THE ACIA STATUS
00445 03EC 47             ASR A           IF CHARACTER IS AVAILABLE
00446 03ED 24 FA          BCC    GETCH    THEN
00447 03EF B6 FCF5        LDA A  ACIAR    READ THE CHARACTER
00448 03F2 0C             CLC             CLEAR THE "C" BIT
00449 03F3 39             RTS             RETURN THE CHARACTER
00450              *
00451              *
00452              *THIS ROUTINE PERFORMS BINARY TO HEX CONVERSION,
00453              *AND PRINTS THE RESULT USING THE SWITCHED PRINT 
00454              *VECTOR TO SELECT THE OUTPUT DEVICE.
00455              *
00456 03F4 97 C9   PRBIN  STA A  HDIGT    COPY THE BINARY DATA
00457 03F6 44             LSR A           SHIFT THE 4
00458 03F7 44             LSR A           MOST SIGNIFICANT
00459 03F8 44             LSR A           BITS INTO A
00460 03F9 44             LSR A           BINARY VALUE
00461 03FA BD 0404        JSR    PRBN1    PRINT THE VALUE(H)
00462 03FD 96 C9          LDA A  HDIGT    GET THE BINARY DATA
00463 03FF 84 0F          AND A  #$0F     STRIP OFF THE HIGH DIGIT
00464 0401 7E 0404        JMP    PRBN1    PRINT THE VALUE(L) & RETURN
00465              *
00466 0404 81 0A   PRBN1  CMP A  #$0A     IF .GE. 9
00467 0406 2B 02          BMI    PRBN2    THEN
00468 0408 8B 07          ADD A  #$7      SKIP OVER : TO @
00469 040A 8B 30   PRBN2  ADD A  #'0      CONVERT TO ASCII (HEX)
00470 040C 7E 0030        JMP    PRNVC    PRINT, USING SWITCHED PRINT & 
00471              *
00472              *
